{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/harshanandak/forge/main/src/core/config/schemas/template.input.json",
  "type": "object",
  "required": ["template"],
  "properties": {
    "template": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "An installed template id (optionally <id>@<version>), or a project-relative .json/.yaml template file."
    }
  },
  "additionalProperties": false
}
