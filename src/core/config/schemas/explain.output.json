{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/harshanandak/forge/main/src/core/config/schemas/explain.output.json",
  "type": "object",
  "required": ["pointer", "set", "value", "layer", "source", "entries"],
  "properties": {
    "pointer": {
      "$ref": "../../../../schemas/common.json#/$defs/JsonPointer"
    },
    "set": {
      "type": "boolean"
    },
    "value": {},
    "layer": {
      "enum": ["default", "derived", "project", "invocation", null]
    },
    "source": {
      "description": "Where the value came from: the block's configSchema default, a template, the user, detection, or this call.",
      "enum": ["default", "template", "user", "derived", "invocation", null]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "defs.json#/$defs/LayerEntry"
      }
    }
  },
  "additionalProperties": false
}
