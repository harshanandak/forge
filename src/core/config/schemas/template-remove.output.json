{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/harshanandak/forge/main/src/core/config/schemas/template-remove.output.json",
  "description": "Only keys the template still owns unchanged are removed; edited keys stay.",
  "allOf": [
    {
      "$ref": "defs.json#/$defs/WriteFields"
    },
    {
      "type": "object",
      "required": ["template", "removed", "kept"],
      "properties": {
        "file": {},
        "previousRevision": {},
        "revision": {},
        "changes": {},
        "fileRemoved": {},
        "template": {
          "$ref": "../../../../schemas/common.json#/$defs/TemplateRef"
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "../../../../schemas/common.json#/$defs/JsonPointer"
          }
        },
        "kept": {
          "type": "array",
          "items": {
            "$ref": "defs.json#/$defs/KeptKey"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
