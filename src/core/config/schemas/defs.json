{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/harshanandak/forge/main/src/core/config/schemas/defs.json",
  "description": "Shapes shared by the config and template operations.",
  "$defs": {
    "Layer": {
      "enum": ["default", "derived", "project", "invocation"]
    },
    "PatchStep": {
      "type": "object",
      "required": ["op", "path"],
      "if": { "properties": { "op": { "const": "set" } } },
      "then": { "required": ["value"] },
      "properties": {
        "op": {
          "enum": ["set", "remove"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "A JSON Pointer into the config document, or <instance>.<key>... for that instance's config."
        },
        "value": {}
      },
      "additionalProperties": false
    },
    "Patch": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "defs.json#/$defs/PatchStep"
      }
    },
    "Change": {
      "type": "object",
      "required": ["pointer"],
      "properties": {
        "pointer": {
          "$ref": "../../../../schemas/common.json#/$defs/JsonPointer"
        },
        "before": {},
        "after": {}
      },
      "additionalProperties": false
    },
    "LayerEntry": {
      "type": "object",
      "required": ["pointer", "value", "layer", "active"],
      "properties": {
        "pointer": {
          "$ref": "../../../../schemas/common.json#/$defs/JsonPointer"
        },
        "value": {},
        "layer": {
          "$ref": "defs.json#/$defs/Layer"
        },
        "origin": {
          "$ref": "../../../../schemas/detection.json#/$defs/DetectionOrigin"
        },
        "owner": {
          "type": "object",
          "required": ["from", "baseline", "edited"],
          "properties": {
            "from": {
              "$ref": "../../../../schemas/common.json#/$defs/TemplateRef"
            },
            "baseline": {
              "$ref": "../../../../schemas/common.json#/$defs/Digest"
            },
            "edited": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "active": {
          "type": "boolean"
        },
        "overriddenBy": {
          "type": "object",
          "required": ["layer", "pointer"],
          "properties": {
            "layer": {
              "$ref": "defs.json#/$defs/Layer"
            },
            "pointer": {
              "$ref": "../../../../schemas/common.json#/$defs/JsonPointer"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Ignored": {
      "type": "object",
      "required": ["key", "reason"],
      "properties": {
        "key": {
          "type": "string"
        },
        "detector": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "KeptKey": {
      "type": "object",
      "required": ["pointer", "reason"],
      "properties": {
        "pointer": {
          "$ref": "../../../../schemas/common.json#/$defs/JsonPointer"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "WriteFields": {
      "allOf": [
        { "$ref": "defs.json#/$defs/TemplateWriteFields" },
        { "required": ["changes"] }
      ]
    },
    "TemplateWriteFields": {
      "type": "object",
      "required": ["file", "previousRevision", "revision", "fileRemoved"],
      "properties": {
        "file": {
          "$ref": "../../../../schemas/common.json#/$defs/RelativePath"
        },
        "previousRevision": {
          "$ref": "../../../../schemas/common.json#/$defs/Digest"
        },
        "revision": {
          "$ref": "../../../../schemas/common.json#/$defs/Digest"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "defs.json#/$defs/Change"
          }
        },
        "fileRemoved": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "LawReason": {
      "description": "One condition of a law, with the resolved value it was judged on.",
      "type": "object",
      "required": ["pointer", "condition", "actual", "set", "holds", "source"],
      "properties": {
        "pointer": {
          "description": "The resolved config pointer, or the key as written when it is not a config path.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "condition": { "type": "object" },
        "actual": {
          "description": "The resolved value; null when it is not set."
        },
        "set": { "type": "boolean" },
        "holds": { "type": "boolean" },
        "source": {
          "enum": [
            "default",
            "derived",
            "project",
            "template",
            "invocation",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "LawReport": {
      "type": "object",
      "required": ["id", "says", "at", "status", "detail", "reasons"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "says": { "type": "string" },
        "at": {
          "$ref": "../../../../schemas/common.json#/$defs/Segment"
        },
        "status": { "enum": ["enforced", "broken", "unenforced"] },
        "detail": {
          "description": "Why the law has this status, in plain words.",
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": { "$ref": "defs.json#/$defs/LawReason" }
        }
      },
      "additionalProperties": false
    }
  }
}
