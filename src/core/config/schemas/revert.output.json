{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/harshanandak/forge/main/src/core/config/schemas/revert.output.json",
  "description": "The exact prior bytes are restored (or the file removed if it did not exist).",
  "allOf": [
    {
      "$ref": "defs.json#/$defs/WriteFields"
    },
    {
      "type": "object",
      "required": ["reverted"],
      "properties": {
        "file": {},
        "previousRevision": {},
        "revision": {},
        "receipt": {},
        "changes": {},
        "fileRemoved": {},
        "reverted": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  ]
}
