{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/harshanandak/forge/main/src/core/config/schemas/explain.input.json",
  "type": "object",
  "required": ["path"],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "A JSON Pointer into the config document, or <instance>.<key>... for that instance's config."
    }
  },
  "additionalProperties": false
}
