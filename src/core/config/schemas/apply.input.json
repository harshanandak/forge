{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/harshanandak/forge/main/src/core/config/schemas/apply.input.json",
  "type": "object",
  "required": ["patch", "expectRevision"],
  "properties": {
    "patch": {
      "$ref": "defs.json#/$defs/Patch"
    },
    "expectRevision": {
      "description": "The revision read with config show: the digest of the config file's bytes (an absent file has the digest of no bytes).",
      "$ref": "../../../../schemas/common.json#/$defs/Digest"
    }
  },
  "additionalProperties": false
}
