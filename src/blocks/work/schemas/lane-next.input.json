{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "all": {
      "const": true,
      "description": "Return the next action for every lane in the registry."
    },
    "pr": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "head": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    }
  },
  "oneOf": [{ "required": ["id"] }, { "required": ["all"] }],
  "additionalProperties": false
}
