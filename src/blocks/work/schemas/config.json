{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "labels": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["prefix"],
                "properties": {
                  "prefix": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["oneOf"],
                "properties": {
                  "oneOf": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "claimTtlSeconds": {
      "description": "Default lease lifetime in seconds for issue.claim and issue.renew when input.ttlSeconds is omitted. An explicit input duration overrides this value.",
      "type": "integer",
      "default": 3600,
      "minimum": 1,
      "maximum": 604800
    },
    "labelOrder": {
      "description": "Labels in rank order, first ranks highest (for example p0, p1, p2). issue.ready sorts an item by the first of these labels it carries; items with none come last, and ties keep their stored order. Left empty, issue.ready does not reorder.",
      "type": "array",
      "default": [],
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "idPrefix": {
      "description": "The prefix new issue ids carry, as in <idPrefix>-<n>. Derived from the project: the origin remote's repository name, or the main checkout's folder name when Git is unavailable or no origin is configured, normalised to lowercase letters, digits and hyphens. A failed origin lookup refuses a work operation only when the project has no explicit idPrefix; other calls omit the failed derived observation: transient failures may be retried; permanent failures require correcting the reported Git error. Every item is shown with the current prefix; an id with a prefix this project minted with earlier (work-12 after a change to acme) still names the same item, and any other prefix is refused.",
      "type": "string",
      "default": "work",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "lanes": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "discardIgnored": {
          "description": "Ignored paths safe to discard when removing a clean lane. A trailing slash matches a directory prefix.",
          "type": "array",
          "default": ["node_modules/", "dist/"],
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "base": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Origin branch to fetch. Omitted: origin HEAD, falling back to main."
        },
        "autopilot": {
          "description": "Autopilot limits and post-merge steps for lane next. enabled false makes every lane next return pause. budgets are per lane; load limits show as a hold in lane status; the hold is advisory and does not yet stop lane start. receiptChecks lists the checks run at the merge commit; rebuild is the runtime rebuild command and has no default.",
          "type": "object",
          "properties": {
            "receiptChecks": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "merge": {
              "default": {},
              "description": "The merge step of lane next. headReviewers are GitHub logins whose completed review must name the exact head (default the Codex connector, read from its codex-review-state:v1 summary comment). securityLabels and securityPaths mark a PR as security tier, which gets a gated ask and never a merge action; paths match a file or a folder prefix.",
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Off until a trusted merge-gate verdict channel exists: lane record cannot yet tell which session recorded a verdict, so with false lane next never returns the merge action and a PR that is otherwise ready pauses for the owner."
                },
                "requiredChecks": {
                  "default": "github-required",
                  "description": "Which checks must pass on the head, the same rule as check.gate: github-required (GitHub's required flag) or a list of check names.",
                  "oneOf": [
                    { "const": "github-required" },
                    {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 256,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    }
                  ]
                },
                "headReviewers": {
                  "default": ["chatgpt-codex-connector[bot]"],
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 16,
                  "description": "GitHub logins compared case-insensitively. An empty list does not skip the head review: lane next pauses.",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(\\[bot\\])?$",
                    "maxLength": 100
                  }
                },
                "securityLabels": {
                  "default": ["security"],
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "securityPaths": {
                  "default": [
                    ".github/workflows",
                    "package.json",
                    "bun.lock",
                    "src/core/trust",
                    "src/adapters/fs",
                    "src/adapters/process",
                    "src/assembly/providers.ts",
                    "templates/delivery"
                  ],
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              },
              "additionalProperties": false
            },
            "rebuild": {
              "type": "object",
              "required": ["argv"],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              },
              "additionalProperties": false
            },
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "budgets": {
              "type": "object",
              "properties": {
                "calls": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 20
                },
                "reviewRounds": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 2
                },
                "ciFixRounds": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 3
                },
                "activeHours": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 8
                }
              },
              "additionalProperties": false
            },
            "load": {
              "type": "object",
              "properties": {
                "minFreeMemoryMb": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 2048
                },
                "maxCpuPercent": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100,
                  "default": 85
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
