{
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "attempt": { "type": "string", "pattern": "^attempt-[1-9][0-9]*$" },
    "pr": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "noPr": { "type": "boolean" },
    "receipt": { "type": "string", "minLength": 1, "maxLength": 200 },
    "dropped": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "keepOpen": { "type": "boolean" },
    "discardIgnored": { "type": "boolean" }
  },
  "oneOf": [
    { "required": ["receipt"], "not": { "required": ["dropped"] } },
    { "required": ["dropped"], "not": { "required": ["receipt"] } }
  ],
  "anyOf": [
    { "required": ["pr"], "properties": { "noPr": { "const": false } } },
    {
      "required": ["noPr", "dropped"],
      "properties": { "noPr": { "const": true } },
      "not": { "required": ["pr"] }
    }
  ],
  "additionalProperties": false
}
