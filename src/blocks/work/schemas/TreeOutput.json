{
  "type": "object",
  "required": ["items", "parentless", "closedParents", "truncated"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/Node" }
    },
    "parentless": { "$ref": "#/$defs/Summary" },
    "closedParents": { "$ref": "#/$defs/Summary" },
    "truncated": { "type": "boolean" }
  },
  "additionalProperties": false,
  "$defs": {
    "Node": {
      "type": "object",
      "required": ["item", "openChildren", "closedChildren", "children"],
      "properties": {
        "item": {
          "$ref": "https://raw.githubusercontent.com/harshanandak/forge/main/schemas/tracker.json#/$defs/TrackerItem"
        },
        "openChildren": { "type": "integer", "minimum": 0 },
        "closedChildren": { "type": "integer", "minimum": 0 },
        "children": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/Node" }
        }
      },
      "additionalProperties": false
    },
    "Summary": {
      "type": "object",
      "required": ["count", "ids"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "ids": {
          "type": "array",
          "maxItems": 1000,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
