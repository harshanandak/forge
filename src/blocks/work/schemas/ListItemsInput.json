{
  "type": "object",
  "properties": {
    "parent": { "type": "string", "minLength": 1, "maxLength": 200 },
    "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
    "label": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "status": {
      "$ref": "https://raw.githubusercontent.com/harshanandak/forge/main/schemas/tracker.json#/$defs/ItemStatus"
    },
    "ready": {
      "description": "Only open items whose dependencies are closed and that no live lease holds.",
      "type": "boolean"
    },
    "limit": {
      "description": "Maximum number of items to return.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "createdSince": {
      "description": "Created at or after this ISO time.",
      "type": "string",
      "format": "date-time"
    },
    "labels": {
      "description": "Only items that carry every one of these labels.",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    }
  },
  "additionalProperties": false
}
