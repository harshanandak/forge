{
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "step", "branch", "worktree", "next"],
  "properties": {
    "id": {
      "$ref": "https://raw.githubusercontent.com/harshanandak/forge/main/schemas/tracker.json#/$defs/ItemId"
    },
    "step": {
      "enum": [
        "claimed",
        "red",
        "green",
        "pushed",
        "review",
        "stopped",
        "merged"
      ]
    },
    "branch": { "type": "string", "minLength": 1, "maxLength": 500 },
    "worktree": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "head": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "pr": {
      "type": "string",
      "maxLength": 2000,
      "format": "uri",
      "pattern": "^https?://(?:\\[[0-9a-fA-F:.]+\\]|[^\\s/:?#.]+(?:\\.[^\\s/:?#.]+)*\\.?)(?::[0-9]+)?(?:[/?#][^\\s]*)?$"
    },
    "receipt": {
      "$ref": "https://raw.githubusercontent.com/harshanandak/forge/main/schemas/tracker.json#/$defs/ItemId"
    },
    "next": { "type": "string", "minLength": 1, "maxLength": 300 }
  }
}
