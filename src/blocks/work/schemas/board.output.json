{
  "type": "object",
  "description": "Rows are sorted by most recent activity. Holder session id, agent, harness and device are unverified metadata copied from the lease. Rows include live/stale lease state and expiry, last checkpoint time and linked PR when present, direct open or missing blockers with their holders, and direct open dependents. snapshotAt is this read's time. truncated means more rows; cursor continues the same ordering or refuses CURSOR_STALE: restart from the first page. Single-id readiness reasons are ordered CLOSED, HELD (holder and expiry), BLOCKED_BY (each open or missing dependency and holder); ready is true exactly when reasons are empty, agreeing with issue ready.",
  "additionalProperties": false,
  "required": ["items", "snapshotAt", "truncated"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/row" }
    },
    "snapshotAt": { "$ref": "#/$defs/time" },
    "truncated": { "type": "boolean" },
    "cursor": { "type": "string", "maxLength": 1024 }
  },
  "$defs": {
    "time": { "type": "string", "format": "date-time" },
    "holder": {
      "description": "Unverified display metadata copied from the lease record, not an identity claim.",
      "$ref": "https://raw.githubusercontent.com/harshanandak/forge/main/schemas/state.json#/$defs/LeaseHolder"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "enum": ["CLOSED", "HELD", "BLOCKED_BY"] },
        "id": { "type": "string" },
        "holder": { "$ref": "#/$defs/holder" },
        "holderUnverified": { "const": true },
        "expiresAt": { "$ref": "#/$defs/time" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "holder": { "$ref": "#/$defs/holder" },
        "holderUnverified": { "const": true }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "blockers",
        "dependents",
        "ready",
        "notReadyBecause"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "holder": { "$ref": "#/$defs/holder" },
        "holderUnverified": { "const": true },
        "leaseState": { "enum": ["live", "stale"] },
        "expiresAt": { "$ref": "#/$defs/time" },
        "lastCheckpointAt": { "$ref": "#/$defs/time" },
        "pr": { "type": "string" },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "dependents": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "ready": { "type": "boolean" },
        "notReadyBecause": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason" }
        }
      }
    }
  }
}
