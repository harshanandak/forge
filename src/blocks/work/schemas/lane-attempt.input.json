{
  "type": "object",
  "required": ["id", "attempt", "branch", "brief"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "attempt": {
      "type": "string",
      "pattern": "^attempt-[1-9][0-9]*$"
    }
  },
  "additionalProperties": false
}
