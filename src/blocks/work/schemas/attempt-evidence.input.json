{
  "type": "object",
  "required": ["id", "attempt", "sha"],
  "properties": {
    "id": {
      "$ref": "https://raw.githubusercontent.com/harshanandak/forge/main/schemas/tracker.json#/$defs/ItemId"
    },
    "attempt": { "type": "string" },
    "sha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "receipt": { "type": "string" },
    "review": { "type": "string" },
    "metrics": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": { "type": ["number", "string"] }
    }
  },
  "additionalProperties": false
}
