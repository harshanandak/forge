{
  "type": "object",
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "headSha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "state": {
      "enum": ["OPEN", "CLOSED", "MERGED"]
    },
    "draft": {
      "type": "boolean"
    },
    "mergeable": {
      "enum": ["MERGEABLE", "CONFLICTING", "UNKNOWN"]
    },
    "complete": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "appId": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "headSha": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          },
          "status": {
            "enum": ["QUEUED", "IN_PROGRESS", "PENDING", "COMPLETED"]
          },
          "conclusion": {
            "enum": [
              null,
              "SUCCESS",
              "NEUTRAL",
              "SKIPPED",
              "FAILURE",
              "CANCELLED",
              "TIMED_OUT",
              "ACTION_REQUIRED",
              "STALE",
              "STARTUP_FAILURE"
            ]
          }
        },
        "required": ["name", "appId", "headSha", "status", "conclusion"],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "requiredChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "appId": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        },
        "required": ["name", "appId"],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "state": {
            "enum": [
              "APPROVED",
              "CHANGES_REQUESTED",
              "COMMENTED",
              "DISMISSED",
              "PENDING"
            ]
          },
          "headSha": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["id", "author", "state", "headSha", "updatedAt"],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "resolved": {
            "type": "boolean"
          }
        },
        "required": ["id", "resolved"],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "resolved": {
            "type": "boolean"
          }
        },
        "required": ["label", "resolved"],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "lastActivityAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "repository",
    "number",
    "headSha",
    "baseSha",
    "state",
    "draft",
    "mergeable",
    "complete",
    "checks",
    "requiredChecks",
    "reviews",
    "threads",
    "findings",
    "lastActivityAt"
  ],
  "additionalProperties": false
}
