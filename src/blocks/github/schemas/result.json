{
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 200
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "runId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "accepted": {
          "const": true
        },
        "merged": {
          "const": true
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "mergeSha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "evidence.json"
        },
        "merged": {
          "const": false
        }
      },
      "type": "object",
      "required": ["merged", "evidence"]
    }
  ]
}
