{
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["merged", "mergeCommit"],
      "properties": {
        "merged": { "const": true },
        "mergeCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "state", "verdict", "reasons", "merged"],
      "properties": {
        "head": { "type": ["string", "null"] },
        "state": { "type": "string" },
        "verdict": {
          "enum": [
            "MERGED",
            "CLOSED",
            "DRAFT",
            "BEHIND",
            "BLOCKED",
            "READY",
            "UNAVAILABLE"
          ]
        },
        "reasons": {
          "type": "array",
          "items": { "$ref": "pr.json#/$defs/Blocker" }
        },
        "merged": { "const": false }
      }
    }
  ]
}
