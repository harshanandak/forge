{
  "schemaVersion": "forge.interface/1",
  "id": "forge.pr-host",
  "version": "1.0.0",
  "summary": "Read evidence and perform targeted host writes for the consuming pr block.",
  "operations": {
    "read": {
      "input": "pr.json#/$defs/PullRequestRef",
      "output": "pr.json#/$defs/Evidence",
      "context": "project",
      "access": "read",
      "idempotent": true
    },
    "reply": {
      "input": "pr.json#/$defs/ThreadReply",
      "output": "pr.json#/$defs/WriteResult",
      "context": "project",
      "access": "write",
      "idempotent": false
    },
    "resolve": {
      "input": "pr.json#/$defs/ThreadResolve",
      "output": "pr.json#/$defs/WriteResult",
      "context": "project",
      "access": "write",
      "idempotent": false
    },
    "rerun": {
      "input": "pr.json#/$defs/Rerun",
      "output": "pr.json#/$defs/WriteResult",
      "context": "project",
      "access": "write",
      "idempotent": false
    },
    "create": {
      "input": "pr.json#/$defs/CreateRequest",
      "output": "pr.json#/$defs/CreatedLink",
      "context": "project",
      "access": "write",
      "idempotent": false
    },
    "merge": {
      "input": "pr.json#/$defs/MergeRequest",
      "output": "merge-result.json",
      "context": "project",
      "access": "write",
      "idempotent": false
    }
  }
}
