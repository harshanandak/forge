{
  "type": "object",
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectHead": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "expectRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "body": {
      "type": "string",
      "minLength": 0,
      "maxLength": 65536
    }
  },
  "required": ["repository", "number", "expectHead", "expectRevision"],
  "additionalProperties": false
}
