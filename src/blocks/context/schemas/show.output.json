{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "forge.context/1"
    },
    "latest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "defs.json#/$defs/Handoff"
        }
      ]
    },
    "check": {
      "type": "object",
      "properties": {
        "head": {
          "enum": [
            "same",
            "moved"
          ]
        },
        "uncommitted": {
          "enum": [
            "same",
            "changed",
            "unknown"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "head",
        "uncommitted"
      ]
    },
    "earlier": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "$ref": "defs.json#/$defs/Earlier"
      }
    },
    "held": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "latest",
    "earlier",
    "held"
  ]
}
