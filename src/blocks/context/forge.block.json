{
  "schemaVersion": "forge.block/1",
  "id": "forge/context",
  "version": "0.1.0",
  "authorAbi": "forge.author/v1",
  "profile": "trusted-action-sync/v1",
  "entry": "index.cjs",
  "files": ["schemas/defs.json"],
  "operations": {
    "context.handoff": {
      "input": "schemas/handoff.input.json",
      "output": "schemas/handoff.output.json",
