      "effects": ["context:write"],
      "args": ["head", "nextStep"],
      "idempotent": false,
      "callers": ["agent", "human"],
      "stability": "stable"
    },
    "context.show": {
      "input": "schemas/show.input.json",
      "output": "schemas/show.output.json",
      "context": "project",
      "effects": [],
      "idempotent": true,
      "callers": ["agent", "human"],
      "stability": "stable"
    }
  },
  "requires": [
    {
      "slot": "state",
      "interface": "forge.state@1"
    }
  ],
  "docs": "docs/records.json"
}
