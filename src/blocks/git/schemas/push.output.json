{
  "type": "object",
  "properties": {
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "remoteBranch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "pushed": {
      "const": true
    }
  },
  "required": ["branch", "remoteBranch", "head", "pushed"],
  "additionalProperties": false
}
