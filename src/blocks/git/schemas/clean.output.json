{
  "type": "object",
  "properties": {
    "base": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "outcomes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "removed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "wouldRemove": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["path", "removed"],
        "additionalProperties": false
      }
    }
  },
  "required": ["base", "baseSha", "outcomes"],
  "additionalProperties": false
}
