{
  "type": "object",
  "properties": {
    "remote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "worktreeRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:\\u0000-\\u001f]).+$"
    },
    "commandTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576
    },
    "maxWorktrees": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "fetchBeforeClean": {
      "type": "boolean"
    },
    "hookDirectory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:\\u0000-\\u001f]).+$"
    },
    "hookCommand": {
      "type": "object",
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "files": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:\\u0000-\\u001f]).+$"
          }
        }
      },
      "required": ["executable", "args", "files"],
      "additionalProperties": false
    },
    "hookMaxBytes": {
      "type": "integer",
      "minimum": 64,
      "maximum": 65536
    },
    "envNames": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "maxLength": 256
      }
    },
    "hookArea": {
      "enum": ["project", "git", "common"]
    }
  },
  "required": [
    "remote",
    "worktreeRoot",
    "commandTimeoutMs",
    "maxOutputBytes",
    "maxWorktrees",
    "fetchBeforeClean",
    "envNames"
  ],
  "additionalProperties": false
}
