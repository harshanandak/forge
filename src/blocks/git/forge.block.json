{
  "schemaVersion": "forge.block/1",
  "id": "forge/git",
  "version": "0.1.0",
  "authorAbi": "forge.author/v2",
  "profile": "trusted-action/v2",
  "entry": "entry.cjs",
  "configSchema": "schemas/config.json",
  "nouns": {
    "worktree": {
      "interface": "1.0.0"
    },
    "branch": {
      "interface": "1.0.0"
    },
    "hook": {
      "interface": "1.0.0"
    }
  },
  "requires": [
    {
      "slot": "state",
      "interface": "forge.state@1"
    },
    {
      "slot": "process",
      "interface": "forge.process@1"
    },
    {
      "slot": "files",
      "interface": "forge.files@1"
    },
    {
      "slot": "environment",
      "interface": "forge.environment@1"
    }
  ],
  "operations": {
    "worktree.create": {
      "input": "schemas/create.input.json",
      "output": "schemas/create.output.json",
      "context": "project",
      "timeoutMs": 300000,
      "effects": [
        "worktree:write",
        "external:write",
        "external:process",
        "environment:read",
        "files:read",
        "files:write"
      ],
      "idempotent": false,
      "callers": ["agent", "human"],
      "stability": "experimental"
    },
    "worktree.list": {
      "input": "schemas/list.input.json",
      "output": "schemas/list.output.json",
      "context": "project",
      "timeoutMs": 30000,
      "effects": ["external:process", "environment:read"],
      "idempotent": true,
      "callers": ["agent", "human"],
      "stability": "experimental"
    },
    "worktree.remove": {
      "input": "schemas/remove.input.json",
      "output": "schemas/remove.output.json",
      "context": "project",
      "timeoutMs": 300000,
      "effects": [
        "worktree:write",
        "external:write",
        "external:process",
        "environment:read",
        "files:write"
      ],
      "idempotent": false,
      "callers": ["agent", "human"],
      "stability": "experimental"
    },
    "worktree.clean": {
      "input": "schemas/clean.input.json",
      "output": "schemas/clean.output.json",
      "context": "project",
      "timeoutMs": 300000,
      "effects": [
        "worktree:write",
        "external:write",
        "external:process",
        "environment:read",
        "files:read",
        "files:write"
      ],
      "idempotent": false,
      "callers": ["agent", "human"],
      "stability": "experimental"
    },
    "branch.push": {
      "input": "schemas/push.input.json",
      "output": "schemas/push.output.json",
      "context": "project",
      "timeoutMs": 300000,
      "effects": [
        "branch:write",
        "external:write",
        "external:process",
        "environment:read"
      ],
      "idempotent": false,
      "callers": ["agent", "human"],
      "stability": "experimental"
    },
    "hook.install": {
      "input": "schemas/install.input.json",
      "output": "schemas/install.output.json",
      "context": "project",
      "timeoutMs": 300000,
      "effects": [
        "hook:write",
        "external:write",
        "external:process",
        "environment:read",
        "files:read",
        "files:write"
      ],
      "idempotent": false,
      "callers": ["agent", "human"],
      "stability": "experimental"
    },
    "hook.remove": {
      "input": "schemas/hook-remove.input.json",
      "output": "schemas/hook-remove.output.json",
      "context": "project",
      "timeoutMs": 300000,
      "effects": [
        "hook:write",
        "external:write",
        "external:process",
        "environment:read",
        "files:read",
        "files:write"
      ],
      "idempotent": false,
      "callers": ["agent", "human"],
      "stability": "experimental"
    },
    "hook.status": {
      "input": "schemas/status.input.json",
      "output": "schemas/status.output.json",
      "context": "project",
      "timeoutMs": 30000,
      "effects": ["external:process", "environment:read", "files:read"],
      "idempotent": true,
      "callers": ["agent", "human"],
      "stability": "experimental"
    }
  },
  "docs": "docs.json"
}
