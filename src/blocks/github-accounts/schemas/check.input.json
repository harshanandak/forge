{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "base": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "tip": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "trigger": {
      "enum": ["push", "merge"]
    }
  },
  "required": ["tip", "trigger"],
  "additionalProperties": false
}
