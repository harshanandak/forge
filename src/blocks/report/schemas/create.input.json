{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![\\s\\S]*[\\r\\n\\u0085\\u2028\\u2029])(?=[\\s\\S]*\\S)"
    },
    "kind": {
      "enum": ["bug", "wrong", "suggest", "missing"],
      "default": "bug"
    }
  },
  "required": ["message"],
  "additionalProperties": false
}
