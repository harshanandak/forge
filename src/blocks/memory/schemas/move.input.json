{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "defs.json#/$defs/NoteRef"
    },
    "to": {
      "$ref": "defs.json#/$defs/Level",
      "description": "The level the note goes to."
    },
    "expectRevision": {
      "type": "integer",
      "minimum": 1,
      "description": "The revision you last read."
    },
    "keep": {
      "type": "boolean",
      "description": "Copy instead of move: the source note stays."
    },
    "scope": { "$ref": "defs.json#/$defs/Scope" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
    "after": {
      "type": "integer",
      "minimum": 0,
      "description": "Continue a scope move after this note number, as returned in next."
    }
  },
  "additionalProperties": false,
  "required": ["to"],
  "oneOf": [
    {
      "required": ["id", "expectRevision"],
      "not": {
        "anyOf": [
          { "required": ["scope"] },
          { "required": ["limit"] },
          { "required": ["after"] }
        ]
      }
    },
    {
      "required": ["scope"],
      "properties": {
        "scope": { "not": { "const": "general" } },
        "to": { "const": "project" },
        "id": false,
        "expectRevision": false,
        "keep": false
      }
    }
  ]
}
