{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "RestoreId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Copy the restoreId returned by the first truncated page onto every continuation. Each continuation requires relayed owner approval."
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "forge.memory.export/2"
        },
        "level": {
          "$ref": "defs.json#/$defs/Level",
          "description": "The level the notes go back to: an export's own level."
        },
        "project": {
          "$ref": "defs.json#/$defs/Project"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "restoreId": { "$ref": "#/$defs/RestoreId" },
        "next": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "defs.json#/$defs/NoteId"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "scope": {
                "$ref": "defs.json#/$defs/Scope"
              },
              "tags": {
                "$ref": "defs.json#/$defs/Tags"
              },
              "links": {
                "$ref": "defs.json#/$defs/Links"
              },
              "replaces": { "$ref": "defs.json#/$defs/Replaces" },
              "replacedBy": { "$ref": "defs.json#/$defs/ReplacedBy" },
              "text": {
                "$ref": "defs.json#/$defs/Untrusted"
              }
            },
            "additionalProperties": false,
            "required": ["id", "tags", "links", "text"]
          }
        },
        "approval": {
          "type": "object",
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/Approval"
            },
            {
              "$ref": "defs.json#/$defs/RelayedApproval"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["format", "level", "notes"]
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "forge.memory.export/3"
        },
        "level": {
          "$ref": "defs.json#/$defs/Level",
          "description": "The level the notes go back to: an export's own level."
        },
        "project": {
          "$ref": "defs.json#/$defs/Project"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "restoreId": { "$ref": "#/$defs/RestoreId" },
        "next": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "defs.json#/$defs/NoteId"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "scope": {
                "$ref": "defs.json#/$defs/Scope"
              },
              "tags": {
                "$ref": "defs.json#/$defs/Tags"
              },
              "links": {
                "$ref": "defs.json#/$defs/Links"
              },
              "replaces": { "$ref": "defs.json#/$defs/Replaces" },
              "replacedBy": { "$ref": "defs.json#/$defs/ReplacedBy" },
              "text": {
                "$ref": "defs.json#/$defs/Untrusted"
              },
              "status": {
                "$ref": "defs.json#/$defs/NoteStatus"
              },
              "proposal": {
                "$ref": "defs.json#/$defs/Proposal"
              },
              "rejectedProposals": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "$ref": "defs.json#/$defs/Proposal"
                }
              }
            },
            "additionalProperties": false,
            "required": ["id", "tags", "links", "text"]
          }
        },
        "approval": {
          "type": "object",
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/Approval"
            },
            {
              "$ref": "defs.json#/$defs/RelayedApproval"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["format", "level", "notes"]
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "forge.memory.export/1"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "restoreId": { "$ref": "#/$defs/RestoreId" },
        "next": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^note-[0-9]{1,9}$",
                "maxLength": 14
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "scope": {
                "$ref": "defs.json#/$defs/Scope"
              },
              "tags": {
                "$ref": "defs.json#/$defs/Tags"
              },
              "links": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^note-[0-9]{1,9}$",
                  "maxLength": 14
                }
              },
              "text": {
                "$ref": "defs.json#/$defs/Untrusted"
              }
            },
            "additionalProperties": false,
            "required": ["id", "tags", "links", "text"]
          }
        },
        "approval": {
          "type": "object",
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/Approval"
            },
            {
              "$ref": "defs.json#/$defs/RelayedApproval"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["format", "notes"],
      "description": "An export written before notes had levels. Its notes are device notes."
    }
  ]
}
