{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": ["adopted", "not_found", "already_adopted"]
    },
    "id": {
      "type": "string",
      "maxLength": 40
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": ["status", "id"]
}
