{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "expectRevision": {
      "type": "integer",
      "minimum": 1
    },
    "approval": {
      "type": "object",
      "anyOf": [
        { "$ref": "defs.json#/$defs/Approval" },
        { "$ref": "defs.json#/$defs/RelayedApproval" }
      ]
    }
  },
  "additionalProperties": false,
  "required": ["id"]
}
