{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": ["added", "updated", "exists", "not_found", "read_only"]
    },
    "id": {
      "$ref": "defs.json#/$defs/NoteId"
    },
    "note": {
      "$ref": "defs.json#/$defs/Note"
    },
    "notice": {
      "type": "string",
      "maxLength": 600,
      "description": "Present when the note or edit waits for the owner, or when an identical owner-tagged note already exists (status exists, id names it): says so and what to do next."
    }
  },
  "additionalProperties": false,
  "required": ["status", "id"]
}
