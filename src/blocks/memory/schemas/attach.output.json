{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["text", "receipt"],
  "additionalProperties": false,
  "properties": {
    "text": { "$ref": "defs.json#/$defs/Untrusted" },
    "receipt": {
      "type": "object",
      "required": ["selected", "omitted", "packet", "cap", "warnings"],
      "additionalProperties": false,
      "properties": {
        "selected": {
          "type": "array",
          "items": { "$ref": "#/$defs/Selected" }
        },
        "omitted": { "type": "array", "items": { "$ref": "#/$defs/Omitted" } },
        "packet": {
          "$ref": "rules.output.json#/properties/receipt/properties/packet"
        },
        "warnings": {
          "$ref": "rules.output.json#/properties/receipt/properties/warnings"
        },
        "cap": {
          "type": "object",
          "required": ["limit", "used", "unit", "includes", "excludes"],
          "additionalProperties": false,
          "properties": {
            "limit": { "const": 4096 },
            "used": { "type": "integer", "minimum": 0 },
            "unit": { "const": "UTF-8 bytes" },
            "includes": {
              "const": "accepted note lines and newline separators"
            },
            "excludes": { "const": "receipt" }
          }
        }
      }
    }
  },
  "$defs": {
    "Selected": {
      "type": "object",
      "required": ["id", "revision", "scope", "reasons"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "scope": { "type": "string" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "Omitted": {
      "type": "object",
      "required": ["id", "revision", "scope", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "scope": { "type": "string" },
        "reason": { "enum": ["seen", "over-budget"] }
      }
    }
  }
}
