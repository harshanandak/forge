{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "$ref": "defs.json#/$defs/Untrusted",
      "description": "The default pointer is under 400 characters. With notes enabled, whole rule lines precede it within a 6000 UTF-16 code-unit cap including prefixes and separators; the omission line and pointer do not consume the cap."
    },
    "receipt": {
      "type": "object",
      "description": "Read-only accounting of the returned packet and the rules considered when notes is true. Pointer-only calls have empty selected and omitted arrays. Warnings are those known by the host when the packet is read.",
      "properties": {
        "selected": {
          "type": "array",
          "items": { "$ref": "#/$defs/Rule" }
        },
        "omitted": {
          "type": "array",
          "description": "The first 50 omitted rules in packet order; omittedCount includes all omitted rules.",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "revision": { "type": "integer", "minimum": 1 },
              "scope": { "type": "string" },
              "reason": { "const": "over-cap" }
            },
            "required": ["id", "revision", "scope", "reason"],
            "additionalProperties": false
          }
        },
        "omittedCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Total eligible rules omitted from the packet, including those beyond the detail bound."
        },
        "packet": {
          "type": "object",
          "description": "Measures result.text.text after neutralization, including rule lines, omission line, pointer and every separator; excludes the hook's trailing newline and any receipt notice.",
          "properties": {
            "utf8Bytes": { "type": "integer", "minimum": 0 },
            "characters": { "type": "integer", "minimum": 0 },
            "characterUnit": { "const": "Unicode code points" }
          },
          "required": ["utf8Bytes", "characters", "characterUnit"],
          "additionalProperties": false
        },
        "cap": {
          "type": "object",
          "properties": {
            "limit": { "const": 6000 },
            "used": { "type": "integer", "minimum": 0, "maximum": 6000 },
            "unit": { "const": "UTF-16 code units" },
            "includes": {
              "const": "accepted rule lines and newline separators"
            },
            "excludes": { "const": "omission line and pointer" }
          },
          "required": ["limit", "used", "unit", "includes", "excludes"],
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "selected",
        "omitted",
        "omittedCount",
        "packet",
        "cap",
        "warnings"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "Rule": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "scope": { "type": "string" }
      },
      "required": ["id", "revision", "scope"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": ["text", "receipt"]
}
