{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "forge.memory.export/1"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "defs.json#/$defs/NoteId"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "scope": {
            "$ref": "defs.json#/$defs/Scope"
          },
          "tags": {
            "$ref": "defs.json#/$defs/Tags"
          },
          "links": {
            "$ref": "defs.json#/$defs/Links"
          },
          "text": {
            "$ref": "defs.json#/$defs/Untrusted"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "tags",
          "links",
          "text"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "count",
    "truncated",
    "notes"
  ]
}
