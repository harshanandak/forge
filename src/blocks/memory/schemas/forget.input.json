{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "defs.json#/$defs/NoteRef"
    },
    "expectRevision": {
      "type": "integer",
      "minimum": 1
    },
    "approval": {
      "type": "object",
      "anyOf": [
        { "$ref": "defs.json#/$defs/Approval" },
        { "$ref": "defs.json#/$defs/RelayedApproval" }
      ]
    },
    "undo": {
      "type": "boolean",
      "description": "Restore the hidden note saved by forget. Moved or legacy tombstones cannot be undone."
    }
  },
  "additionalProperties": false,
  "required": ["id"]
}
