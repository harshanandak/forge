{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "added": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "defs.json#/$defs/NoteId"
      }
    }
  },
  "additionalProperties": false,
  "required": ["added", "skipped", "conflicts"]
}
