{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "added": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "notice": {
      "type": "string",
      "maxLength": 400,
      "description": "Present when owner-tagged notes were restored as proposals that wait for the owner."
    }
  },
  "additionalProperties": false,
  "required": ["added", "skipped", "conflicts"]
}
