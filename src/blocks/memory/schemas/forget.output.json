{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "forgotten",
        "not_found",
        "already_forgotten",
        "read_only",
        "restored",
        "not_forgotten",
        "undo_unavailable"
      ]
    },
    "id": {
      "$ref": "defs.json#/$defs/NoteId"
    },
    "note": {
      "$ref": "defs.json#/$defs/Note"
    }
  },
  "additionalProperties": false,
  "required": ["status", "id"]
}
