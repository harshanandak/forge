{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": ["proposed", "format_missing"]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "mode": {
          "enum": ["create", "append"]
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["path", "mode", "content"],
      "description": "The record as the project writes it. Forge does not write project files; place this where it says."
    },
    "repair": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": ["status"]
}
