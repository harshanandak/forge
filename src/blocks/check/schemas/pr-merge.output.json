{
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "pr", "head", "gate"],
  "properties": {
    "outcome": {
      "enum": [
        "MERGED",
        "REFUSED",
        "HEAD_MOVED",
        "MERGE_REFUSED",
        "MERGE_UNVERIFIED"
      ]
    },
    "pr": { "type": "integer", "minimum": 1 },
    "head": { "type": "string" },
    "receipt": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "mergeCommit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "detail": { "type": "string", "maxLength": 300 },
    "readbackProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode",
        "signal",
        "timedOut",
        "truncated",
        "stdout",
        "stderr"
      ],
      "properties": {
        "exitCode": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] },
        "timedOut": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "stdout": { "type": "string", "maxLength": 2048 },
        "stderr": { "type": "string", "maxLength": 2048 }
      }
    },
    "gate": { "$ref": "gate.output.json" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "MERGED" } } },
      "then": {
        "required": ["receipt", "mergeCommit"],
        "properties": {
          "head": { "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
        }
      }
    }
  ]
}
