{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "head",
    "checks",
    "unresolvedThreads",
    "doorPaths",
    "reasons"
  ],
  "properties": {
    "verdict": { "enum": ["PASS", "REFUSED"] },
    "head": { "type": "string" },
    "receipt": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state"],
        "properties": {
          "name": { "type": "string" },
          "state": { "type": "string" }
        }
      }
    },
    "unresolvedThreads": { "type": "integer", "minimum": 0 },
    "doorPaths": { "type": "array", "items": { "type": "string" } },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
