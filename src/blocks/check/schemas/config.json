{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commands",
    "timeoutMs",
    "maxOutputBytes",
    "report",
    "stopOnFailure",
    "inputs",
    "maxInputBytes",
    "environment"
  ],
  "properties": {
    "report": {
      "enum": ["auto", "json", "exit-code"]
    },
    "stopOnFailure": {
      "type": "boolean"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "commands": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["argv"],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1024,
                "items": {
                  "type": "string"
                }
              },
              "report": {
                "enum": ["auto", "json", "exit-code"]
              }
            }
          }
        ]
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "maxInputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "environment": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "maxLength": 200
      }
    }
  }
}
