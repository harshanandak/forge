{
  "type": "object",
  "additionalProperties": false,
  "description": "Every key but commands has a default; a key left out takes it, and config explain shows its source as default.",
  "required": [
    "commands",
    "timeoutMs",
    "maxOutputBytes",
    "report",
    "stopOnFailure",
    "inputs",
    "maxInputBytes",
    "environment",
    "outputHeadBytes",
    "outputTailBytes",
    "maxMetadataBytes",
    "maxReceiptBytes"
  ],
  "properties": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "rounds": { "type": "integer", "minimum": 0, "default": 2 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "requiredChecks": {
          "default": "github-required",
          "oneOf": [
            { "const": "github-required" },
            {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 256,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          ]
        },
        "receiptChecks": {
          "default": [],
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "doorPaths": {
          "default": [],
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1024,
          "description": "Repository-relative globs without / or ./ prefixes or braces: * and ? match within a path segment; ** matches across segments.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/|\\./)[^{}\\\\\\u0000-\\u001f]+$"
          }
        }
      }
    },
    "report": {
      "default": "auto",
      "enum": ["auto", "json", "exit-code"]
    },
    "stopOnFailure": {
      "default": true,
      "type": "boolean"
    },
    "timeoutMs": {
      "default": 600000,
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "maxOutputBytes": {
      "default": 65536,
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "commands": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["argv"],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1024,
                "items": {
                  "type": "string"
                }
              },
              "report": {
                "enum": ["auto", "json", "exit-code"]
              }
            }
          }
        ]
      }
    },
    "inputs": {
      "default": [],
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "maxInputBytes": {
      "default": 1048576,
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "environment": {
      "description": "Names of variables passed to each command; nothing else is inherited. The default lets the project's own toolchain be found and run on Linux, macOS and Windows; names a platform lacks are skipped.",
      "default": [
        "PATH",
        "PATHEXT",
        "SystemRoot",
        "windir",
        "ComSpec",
        "TEMP",
        "TMP",
        "TMPDIR",
        "HOME",
        "USERPROFILE",
        "APPDATA",
        "LOCALAPPDATA"
      ],
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "maxLength": 200
      }
    },
    "outputHeadBytes": {
      "default": 1024,
      "type": "integer",
      "minimum": 0,
      "maximum": 262144
    },
    "outputTailBytes": {
      "default": 1024,
      "type": "integer",
      "minimum": 0,
      "maximum": 262144
    },
    "maxMetadataBytes": {
      "default": 32768,
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "maxReceiptBytes": {
      "description": "Caps the whole receipt. Each selected command reserves two streams × (outputHeadBytes + outputTailBytes) × 10 encoded bytes; with the defaults that is 40960 per command, so 524288 holds maxMetadataBytes plus 12 commands.",
      "default": 524288,
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    }
  }
}
