{
  "type": "object",
  "additionalProperties": false,
  "required": ["commands", "timeoutMs", "maxOutputBytes"],
  "properties": {
    "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
    "commands": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 200 },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["argv"],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1024,
                "items": { "type": "string" }
              },
              "report": { "enum": ["auto", "json"] }
            }
          }
        ]
      }
    }
  }
}
