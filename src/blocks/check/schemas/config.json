{
  "type": "object",
  "additionalProperties": false,
  "description": "Every key but commands has a default; a key left out takes it, and config explain shows its source as default.",
  "required": [
    "commands",
    "timeoutMs",
    "maxOutputBytes",
    "report",
    "stopOnFailure",
    "inputs",
    "maxInputBytes",
    "environment",
    "outputHeadBytes",
    "outputTailBytes",
    "maxMetadataBytes",
    "maxReceiptBytes"
  ],
  "properties": {
    "report": {
      "default": "auto",
      "enum": ["auto", "json", "exit-code"]
    },
    "stopOnFailure": {
      "default": true,
      "type": "boolean"
    },
    "timeoutMs": {
      "default": 600000,
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "maxOutputBytes": {
      "default": 65536,
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "commands": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["argv"],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1024,
                "items": {
                  "type": "string"
                }
              },
              "report": {
                "enum": ["auto", "json", "exit-code"]
              }
            }
          }
        ]
      }
    },
    "inputs": {
      "default": [],
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "maxInputBytes": {
      "default": 1048576,
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "environment": {
      "default": [],
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "maxLength": 200
      }
    },
    "outputHeadBytes": {
      "default": 1024,
      "type": "integer",
      "minimum": 0,
      "maximum": 262144
    },
    "outputTailBytes": {
      "default": 1024,
      "type": "integer",
      "minimum": 0,
      "maximum": 262144
    },
    "maxMetadataBytes": {
      "default": 32768,
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "maxReceiptBytes": {
      "default": 262144,
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    }
  }
}
