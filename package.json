{
  "name": "forge-workflow",
  "version": "0.1.0-dev.0",
  "description": "An open building-block platform for AI coding agents.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshanandak/forge.git"
  },
  "homepage": "https://github.com/harshanandak/forge#readme",
  "bugs": {
    "url": "https://github.com/harshanandak/forge/issues"
  },
  "bin": {
    "forge": "dist/bin/forge.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./dist/src/assembly/runtime.d.ts",
      "default": "./dist/src/assembly/runtime.js"
    },
    "./config": {
      "types": "./dist/src/assembly/config.d.ts",
      "default": "./dist/src/assembly/config.js"
    },
    "./state": {
      "types": "./dist/src/core/state/index.d.ts",
      "default": "./dist/src/core/state/index.js"
    },
    "./adapters/sqlite": {
      "types": "./dist/src/assembly/sqlite.d.ts",
      "default": "./dist/src/assembly/sqlite.js"
    },
    "./author": {
      "types": "./dist/src/contract/author.d.ts",
      "default": "./dist/src/contract/author.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "examples/hello-block",
    "docs/writing-a-block.md",
    "LICENSE",
    "CREDITS",
    "README.md"
  ],
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "check": "bun check",
    "lint": "bun tools/bun-builtin.ts lint --type-aware --rule '@typescript-eslint/no-explicit-any: error' --max-warnings 0",
    "fmt": "bun tools/bun-builtin.ts fmt",
    "test": "bun run gen && bun run test:unit && bun run test:integration && bun run test:pack",
    "test:unit": "bun test --parallel --timeout 30000 --path-ignore-patterns '**/*.integration.test.ts'",
    "test:integration": "bun run build && bun test --parallel --timeout 30000 --path-ignore-patterns '**/{packed,private-files,help-examples,vcs-git,shared-store,lane-run,lane,lane-close}.integration.test.ts' .integration.test && bun test --timeout 30000 test/adapters/l5-state/private-files.integration.test.ts test/surface/help-examples.integration.test.ts test/adapters/vcs-git/vcs-git.integration.test.ts test/assembly/shared-store/shared-store.integration.test.ts test/tools/lane-run.integration.test.ts test/tools/lane.integration.test.ts test/tools/lane-close.integration.test.ts",
    "test:structure": "bun test --timeout 30000 test/structure",
    "test:pack": "bun run build && node tools/pack-smoke/run.ts",
    "gen": "bun tools/gen/types.ts",
    "precheck": "bun run gen",
    "prelint": "bun run gen",
    "prebuild": "bun run gen",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "bun tools/build-assets.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "koffi": "3.3.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
