{
  "name": "forge-wait-trial",
  "main": "mailbox.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["enable_request_signal"],
  "send_metrics": false,
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "Mailbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailbox"] }]
}

