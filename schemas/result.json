{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/harshanandak/forge/main/schemas/result.json",
  "title": "ResultEnvelope",
  "description": "The envelope every surface returns: the CLI prints it, MCP carries it in structuredContent.",
  "oneOf": [
    { "$ref": "#/$defs/SuccessEnvelope" },
    { "$ref": "#/$defs/FailureEnvelope" }
  ],
  "$defs": {
    "SuccessEnvelope": {
      "type": "object",
      "required": ["ok", "op", "status", "result", "warnings"],
      "properties": {
        "ok": { "const": true },
        "op": { "$ref": "common.json#/$defs/OperationName" },
        "status": { "const": "OK" },
        "result": {},
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/Warning" }
        },
        "observation": { "$ref": "observation.json" }
      },
      "additionalProperties": false
    },
    "FailureEnvelope": {
      "description": "FAIL: the operation refused or failed; INCOMPLETE: something outside the caller's control (admission, a grant, a provider) is missing.",
      "type": "object",
      "required": ["ok", "status", "error", "warnings"],
      "properties": {
        "ok": { "const": false },
        "op": { "$ref": "common.json#/$defs/OperationName" },
        "status": { "enum": ["FAIL", "INCOMPLETE"] },
        "error": { "$ref": "error.json" },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/Warning" }
        },
        "observation": { "$ref": "observation.json" }
      },
      "additionalProperties": false
    },
    "Warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "common.json#/$defs/ErrorCode" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "additionalProperties": false
    }
  }
}
