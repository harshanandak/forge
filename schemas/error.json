{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/harshanandak/forge/main/schemas/error.json",
  "title": "ForgeError",
  "description": "An actionable error: what was expected, what was observed, how to repair it, and whether a retry is ever safe.",
  "type": "object",
  "required": ["code", "message", "retry"],
  "properties": {
    "code": { "$ref": "common.json#/$defs/ErrorCode" },
    "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "retry": { "$ref": "#/$defs/RetryPosture" },
    "pointer": { "$ref": "common.json#/$defs/JsonPointer" },
    "flag": { "type": "string", "maxLength": 100 },
    "expected": {},
    "observed": {},
    "repair": { "type": "string", "maxLength": 2000 },
    "suggest": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 200 }
    },
    "missing": {
      "description": "Context fields the declared variant needs and the request did not supply.",
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/ContextField" }
    },
    "lease": { "$ref": "#/$defs/LeaseConflict" },
    "currentRevision": { "type": "integer", "minimum": 0 },
    "reconcileWith": { "$ref": "common.json#/$defs/OperationName" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["code"],
        "properties": { "code": { "const": "CONTEXT_MISSING" } }
      },
      "then": { "required": ["missing"] }
    },
    {
      "if": {
        "required": ["code"],
        "properties": {
          "code": {
            "enum": [
              "LEASE_HELD",
              "LEASE_STALE",
              "LEASE_NOT_HELD",
              "LEASE_EXPIRED"
            ]
          }
        }
      },
      "then": { "required": ["lease"] }
    }
  ],
  "$defs": {
    "CoreErrorCode": {
      "description": "Error codes core itself returns; blocks add their own UPPER_SNAKE codes.",
      "enum": [
        "INPUT_INVALID",
        "INPUT_CONFLICT",
        "OUTPUT_INVALID",
        "UNKNOWN_COMMAND",
        "CONTEXT_MISSING",
        "REVISION_CONFLICT",
        "LEASE_HELD",
        "LEASE_STALE",
        "LEASE_NOT_HELD",
        "LEASE_EXPIRED",
        "ADMISSION_REQUIRED",
        "GRANT_REQUIRED",
        "NOUN_COLLISION",
        "NAME_RESERVED",
        "PROVIDER_MISSING",
        "BINDING_AMBIGUOUS",
        "INTERFACE_INCOMPATIBLE",
        "BLOCK_EXECUTION_FAILED",
        "INVOCATION_TIMEOUT",
        "INVOCATION_CANCELLED",
        "SERVICE_EXPIRED",
        "PROCESS_CLEANUP_FAILED",
        "EFFECT_UNCERTAIN",
        "LIMIT_EXCEEDED",
        "UNAVAILABLE",
        "INTERNAL"
      ]
    },
    "RetryPosture": {
      "description": "never: do not repeat the request; reconcile_first: read the current state through reconcileWith or the named data, then decide; safe: the request had no effect and may be repeated.",
      "enum": ["never", "reconcile_first", "safe"]
    },
    "ContextField": {
      "enum": [
        "actor",
        "device",
        "project",
        "session",
        "leaseGeneration",
        "subjectVersion"
      ]
    },
    "LeaseConflict": {
      "description": "What a caller needs to reconcile a lease conflict by reading, never by retrying blindly.",
      "type": "object",
      "required": ["subject"],
      "properties": {
        "subject": { "type": "string", "minLength": 1, "maxLength": 500 },
        "holder": { "$ref": "state.json#/$defs/LeaseHolder" },
        "generation": { "type": "integer", "minimum": 1 },
        "expiresAt": { "$ref": "common.json#/$defs/Timestamp" }
      },
      "additionalProperties": false
    }
  }
}
