+'use strict';
+
+const { describe, test, expect, beforeEach, afterEach } = require('bun:test');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+
+const journal = require('../../lib/pr-monitor/journal');
+const { runMonitorPass } = require('../../lib/pr-monitor/monitor');
+const { EVENT_TYPES: T } = require('../../lib/pr-monitor/events');
+
+const HEAD = 'a'.repeat(40);
+const NEXT_HEAD = 'b'.repeat(40);
+const START = Date.parse('2026-08-07T10:00:00Z');
+const POLICY = {
+  reviewers: [
+    { provider: 'codex', accountId: 'sol', riskClass: 'required' },
+    { provider: 'codex', accountId: 'luna', riskClass: 'optional', unavailable: 'allow' },
+  ],
+};
+
+function snap(over = {}) {
+  return {
+    repo: 'acme-forge', pr: '493', headSha: HEAD, prState: 'OPEN', draft: false,
+    verdict: { state: 'CLEAN-MERGEABLE', reason: null },
+    checks: [], threads: [], reviews: [], comments: [], behind: 0, conflicts: false, degraded: [],
+    ...over,
+  };
+}
+
+let root; let dir;
+beforeEach(() => {
+  root = fs.mkdtempSync(path.join(os.tmpdir(), 'prmon-reviewer-'));
+  dir = journal.journalDir({ root, repo: 'acme-forge', pr: '493' });
+});
+afterEach(() => fs.rmSync(root, { recursive: true, force: true }));
+
+describe('Shepherd reviewer producer', () => {
+  test('persists the exact-head ledger and emits deterministic request/state/actionable events', async () => {
+    const source = snap({
+      reviewerPolicy: POLICY,
+      finalCorrectionSha: HEAD,
+      finalCorrectionAt: START,
+      reviewerRequests: [
+        { provider: 'codex', accountId: 'sol', headSha: HEAD, requestedAt: START },
+      ],
+      reviewerStates: [
+        { provider: 'codex', accountId: 'sol', headSha: HEAD, state: 'clean', at: START + 1000 },
+      ],
+      reviewEvents: [
+        { id: 'finding-1', headSha: HEAD, classification: 'actionable', at: START + 2000 },
+      ],
+      emergencyBypass: {
+        humanActor: 'release-manager', reason: 'incident window', auditId: 'audit-493', at: START,
+      },
+    });
+
+    const result = await runMonitorPass({ dir, gather: async () => source, now: () => new Date(START + 3000).toISOString() });
+    const types = result.events.map((event) => event.type);
+    expect(types).toContain(T.REVIEWER_REQUESTED);
+    expect(types).toContain(T.REVIEWER_STATE);
+    expect(types).toContain(T.REVIEWER_ACTIONABLE);
+    expect(types).toContain(T.REVIEWER_BYPASS);
+    expect(journal.readSnapshot(dir).snapshot.reviewerLedger.headSha).toBe(HEAD);
+    expect(journal.readSnapshot(dir).snapshot.reviewerLedger.reviewers[0]).toMatchObject({
+      id: 'codex:sol', requestedAt: START, state: 'clean', stateAt: START + 1000,
+    });
+    expect(journal.readSnapshot(dir).snapshot.reviewerLedger.quietWindow.startsAt).toBe(START + 2000);
+  });
+
+  test('does not duplicate id-less actionable observations and ignores status-only events', async () => {
+    const baseline = snap({
+      reviewerPolicy: { reviewers: [{ provider: 'codex', accountId: 'sol', riskClass: 'required' }] },
+      finalCorrectionSha: HEAD, finalCorrectionAt: START,
+      reviewerRequests: [{ provider: 'codex', accountId: 'sol', headSha: HEAD, requestedAt: START }],
+    });
+    await runMonitorPass({ dir, gather: async () => baseline, now: () => new Date(START).toISOString() });
+
+    const observed = snap({
+      ...baseline,
+      reviewEvents: [
+        { classification: 'status', at: START + 1000 },
+        { classification: 'actionable', at: START + 2000 },
+        { classification: 'actionable', at: START + 2000 },
+      ],
+    });
+    const result = await runMonitorPass({ dir, gather: async () => observed, now: () => new Date(START + 3000).toISOString() });
+    expect(result.events.filter((event) => event.type === T.REVIEWER_ACTIONABLE)).toHaveLength(1);
+    const ledger = journal.readSnapshot(dir).snapshot.reviewerLedger;
+    expect(ledger.events).toHaveLength(2); // status + one id-less actionable
+    expect(ledger.quietWindow.resets).toHaveLength(1);
+    expect(ledger.quietWindow.resets[0].at).toBe(START + 2000);
+  });
+
+  test('starts a fresh quiet window for a new exact head and cleans reviewer state at terminal lifecycle', async () => {
+    const open = snap({
+      reviewerPolicy: { reviewers: [{ provider: 'codex', accountId: 'sol', riskClass: 'required' }] },
+      finalCorrectionSha: HEAD, finalCorrectionAt: START,
+      reviewerRequests: [{ provider: 'codex', accountId: 'sol', headSha: HEAD, requestedAt: START }],
+    });
+    await runMonitorPass({ dir, gather: async () => open, now: () => new Date(START).toISOString() });
+
+    const next = snap({
+      headSha: NEXT_HEAD,
+      reviewerPolicy: open.reviewerPolicy,
+      finalCorrectionSha: NEXT_HEAD,
+      finalCorrectionAt: START + 10_000,
+      reviewerRequests: [{ provider: 'codex', accountId: 'sol', headSha: NEXT_HEAD, requestedAt: START + 10_000 }],
+      prState: 'MERGED',
+    });
+    await runMonitorPass({ dir, gather: async () => next, now: () => new Date(START + 11_000).toISOString() });
+    const terminal = journal.readSnapshot(dir).snapshot;
+    expect(terminal.headSha).toBe(NEXT_HEAD);
+    expect(terminal.reviewerLedger).toBeNull();
+  });
+});
