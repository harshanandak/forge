@@ -164,7 +165,36 @@ describe('structured feedback intake', () => {
       status: 'accepted-local',
       accepted: true,
       delivered: false,
-      delivery_error: { code: 'FEEDBACK_DELIVERY_FAILED' },
+      delivery_error: {
+        code: 'FEEDBACK_DELIVERY_FAILED',
+        reason: 'offline [REDACTED] at <user-path>/forge',
+      },
