diff --git a/lib/memory/hygiene.js b/lib/memory/hygiene.js
index f1610aa9..db4536ff 100644
--- a/lib/memory/hygiene.js
+++ b/lib/memory/hygiene.js
@@ -8,6 +8,13 @@ const VOLATILE_FIELDS = new Set([
   'id', 'key', 'memory_id', 'created_at', 'updated_at', 'timestamp', 'revision',
   'createdAt', 'updatedAt',
 ]);
+const NEGATION_PREFIXES = Object.freeze(['do not ', "don't ", 'never ']);
+
+function compareCodeUnits(left, right) {
+  if (left < right) return -1;
+  if (left > right) return 1;
+  return 0;
+}
 
 function normalizeText(value) {
   return String(value)
@@ -22,12 +29,13 @@ function normalizeText(value) {
 function canonicalize(value) {
   if (typeof value === 'string') return normalizeText(value);
   if (Array.isArray(value)) {
-    return value.map(canonicalize).sort((a, b) => JSON.stringify(a).localeCompare(JSON.stringify(b)));
+    return value.map(canonicalize).sort((left, right) =>
+      compareCodeUnits(JSON.stringify(left), JSON.stringify(right)));
   }
   if (!value || typeof value !== 'object') return value;
   return Object.fromEntries(Object.keys(value)
     .filter(key => !VOLATILE_FIELDS.has(key))
-    .sort()
+    .sort(compareCodeUnits)
     .map(key => [key, canonicalize(value[key])]));
 }
 
@@ -43,7 +51,7 @@ function fingerprint(value) {
 
 function reviewId(kind, parts) {
   const digest = createHash('sha256')
-    .update(`${kind}\0${[...parts].sort().join('\0')}`)
+    .update(`${kind}\0${[...parts].sort(compareCodeUnits).join('\0')}`)
     .digest('hex')
     .slice(0, 16);
   return `memory-${kind}-${digest}`;
@@ -54,10 +62,10 @@ function claimFor(entry) {
   if (typeof payload !== 'string') return null;
   let text = normalizeText(payload);
   let negative = false;
-  const match = text.match(/^(?:do not|don't|never)\s+(.+)$/);
-  if (match) {
+  const prefix = NEGATION_PREFIXES.find(candidate => text.startsWith(candidate));
+  if (prefix) {
     negative = true;
-    text = match[1];
+    text = text.slice(prefix.length).trim();
   }
   return text ? { basis: text, negative } : null;
 }
@@ -83,7 +91,7 @@ function reviewMemories(entries, options = {}) {
       review_id: reviewId('duplicate', [canonical]),
       kind: 'duplicate',
       count: members.length,
-      members: [...new Set(members)].sort(),
+      members: [...new Set(members)].sort(compareCodeUnits),
     });
   }
 
@@ -101,11 +109,11 @@ function reviewMemories(entries, options = {}) {
       review_id: reviewId('contradiction', [basis]),
       kind: 'contradiction',
       claim: basis,
-      members: [...new Set([...sides.positive, ...sides.negative])].sort(),
+      members: [...new Set([...sides.positive, ...sides.negative])].sort(compareCodeUnits),
     });
   }
 
-  findings.sort((a, b) => a.review_id.localeCompare(b.review_id));
+  findings.sort((left, right) => compareCodeUnits(left.review_id, right.review_id));
   const total = Number.isInteger(options.total) && options.total >= source.length
     ? options.total
     : source.length;
