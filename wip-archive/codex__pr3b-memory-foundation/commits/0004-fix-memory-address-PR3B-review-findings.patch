diff --git a/lib/commands/memory.js b/lib/commands/memory.js
index 324d0614..a50352ee 100644
--- a/lib/commands/memory.js
+++ b/lib/commands/memory.js
@@ -10,7 +10,8 @@ const { MEMORY_REVIEW_ENTRY_LIMIT, reviewMemories } = require('../memory/hygiene
 function renderReview(review) {
