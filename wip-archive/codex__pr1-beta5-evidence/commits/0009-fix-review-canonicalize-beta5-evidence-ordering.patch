From 9cfa59adc18be1f61a01fff4301fc6c3c3e218ff Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Sun, 9 Aug 2026 20:53:16 +0530
Subject: [PATCH] fix(review): canonicalize beta5 evidence ordering

---
 lib/beta5-compatibility-evidence.js        | 22 +++++++++++++---------
 lib/fixtures/beta5-corpus/v1/manifest.json |  2 +-
 test/beta5-compatibility-evidence.test.js  | 12 ++++++++++++
 3 files changed, 26 insertions(+), 10 deletions(-)

diff --git a/lib/beta5-compatibility-evidence.js b/lib/beta5-compatibility-evidence.js
index 8ce028c5..149c97be 100644
--- a/lib/beta5-compatibility-evidence.js
+++ b/lib/beta5-compatibility-evidence.js
@@ -86,6 +86,10 @@ function sha256(bytes) {
   return crypto.createHash('sha256').update(bytes).digest('hex');
 }
 
+function compareCanonicalText(left, right) {
+  return Buffer.compare(Buffer.from(left), Buffer.from(right));
+}
+
 function checkRegularFile(filePath, budget, sizeReason = 'state_tree_file_size_limit') {
   budget.check();
   const stat = fs.lstatSync(filePath);
@@ -138,7 +142,7 @@ function categoryFor(relativePath) {
 function summarizeCategories(files) {
   const counts = {};
   for (const file of files) counts[file.category] = (counts[file.category] || 0) + 1;
-  return Object.fromEntries(Object.entries(counts).sort(([left], [right]) => left.localeCompare(right)));
+  return Object.fromEntries(Object.entries(counts).sort(([left], [right]) => compareCanonicalText(left, right)));
 }
 
 function isSafeRelativePath(relativePath) {
@@ -150,7 +154,7 @@ function isSafeRelativePath(relativePath) {
 
 function aggregateHash(files) {
   const sortedFiles = [...files];
-  sortedFiles.sort((left, right) => left.path.localeCompare(right.path));
+  sortedFiles.sort((left, right) => compareCanonicalText(left.path, right.path));
   const canonical = sortedFiles
     .map(file => `${file.path}\0${file.sha256}\n`)
     .join('');
@@ -232,7 +236,7 @@ function scanCorpusTree(corpusRoot, budget) {
   } finally {
     directory.closeSync();
   }
-  files.sort((left, right) => left.localeCompare(right));
+  files.sort(compareCanonicalText);
   return { files, rootIdentity };
 }
 
@@ -343,7 +347,7 @@ function verifyBeta5Corpus(corpusRoot = BETA5_CORPUS_ROOT, options = {}) {
     fileCount: observedFiles.length,
     sourceBlobCount: metadata.sourceBlobs.length,
     contentHash: observedContentHash,
-    reasons: [...new Set(reasons)].toSorted((left, right) => left.localeCompare(right)),
+    reasons: [...new Set(reasons)].toSorted(compareCanonicalText),
   };
 }
 
@@ -558,7 +562,7 @@ function buildPrivacySafeInventory(projectRoot, options = {}) {
     schemaVersion: 'forge.beta5-inventory.v1',
     status: unknowns.length === 0 ? 'PASS' : 'INCOMPLETE',
     surfaces,
-    unknowns: [...new Set(unknowns)].toSorted((left, right) => left.localeCompare(right)),
+    unknowns: [...new Set(unknowns)].toSorted(compareCanonicalText),
   };
 }
 
@@ -618,14 +622,14 @@ function scanStateTree(projectRoot, options = {}) {
   } catch (error) {
     reasons.push(error.reason || 'state_tree_unreadable');
   }
-  files.sort((left, right) => left.path.localeCompare(right.path));
+  files.sort((left, right) => compareCanonicalText(left.path, right.path));
   return {
     status: reasons.length === 0 ? 'PASS' : 'INCOMPLETE',
     fileCount: files.length,
     hash: aggregateHash(files),
     categories: summarizeCategories(files),
     files,
-    reasons: [...new Set(reasons)].toSorted((left, right) => left.localeCompare(right)),
+    reasons: [...new Set(reasons)].toSorted(compareCanonicalText),
   };
 }
 
@@ -762,7 +766,7 @@ function normalizeSqlValue(value) {
 
 function normalizeSqlRow(row) {
   const keys = Object.keys(row);
-  keys.sort((left, right) => left.localeCompare(right));
+  keys.sort(compareCanonicalText);
   return Object.fromEntries(keys.map(key => [key, normalizeSqlValue(row[key])]));
 }
 
@@ -795,7 +799,7 @@ function boundedTableRows(runtime, database, table, count, budget) {
       rowHashes.push(sha256(encoded));
     }
   }
-  rowHashes.sort((left, right) => left.localeCompare(right));
+  rowHashes.sort(compareCanonicalText);
   return { contentBytes, rowHashes };
 }
 
diff --git a/lib/fixtures/beta5-corpus/v1/manifest.json b/lib/fixtures/beta5-corpus/v1/manifest.json
index f362f04d..d3fed2b4 100644
--- a/lib/fixtures/beta5-corpus/v1/manifest.json
+++ b/lib/fixtures/beta5-corpus/v1/manifest.json
@@ -10,7 +10,7 @@
     "lib/workflow/stages.js": "0b7ae32bddcbb9bd6dd52a07ca22e43364621918"
   },
   "hash_algorithm": "sha256",
-  "content_hash": "341a301263cb54fc8c5f16a56f5db31edba69c530b69394bc49ca69054786cbf",
+  "content_hash": "c6978eed757c6255f2d25ea6d49ada44e5b3da91830d348016267981d13afd18",
   "files": [
     { "path": "README.md", "sha256": "3cfcc78856e397f2cfd3fee9fa2fffb630e27ea3e76ee8d8b5d9a77cb366a709" },
     { "path": "contract/command-contract.json", "sha256": "8b4f885091fa8afe72b7b5a5a8039869c871f4fb1dc3344728b2c4322f491a84" },
diff --git a/test/beta5-compatibility-evidence.test.js b/test/beta5-compatibility-evidence.test.js
index 60b3d9b2..df36907b 100644
--- a/test/beta5-compatibility-evidence.test.js
+++ b/test/beta5-compatibility-evidence.test.js
@@ -78,6 +78,18 @@ describe('beta.5 compatibility evidence', () => {
     }
   });
 
+  test('keeps canonical evidence independent of the host locale', () => {
+    const baseline = verifyBeta5Corpus();
+    const localeSpy = spyOn(String.prototype, 'localeCompare').mockImplementation(function compare(other) {
+      return String(other) < String(this) ? -1 : String(other) > String(this) ? 1 : 0;
+    });
+    try {
+      expect(verifyBeta5Corpus()).toEqual(baseline);
+    } finally {
+      localeSpy.mockRestore();
+    }
+  });
+
   test('rejects unmanifested corpus files instead of silently extending immutable evidence', () => {
     const copied = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-beta5-corpus-extra-'));
     fs.cpSync(BETA5_CORPUS_ROOT, copied, { recursive: true });
-- 
