From a693e1264a0fca70e5765d8311a26ebf1755b9d2 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Tue, 4 Aug 2026 12:27:37 +0530
Subject: [PATCH] fix(shepherd): store canonical PR repository identity

Issue: a7af259f-e47a-490b-bef8-3192a60ff93a
---
 lib/pr-monitor/reconcile-executor.js       |  86 +++++++++++--
 test/pr-monitor/reconcile-executor.test.js | 141 +++++++++++++++++++++
 2 files changed, 217 insertions(+), 10 deletions(-)

diff --git a/lib/pr-monitor/reconcile-executor.js b/lib/pr-monitor/reconcile-executor.js
index c25432b1..3a1bc417 100644
--- a/lib/pr-monitor/reconcile-executor.js
+++ b/lib/pr-monitor/reconcile-executor.js
@@ -38,10 +38,30 @@ const shepherdLease = require('./shepherd-lease');
 const journal = require('./journal');
 const { reconcile: defaultReconcile } = require('./reconcile');
 const { tick: defaultTick } = require('./reconcile-tick');
-const { startPrWatcherDetached, defaultResolveSlug, forgeBin } = require('./watch-lifecycle');
+const { startPrWatcherDetached, forgeBin } = require('./watch-lifecycle');
 const brokerMod = require('../kernel/broker');
 
 const { STALE_MS } = shepherdLease;
+const CANONICAL_REPOSITORY = /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/;
+
+function normalizeRepository(value) {
+	return typeof value === 'string' && CANONICAL_REPOSITORY.test(value.trim())
+		? value.trim().toLowerCase()
+		: null;
+}
+
+/** Resolve the GitHub identity used by merge binding, never a bare repo basename. */
+function resolveCanonicalRepository(runGh) {
+	try {
+		const raw = runGh(['repo', 'view', '--json', 'owner,name']);
+		const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
+		const owner = parsed && parsed.owner && parsed.owner.login;
+		const name = parsed && parsed.name;
+		return normalizeRepository(`${owner || ''}/${name || ''}`);
+	} catch {
+		return null;
+	}
+}
 
 /**
  * Persist the daemon's latest lifecycle outcome beside the lease. This status
@@ -145,14 +165,17 @@ function removeClaimMarker(projectRoot, repo, pr, gitCommonDir) {
  */
 async function gatherDesired(gitCommonDir, opts = {}) {
 	const runGh = opts.runGh || ((args) => require('node:child_process').execFileSync('gh', args, {
-		encoding: 'utf8', timeout: 30000, windowsHide: true,
+		cwd: opts.projectRoot || process.cwd(), encoding: 'utf8', timeout: 30000, windowsHide: true,
 	}));
 	// The broker is a live kernel handle from createLocalBroker (listOpenPrs/upsertPr/
 	// retirePr are INSTANCE methods) — the daemon threads one in. Never fall back to the
 	// broker MODULE namespace: those methods don't exist there and every call would
 	// silently no-op behind the catch (this exact bug shipped once — keep it gone).
 	const broker = opts.broker || null;
-	const repo = opts.repo || defaultResolveSlug({ cwd: opts.projectRoot || process.cwd() });
+	// Explicit repo injection remains a test/programmatic seam. Production resolves the
+	// owner/name pair from GitHub; a bare basename is never inferred from a failed lookup.
+	const suppliedRepo = typeof opts.repo === 'string' && opts.repo.trim() ? opts.repo.trim() : null;
+	const repo = suppliedRepo || resolveCanonicalRepository(runGh);
 
 	let ghPrs = [];
 	// `listingOk` distinguishes "GitHub says zero open PRs" from "the gh call failed"
@@ -170,22 +193,65 @@ async function gatherDesired(gitCommonDir, opts = {}) {
 		listingOk = false;
 	}
 
+	if (!repo) return { openPrs: [], gitCommonDir, listingOk: false, repositoryOk: false };
+
 	let prRows = [];
 	try {
 		if (broker) prRows = await broker.listOpenPrs(gitCommonDir);
 	} catch {
 		/* kernel unavailable → treat as no linkage; the GitHub-driven desired set still stands */
 	}
-	// Key by (repo, number) — matches reconcile.js `keyOf` — so a repo rename that
-	// leaves a same-number row under one git_common_dir can't attach the wrong repo's
-	// linkage to the desired PR.
-	const keyOf = (r, n) => `${r} ${n}`;
-	const rowByKey = new Map((Array.isArray(prRows) ? prRows : []).map((r) => [keyOf(r.repo, r.number), r]));
+	// Key by canonical (repo, number). A single bare-name row is accepted
+	// only as a one-way compatibility bridge; it is rewritten under the canonical key
+	// and retired by the same reconcile pass. The common-dir natural key plus an exact
+	// basename/number match preserves links across force-pushes; cross-repository,
+	// ambiguous, and other malformed rows never bind.
+	const canonicalRepo = normalizeRepository(repo);
+	const legacyRepo = canonicalRepo ? canonicalRepo.slice(canonicalRepo.lastIndexOf('/') + 1) : null;
+	const validPrNumber = (value) => (Number.isSafeInteger(value) && value > 0)
+		|| (typeof value === 'string' && /^[1-9][0-9]*$/.test(value));
+	const rows = Array.isArray(prRows) ? prRows : [];
+	if (canonicalRepo) {
+		const counts = new Map();
+		const conflicting = rows.some((row) => {
+			if (!row || !validPrNumber(row.number)) return true;
+			const rowRepo = normalizeRepository(row.repo);
+			const legacy = typeof row.repo === 'string' && row.repo.toLowerCase() === legacyRepo;
+			if (!rowRepo && !legacy) return true;
+			if (rowRepo !== canonicalRepo && !legacy) return true;
+			const number = String(row.number);
+			const count = (counts.get(number) || 0) + 1;
+			counts.set(number, count);
+			return count > 1;
+		});
+		if (conflicting) return { openPrs: [], gitCommonDir, listingOk: false, repositoryOk: false };
+	}
+	const exactRows = new Map();
+	const legacyRows = new Map();
+	const add = (map, number, row) => {
+		if (!validPrNumber(number)) return;
+		const list = map.get(String(number)) || [];
+		list.push(row);
+		map.set(String(number), list);
+	};
+	for (const row of rows) {
+		if (canonicalRepo && normalizeRepository(row && row.repo) === canonicalRepo) add(exactRows, row.number, row);
+		else if (legacyRepo && row && typeof row.repo === 'string' && row.repo.toLowerCase() === legacyRepo) add(legacyRows, row.number, row);
+		else if (!canonicalRepo && row && row.repo === repo) add(exactRows, row.number, row);
+	}
+	const rowForPr = (p) => {
+		const exact = exactRows.get(String(p.number)) || [];
+		if (exact.length === 1) return exact[0];
+		if (!canonicalRepo || exact.length > 0) return null;
+		const legacy = legacyRows.get(String(p.number)) || [];
+		if (legacy.length !== 1) return null;
+		return legacy[0];
+	};
 
 	const openPrs = ghPrs.map((p) => {
-		const row = rowByKey.get(keyOf(repo, p.number));
+		const row = rowForPr(p);
 		return {
-			repo,
+			repo: canonicalRepo || repo,
 			number: p.number,
 			branch: p.headRefName ?? null,
 			headSha: p.headRefOid ?? null,
diff --git a/test/pr-monitor/reconcile-executor.test.js b/test/pr-monitor/reconcile-executor.test.js
index 3325f6d0..65ad1eae 100644
--- a/test/pr-monitor/reconcile-executor.test.js
+++ b/test/pr-monitor/reconcile-executor.test.js
@@ -656,6 +656,147 @@ describe('finding 1 — a failed gh listing is a no-op, never a teardown', () =>
 		expect(desired.listingOk).toBe(true);
 	});
 
+	test('gatherDesired uses canonical owner/repo identity and carries legacy linkage forward', async () => {
+		const calls = [];
+		const desired = await executor.gatherDesired('/g', {
+			projectRoot: '/repo',
+			runGh: (args) => {
+				calls.push(args);
+				if (args[0] === 'repo') return JSON.stringify({ owner: { login: 'harshanandak' }, name: 'forge' });
+				return JSON.stringify([{ number: 7, headRefName: 'feat/7', headRefOid: 'sha7' }]);
+			},
+			broker: { listOpenPrs: async () => [
+				{ repo: 'forge', number: 7, head_sha: 'old-sha7', issue_id: 'ISSUE-7', worktree_id: 'WT-7' },
+			] },
+		});
+		expect(calls.some((args) => args.join(' ') === 'repo view --json owner,name')).toBe(true);
+		expect(desired.openPrs[0]).toMatchObject({
+			repo: 'harshanandak/forge', issueId: 'ISSUE-7', worktreeId: 'WT-7',
+		});
+	});
+
+	test('gatherDesired fails closed when the GitHub repository identity is malformed or unreadable', async () => {
+		for (const repoResponse of [
+			JSON.stringify({ owner: { login: 'bad owner' }, name: 'forge' }),
+			() => { throw new Error('gh unavailable'); },
+		]) {
+			const desired = await executor.gatherDesired('/g', {
+				projectRoot: '/repo',
+				runGh: (args) => {
+					if (args[0] === 'repo') return typeof repoResponse === 'function' ? repoResponse() : repoResponse;
+					return JSON.stringify([{ number: 7, headRefName: 'feat/7', headRefOid: 'sha7' }]);
+				},
+			});
+			expect(desired.listingOk).toBe(false);
+			expect(desired.openPrs).toEqual([]);
+		}
+	});
+
+	test('gatherDesired does not alias cross-repository or ambiguous basename rows', async () => {
+		const desired = await executor.gatherDesired('/g', {
+			projectRoot: '/repo',
+			runGh: (args) => args[0] === 'repo'
+				? JSON.stringify({ owner: { login: 'harshanandak' }, name: 'forge' })
+				: JSON.stringify([{ number: 7, headRefName: 'feat/7', headRefOid: 'sha7' }]),
+			broker: { listOpenPrs: async () => [
+				{ repo: 'other/forge', number: 7, head_sha: 'sha7', issue_id: 'CROSS', worktree_id: 'CROSS' },
+				{ repo: 'forge', number: 7, head_sha: 'sha7', issue_id: 'LEGACY-1', worktree_id: 'WT-1' },
+				{ repo: 'forge', number: 7, head_sha: 'sha7', issue_id: 'LEGACY-2', worktree_id: 'WT-2' },
+			] },
+		});
+		expect(desired.listingOk).toBe(false);
+		expect(desired.openPrs).toEqual([]);
+	});
+
+	test('convergeOnce rewrites a legacy row under canonical repo while preserving its issue link', async () => {
+		const row = { repo: 'forge', number: 7, head_sha: 'old-sha7', issue_id: 'ISSUE-7', worktree_id: 'WT-7', state: 'open' };
+		const upserts = [];
+		const retires = [];
+		const conv = await executor.convergeOnce('/repo', {
+			gitCommonDir: '/g',
+			runGh: (args) => args[0] === 'repo'
+				? JSON.stringify({ owner: { login: 'harshanandak' }, name: 'forge' })
+				: JSON.stringify([{ number: 7, headRefName: 'feat/7', headRefOid: 'new-sha7' }]),
+			broker: {
+				listOpenPrs: async () => [row],
+				upsertPr: async (value) => { upserts.push(value); },
+				retirePr: async (value) => { retires.push(value); },
+			},
+			gatherObserved: async () => ({ lease: null, leaseFresh: false, prRows: [row], liveWatcherPids: [] }),
+			spawnWatcher: () => ({ pid: 17 }),
+			writeClaim: () => {},
+		});
+		expect(conv.actions).toContainEqual(expect.objectContaining({
+			type: 'upsertPrRow',
+			row: expect.objectContaining({ repo: 'harshanandak/forge', issue_id: 'ISSUE-7', worktree_id: 'WT-7' }),
+		}));
+		expect(conv.actions).toContainEqual({ type: 'retire', pr: { repo: 'forge', number: 7 } });
+		expect(upserts[0]).toMatchObject({ repo: 'harshanandak/forge', issue_id: 'ISSUE-7' });
+		expect(retires[0]).toMatchObject({ repo: 'forge', number: 7 });
+	});
+
+	test('convergeOnce skips all teardown when repository identity lookup fails', async () => {
+		let observed = false;
+		const conv = await executor.convergeOnce('/repo', {
+			gitCommonDir: '/g',
+			runGh: (args) => {
+				if (args[0] === 'repo') throw new Error('gh unavailable');
+				return JSON.stringify([{ number: 7, headRefName: 'feat/7', headRefOid: 'sha7' }]);
+			},
+			gatherObserved: async () => { observed = true; return { lease: null, leaseFresh: false, prRows: [{ repo: 'forge', number: 7, state: 'open' }], liveWatcherPids: [] }; },
+		});
+		expect(conv.actions).toEqual([]);
+		expect(observed).toBe(false);
+		expect(conv.desiredCount).toBeNull();
+	});
+
+	test('convergeOnce fails closed on a cross-owner row for an open PR number', async () => {
+		let observed = false;
+		let writes = 0;
+		const crossOwner = { repo: 'other/forge', number: 7, head_sha: 'sha7', state: 'open' };
+		const conv = await executor.convergeOnce('/repo', {
+			gitCommonDir: '/g',
+			runGh: (args) => args[0] === 'repo'
+				? JSON.stringify({ owner: { login: 'harshanandak' }, name: 'forge' })
+				: JSON.stringify([{ number: 7, headRefName: 'feat/7', headRefOid: 'sha7' }]),
+			broker: {
+				listOpenPrs: async () => [crossOwner],
+				upsertPr: async () => { writes += 1; },
+				retirePr: async () => { writes += 1; },
+			},
+			gatherObserved: async () => { observed = true; return { lease: null, leaseFresh: false, prRows: [crossOwner], liveWatcherPids: [] }; },
+		});
+		expect(conv.actions).toEqual([]);
+		expect(conv.desiredCount).toBeNull();
+		expect(observed).toBe(false);
+		expect(writes).toBe(0);
+	});
+
+	test('convergeOnce fails closed on duplicate legacy rows for an open PR number', async () => {
+		let observed = false;
+		let writes = 0;
+		const legacyRows = [
+			{ repo: 'forge', number: 7, head_sha: 'sha7', issue_id: 'ISSUE-1', state: 'open' },
+			{ repo: 'forge', number: 7, head_sha: 'sha7', issue_id: 'ISSUE-2', state: 'open' },
+		];
+		const conv = await executor.convergeOnce('/repo', {
+			gitCommonDir: '/g',
+			runGh: (args) => args[0] === 'repo'
+				? JSON.stringify({ owner: { login: 'harshanandak' }, name: 'forge' })
+				: JSON.stringify([{ number: 7, headRefName: 'feat/7', headRefOid: 'sha7' }]),
+			broker: {
+				listOpenPrs: async () => legacyRows,
+				upsertPr: async () => { writes += 1; },
+				retirePr: async () => { writes += 1; },
+			},
+			gatherObserved: async () => { observed = true; return { lease: null, leaseFresh: false, prRows: legacyRows, liveWatcherPids: [] }; },
+		});
+		expect(conv.actions).toEqual([]);
+		expect(conv.desiredCount).toBeNull();
+		expect(observed).toBe(false);
+		expect(writes).toBe(0);
+	});
+
 	test('convergeOnce SKIPS reconcile+execute when listingOk===false (zero retire/stop, no observe)', async () => {
 		let observed = false;
 		const conv = await executor.convergeOnce('/repo', {
