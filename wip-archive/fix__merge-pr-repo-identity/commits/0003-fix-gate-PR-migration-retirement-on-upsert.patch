From 3fcf83a73aecc9c2c20fda3ac89d77a260473cb3 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Tue, 4 Aug 2026 13:31:49 +0530
Subject: [PATCH] fix: gate PR migration retirement on upsert

---
 lib/pr-monitor/reconcile-executor.js       | 13 ++++---
 test/pr-monitor/reconcile-executor.test.js | 41 ++++++++++++++++++++++
 2 files changed, 50 insertions(+), 4 deletions(-)

diff --git a/lib/pr-monitor/reconcile-executor.js b/lib/pr-monitor/reconcile-executor.js
index fd04f38f..f4cee219 100644
--- a/lib/pr-monitor/reconcile-executor.js
+++ b/lib/pr-monitor/reconcile-executor.js
@@ -59,7 +59,8 @@ function resolveCanonicalRepository(runGh) {
 		const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
 		const owner = parsed && parsed.owner && parsed.owner.login;
 		const name = parsed && parsed.name;
-		return normalizeRepository(`${owner || ''}/${name || ''}`);
+		if (typeof owner !== 'string' || owner.trim() === '' || typeof name !== 'string' || name.trim() === '') return null;
+		return normalizeRepository(`${owner}/${name}`);
 	} catch {
 		return null;
 	}
@@ -381,9 +382,12 @@ const ACTION_HANDLERS = {
 	},
 	async upsertPrRow(action, s) {
 		try {
-			if (s.broker) await s.broker.upsertPr(action.row);
+			if (!s.broker) return true;
+			const result = await s.broker.upsertPr(action.row);
+			return result !== false && !(result && result.ok === false);
 		} catch {
 			/* derived reconcile state — a failed upsert retries on the next converge */
+			return false;
 		}
 	},
 	async retire(action, s) {
@@ -399,7 +403,8 @@ const ACTION_HANDLERS = {
 };
 
 /**
- * Dispatch a reconcile action set. Idempotent and order-free. Returns the updated
+ * Dispatch a reconcile action set in order. A failed kernel upsert stops the pass so
+ * dependent retire actions retry on the next converge. Returns the updated
  * watcher entry list (`{pr,repo,pid,startedAt}[]`) for the caller to publish via
  * `updateWatchers`. `ctx.watchers` seeds the current set (from observed state).
  */
@@ -421,7 +426,7 @@ async function execute(actions, ctx = {}) {
 
 	for (const action of (Array.isArray(actions) ? actions : [])) {
 		const handler = ACTION_HANDLERS[action && action.type];
-		if (handler) await handler(action, s);
+		if (handler && (await handler(action, s)) === false) break;
 	}
 	return s.watchers;
 }
diff --git a/test/pr-monitor/reconcile-executor.test.js b/test/pr-monitor/reconcile-executor.test.js
index 2542a294..a70ee469 100644
--- a/test/pr-monitor/reconcile-executor.test.js
+++ b/test/pr-monitor/reconcile-executor.test.js
@@ -678,6 +678,8 @@ describe('finding 1 — a failed gh listing is a no-op, never a teardown', () =>
 	test('gatherDesired fails closed when the GitHub repository identity is malformed or unreadable', async () => {
 		for (const repoResponse of [
 			JSON.stringify({ owner: { login: 'bad owner' }, name: 'forge' }),
+			JSON.stringify({ owner: { login: 123 }, name: 'forge' }),
+			JSON.stringify({ owner: { login: 'harshanandak' }, name: ['forge'] }),
 			() => { throw new Error('gh unavailable'); },
 		]) {
 			const desired = await executor.gatherDesired('/g', {
@@ -775,6 +777,45 @@ describe('finding 1 — a failed gh listing is a no-op, never a teardown', () =>
 		expect(retires).toContainEqual(expect.objectContaining({ repo: 'forge', number: 7 }));
 	});
 
+	test('convergeOnce does not retire the legacy row when canonical upsert fails', async () => {
+		const rows = [
+			{ repo: 'harshanandak/forge', number: 7, head_sha: 'new-sha7', issue_id: null, worktree_id: null, journal_ptr: null, state: 'open' },
+			{ repo: 'forge', number: 7, head_sha: 'old-sha7', issue_id: 'ISSUE-7', worktree_id: 'WT-7', journal_ptr: 'JOURNAL-7', state: 'open' },
+		];
+		const retires = [];
+		const conv = await executor.convergeOnce('/repo', {
+			gitCommonDir: '/g',
+			runGh: (args) => args[0] === 'repo'
+				? JSON.stringify({ owner: { login: 'harshanandak' }, name: 'forge' })
+				: JSON.stringify([{ number: 7, headRefName: 'feat/7', headRefOid: 'new-sha7' }]),
+			broker: {
+				listOpenPrs: async () => rows,
+				upsertPr: async () => { throw new Error('canonical write failed'); },
+				retirePr: async (value) => { retires.push(value); },
+			},
+			gatherObserved: async () => ({ lease: null, leaseFresh: false, prRows: rows, liveWatcherPids: [] }),
+			spawnWatcher: () => ({ pid: 17 }),
+			writeClaim: () => {},
+		});
+		expect(conv.actions).toContainEqual(expect.objectContaining({ type: 'upsertPrRow' }));
+		expect(conv.actions).toContainEqual({ type: 'retire', pr: { repo: 'forge', number: 7 } });
+		expect(retires).toEqual([]);
+	});
+
+	test('execute treats an explicit false upsert result as a failed dependency', async () => {
+		const retires = [];
+		await executor.execute([
+			{ type: 'upsertPrRow', row: { repo: 'harshanandak/forge', number: 7 } },
+			{ type: 'retire', pr: { repo: 'forge', number: 7 } },
+		], {
+			broker: {
+				upsertPr: async () => false,
+				retirePr: async (value) => { retires.push(value); },
+			},
+		});
+		expect(retires).toEqual([]);
+	});
+
 	test('convergeOnce fails closed when canonical and legacy rows have conflicting linkage', async () => {
 		for (const field of ['issue_id', 'worktree_id', 'journal_ptr']) {
 			let observed = false;
