From 3cd22dd0aadd2b3ae96f215498a178097c08c020 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Thu, 30 Jul 2026 19:45:56 +0530
Subject: [PATCH] fix(skills): preserve malformed invocation quotes

---
 lib/using-forge.js       | 6 +++++-
 test/using-forge.test.js | 7 +++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/lib/using-forge.js b/lib/using-forge.js
index 90f6e7c3..4c90b171 100644
--- a/lib/using-forge.js
+++ b/lib/using-forge.js
@@ -115,7 +115,11 @@ function applyFrontmatterLine(state, line) {
   }
   if (line.startsWith('invocation:')) {
     const value = line.slice('invocation:'.length).trim();
-    state.invocation = unquote(value);
+    const quote = value[0];
+    const hasMatchingQuotes = value.length >= 2
+      && (quote === '"' || quote === "'")
+      && value.endsWith(quote);
+    state.invocation = hasMatchingQuotes ? value.slice(1, -1) : value;
     return;
   }
   const descMatch = /^description:\s*(.*)$/.exec(line);
diff --git a/test/using-forge.test.js b/test/using-forge.test.js
index 71f871b8..52645435 100644
--- a/test/using-forge.test.js
+++ b/test/using-forge.test.js
@@ -146,6 +146,13 @@ describe('parseFrontmatter', () => {
   test.each([
     ['invocation: model', 'model'],
     ['invocation: user', 'user'],
+    ['invocation: "model"', 'model'],
+    ["invocation: 'user'", 'user'],
+    ['invocation: "model', '"model'],
+    ['invocation: model"', 'model"'],
+    ["invocation: 'user", "'user"],
+    ["invocation: user'", "user'"],
+    [`invocation: "model'`, `"model'`],
     [null, 'model'],
     ['invocation:', ''],
     ['invocation: Model', 'Model'],
-- 
