+	if (!identity || record?.repo !== identity.repo || record?.version !== VERSION) return 'invalid_identity';
+	if (!boundedString(record.generation, MAX_GENERATION_BYTES) || !PHASES.has(record.phase)) return 'invalid_generation_or_phase';
+	if (!canonicalTimestamp(record.startedAt) || !canonicalTimestamp(record.updatedAt)
+		|| record.updatedAt < record.startedAt) return 'invalid_timestamp';
+	if (record.heartbeatAt != null && !canonicalTimestamp(record.heartbeatAt)) return 'invalid_heartbeat';
+	if (record.terminalReceiptId != null && !boundedString(record.terminalReceiptId, MAX_RECEIPT_BYTES)) return 'invalid_receipt';
+	if (record.legacyEvidenceHash != null && !SHA256.test(record.legacyEvidenceHash)) return 'invalid_evidence';
+	if (record.controllerPid != null && !positivePid(record.controllerPid)) return 'invalid_controller_pid';
+	if (record.watcherPid != null && !positivePid(record.watcherPid)) return 'invalid_watcher_pid';
+	if (record.phase === 'starting') {
+		return positivePid(record.controllerPid) && record.watcherPid == null && record.heartbeatAt == null
+			&& record.terminalReceiptId == null && record.blockReason == null
+			? null : 'invalid_starting';
+	}
+	if (record.phase === 'running' || record.phase === 'stop_requested') {
+		return record.controllerPid == null && positivePid(record.watcherPid) && record.heartbeatAt != null
+			&& record.terminalReceiptId == null && record.blockReason == null
+			? null : 'invalid_active';
+	}
+	if (record.phase === 'terminal_pending') {
+		return record.controllerPid == null && positivePid(record.watcherPid) && record.heartbeatAt != null
+			&& record.terminalReceiptId != null && record.blockReason == null ? null : 'invalid_terminal_pending';
+	}
+	if (record.phase === 'complete') {
+		return record.controllerPid == null && record.watcherPid == null && record.heartbeatAt == null
+			&& record.terminalReceiptId != null && record.blockReason == null ? null : 'invalid_complete';
+	}
+	if (!BLOCK_REASONS.has(record.blockReason) || record.controllerPid != null
+		|| !SHA256.test(record.legacyEvidenceHash)) return 'invalid_blocked';
+	return record.blockReason === 'legacy_live_pid' === positivePid(record.watcherPid)
+		? null : 'invalid_blocked_pid';
+}
+
+function envelope(ok, changed, reason, record = null) {
+	return { ok, changed, reason, record };
+}
+
+function invalid(reason = 'invalid_input') {
+	return envelope(false, false, reason);
+}
+
+function invalidGate(reason = 'invalid_input') {
+	return { ok: false, changed: false, reason, gate: null };
+}
+
+function authority(opts) {
+	return opts?.driver && typeof opts.driver === 'object' ? opts.driver : null;
+}
+
+function invoke(method, identity, input, opts) {
+	const driver = authority(opts);
+	if (!driver || typeof driver[method] !== 'function') return invalid('authority_unavailable');
+	try {
+		const result = driver[method]({ ...identity, ...input }, opts.databaseConfig || {});
+		if (result && typeof result.then === 'function') return invalid('invalid_operation');
+		return envelope(result.ok, result.changed, result.reason, fromSqliteOwnerRow(result.row));
+	} catch (error) {
+		return invalid(error?.code === 'AUTHORITY_UNAVAILABLE' ? 'authority_unavailable' : 'store_error');
+	}
+}
+
+function captureAuthoritySnapshot(ctx, opts) {
+	const identity = normalizeIdentity(ctx);
+	const driver = authority(opts);
+	if (!identity) return { ok: false, reason: 'invalid_input' };
+	if (!driver || typeof driver.watchOwnerRead !== 'function') return { ok: false, reason: 'authority_unavailable' };
+	try {
+		const result = driver.watchOwnerRead(identity, opts.databaseConfig || {});
+		if (result && typeof result.then === 'function') return { ok: false, reason: 'invalid_operation' };
+		if (!result.ok) return { ok: false, reason: result.reason };
+		return { ok: true, identity, snapshot: result.row };
+	} catch (error) {
+		return { ok: false, reason: error?.code === 'AUTHORITY_UNAVAILABLE' ? 'authority_unavailable' : 'store_error' };
+	}
+}
+
+async function evidenceVerified(identity, evidence, states, opts) {
+	if (typeof opts.verifyProviderEvidence !== 'function') return false;
+	try {
+		return await opts.verifyProviderEvidence(evidence, { ...identity, states }) === true;
+	} catch {
+		return false;
+	}
+}
+
+async function receiptVerified(identity, receipt, opts) {
+	if (!boundedString(receipt, MAX_RECEIPT_BYTES) || typeof opts.verifyTerminalReceipt !== 'function') return false;
+	try {
+		return await opts.verifyTerminalReceipt(receipt, identity) === true;
+	} catch {
+		return false;
+	}
+}
+
+async function pidState(pid, opts) {
+	const inspect = opts.isPidAlive || journal.pidAlive;
+	try {
+		return await inspect(pid);
+	} catch {
+		return null;
+	}
+}
+
+function mutationInput(ctx, input, opts, { generation = true, now = true } = {}) {
+	const identity = normalizeIdentity(ctx);
+	if (!identity) return null;
+	const value = { ...identity };
+	if (generation) {
+		if (!boundedString(input?.generation, MAX_GENERATION_BYTES)) return null;
+		value.generation = input.generation;
+	}
+	if (now) {
+		value.now = nowIso(opts, input?.updatedAt || input?.startedAt);
+		if (!value.now) return null;
+	}
+	return value;
+}
+
+async function readOwner(ctx, opts = {}) {
+	const identity = normalizeIdentity(ctx);
+	return identity ? invoke('watchOwnerRead', identity, {}, opts) : invalid();
+}
+
+async function enumerateOwners(_ctx, opts = {}) {
+	const driver = authority(opts);
+	if (!driver || typeof driver.watchOwnerList !== 'function') {
+		return { ok: false, changed: false, reason: 'authority_unavailable', records: [] };
+	}
+	try {
+		const result = driver.watchOwnerList(opts.databaseConfig || {});
+		return { ok: result.ok, changed: false, reason: result.reason,
+			records: result.rows.map(fromSqliteOwnerRow) };
+	} catch (error) {
+		return { ok: false, changed: false,
+			reason: error?.code === 'AUTHORITY_UNAVAILABLE' ? 'authority_unavailable' : 'store_error', records: [] };
+	}
+}
+
+async function reserveStarting(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts, { generation: false });
+	if (!value || !positivePid(input?.controllerPid)) return invalid('invalid_reservation');
+	return invoke('watchOwnerReserveStarting', value, { controllerPid: Number(input.controllerPid) }, opts);
+}
+
+async function reserveReopened(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts);
+	if (!value || !positivePid(input?.controllerPid)
+		|| !boundedString(input?.expectedReceiptId, MAX_RECEIPT_BYTES)) return invalid('invalid_reservation');
+	const captured = captureAuthoritySnapshot(ctx, opts);
+	if (!captured.ok) return invalid(captured.reason);
+	if (!await evidenceVerified(value, input.providerEvidence, ['open'], opts)) return invalid('provider_evidence_invalid');
+	return invoke('watchOwnerReserveReopened', value, {
+		controllerPid: Number(input.controllerPid), expectedReceiptId: input.expectedReceiptId,
+		expectedSnapshot: captured.snapshot,
+	}, opts);
+}
+
+async function bindRunning(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts);
+	if (!value || !positivePid(input?.controllerPid) || !positivePid(input?.pid)) return invalid('invalid_pid');
+	return invoke('watchOwnerBindRunning', value, {
+		controllerPid: Number(input.controllerPid), watcherPid: Number(input.pid),
+	}, opts);
+}
+
+async function heartbeat(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts);
+	if (!value || !positivePid(input?.pid)) return invalid('invalid_pid');
+	return invoke('watchOwnerHeartbeat', value, { watcherPid: Number(input.pid) }, opts);
+}
+
+async function requestStop(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts);
+	if (!value || !positivePid(input?.pid)) return invalid('invalid_pid');
+	return invoke('watchOwnerRequestStop', value, { watcherPid: Number(input.pid) }, opts);
+}
+
+async function recordTerminal(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts);
+	if (!value || !positivePid(input?.pid)) return invalid('invalid_pid');
+	const captured = captureAuthoritySnapshot(ctx, opts);
+	if (!captured.ok) return invalid(captured.reason);
+	if (!await receiptVerified(value, input.terminalReceiptId, opts)) return invalid('receipt_unverified');
+	return invoke('watchOwnerRecordTerminal', value, {
+		watcherPid: Number(input.pid), terminalReceiptId: input.terminalReceiptId,
+		expectedSnapshot: captured.snapshot,
+	}, opts);
+}
+
+async function completeTerminal(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts);
+	if (!value || !positivePid(input?.pid) || !boundedString(input?.terminalReceiptId, MAX_RECEIPT_BYTES)) return invalid();
+	const captured = captureAuthoritySnapshot(ctx, opts);
+	if (!captured.ok) return invalid(captured.reason);
+	if (await pidState(Number(input.pid), opts) !== false) return invalid('pid_live');
+	return invoke('watchOwnerCompleteTerminal', value, {
+		watcherPid: Number(input.pid), terminalReceiptId: input.terminalReceiptId,
+		expectedSnapshot: captured.snapshot,
+	}, opts);
+}
+
+async function abortStarting(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts, { now: false });
+	if (!value || !positivePid(input?.controllerPid)) return invalid('invalid_pid');
+	const captured = captureAuthoritySnapshot(ctx, opts);
+	if (!captured.ok) return invalid(captured.reason);
+	if (await pidState(Number(input.controllerPid), opts) !== true) return invalid('controller_dead');
+	return invoke('watchOwnerAbortStarting', value, {
+		controllerPid: Number(input.controllerPid), expectedSnapshot: captured.snapshot,
+	}, opts);
+}
+
+async function releaseNonterminal(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts, { now: false });
+	if (!value || !positivePid(input?.pid)) return invalid('invalid_pid');
+	return invoke('watchOwnerReleaseNonterminal', value, { watcherPid: Number(input.pid) }, opts);
+}
+
+async function recoverDeadStarting(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts);
+	if (!value || !positivePid(input?.controllerPid) || !positivePid(input?.recoveryControllerPid)) return invalid('invalid_pid');
+	const captured = captureAuthoritySnapshot(ctx, opts);
+	if (!captured.ok) return invalid(captured.reason);
+	if (await pidState(Number(input.controllerPid), opts) !== false) return invalid('pid_live');
+	return invoke('watchOwnerRecoverDeadStarting', value, {
+		expectedControllerPid: Number(input.controllerPid), controllerPid: Number(input.recoveryControllerPid),
+		expectedSnapshot: captured.snapshot,
+	}, opts);
+}
+
+async function recoverDeadWatcher(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts);
+	if (!value || !positivePid(input?.pid) || !positivePid(input?.recoveryControllerPid)) return invalid('invalid_pid');
+	const captured = captureAuthoritySnapshot(ctx, opts);
+	if (!captured.ok) return invalid(captured.reason);
+	if (await pidState(Number(input.pid), opts) !== false) return invalid('pid_live');
+	if (!await evidenceVerified(value, input.providerEvidence, ['open', 'terminal'], opts)) return invalid('provider_evidence_invalid');
+	return invoke('watchOwnerRecoverDeadWatcher', value, {
+		watcherPid: Number(input.pid), controllerPid: Number(input.recoveryControllerPid),
+		expectedSnapshot: captured.snapshot,
+	}, opts);
+}
+
+async function markLegacyBlocked(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts, { generation: false });
+	if (!value || !BLOCK_REASONS.has(input?.blockReason) || !SHA256.test(input?.legacyEvidenceHash)
+		|| !SHA256.test(input?.snapshotHash)) {
+		return invalid('invalid_legacy_evidence');
+	}
+	if (input.pid != null && !positivePid(input.pid)) return invalid('invalid_legacy_evidence');
+	const watcherPid = input.pid == null ? null : input.pid;
+	if ((input.blockReason === 'legacy_live_pid') !== positivePid(watcherPid)) return invalid('invalid_legacy_evidence');
+	const captured = captureAuthoritySnapshot(ctx, opts);
+	if (!captured.ok) return invalid(captured.reason);
+	if (watcherPid != null && await pidState(watcherPid, opts) !== true) return invalid('pid_dead');
+	if (input.terminalReceiptId != null && !boundedString(input.terminalReceiptId, MAX_RECEIPT_BYTES)) return invalid('invalid_legacy_evidence');
+	return invoke('watchOwnerMarkLegacyBlocked', value, {
+		watcherPid, blockReason: input.blockReason, terminalReceiptId: input.terminalReceiptId || null,
+		legacyEvidenceHash: input.legacyEvidenceHash, snapshotHash: input.snapshotHash,
+		expectedSnapshot: captured.snapshot,
+	}, opts);
+}
+
+async function recheckLegacyBlocked(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts);
+	if (!value || !SHA256.test(input?.legacyEvidenceHash) || !['release', 'complete'].includes(input?.action)) {
+		return invalid('invalid_legacy_evidence');
+	}
+	const captured = captureAuthoritySnapshot(ctx, opts);
+	if (!captured.ok) return invalid(captured.reason);
+	const storedLivePid = captured.snapshot?.phase === 'blocked'
+		&& captured.snapshot.block_reason === 'legacy_live_pid'
+		? captured.snapshot.watcher_pid : null;
+	if (storedLivePid != null && (!positivePid(input.pid) || input.pid !== storedLivePid)) {
+		return invalid('pid_mismatch');
+	}
+	if (input.pid != null && await pidState(Number(input.pid), opts) !== false) return invalid('pid_live');
+	if (input.action === 'complete' && !await receiptVerified(value, input.terminalReceiptId, opts)) return invalid('receipt_unverified');
+	return invoke('watchOwnerRecheckLegacyBlocked', value, {
+		action: input.action, legacyEvidenceHash: input.legacyEvidenceHash,
+		terminalReceiptId: input.action === 'complete' ? input.terminalReceiptId : null,
+		watcherPid: input.pid == null ? null : Number(input.pid), expectedSnapshot: captured.snapshot,
+	}, opts);
+}
+
+async function importLegacyComplete(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts, { generation: false });
+	if (!value || !SHA256.test(input?.snapshotHash) || !SHA256.test(input?.legacyEvidenceHash)) {
+		return invalid('invalid_legacy_evidence');
+	}
+	const captured = captureAuthoritySnapshot(ctx, opts);
+	if (!captured.ok) return invalid(captured.reason);
+	if (input.legacyPid != null && !positivePid(input.legacyPid)) return invalid('invalid_legacy_evidence');
+	if (input.legacyPid != null && await pidState(Number(input.legacyPid), opts) !== false) return invalid('pid_live');
+	if (!await receiptVerified(value, input.terminalReceiptId, opts)) return invalid('receipt_unverified');
+	return invoke('watchOwnerImportLegacyComplete', value, {
+		snapshotHash: input.snapshotHash, legacyEvidenceHash: input.legacyEvidenceHash,
+		terminalReceiptId: input.terminalReceiptId, expectedSnapshot: captured.snapshot,
+	}, opts);
+}
+
+async function importLegacyStarting(ctx, input, opts = {}) {
+	const value = mutationInput(ctx, input, opts, { generation: false });
+	if (!value || !SHA256.test(input?.snapshotHash) || !SHA256.test(input?.legacyEvidenceHash)
+		|| !positivePid(input?.legacyPid) || !positivePid(input?.controllerPid)) {
+		return invalid('invalid_legacy_evidence');
+	}
+	const captured = captureAuthoritySnapshot(ctx, opts);
+	if (!captured.ok) return invalid(captured.reason);
+	const gate = await readMigrationGate({}, opts);
+	if (!gate.ok) return invalid(gate.reason === 'corrupt' ? 'corrupt' : gate.reason === 'authority_unavailable'
+		? 'authority_unavailable' : 'gate_mismatch');
+	if (gate.gate.state !== 'quarantined' || gate.gate.snapshot_hash !== input.snapshotHash) {
+		return invalid('gate_mismatch');
+	}
+	if (await pidState(input.legacyPid, opts) !== false) return invalid('pid_live');
+	if (!await evidenceVerified(value, input.providerEvidence, ['open'], opts)) return invalid('provider_evidence_invalid');
+	return invoke('watchOwnerImportLegacyStarting', value, {
+		snapshotHash: input.snapshotHash, legacyEvidenceHash: input.legacyEvidenceHash,
+		controllerPid: input.controllerPid, expectedSnapshot: captured.snapshot,
+	}, opts);
+}
+
+function gateInput(input, opts) {
+	const now = nowIso(opts, input?.updatedAt);
+	return now ? { now } : null;
+}
+
+function invokeGate(method, input, opts) {
+	const driver = authority(opts);
+	if (!driver || typeof driver[method] !== 'function') return { ok: false, changed: false, reason: 'authority_unavailable', gate: null };
+	try {
+		const result = driver[method](input, opts.databaseConfig || {});
+		return result && typeof result.then === 'function'
+			? { ok: false, changed: false, reason: 'invalid_operation', gate: null }
+			: result;
+	} catch (error) {
+		return { ok: false, changed: false,
+			reason: error?.code === 'AUTHORITY_UNAVAILABLE' ? 'authority_unavailable' : 'store_error', gate: null };
+	}
+}
+
+async function readMigrationGate(input = {}, opts = {}) {
+	return invokeGate('watchGateRead', input, opts);
+}
+
+async function publishMigrationQuarantine(input = {}, opts = {}) {
+	const value = gateInput(input, opts);
+	return value ? invokeGate('watchGatePublishQuarantine', value, opts) : invalidGate();
+}
+
+async function bindMigrationSnapshot(input = {}, opts = {}) {
+	const value = gateInput(input, opts);
+	if (!value || !SHA256.test(input.snapshotHash)) return invalidGate('invalid_snapshot');
+	return invokeGate('watchGateBindSnapshot', { ...value, snapshotHash: input.snapshotHash }, opts);
+}
+
+async function publishMigrationConflict(input = {}, opts = {}) {
+	const value = gateInput(input, opts);
+	if (!value || !SHA256.test(input.snapshotHash) || !CONFLICT_CODES.has(input.conflictCode)) return invalidGate('invalid_conflict');
+	return invokeGate('watchGatePublishConflict', { ...value, snapshotHash: input.snapshotHash, conflictCode: input.conflictCode }, opts);
+}
+
+async function completeMigrationGate(input = {}, opts = {}) {
+	const value = gateInput(input, opts);
+	if (!value || !SHA256.test(input.snapshotHash)) return invalidGate('invalid_snapshot');
+	return invokeGate('watchGateCompleteMigration', { ...value, snapshotHash: input.snapshotHash }, opts);
+}
+
+module.exports = {
+	VERSION,
+	PHASES,
+	BLOCK_REASONS,
+	CONFLICT_CODES,
+	validateRecord,
+	readOwner,
+	enumerateOwners,
+	reserveStarting,
+	reserveReopened,
+	bindRunning,
+	heartbeat,
+	requestStop,
+	recordTerminal,
+	completeTerminal,
+	abortStarting,
+	releaseNonterminal,
+	recoverDeadStarting,
+	recoverDeadWatcher,
+	markLegacyBlocked,
+	recheckLegacyBlocked,
+	importLegacyStarting,
+	importLegacyComplete,
+	readMigrationGate,
+	publishMigrationQuarantine,
+	bindMigrationSnapshot,
+	publishMigrationConflict,
+	completeMigrationGate,
+};
