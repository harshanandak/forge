 	for (let attempt = 0; attempt < MAX_MIGRATION_ATTEMPTS; attempt += 1) {
 		const first = await readSnapshot();
 		const firstHash = hashLegacySnapshot(first);
-		if (!first || first.corrupt) {
-			snapshot = first;
-			snapshotHash = firstHash;
-			break;
-		}
-		const consolidated = consolidateLegacyEntries(first.entries);
-		if (first.unmappable || consolidated.unmappable) {
-			await authority.publishMigrationConflict({
-				snapshotHash: firstHash, conflictCode: 'legacy_identity_unmappable', updatedAt: now,
