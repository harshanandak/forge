+	try {
+		providerState = String(
+			await (opts.readProviderState || defaultReadProviderState)(entry, { ...opts, projectRoot }) || '',
+		).toLowerCase();
+		providerReadable = providerState.length > 0;
+	} catch { providerReadable = false; }
 	const providerTerminal = ['closed', 'merged', 'terminal'].includes(providerState);
 	let providerVerified = false;
 	if (hasPid && providerState === 'open' && typeof options.verifyProviderEvidence === 'function') {
@@ -617,6 +628,7 @@ async function collectLegacyEntryEvidence(entry, options, opts, projectRoot) {
 		hasPid,
 		pidState,
 		providerState,
+		providerReadable,
 		providerTerminal,
 		providerVerified,
 		receiptVerified,
