Subject: [PATCH] fix(shepherd): block unverified legacy evidence

---
 lib/pr-monitor/reconcile-executor.js          |  76 ++++++++---
 .../reconcile-migration-gate.test.js          | 126 +++++++++++++++++-
 2 files changed, 178 insertions(+), 24 deletions(-)

diff --git a/lib/pr-monitor/reconcile-executor.js b/lib/pr-monitor/reconcile-executor.js
index 3ef36d9b..7c37dce6 100644
--- a/lib/pr-monitor/reconcile-executor.js
+++ b/lib/pr-monitor/reconcile-executor.js
@@ -591,10 +591,21 @@ async function collectLegacyEntryEvidence(entry, options, opts, projectRoot) {
 	const ctx = identity(entry);
 	const pid = Number(entry.pid);
 	const hasPid = Number.isSafeInteger(pid) && pid > 0;
-	const pidState = hasPid ? await options.isPidAlive(pid) : false;
-	const providerState = String(
-		await (opts.readProviderState || defaultReadProviderState)(entry, { ...opts, projectRoot }) || '',
-	).toLowerCase();
+	let pidState = false;
