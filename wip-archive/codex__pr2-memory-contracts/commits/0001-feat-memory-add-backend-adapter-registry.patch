@@ -182,19 +210,27 @@ function assertMemoryConfigValid({ deps = {}, env = process.env, projectRoot, co
  * never-hang guarantee — the emitter, not this seam, owns preventing that.
  *
  * @param {object} [emitter] - optional `{ emit(entry) }` injected by callers.
- * @param {object} entry - the persisted local entry.
+ * @param {Function} entryProvider - returns the persisted local entry.
  */
-function fireAndForgetGraphitiEmit(emitter, entry) {
-  if (!emitter || typeof emitter.emit !== 'function') return;
-  try {
-    // Do not await: fire-and-forget. If it returns a promise, swallow rejection.
-    const maybePromise = emitter.emit(entry);
-    if (maybePromise && typeof maybePromise.then === 'function') {
-      maybePromise.then(() => {}, () => {});
-    }
-  } catch {
-    // Hard fallback: the local write already succeeded. Never surface emit errors.
-  }
+// The implementation now lives in the adapter below so synchronous failures can
+// be represented in the operation receipt while rejected promises stay consumed.
+
+function graphitiAdapter(emitter, entryProvider) {
+  const unavailable = () => [];
+  return {
+    add() {
+      if (!emitter || typeof emitter.emit !== 'function') return null;
+      const maybePromise = emitter.emit(entryProvider());
+      if (maybePromise && typeof maybePromise.then === 'function') {
+        maybePromise.then(() => {}, () => {});
+      }
+      return null;
+    },
+    recall: unavailable,
+    search: unavailable,
+    capture: unavailable,
+    digest: unavailable,
+  };
 }
 
