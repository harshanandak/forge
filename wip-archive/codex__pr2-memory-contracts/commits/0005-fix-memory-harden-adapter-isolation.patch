 		const serverPath = graphiti.mcpServerPath;
-		const serverPathExists = fs.existsSync(serverPath);
-		const reach = serverPathExists
-			? `mcp_server present at ${serverPath}`
-			: `mcp_server path not found locally (${serverPath}); run it before agents can use graph memory`;
+		const path = require('node:path');
+		const resolvedServerPath = path.isAbsolute(serverPath)
+			? serverPath
+			: path.resolve(projectRoot, serverPath);
+		const serverPathExists = fs.existsSync(resolvedServerPath);
+		let serverPathIsDirectory = false;
+		if (serverPathExists) {
+			try {
+				serverPathIsDirectory = fs.statSync(resolvedServerPath).isDirectory();
+			} catch {
+				serverPathIsDirectory = false;
+			}
+		}
+		const entrypointPath = path.join(resolvedServerPath, 'main.py');
+		const entrypointExists = serverPathIsDirectory && fs.existsSync(entrypointPath);
+		const serverReady = serverPathExists && serverPathIsDirectory && entrypointExists;
+		let reach;
+		if (!serverPathExists) {
+			reach = `mcp_server path not found locally (${serverPath}); run it before agents can use graph memory`;
+		} else if (!serverPathIsDirectory) {
+			reach = `mcp_server path is not a directory (${serverPath})`;
+		} else if (!entrypointExists) {
+			reach = `mcp_server entrypoint not found (${path.join(serverPath, 'main.py')})`;
+		} else {
+			reach = `mcp_server present at ${serverPath}`;
+		}
 		return {
 			// Reflect reality in the line symbol: a graphiti backend whose MCP server
 			// isn't present yet renders as `!` (warn), not a misleading `✓`. This does
@@ -49,9 +71,11 @@ function buildMemoryCheck(projectRoot, env) {
