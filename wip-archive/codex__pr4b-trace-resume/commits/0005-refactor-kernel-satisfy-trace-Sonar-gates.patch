+const PR_LINKAGE_DRIVER_METHODS = ['resolvePrLinkage', 'upsertPr', 'retirePr', 'readTrace', 'loadKernelEventByIdempotencyKey'];
+
+function preparePrLinkageInput(input, driver) {
+	const linkageInput = snapshotPrLinkageInput(input);
+	if (!linkageInput || !['opened', 'merged'].includes(linkageInput.phase)) {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage phase must be opened or merged');
+	}
+	for (const field of ['git_common_dir', 'repo', 'number', 'branch']) {
+		if (linkageInput[field] === undefined || linkageInput[field] === null || linkageInput[field] === '') {
+			throw traceError('FORGE_TRACE_INVALID_RECEIPT', `recordPrLinkage requires ${field}`);
+		}
+	}
+	for (const method of PR_LINKAGE_DRIVER_METHODS) requireDriverMethod(driver, method);
+	return linkageInput;
+}
+
+function assertResolvedPrLinkage(inferred, evidence) {
+	if (!inferred.issue_id || inferred.issue_revision === null) {
+		throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage requires resolved issue linkage');
+	}
+	if (!inferred.worktree_id || !inferred.worktree_matches) {
+		throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage requires a matching active worktree binding');
+	}
+	if (inferred.inferred_issue_id && evidence.issue_id !== inferred.inferred_issue_id) {
+		throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage WorkPacket issue conflicts with inferred worktree issue');
+	}
+	if (evidence.issue_revision !== inferred.issue_revision) {
+		throw traceError(
+			'FORGE_TRACE_STALE_AUTHORITY',
+			`recordPrLinkage stale issue revision: expected ${evidence.issue_revision}, actual ${inferred.issue_revision}`,
+		);
+	}
+}
+
+function findPriorPr(pullRequests, input) {
+	return pullRequests.find(candidate => (
+		candidate.git_common_dir === input.git_common_dir
+			&& candidate.repo === input.repo
+			&& Number(candidate.number) === Number(input.number)
+	)) || null;
+}
+
+function buildPrLinkagePayload(input, evidence, worktreeId, gateReceipts) {
+	return {
+		issue_id: evidence.issue_id,
+		issue_revision: evidence.issue_revision,
+		worktree_id: worktreeId,
+		repo: input.repo,
+		number: input.number,
+		url: input.url ?? null,
+		head_sha: evidence.head_sha,
+		work_packet_hash: evidence.work_packet_hash,
+		run_receipt_hash: evidence.run_receipt_hash,
+		risk_manifest_digest: evidence.risk_manifest_digest,
+		gate_receipts: gateReceipts,
+	};
+}
+
+function assertTerminalPrCompatibility(terminalPr, input, evidence, worktreeId) {
+	if (!terminalPr) return;
+	const conflicts = evidence.head_sha !== terminalPr.head_sha
+		|| (input.branch != null && input.branch !== terminalPr.branch)
+		|| evidence.issue_id !== terminalPr.issue_id
+		|| (worktreeId != null && worktreeId !== terminalPr.worktree_id)
+		|| (input.journal_ptr != null && input.journal_ptr !== terminalPr.journal_ptr);
+	if (conflicts) throw traceError('FORGE_TRACE_TERMINAL_CONFLICT', 'recordPrLinkage terminal PR linkage conflict');
+}
+
+function assertTerminalPrEvent(terminalPr, existingEvent) {
+	if (terminalPr && !existingEvent) {
+		throw traceError('FORGE_TRACE_TERMINAL_CONFLICT', 'recordPrLinkage terminal PR linkage conflict');
+	}
