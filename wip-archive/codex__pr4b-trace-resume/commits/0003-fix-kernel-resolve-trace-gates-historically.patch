From 24e8f299024c8a9b632f4755cc51d7e54d4b9ece Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Tue, 11 Aug 2026 01:11:39 +0530
Subject: [PATCH] fix(kernel): resolve trace gates historically

---
 lib/kernel/broker.js      | 90 ++++++++++++++++++++++++++-------------
 test/kernel/trace.test.js | 61 ++++++++++++++++++++++++++
 2 files changed, 122 insertions(+), 29 deletions(-)

diff --git a/lib/kernel/broker.js b/lib/kernel/broker.js
index d9c758ad..526de0c3 100644
--- a/lib/kernel/broker.js
+++ b/lib/kernel/broker.js
@@ -196,18 +196,43 @@ function assertBoundedReceiptValue(value, state = { ancestors: new WeakSet(), no
 	}
 }
 
+function canonicalReceiptStringify(value) {
+	if (value === null || typeof value !== 'object') return JSON.stringify(value);
+	if (Array.isArray(value)) return `[${value.map(canonicalReceiptStringify).join(',')}]`;
+	return `{${Object.keys(value).sort()
+		.map(key => `${JSON.stringify(key)}:${canonicalReceiptStringify(value[key])}`)
+		.join(',')}}`;
+}
+
+function snapshotReceipt(receipt) {
+	assertBoundedReceiptValue(receipt);
+	return JSON.parse(canonicalReceiptStringify(receipt));
+}
+
+function snapshotPrLinkageInput(input) {
+	if (!input || typeof input !== 'object') return input;
+	return {
+		phase: input.phase,
+		git_common_dir: input.git_common_dir,
+		repo: input.repo,
+		number: input.number,
+		url: input.url,
+		branch: input.branch,
+		work_packet: snapshotReceipt(input.work_packet),
+		run_receipt: snapshotReceipt(input.run_receipt),
+		occurred_at: input.occurred_at || new Date().toISOString(),
+		worktree_id: input.worktree_id,
+		issue_id: input.issue_id,
+		journal_ptr: input.journal_ptr,
+		id: input.id,
+	};
+}
+
 function receiptContentHash(receipt) {
 	const withoutHash = {};
 	for (const [key, value] of Object.entries(receipt)) {
 		if (key !== 'content_hash') withoutHash[key] = value;
 	}
-	const canonicalReceiptStringify = (value) => {
-		if (value === null || typeof value !== 'object') return JSON.stringify(value);
-		if (Array.isArray(value)) return `[${value.map(canonicalReceiptStringify).join(',')}]`;
-		return `{${Object.keys(value).sort()
-			.map(key => `${JSON.stringify(key)}:${canonicalReceiptStringify(value[key])}`)
-			.join(',')}}`;
-	};
 	const canonical = canonicalReceiptStringify(withoutHash);
 	if (Buffer.byteLength(canonical, 'utf8') > TRACE_MAX_RECEIPT_BYTES) {
 		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage receipt exceeds byte bound');
@@ -289,9 +314,15 @@ function parseTracePayload(row) {
 }
 
 function resolveGateReceipts(events, gateIds, occurredAt) {
+	const occurredAtMs = Date.parse(occurredAt);
+	if (!Number.isFinite(occurredAtMs)) {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage occurred_at must be a valid timestamp');
+	}
 	const gateEvents = new Map();
 	for (const event of events) {
 		if (!['gate.approved', 'gate.rejected'].includes(event.event_type)) continue;
+		const eventAtMs = Date.parse(event.created_at);
+		if (!Number.isFinite(eventAtMs) || eventAtMs > occurredAtMs) continue;
 		const payload = parseTracePayload(event);
 		if (gateIds.includes(payload.gate)) gateEvents.set(payload.gate, { event, payload });
 	}
@@ -1504,20 +1535,21 @@ function createLocalBroker(options = {}) {
 		},
 
 		async recordPrLinkage(input, context = {}) {
-			if (!input || !['opened', 'merged'].includes(input.phase)) {
+			const linkageInput = snapshotPrLinkageInput(input);
+			if (!linkageInput || !['opened', 'merged'].includes(linkageInput.phase)) {
 				throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage phase must be opened or merged');
 			}
 			for (const field of ['git_common_dir', 'repo', 'number', 'branch']) {
-				if (input[field] === undefined || input[field] === null || input[field] === '') {
+				if (linkageInput[field] === undefined || linkageInput[field] === null || linkageInput[field] === '') {
 					throw traceError('FORGE_TRACE_INVALID_RECEIPT', `recordPrLinkage requires ${field}`);
 				}
 			}
 			for (const method of ['resolvePrLinkage', 'upsertPr', 'retirePr', 'readTrace', 'loadKernelEventByIdempotencyKey']) {
 				requireDriverMethod(driver, method);
 			}
-			const evidence = derivePrEvidence(input);
+			const evidence = derivePrEvidence(linkageInput);
 			const config = getConfig();
-			const inferred = await driver.resolvePrLinkage({ ...input, issue_id: evidence.issue_id }, context, config);
+			const inferred = await driver.resolvePrLinkage({ ...linkageInput, issue_id: evidence.issue_id }, context, config);
 			if (!inferred.issue_id || inferred.issue_revision === null) {
 				throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage requires resolved issue linkage');
 			}
@@ -1537,27 +1569,27 @@ function createLocalBroker(options = {}) {
 			const gateReceipts = resolveGateReceipts(
 				issueEvents,
 				evidence.gate_ids,
-				input.occurred_at || new Date().toISOString(),
+				linkageInput.occurred_at,
 			);
 			const priorRows = await driver.readTrace({
-				pr_number: input.number,
-				repo: input.repo,
-				git_common_dir: input.git_common_dir,
+				pr_number: linkageInput.number,
+				repo: linkageInput.repo,
+				git_common_dir: linkageInput.git_common_dir,
 			}, context, config);
 			const priorPr = priorRows.pull_requests.find(candidate => (
-				candidate.git_common_dir === input.git_common_dir
-				&& candidate.repo === input.repo
-				&& Number(candidate.number) === Number(input.number)
+				candidate.git_common_dir === linkageInput.git_common_dir
+					&& candidate.repo === linkageInput.repo
+					&& Number(candidate.number) === Number(linkageInput.number)
 			)) || null;
 			const worktreeId = inferred.worktree_id;
-			const eventType = `pr.${input.phase}`;
+			const eventType = `pr.${linkageInput.phase}`;
 			const payload = {
 				issue_id: evidence.issue_id,
 				issue_revision: evidence.issue_revision,
 				worktree_id: worktreeId,
-				repo: input.repo,
-				number: input.number,
-				url: input.url ?? null,
+				repo: linkageInput.repo,
+				number: linkageInput.number,
+				url: linkageInput.url ?? null,
 				head_sha: evidence.head_sha,
 				work_packet_hash: evidence.work_packet_hash,
 				run_receipt_hash: evidence.run_receipt_hash,
@@ -1568,10 +1600,10 @@ function createLocalBroker(options = {}) {
 			const terminalPr = priorPr && ['merged', 'closed'].includes(priorPr.state) ? priorPr : null;
 			if (terminalPr) {
 				const conflicts = evidence.head_sha !== priorPr.head_sha
-					|| (input.branch != null && input.branch !== priorPr.branch)
+					|| (linkageInput.branch != null && linkageInput.branch !== priorPr.branch)
 					|| evidence.issue_id !== priorPr.issue_id
 					|| (worktreeId != null && worktreeId !== priorPr.worktree_id)
-					|| (input.journal_ptr != null && input.journal_ptr !== priorPr.journal_ptr);
+					|| (linkageInput.journal_ptr != null && linkageInput.journal_ptr !== priorPr.journal_ptr);
 				if (conflicts) throw traceError('FORGE_TRACE_TERMINAL_CONFLICT', 'recordPrLinkage terminal PR linkage conflict');
 			}
 
@@ -1587,11 +1619,11 @@ function createLocalBroker(options = {}) {
 			const linked = terminalPr
 				? { ok: true, ...terminalPr }
 				: await driver.upsertPr({
-					...input,
+					...linkageInput,
 					head_sha: evidence.head_sha,
 					issue_id: evidence.issue_id,
 					worktree_id: worktreeId,
-					registered_at: input.occurred_at,
+					registered_at: linkageInput.occurred_at,
 				}, context, config);
 			const event = await runGuardedEventImpl({
 				entity_type: 'pr',
@@ -1601,16 +1633,16 @@ function createLocalBroker(options = {}) {
 				expected_revision: 0,
 				actor: context.actor || 'forge',
 				origin: context.origin || 'cli',
-				created_at: input.occurred_at || new Date().toISOString(),
+				created_at: linkageInput.occurred_at,
 				payload,
 			}, context);
 			assertCompatiblePrEvidence(event.originalEvent, payload);
-			if (input.phase === 'merged' && !terminalPr) {
+			if (linkageInput.phase === 'merged' && !terminalPr) {
 				await driver.retirePr({
 					git_common_dir: linked.git_common_dir,
 					repo: linked.repo,
 					number: linked.number,
-				}, { state: 'merged', retired_at: input.occurred_at }, context, config);
+				}, { state: 'merged', retired_at: linkageInput.occurred_at }, context, config);
 			}
 			return { link: linked, iteration: event };
 		},
diff --git a/test/kernel/trace.test.js b/test/kernel/trace.test.js
index 772564b9..afb719ab 100644
--- a/test/kernel/trace.test.js
+++ b/test/kernel/trace.test.js
@@ -218,6 +218,67 @@ describe('Kernel receipt-bound PR trace', () => {
 		expect(await driver.queryAll("SELECT * FROM kernel_events WHERE entity_type = 'pr';", config)).toEqual([]);
 	});
 
+	test('resolves gate authority historically at the linkage occurrence time', async () => {
+		await driver.insertKernelEvent({
+			entity_type: 'issue', entity_id: 'issue-trace', event_type: 'gate.rejected',
+			idempotency_key: 'gate.rejected:issue-trace:gate.merge:future', expected_revision: 0,
+			actor: 'maintainer', origin: 'test', payload: { gate: GATE_ID, expires_at: null, generation: 1 },
+			created_at: '2026-08-11T00:08:00.000Z',
+		}, {}, config);
+
+		await broker.recordPrLinkage(linkage());
+
+		const trace = await broker.readTrace({ issue_id: 'issue-trace' });
+		expect(trace.pull_requests[0].iterations[0].gate_receipts).toEqual([GATE_RECEIPT]);
+	});
+
+	test('keeps an exact T1 replay idempotent after T2 rejection and renewed approval', async () => {
+		const packet = workPacket();
+		const opened = linkage('opened', packet, runReceipt(packet));
+		await broker.recordPrLinkage(opened);
+
+		await driver.insertKernelEvent({
+			entity_type: 'issue', entity_id: 'issue-trace', event_type: 'gate.rejected',
+			idempotency_key: 'gate.rejected:issue-trace:gate.merge:t2', expected_revision: 0,
+			actor: 'maintainer', origin: 'test', payload: { gate: GATE_ID, expires_at: null, generation: 1 },
+			created_at: '2026-08-11T00:10:00.000Z',
+		}, {}, config);
+		await broker.recordPrLinkage(opened);
+
+		const renewedReceipt = 'gate.approved:issue-trace:gate.merge:renewed';
+		await driver.insertKernelEvent({
+			entity_type: 'issue', entity_id: 'issue-trace', event_type: 'gate.approved',
+			idempotency_key: renewedReceipt, expected_revision: 0,
+			actor: 'maintainer', origin: 'test', payload: { gate: GATE_ID, expires_at: null, generation: 2 },
+			created_at: '2026-08-11T00:10:00.000Z',
+		}, {}, config);
+		await broker.recordPrLinkage(opened);
+		await broker.recordPrLinkage(linkage('merged', packet, runReceipt(packet, {}, 'merged'), {
+			occurred_at: '2026-08-11T00:10:00.000Z',
+		}));
+
+		const trace = await broker.readTrace({ issue_id: 'issue-trace' });
+		expect(trace.pull_requests[0].iterations.map(iteration => iteration.gate_receipts)).toEqual([
+			[GATE_RECEIPT],
+			[renewedReceipt],
+		]);
+		expect(await driver.queryAll("SELECT COUNT(*) AS n FROM kernel_events WHERE entity_type = 'pr';", config)).toEqual([{ n: 2 }]);
+	});
+
+	test('snapshots caller input before the first asynchronous driver boundary', async () => {
+		const input = linkage();
+		const resolvePrLinkage = driver.resolvePrLinkage;
+		driver.resolvePrLinkage = async (...args) => {
+			const result = await resolvePrLinkage(...args);
+			input.branch = 'codex/mutated-after-validation';
+			return result;
+		};
+
+		await broker.recordPrLinkage(input);
+
+		expect(await driver.queryAll('SELECT branch FROM kernel_pr;', config)).toEqual([{ branch }]);
+	});
+
 	test('requires the RunReceipt to attempt and authorize the exact linkage phase', async () => {
 		const packet = workPacket();
 		await expect(broker.recordPrLinkage(linkage('opened', packet, runReceipt(packet, {
