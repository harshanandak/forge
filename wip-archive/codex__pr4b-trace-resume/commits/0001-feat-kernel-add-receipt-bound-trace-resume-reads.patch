+const TRACE_FULL_HEAD = /^[0-9a-f]{40}$/;
+const TRACE_SHA256 = /^[0-9a-f]{64}$/;
+const TRACE_MAX_RECEIPT_BYTES = 1_048_576;
+const TRACE_MAX_RECEIPT_DEPTH = 64;
+const TRACE_MAX_RECEIPT_NODES = 100_000;
+const TRACE_MAX_ARTIFACT_BYTES = 65_536;
+const TRACE_MAX_GATES = 32;
+
+function traceError(code, message) {
+	const error = new Error(message);
+	error.code = code;
+	error.status = 'INCOMPLETE';
+	return error;
+}
+
+function assertBoundedReceiptValue(value, state = { ancestors: new WeakSet(), nodes: 0 }, depth = 0) {
+	state.nodes += 1;
+	if (state.nodes > TRACE_MAX_RECEIPT_NODES || depth > TRACE_MAX_RECEIPT_DEPTH) {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage receipt exceeds canonical bounds');
+	}
+	if (value === null || typeof value === 'string' || typeof value === 'boolean') return;
+	if (typeof value === 'number' && Number.isFinite(value)) return;
+	if (!value || typeof value !== 'object' || isProxy(value) || state.ancestors.has(value)) {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage receipt must be bounded plain JSON');
+	}
+	let descriptors;
+	let prototype;
+	try {
+		descriptors = Object.getOwnPropertyDescriptors(value);
+		prototype = Object.getPrototypeOf(value);
+	} catch {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage receipt must be bounded plain JSON');
+	}
+	const keys = Reflect.ownKeys(descriptors);
+	if (keys.some(key => typeof key !== 'string')) {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage receipt must not contain symbol keys');
+	}
+	state.ancestors.add(value);
+	try {
+		if (Array.isArray(value)) {
+			if (prototype !== Array.prototype || keys.length !== value.length + 1) {
+				throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage receipt arrays must be dense');
+			}
+			for (let index = 0; index < value.length; index += 1) {
+				const descriptor = descriptors[String(index)];
+				if (!descriptor?.enumerable || !Object.hasOwn(descriptor, 'value')) {
+					throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage receipt must not contain accessors');
+				}
+				assertBoundedReceiptValue(descriptor.value, state, depth + 1);
+			}
+			return;
+		}
+		if (prototype !== Object.prototype) {
+			throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage receipt objects must be plain');
+		}
+		for (const key of keys) {
+			const descriptor = descriptors[key];
+			if (!descriptor.enumerable || !Object.hasOwn(descriptor, 'value')) {
+				throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage receipt must not contain accessors');
+			}
+			assertBoundedReceiptValue(descriptor.value, state, depth + 1);
+		}
+	} finally {
+		state.ancestors.delete(value);
+	}
+}
+
+function receiptContentHash(receipt) {
+	const withoutHash = {};
+	for (const [key, value] of Object.entries(receipt)) {
+		if (key !== 'content_hash') withoutHash[key] = value;
+	}
+	const canonicalReceiptStringify = (value) => {
+		if (value === null || typeof value !== 'object') return JSON.stringify(value);
+		if (Array.isArray(value)) return `[${value.map(canonicalReceiptStringify).join(',')}]`;
+		return `{${Object.keys(value).sort()
+			.map(key => `${JSON.stringify(key)}:${canonicalReceiptStringify(value[key])}`)
+			.join(',')}}`;
+	};
+	const canonical = canonicalReceiptStringify(withoutHash);
+	if (Buffer.byteLength(canonical, 'utf8') > TRACE_MAX_RECEIPT_BYTES) {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage receipt exceeds byte bound');
+	}
+	return createHash('sha256').update(canonical, 'utf8').digest('hex');
+}
+
+function assertReceiptEnvelope(receipt, schemaId) {
+	assertBoundedReceiptValue(receipt);
+	if (!receipt || receipt.schema_id !== schemaId || receipt.schema_version !== 1
+		|| !TRACE_SHA256.test(receipt.content_hash)
+		|| receiptContentHash(receipt) !== receipt.content_hash
+		|| !receipt.payload || typeof receipt.payload !== 'object' || Array.isArray(receipt.payload)) {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', `recordPrLinkage requires a valid ${schemaId} receipt`);
+	}
+	return receipt;
+}
+
+function derivePrEvidence(input) {
+	const packet = assertReceiptEnvelope(input?.work_packet, 'forge.memory.work-packet.v1');
+	const receipt = assertReceiptEnvelope(input?.run_receipt, 'forge.memory.run-receipt.v1');
+	const packetPayload = packet.payload;
+	const receiptPayload = receipt.payload;
+	if (typeof packetPayload.issue_id !== 'string' || !packetPayload.issue_id
+		|| !Number.isInteger(packetPayload.expected_issue_revision) || packetPayload.expected_issue_revision < 0
+		|| packetPayload.authority?.issue_revision !== packetPayload.expected_issue_revision
+		|| !TRACE_FULL_HEAD.test(packetPayload.target_head)
+		|| !TRACE_SHA256.test(packetPayload.risk_manifest_digest)) {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage WorkPacket authority binding is incomplete');
+	}
+	const gateIds = packetPayload.receipt_requirements?.gate_ids;
+	if (!Array.isArray(gateIds) || gateIds.length === 0 || gateIds.length > TRACE_MAX_GATES
+		|| new Set(gateIds).size !== gateIds.length
+		|| gateIds.some(gateId => typeof gateId !== 'string' || gateId.length === 0 || gateId.length > 128)) {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage WorkPacket gate requirements are incomplete');
+	}
+	if (!Array.isArray(packetPayload.allowed_mutations)
+		|| !packetPayload.allowed_mutations.includes(`pr.${input.phase}`)) {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', `recordPrLinkage WorkPacket does not authorize pr.${input.phase}`);
+	}
+	if (receiptPayload.status !== 'PASS' || receiptPayload.validation?.status !== 'PASS') {
+		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage requires a PASS RunReceipt');
+	}
+	const bindingsMatch = receiptPayload.packet_hash === packet.content_hash
+		&& receiptPayload.exact_head === packetPayload.target_head
+		&& receiptPayload.packet_revision === packetPayload.packet_revision
+		&& receiptPayload.manifest_digest === packetPayload.capability_manifest_digest
+		&& receiptPayload.workflow_config_revision === packetPayload.workflow_config_revision;
+	if (!bindingsMatch) {
+		throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage WorkPacket and RunReceipt bindings conflict');
+	}
+	if (input.issue_id && input.issue_id !== packetPayload.issue_id) {
+		throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage explicit issue_id conflicts with WorkPacket authority');
+	}
+	return {
+		issue_id: packetPayload.issue_id,
+		issue_revision: packetPayload.expected_issue_revision,
+		head_sha: packetPayload.target_head,
+		work_packet_hash: packet.content_hash,
+		run_receipt_hash: receipt.content_hash,
+		risk_manifest_digest: packetPayload.risk_manifest_digest,
+		gate_ids: gateIds,
+	};
+}
+
+function parseTracePayload(row) {
+	try {
+		return JSON.parse(row?.payload_json || '{}');
+	} catch {
+		return {};
+	}
+}
+
+function resolveGateReceipts(events, gateIds, occurredAt) {
+	const gateEvents = new Map();
+	for (const event of events) {
+		if (!['gate.approved', 'gate.rejected'].includes(event.event_type)) continue;
+		const payload = parseTracePayload(event);
+		if (gateIds.includes(payload.gate)) gateEvents.set(payload.gate, { event, payload });
+	}
+	return gateIds.map(gateId => {
+		const latest = gateEvents.get(gateId);
+		const expiry = latest?.payload?.expires_at;
+		const active = latest?.event?.event_type === 'gate.approved'
+			&& (!expiry || (Number.isFinite(Date.parse(expiry)) && Date.parse(occurredAt) < Date.parse(expiry)));
+		if (!active || typeof latest.event.idempotency_key !== 'string' || !latest.event.idempotency_key) {
+			throw traceError('FORGE_TRACE_GATE_UNAVAILABLE', `recordPrLinkage gate ${gateId} lacks an active approval receipt`);
+		}
+		return latest.event.idempotency_key;
+	});
+}
+
+function readTraceArtifact(projectRoot, workFolder, filename) {
+	if (!workFolder) return { artifact: null, gap: filename.replace('.md', '') };
+	const root = fs.realpathSync(path.resolve(projectRoot));
+	const candidateFolder = path.resolve(root, workFolder);
+	if (!fs.existsSync(candidateFolder)) return { artifact: null, gap: filename.replace('.md', '') };
+	const folder = fs.realpathSync(candidateFolder);
+	const relativeFolder = path.relative(root, folder);
+	if (relativeFolder.startsWith('..') || path.isAbsolute(relativeFolder)) {
+		return { artifact: null, gap: `${filename.replace('.md', '')}:outside_project` };
+	}
+	const file = path.join(folder, filename);
+	if (!fs.existsSync(file) || !fs.statSync(file).isFile()) return { artifact: null, gap: filename.replace('.md', '') };
+	const resolvedFile = fs.realpathSync(file);
+	const relativeFile = path.relative(root, resolvedFile);
+	if (relativeFile.startsWith('..') || path.isAbsolute(relativeFile)) {
+		return { artifact: null, gap: `${filename.replace('.md', '')}:outside_project` };
+	}
+	if (fs.statSync(resolvedFile).size > TRACE_MAX_ARTIFACT_BYTES) {
+		return { artifact: null, gap: `${filename.replace('.md', '')}:oversized` };
+	}
+	return {
+		artifact: {
+			path: path.posix.join(String(workFolder).replaceAll('\\', '/'), filename),
+			content: fs.readFileSync(resolvedFile, 'utf8'),
+		},
+		gap: null,
+	};
+}
+
+function buildTraceEnvelope(projectRoot, target, rows) {
+	const artifactReads = Object.fromEntries(['plan', 'tasks', 'decisions'].map(name => (
+		[name, readTraceArtifact(projectRoot, rows.work_folder, `${name}.md`)]
+	)));
+	const artifacts = Object.fromEntries(Object.entries(artifactReads).map(([name, value]) => [name, value.artifact]));
+	const gaps = [];
+	if (!rows.issue) gaps.push('issue');
+	if (!rows.worktree) gaps.push('worktree');
+	if (!rows.work_folder) gaps.push('work_folder');
+	for (const name of ['plan', 'tasks', 'decisions']) if (artifactReads[name].gap) gaps.push(artifactReads[name].gap);
+	if (rows.pull_requests.length === 0) gaps.push('pull_requests');
+	for (const gap of rows.gaps || []) if (!gaps.includes(gap)) gaps.push(gap);
+	return {
+		schema_version: 'forge.trace.v1',
+		target: target.issue_id
+			? { kind: 'issue', id: target.issue_id }
+			: { kind: 'pr', number: Number(target.pr_number), repo: target.repo ?? null },
+		issue: rows.issue,
+		worktree: rows.worktree,
+		work_folder: rows.work_folder,
+		artifacts,
+		pull_requests: rows.pull_requests,
+		gaps,
+	};
+}
+
+function assertCompatiblePrEvidence(existingEvent, payload) {
+	if (!existingEvent || stableStringify(normalizePayload(existingEvent)) === stableStringify(payload)) return;
+	throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'INCOMPLETE: conflicting evidence for idempotency key');
+}
+
 // The migration ledger records which migration ids have been applied so initialize()
 // applies each migration AT MOST ONCE — no full re-run, no blanket duplicate-error
 // swallow. The ledger table is broker-managed bookkeeping (created before the plan is
@@ -1264,6 +1496,124 @@ function createLocalBroker(options = {}) {
 			return driver.upsertPr(row, context, getConfig());
 		},
 
+		async recordPrLinkage(input, context = {}) {
+			if (!input || !['opened', 'merged'].includes(input.phase)) {
+				throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage phase must be opened or merged');
+			}
+			for (const field of ['git_common_dir', 'repo', 'number']) {
+				if (input[field] === undefined || input[field] === null || input[field] === '') {
+					throw traceError('FORGE_TRACE_INVALID_RECEIPT', `recordPrLinkage requires ${field}`);
+				}
+			}
+			for (const method of ['resolvePrLinkage', 'upsertPr', 'retirePr', 'readTrace', 'loadKernelEventByIdempotencyKey']) {
+				requireDriverMethod(driver, method);
+			}
+			const evidence = derivePrEvidence(input);
+			const config = getConfig();
+			const inferred = await driver.resolvePrLinkage({ ...input, issue_id: evidence.issue_id }, context, config);
+			if (!inferred.issue_id || inferred.issue_revision === null) {
+				throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage requires resolved issue linkage');
+			}
+			if (inferred.inferred_issue_id && evidence.issue_id !== inferred.inferred_issue_id) {
+				throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage WorkPacket issue conflicts with inferred worktree issue');
+			}
+			if (evidence.issue_revision !== inferred.issue_revision) {
+				throw traceError(
+					'FORGE_TRACE_STALE_AUTHORITY',
+					`recordPrLinkage stale issue revision: expected ${evidence.issue_revision}, actual ${inferred.issue_revision}`,
+				);
+			}
+			const issueEvents = await driver.listKernelEvents('issue', evidence.issue_id, context, config);
+			const gateReceipts = resolveGateReceipts(
+				issueEvents,
+				evidence.gate_ids,
+				input.occurred_at || new Date().toISOString(),
+			);
+			const priorRows = await driver.readTrace({
+				pr_number: input.number,
+				repo: input.repo,
+				git_common_dir: input.git_common_dir,
+			}, context, config);
+			const priorPr = priorRows.pull_requests.find(candidate => (
+				candidate.git_common_dir === input.git_common_dir
+				&& candidate.repo === input.repo
+				&& Number(candidate.number) === Number(input.number)
+			)) || null;
+			const worktreeId = input.worktree_id ?? inferred.worktree_id ?? priorPr?.worktree_id ?? null;
+			const eventType = `pr.${input.phase}`;
+			const payload = {
+				issue_id: evidence.issue_id,
+				issue_revision: evidence.issue_revision,
+				worktree_id: worktreeId,
+				repo: input.repo,
+				number: input.number,
+				url: input.url ?? null,
+				head_sha: evidence.head_sha,
+				work_packet_hash: evidence.work_packet_hash,
+				run_receipt_hash: evidence.run_receipt_hash,
+				risk_manifest_digest: evidence.risk_manifest_digest,
+				gate_receipts: gateReceipts,
+			};
+
+			const terminalPr = priorPr && ['merged', 'closed'].includes(priorPr.state) ? priorPr : null;
+			if (terminalPr) {
+				const conflicts = evidence.head_sha !== priorPr.head_sha
+					|| (input.branch != null && input.branch !== priorPr.branch)
+					|| evidence.issue_id !== priorPr.issue_id
+					|| (worktreeId != null && worktreeId !== priorPr.worktree_id)
+					|| (input.journal_ptr != null && input.journal_ptr !== priorPr.journal_ptr);
+				if (conflicts) throw traceError('FORGE_TRACE_TERMINAL_CONFLICT', 'recordPrLinkage terminal PR linkage conflict');
+			}
+
+			const existingEventKey = priorPr ? `${eventType}:${priorPr.id}:${evidence.head_sha}` : null;
+			const existingEvent = existingEventKey
+				? await driver.loadKernelEventByIdempotencyKey(existingEventKey, context, config)
+				: null;
+			assertCompatiblePrEvidence(existingEvent, payload);
+			if (terminalPr && !existingEvent) {
+				throw traceError('FORGE_TRACE_TERMINAL_CONFLICT', 'recordPrLinkage terminal PR linkage conflict');
+			}
+
+			const linked = terminalPr
+				? { ok: true, ...terminalPr }
+				: await driver.upsertPr({
+					...input,
+					head_sha: evidence.head_sha,
+					issue_id: evidence.issue_id,
+					worktree_id: worktreeId,
+					registered_at: input.occurred_at,
+				}, context, config);
+			const event = await runGuardedEventImpl({
+				entity_type: 'pr',
+				entity_id: linked.id,
+				event_type: eventType,
+				idempotency_key: `${eventType}:${linked.id}:${evidence.head_sha}`,
+				expected_revision: 0,
+				actor: context.actor || 'forge',
+				origin: context.origin || 'cli',
+				created_at: input.occurred_at || new Date().toISOString(),
+				payload,
+			}, context);
+			assertCompatiblePrEvidence(event.originalEvent, payload);
+			if (input.phase === 'merged' && !terminalPr) {
+				await driver.retirePr({
+					git_common_dir: linked.git_common_dir,
+					repo: linked.repo,
+					number: linked.number,
+				}, { state: 'merged', retired_at: input.occurred_at }, context, config);
+			}
+			return { link: linked, iteration: event };
+		},
+
+		async readTrace(target, context = {}) {
+			if (!target || (!target.issue_id && target.pr_number === undefined)) {
+				throw new Error('readTrace requires issue_id or pr_number');
+			}
+			requireDriverMethod(driver, 'readTrace');
+			const config = getConfig();
+			return buildTraceEnvelope(config.projectRoot, target, await driver.readTrace(target, context, config));
+		},
+
 		async updatePrVerdict(key, patch = {}, context = {}) {
 			requireDriverMethod(driver, 'updatePrVerdict');
 			return driver.updatePrVerdict(key, patch, context, getConfig());
diff --git a/lib/kernel/sqlite-driver.js b/lib/kernel/sqlite-driver.js
index c517746f..d5bb979a 100644
--- a/lib/kernel/sqlite-driver.js
+++ b/lib/kernel/sqlite-driver.js
@@ -1316,6 +1316,140 @@ function listWorktreeRows(runtime, db, filter = {}) {
 	return safeAll(runtime, db, 'SELECT * FROM kernel_worktrees ORDER BY registered_at DESC');
 }
 
+const TRACE_MAX_PULL_REQUESTS = 128;
+const TRACE_MAX_ITERATIONS = 128;
+
+function resolvePrLinkageRow(runtime, db, input = {}) {
+	let worktree = null;
+	if (input.worktree_id) {
+		worktree = safeAll(runtime, db, 'SELECT * FROM kernel_worktrees WHERE id = ? LIMIT 1', [input.worktree_id])[0] || null;
+	} else if (input.branch && input.git_common_dir) {
+		worktree = safeAll(
+			runtime,
+			db,
+			`SELECT * FROM kernel_worktrees
+			 WHERE git_common_dir = ? AND branch = ? AND state = 'active'
+			 ORDER BY registered_at DESC LIMIT 1`,
+			[input.git_common_dir, input.branch],
+		)[0] || null;
+	}
+	const inferredIssueId = worktree?.issue_id ?? null;
+	const issueId = input.issue_id ?? inferredIssueId;
+	const issue = issueId
+		? safeAll(runtime, db, 'SELECT id, entity_revision FROM kernel_issues WHERE id = ? LIMIT 1', [issueId])[0] || null
+		: null;
+	return {
+		issue_id: issueId,
+		inferred_issue_id: inferredIssueId,
+		issue_revision: issue?.entity_revision ?? null,
+		worktree_id: input.worktree_id ?? worktree?.id ?? null,
+	};
+}
+
+function parseTraceEvent(row) {
+	let payload;
+	try {
+		payload = JSON.parse(row.payload_json || '{}');
+	} catch {
+		payload = {};
+	}
+	return {
+		id: row.id,
+		type: row.event_type,
+		at: row.created_at,
+		issue_revision: payload.issue_revision ?? null,
+		head_sha: payload.head_sha ?? null,
+		work_packet_hash: payload.work_packet_hash ?? null,
+		run_receipt_hash: payload.run_receipt_hash ?? null,
+		risk_manifest_digest: payload.risk_manifest_digest ?? null,
+		gate_receipts: payload.gate_receipts ?? null,
+		url: payload.url ?? null,
+	};
+}
+
+function loadTraceRows(runtime, db, target = {}) {
+	const gaps = [];
+	let selectedPr = null;
+	if (target.pr_number !== undefined && target.pr_number !== null) {
+		const clauses = ['number = ?'];
+		const params = [Number(target.pr_number)];
+		if (target.repo) {
+			clauses.push('repo = ?');
+			params.push(target.repo);
+		}
+		if (target.git_common_dir) {
+			clauses.push('git_common_dir = ?');
+			params.push(target.git_common_dir);
+		}
+		const matches = safeAll(
+			runtime,
+			db,
+			`SELECT * FROM kernel_pr WHERE ${clauses.join(' AND ')} ORDER BY registered_at DESC LIMIT 2`,
+			params,
+		);
+		if (matches.length > 1) throw new Error('Kernel trace PR target is ambiguous; supply repo and git_common_dir');
+		selectedPr = matches[0] || null;
+	}
+
+	const issueId = target.issue_id ?? selectedPr?.issue_id ?? null;
+	const issue = issueId
+		? safeAll(runtime, db, 'SELECT * FROM kernel_issues WHERE id = ? LIMIT 1', [issueId])[0] || null
+		: null;
+	let pullRequests = issue
+		? safeAll(
+			runtime,
+			db,
+			' SELECT * FROM kernel_pr WHERE issue_id = ? ORDER BY registered_at ASC, number ASC LIMIT ?',
+			[issue.id, TRACE_MAX_PULL_REQUESTS + 1],
+		)
+		: [];
+	if (pullRequests.length > TRACE_MAX_PULL_REQUESTS) {
+		pullRequests = pullRequests.slice(0, TRACE_MAX_PULL_REQUESTS);
+		gaps.push('pull_requests:overflow');
+	}
+	if (selectedPr && !pullRequests.some(row => row.id === selectedPr.id)) pullRequests = [selectedPr];
+
+	let worktree = null;
+	const preferredWorktreeId = selectedPr?.worktree_id || pullRequests.find(row => row.worktree_id)?.worktree_id;
+	if (preferredWorktreeId) {
+		worktree = safeAll(runtime, db, 'SELECT * FROM kernel_worktrees WHERE id = ? LIMIT 1', [preferredWorktreeId])[0] || null;
+	}
+	if (!worktree && issue) {
+		worktree = safeAll(
+			runtime,
+			db,
+			`SELECT * FROM kernel_worktrees WHERE issue_id = ?
+			 ORDER BY CASE state WHEN 'active' THEN 0 ELSE 1 END, registered_at DESC LIMIT 1`,
+			[issue.id],
+		)[0] || null;
+	}
