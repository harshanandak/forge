+function isNewerGateCandidate(candidate, current) {
+	return !current || candidate.eventAtMs > current.eventAtMs
+		|| (candidate.eventAtMs === current.eventAtMs && candidate.order > current.order);
+}
+
 function resolveGateReceipts(events, gateIds, occurredAt) {
 	const occurredAtMs = Date.parse(occurredAt);
 	if (!Number.isFinite(occurredAtMs)) {
 		throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordPrLinkage occurred_at must be a valid timestamp');
 	}
 	const gateEvents = new Map();
-	for (const event of events) {
+	for (const [order, event] of events.entries()) {
 		if (!['gate.approved', 'gate.rejected'].includes(event.event_type)) continue;
 		const eventAtMs = Date.parse(event.created_at);
 		if (!Number.isFinite(eventAtMs) || eventAtMs > occurredAtMs) continue;
 		const payload = parseTracePayload(event);
-		if (gateIds.includes(payload.gate)) gateEvents.set(payload.gate, { event, payload });
+		const candidate = { event, payload, eventAtMs, order };
+		if (gateIds.includes(payload.gate) && isNewerGateCandidate(candidate, gateEvents.get(payload.gate))) {
+			// listKernelEvents supplies rowid order for equal timestamps; later rows win explicitly.
+			gateEvents.set(payload.gate, candidate);
+		}
 	}
 	return gateIds.map(gateId => {
 		const latest = gateEvents.get(gateId);
diff --git a/lib/kernel/sqlite-driver.js b/lib/kernel/sqlite-driver.js
index f0b69a92..3c74e8f3 100644
--- a/lib/kernel/sqlite-driver.js
+++ b/lib/kernel/sqlite-driver.js
@@ -1438,6 +1438,20 @@ function loadSelectedTracePr(runtime, db, target) {
 	return matches[0] || null;
 }
 
+function appendSelectedTracePr(pullRequests, selectedPr, issueId, gaps) {
+	if (!selectedPr || pullRequests.some(row => row.id === selectedPr.id)) return pullRequests;
+	if (issueId && selectedPr.issue_id !== issueId) {
+		gaps.push(`pull_requests:${selectedPr.id}:unlinked_issue`);
+	}
+	const retained = pullRequests.length >= TRACE_MAX_PULL_REQUESTS
+		? pullRequests.slice(0, TRACE_MAX_PULL_REQUESTS - 1)
+		: pullRequests;
+	if (retained.length < pullRequests.length && !gaps.includes('pull_requests:overflow')) {
+		gaps.push('pull_requests:overflow');
+	}
+	return [...retained, selectedPr];
+}
+
 function loadTraceRows(runtime, db, target = {}) {
 	const gaps = [];
 	const selectedPr = loadSelectedTracePr(runtime, db, target);
@@ -1458,7 +1472,7 @@ function loadTraceRows(runtime, db, target = {}) {
 		pullRequests = pullRequests.slice(0, TRACE_MAX_PULL_REQUESTS);
 		gaps.push('pull_requests:overflow');
 	}
-	if (selectedPr && !pullRequests.some(row => row.id === selectedPr.id)) pullRequests = [selectedPr];
+	pullRequests = appendSelectedTracePr(pullRequests, selectedPr, issueId, gaps);
 
 	let worktree = null;
 	const preferredWorktreeId = selectedPr?.worktree_id || pullRequests.find(row => row.worktree_id)?.worktree_id;
