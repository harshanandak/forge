diff --git a/lib/shell-utils.js b/lib/shell-utils.js
index 73322ed7..6efd3cd2 100644
--- a/lib/shell-utils.js
+++ b/lib/shell-utils.js
@@ -100,7 +100,12 @@ function secureExecFileSync(command, args = [], options = {}) {
     const spec = resolveWindowsSpawnSpec(command, candidates);
     if (spec.shell) {
       assertShellSafeTokens(command, args);
-      return _execFileSync(command, args, { ...execOptions, shell: true });
+      // Node 22 (DEP0190) deprecates passing an args array together with shell:true.
+      // assertShellSafeTokens has already guaranteed every token is free of shell
+      // metacharacters, so fold them into a single command line and pass no args array —
+      // identical execution through cmd.exe (npm.cmd/npx.cmd shims), no deprecation warning.
+      const commandLine = [command, ...args].join(' ');
+      return _execFileSync(commandLine, [], { ...execOptions, shell: true });
     }
     return _execFileSync(spec.file, args, execOptions);
   }
