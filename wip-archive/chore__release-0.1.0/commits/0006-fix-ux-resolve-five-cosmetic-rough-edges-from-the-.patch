diff --git a/lib/issue-render.js b/lib/issue-render.js
index d1e32741..e402685b 100644
--- a/lib/issue-render.js
+++ b/lib/issue-render.js
@@ -146,8 +146,42 @@ function renderIssueShow(envelope) {
   return lines.join('\n');
 }
 
-// Dispatch a human rendering for one read subcommand's success envelope.
+// Write subcommands → the past-tense verb used in their confirmation line.
+const MUTATION_VERBS = {
+  create: 'Created',
+  update: 'Updated',
+  claim: 'Claimed',
+  release: 'Released',
+  comment: 'Commented on',
+  close: 'Closed',
+};
+
+// Concise, human-first confirmation for a write. Mutations used to dump the raw
+// contract JSON (schema_version/revision/next_commands) while reads rendered as text.
+function renderIssueMutation(subcommand, envelope) {
+  const issue = envelope && envelope.data && typeof envelope.data === 'object' ? envelope.data : {};
+  const verb = MUTATION_VERBS[subcommand] || 'Updated';
+  const id = issue.id ? String(issue.id) : '(issue)';
+  let headline = `✓ ${verb} ${id}`;
+  if (typeof issue.title === 'string' && issue.title.trim() !== '') {
+    headline += `  ${issue.title.trim()}`;
+  }
+  if (issue.status) {
+    headline += `  [${issue.status}]`;
+  }
+  const lines = [headline];
+  const verification = verificationLines(envelope);
+  if (verification.length > 0) {
+    lines.push(...verification);
+  }
+  return lines.join('\n');
+}
+
+// Dispatch a human rendering for one subcommand's success envelope.
 function renderIssueEnvelope(subcommand, envelope) {
+  if (MUTATION_VERBS[subcommand]) {
+    return renderIssueMutation(subcommand, envelope);
+  }
   if (subcommand === 'show') {
     return renderIssueShow(envelope);
   }
@@ -160,5 +194,6 @@ module.exports = {
   shortId,
   renderIssueList,
   renderIssueShow,
+  renderIssueMutation,
   renderIssueEnvelope,
 };
