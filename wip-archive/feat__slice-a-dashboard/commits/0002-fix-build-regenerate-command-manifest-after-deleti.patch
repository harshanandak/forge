From b540a13f63b624059648b2cabf81053242e8969f Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Wed, 22 Jul 2026 18:17:29 +0530
Subject: [PATCH] fix(build): regenerate command manifest after deleting
 board.js
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The static command manifest (lib/commands/_manifest.js, generated by
scripts/gen-command-manifest.js, drift-gated) still require()'d ./board — broke
'bun build --compile' (Could not resolve ./board) + the manifest-drift test on
CI, though the dev registry auto-discovery masked it locally. Regenerated:
61 commands, board removed. Deleting a command must regenerate this manifest.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 lib/commands/_manifest.js | 1 -
 1 file changed, 1 deletion(-)

diff --git a/lib/commands/_manifest.js b/lib/commands/_manifest.js
index 3663c45e..62595c38 100644
--- a/lib/commands/_manifest.js
+++ b/lib/commands/_manifest.js
@@ -26,7 +26,6 @@ const commands = [
   { file: "add.js", module: require("./add") },
   { file: "audit.js", module: require("./audit") },
   { file: "blocked.js", module: require("./blocked") },
-  { file: "board.js", module: require("./board") },
   { file: "claim.js", module: require("./claim") },
   { file: "claims.js", module: require("./claims") },
   { file: "clean.js", module: require("./clean") },
-- 
2.51.0.windows.1

