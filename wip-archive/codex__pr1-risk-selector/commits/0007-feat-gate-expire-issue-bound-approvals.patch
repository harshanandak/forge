+function evaluateGateApproval(events, gateId, now = new Date().toISOString()) {
+  const decisions = events.filter(event => event.gate === gateId);
+  const event = decisions.at(-1);
+  if (!event || event.event_type !== GATE_APPROVED_EVENT) return { approved: false, event };
+  if (!event.expires_at) return { approved: true, event };
+  const nowMillis = Date.parse(now);
+  const expiryMillis = Date.parse(event.expires_at);
+  return {
+    approved: Number.isFinite(nowMillis) && Number.isFinite(expiryMillis) && nowMillis < expiryMillis,
+    event,
+  };
+}
+
