-    return `${label} ${event.gate} by ${event.actor} at ${event.created_at}${reason}`;
+    return `${label} ${event.gate} for ${event.issue_id} (${event.control_id}) by ${event.actor} at ${event.issued_at}; expires ${event.expires_at || 'never'}${reason}`;
