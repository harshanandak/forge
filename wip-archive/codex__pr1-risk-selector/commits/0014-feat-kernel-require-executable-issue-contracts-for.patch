diff --git a/lib/issue-render.js b/lib/issue-render.js
index 1bacb07d..319cf6f8 100644
--- a/lib/issue-render.js
+++ b/lib/issue-render.js
@@ -114,6 +114,12 @@ function pushSection(lines, label, text) {
   lines.push('', `${label}:`, text);
 }
 
+function renderReadinessReason(reason) {
+	if (!reason || typeof reason !== 'object') return String(reason ?? 'unknown');
+	const detail = reason.field || reason.issue_id || reason.gate || reason.actor || reason.status;
+	return detail ? `${reason.code} (${detail})` : String(reason.code || 'unknown');
+}
+
 // forge show: the full detail view. This is the surface that prints the FULL id
 // (list/ready show only the 8-char prefix), so every field a script or human
 // needs to act on the issue is reachable without --json.
@@ -135,6 +141,12 @@ function renderIssueShow(envelope) {
   pushField(lines, 'Claimed by', issue.claimed_by);
   pushField(lines, 'Parent', shortId(issue.parent_id ?? null) || null);
   pushField(lines, 'Blocked by', Array.isArray(issue.blocked_by) ? issue.blocked_by.map(shortId) : null);
+	pushField(lines, 'Readiness', issue.readiness_state);
+	pushField(
+		lines,
+		'Readiness reasons',
+		Array.isArray(issue.readiness_reasons) ? issue.readiness_reasons.map(renderReadinessReason) : null,
+	);
   pushField(lines, 'Dependencies', Array.isArray(issue.dependencies) ? issue.dependencies.map(shortId) : null);
   pushField(lines, 'Dependents', Array.isArray(issue.dependents) ? issue.dependents.map(shortId) : null);
   pushField(lines, 'Created', issue.created_at);
diff --git a/lib/kernel/readiness-model.js b/lib/kernel/readiness-model.js
index c9b7d305..9ad7d526 100644
--- a/lib/kernel/readiness-model.js
+++ b/lib/kernel/readiness-model.js
@@ -18,6 +18,10 @@ const READINESS_REASONS = Object.freeze({
 	CLAIM: 'claimed',
 	DEFERRED: 'deferred',
 	POLICY: 'policy_disabled',
+	CONTRACT_MISSING: 'contract_missing',
+	CONTRACT_INVALID: 'contract_invalid',
+	CONTRACT_MISMATCH: 'contract_mismatch',
+	CONTRACT_ADOPTION_REQUIRED: 'contract_adoption_required',
 });
 
 const READINESS_STATES = Object.freeze([
@@ -129,6 +133,92 @@ function collectGateBlockers(context, reasons) {
 	return hasGate;
 }
 
+function nonEmptyText(value) {
+	if (typeof value === 'string') return value.trim() !== '';
+	return Array.isArray(value)
+		&& value.length > 0
+		&& value.every(item => typeof item === 'string' && item.trim() !== '');
+}
+
+function parseMetadata(issue) {
+	if (!issue || issue.metadata == null) return {};
+	if (issue.metadata && typeof issue.metadata === 'object' && !Array.isArray(issue.metadata)) {
+		return issue.metadata;
+	}
+	if (typeof issue.metadata !== 'string' || issue.metadata.trim() === '') return {};
+	try {
+		const parsed = JSON.parse(issue.metadata);
+		return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
+	} catch {
+		return {};
+	}
+}
+
+function getIssueContract(issue) {
+	if (issue && issue.contract && typeof issue.contract === 'object' && !Array.isArray(issue.contract)) {
+		return { contract: issue.contract, versioned: false };
+	}
+	const metadata = parseMetadata(issue);
+	const contract = metadata['forge.contract'];
+	return {
+		contract: contract && typeof contract === 'object' && !Array.isArray(contract) ? contract : {},
+		versioned: Boolean(contract),
+		metadata,
+	};
+}
+
+function normalizeIds(ids) {
+	return [...new Set((Array.isArray(ids) ? ids : []).map(String))]
+		.sort((left, right) => left.localeCompare(right));
+}
+
+/**
+ * Validate only the presence, shape, and authority agreement of an issue contract.
+ * The policy deliberately does not score prose, dictate reasoning, or require headings.
+ */
+function evaluateIssueContract(issue = {}, policy = {}, context = {}) {
+	const workClasses = Array.isArray(policy.workClasses) ? policy.workClasses : [];
+	const applicable = policy.enabled === true && workClasses.includes(issue.type);
+	if (!applicable) return { applicable: false, valid: true, reasons: [] };
+
+	const { contract, versioned, metadata = parseMetadata(issue) } = getIssueContract(issue);
+	const reasons = [];
+	if (!nonEmptyText(issue.body)) reasons.push({ code: READINESS_REASONS.CONTRACT_MISSING, field: 'purpose' });
+	if (!nonEmptyText(issue.acceptance_criteria)) {
+		reasons.push({ code: READINESS_REASONS.CONTRACT_MISSING, field: 'acceptance_criteria' });
+	}
+	if (!nonEmptyText(contract.risk)) reasons.push({ code: READINESS_REASONS.CONTRACT_MISSING, field: 'risk' });
+	if (!Array.isArray(contract.dependencies)) {
+		reasons.push({ code: READINESS_REASONS.CONTRACT_MISSING, field: 'dependencies' });
+	}
+	if (!nonEmptyText(contract.out_of_scope)) {
+		reasons.push({ code: READINESS_REASONS.CONTRACT_MISSING, field: 'out_of_scope' });
+	}
+	if (versioned && contract.version !== 1) {
+		reasons.push({ code: READINESS_REASONS.CONTRACT_INVALID, field: 'version', expected: 1 });
+	}
+
+	if (Array.isArray(contract.dependencies) && Array.isArray(context.dependencyIds)) {
+		const declared = normalizeIds(contract.dependencies);
+		const expected = normalizeIds(context.dependencyIds);
+		if (JSON.stringify(declared) !== JSON.stringify(expected)) {
+			reasons.push({
+				code: READINESS_REASONS.CONTRACT_MISMATCH,
+				field: 'dependencies',
+				expected,
+				declared,
+			});
+		}
+	}
+
+	const origin = issue.origin ?? metadata.origin ?? metadata.source;
+	if (['import', 'imported', 'fork', 'fork_pr'].includes(origin) && !nonEmptyText(contract.adopted_by)) {
+		reasons.push({ code: READINESS_REASONS.CONTRACT_ADOPTION_REQUIRED });
+	}
+
+	return { applicable: true, valid: reasons.length === 0, reasons };
+}
+
 // Precedence high→low. `blocked` (dependencies/quarantine/conflict) always outranks the
 // softer not-ready reasons; consumers picking next work should read the full reasons[]
 // because a claim hidden behind a defer window is not reflected in this single summary.
@@ -165,6 +255,10 @@ function deriveReadiness(issue = {}, context = {}) {
 
 	const reasons = [];
 	const blockedBy = [];
+	const contract = evaluateIssueContract(issue, context.contractPolicy, {
+		dependencyIds: context.dependencyIds,
+	});
+	reasons.push(...contract.reasons);
 
 	collectDependencyBlockers(context, reasons, blockedBy);
 	const hasConflict = collectConflictBlockers(issue, context, reasons);
@@ -191,6 +285,7 @@ function deriveReadiness(issue = {}, context = {}) {
 		&& !deferred
 		&& !policyDisabled
 		&& !conflictingClaim
+		&& contract.valid
 		&& isWorkableStatus(status)
 		&& isReadyEligibleType(issue.type);
 
@@ -203,7 +298,16 @@ function deriveReadiness(issue = {}, context = {}) {
 		ready,
 	});
 
-	return { id, status, ready, blocked, blocked_by: blockedBy, reasons, state };
+	return {
+		id,
+		status,
+		ready,
+		blocked,
+		blocked_by: blockedBy,
+		reasons,
+		state,
+		contract_applicable: contract.applicable,
+	};
 }
 
 // BETA stop-gap for claim thundering-herd (kernel 369c43d7): concurrent `forge ready`
@@ -302,6 +406,8 @@ function buildReadinessIndex(input = {}) {
 			claims: claimsByIssue.get(issue.id) || [],
 			gates: gatesByIssue.get(issue.id) || [],
 			policyDisabled: policyDisabledIds.has(issue.id),
+			contractPolicy: input.contractPolicy,
+			dependencyIds: (dependencyStatusesByIssue.get(issue.id) || []).map(dependency => dependency.id),
 		});
 	}
 
@@ -325,5 +431,6 @@ module.exports = {
 	DEFAULT_TOP_K_READY_PICK,
 	buildReadinessIndex,
 	deriveReadiness,
+	evaluateIssueContract,
 	isWorkableStatus,
 };
