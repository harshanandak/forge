+function isPlainJsonObject(value) {
+	if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
+	const prototype = Object.getPrototypeOf(value);
+	return prototype === Object.prototype || prototype === null;
+}
+
+function ownDataProperty(object, key) {
+	if (!isPlainJsonObject(object)) return undefined;
+	const descriptor = Object.getOwnPropertyDescriptor(object, key);
+	return descriptor && Object.prototype.hasOwnProperty.call(descriptor, 'value')
+		? descriptor.value
+		: undefined;
+}
+
 function parseMetadata(issue) {
-	if (!issue || issue.metadata == null) return {};
-	if (issue.metadata && typeof issue.metadata === 'object' && !Array.isArray(issue.metadata)) {
-		return issue.metadata;
