 function resolveIssueContractPolicy(projectRoot, deps = {}) {
 	const loadConfig = deps.loadRuntimeGraphConfig || loadRuntimeGraphConfig;
 	const loaded = loadConfig({ projectRoot });
+	const fail = message => {
+		const error = new Error(`FORGE_ISSUE_CONTRACT_CONFIG_INVALID: ${message}`);
+		error.code = 'FORGE_ISSUE_CONTRACT_CONFIG_INVALID';
+		throw error;
+	};
+	if (Array.isArray(loaded?.errors) && loaded.errors.length > 0) {
+		fail(loaded.errors.map(error => error.message || error.code || String(error)).join('; '));
+	}
 	const configured = loaded?.config?.issues?.readiness?.contracts;
-	if (!configured || typeof configured !== 'object' || Array.isArray(configured)) return null;
+	if (configured == null) return null;
+	if (!configured || typeof configured !== 'object' || Array.isArray(configured)) {
+		fail('issues.readiness.contracts must be an object');
+	}
+	if (configured.enabled !== undefined && typeof configured.enabled !== 'boolean') {
+		fail('issues.readiness.contracts.enabled must be a boolean');
+	}
+	if (configured.enabled !== true) return { enabled: false, workClasses: [] };
+	const allowedKeys = new Set(['enabled', 'workClasses']);
+	const unknownKeys = Object.keys(configured).filter(key => !allowedKeys.has(key));
+	if (unknownKeys.length > 0) {
+		fail(`unknown issues.readiness.contracts keys: ${unknownKeys.sort().join(', ')}`);
+	}
+	if (!Array.isArray(configured.workClasses) || configured.workClasses.length === 0) {
+		fail('issues.readiness.contracts.workClasses must be a non-empty array');
+	}
+	const allowedClasses = new Set(ISSUE_TYPES);
+	if (configured.workClasses.some(value => typeof value !== 'string' || !allowedClasses.has(value))) {
+		fail('issues.readiness.contracts.workClasses contains an unknown work class');
+	}
 	return {
-		enabled: configured.enabled === true,
-		workClasses: Array.isArray(configured.workClasses)
-			? configured.workClasses.filter(value => typeof value === 'string' && value.trim() !== '')
-			: [],
-		trustedAdopters: Array.isArray(configured.trustedAdopters)
-			? [...new Set(configured.trustedAdopters
-				.filter(value => typeof value === 'string' && value.trim() !== '')
-				.map(value => value.trim()))]
-			: [],
+		enabled: true,
+		workClasses: [...new Set(configured.workClasses)],
 	};
 }
 
