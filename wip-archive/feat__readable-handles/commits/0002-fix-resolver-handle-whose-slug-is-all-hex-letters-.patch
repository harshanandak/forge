From eb16a697d2b1447df7afe0605326a3a462df7d7d Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Thu, 9 Jul 2026 10:59:50 +0530
Subject: [PATCH] fix(resolver): handle whose slug is all hex letters still
 resolves (CodeRabbit #335)

A title like 'Facade decade fee add' makes a handle (facade-decade-fee-add-1a2b3c4d) that
matches the broad HEX_PREFIX_PATTERN, so the handle-extraction branch never ran and
forge show <handle> missed. Extract resolveHexToken() and, when the whole hex-ish token
resolves to nothing, retry with its trailing 8-hex short id. Partial dashed UUID prefixes
(no 8-hex suffix) and legacy/imported ids are unaffected. Adds regression tests.
---
 lib/kernel/issue-id-resolver.js       | 70 ++++++++++++++++-----------
 test/kernel/issue-id-resolver.test.js | 14 ++++++
 2 files changed, 56 insertions(+), 28 deletions(-)

diff --git a/lib/kernel/issue-id-resolver.js b/lib/kernel/issue-id-resolver.js
index 3a1eb095..6ce59837 100644
--- a/lib/kernel/issue-id-resolver.js
+++ b/lib/kernel/issue-id-resolver.js
@@ -91,33 +91,14 @@ function ambiguousError(token, candidates) {
 // which guarantees an exact match (shortest id sharing the prefix) sorts first
 // and is never pushed out by the limit. Returns { id } on success (possibly the
 // untouched input) or { error: { code, message, exitCode, details } }.
-async function resolveIssueId(token, lookup) {
-	if (typeof token !== 'string' || token.length === 0) return { id: token };
-	if (FULL_UUID_PATTERN.test(token)) return { id: token };
-
-	// A non-hex token is either a legacy/imported id (must pass through so the store
-	// resolves it exactly) or a human display handle `<title-slug>-<short-id>` (kernel
-	// 1db53c60). Only the handle form is rewritten to its trailing short-id — and only
-	// after confirming the whole token is not itself a stored id, so `forge-abc123`-style
-	// imported ids keep resolving exactly.
-	let ref = token;
-	if (!HEX_PREFIX_PATTERN.test(token) && !SHORT_HEX_PATTERN.test(token)) {
-		// The display handle's short-id is always the 8-char UUID prefix (shortId), so a
-		// handle ends in >= 8 trailing hex. Requiring 8+ (not 6+) keeps short legacy/Beads
-		// suffixes like `forge-2a3bc9` a plain passthrough with no lookup.
-		const handle = /-([0-9a-f]{8,})$/i.exec(token);
-		if (!handle) return { id: token };
-		const whole = (await lookup(token.toLowerCase(), 2)) || [];
-		const wholeExact = whole.find(
-			candidate => candidate && typeof candidate.id === 'string' && candidate.id.toLowerCase() === token.toLowerCase(),
-		);
-		if (wholeExact) return { id: wholeExact.id };
-		ref = handle[1];
-	}
-
+// Resolve a hex ref (prefix >= 6, or short hex < 6) against the store. Returns { id } —
+// the resolved full id, or `ref` untouched when nothing matches — or an { error } for the
+// too-short / ambiguous cases. `reportToken` is what user-facing errors name (the original
+// input the caller typed, which may be a handle rather than the bare hex).
+async function resolveHexToken(ref, lookup, reportToken = ref) {
 	const isPrefix = HEX_PREFIX_PATTERN.test(ref);
 	const isShortHex = !isPrefix && SHORT_HEX_PATTERN.test(ref);
-	if (!isPrefix && !isShortHex) return { id: token };
+	if (!isPrefix && !isShortHex) return { id: ref };
 
 	const needle = ref.toLowerCase();
 	const candidates = (await lookup(needle, MAX_AMBIGUOUS_CANDIDATES + 1)) || [];
@@ -125,10 +106,43 @@ async function resolveIssueId(token, lookup) {
 		candidate => candidate && typeof candidate.id === 'string' && candidate.id.toLowerCase() === needle,
 	);
 	if (exact) return { id: exact.id };
-	if (isShortHex) return tooShortError(token);
-	if (candidates.length === 0) return { id: token };
+	if (isShortHex) return tooShortError(reportToken);
+	if (candidates.length === 0) return { id: ref };
 	if (candidates.length === 1) return { id: candidates[0].id };
-	return ambiguousError(token, candidates);
+	return ambiguousError(reportToken, candidates);
+}
+
+async function resolveIssueId(token, lookup) {
+	if (typeof token !== 'string' || token.length === 0) return { id: token };
+	if (FULL_UUID_PATTERN.test(token)) return { id: token };
+
+	// A display handle is `<title-slug>-<short-id>` (kernel 1db53c60); its short-id is the
+	// 8-char UUID prefix, so a handle ends in >= 8 trailing hex. Short legacy/Beads suffixes
+	// (`forge-2a3bc9`, 6 hex) are NOT handles and pass through untouched.
+	const handleSuffix = (/-([0-9a-f]{8,})$/i.exec(token) || [])[1] || null;
+
+	if (HEX_PREFIX_PATTERN.test(token) || SHORT_HEX_PATTERN.test(token)) {
+		const direct = await resolveHexToken(token, lookup);
+		// A handle whose slug is all hex letters (e.g. `facade-decade-fee-add-1a2b3c4d`) also
+		// matches the broad hex-prefix pattern; when the whole token matches nothing, retry
+		// with its trailing short-id so the handle still resolves (CodeRabbit, PR #335).
+		if (direct.id === token && handleSuffix && handleSuffix !== token) {
+			const viaHandle = await resolveHexToken(handleSuffix, lookup, token);
+			if (viaHandle.error || viaHandle.id !== handleSuffix) return viaHandle;
+		}
+		return direct;
+	}
+
+	// Non-hex token: a legacy/imported id (pass through so the store resolves it exactly),
+	// or a display handle. Prefer an exact whole-token match first so imported handle-shaped
+	// ids (`legacy-2a3bc9de`) still resolve; otherwise resolve by the handle's short-id.
+	if (!handleSuffix) return { id: token };
+	const whole = (await lookup(token.toLowerCase(), 2)) || [];
+	const wholeExact = whole.find(
+		candidate => candidate && typeof candidate.id === 'string' && candidate.id.toLowerCase() === token.toLowerCase(),
+	);
+	if (wholeExact) return { id: wholeExact.id };
+	return resolveHexToken(handleSuffix, lookup, token);
 }
 
 // Resolve every id-carrying token in `args` for `operation`. Returns
diff --git a/test/kernel/issue-id-resolver.test.js b/test/kernel/issue-id-resolver.test.js
index 800da7d6..d80f7da6 100644
--- a/test/kernel/issue-id-resolver.test.js
+++ b/test/kernel/issue-id-resolver.test.js
@@ -315,4 +315,18 @@ describe('issue-id resolver — human handles (1db53c60)', () => {
     expect(result).toEqual({ id: 'forge-2a3bc9' });
     expect(lookup.calls.length).toBe(0);
   });
+
+  test('resolves an all-hex-letter slug handle that also matches the hex-prefix pattern', async () => {
+    // "Facade decade fee add" → every slug word is valid hex, so the whole handle matches
+    // HEX_PREFIX_PATTERN; the trailing short id still resolves it (CodeRabbit, PR #335).
+    const lookup = fakeLookup([{ id: UUID_A, title: 'Facade decade fee add' }]);
+    const result = await resolveIssueId('facade-decade-fee-add-e79a1b2c', lookup);
+    expect(result).toEqual({ id: UUID_A });
+  });
+
+  test('a partial dashed UUID prefix (no 8-hex handle suffix) still resolves as a prefix', async () => {
+    const lookup = fakeLookup([{ id: UUID_A, title: 'target' }]);
+    const result = await resolveIssueId('e79a1b2c-0000', lookup);
+    expect(result).toEqual({ id: UUID_A });
+  });
 });
