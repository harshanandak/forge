From 29cb7e0f858b632f3640fd1e53cfb304d408a520 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Thu, 13 Aug 2026 01:09:12 +0530
Subject: [PATCH] fix(kernel): reap rolled-back recovery copies

---
 lib/kernel/sqlite-driver.js             | 18 +++++++++++++++---
 test/kernel/legacy-claim-repair.test.js |  1 +
 2 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/lib/kernel/sqlite-driver.js b/lib/kernel/sqlite-driver.js
index 5612e8c0..d2a1c99c 100644
--- a/lib/kernel/sqlite-driver.js
+++ b/lib/kernel/sqlite-driver.js
@@ -3512,10 +3512,18 @@ function removeClaimRepairBackupSidecarBlockers(blockers = []) {
 	}
 }
 
-function closeClaimRepairBackupFence(fence) {
+function closeClaimRepairBackupFence(fence, options = {}) {
 	if (!fence) return;
 	try { fs.closeSync(fence.fileDescriptor); } catch { /* descriptor cleanup cannot change a committed receipt */ }
 	try { fs.closeSync(fence.recoveryFileDescriptor); } catch { /* descriptor cleanup cannot change a committed receipt */ }
+	if (options.removeRecovery) {
+		try {
+			const recovery = fs.statSync(fence.recoveryPath);
+			if (recovery.dev === fence.recoveryDevice && recovery.ino === fence.recoveryInode) {
+				fs.rmSync(fence.recoveryPath);
+			}
+		} catch { /* rolled-back cleanup cannot change authority */ }
+	}
 }
 
 function assertClaimRepairReplayInput(input = {}) {
@@ -3570,6 +3578,7 @@ function applyLegacyClaimRepairRow(runtime, db, input = {}, driverOptions = {})
 	let backupFence;
 	let sidecarBlockers = [];
 	let committed = false;
+	let rolledBack = false;
 	execSql(runtime, db, 'BEGIN IMMEDIATE;');
 	try {
 		const existingRow = allParams(
@@ -3677,12 +3686,15 @@ function applyLegacyClaimRepairRow(runtime, db, input = {}, driverOptions = {})
 		return attachClaimRepairRecoveryPath(receipt, input.backupPath);
 	} catch (error) {
 		if (!committed) {
-			try { execSql(runtime, db, 'ROLLBACK;'); } catch { /* preserve the original failure */ }
+			try {
+				execSql(runtime, db, 'ROLLBACK;');
+				rolledBack = true;
+			} catch { /* preserve the original failure and recovery copy */ }
 		}
 		throw error;
 	} finally {
 		removeClaimRepairBackupSidecarBlockers(sidecarBlockers);
-		closeClaimRepairBackupFence(backupFence);
+		closeClaimRepairBackupFence(backupFence, { removeRecovery: rolledBack });
 	}
 }
 
diff --git a/test/kernel/legacy-claim-repair.test.js b/test/kernel/legacy-claim-repair.test.js
index 61218db0..fc24ce8c 100644
--- a/test/kernel/legacy-claim-repair.test.js
+++ b/test/kernel/legacy-claim-repair.test.js
@@ -728,6 +728,7 @@ describe('legacy claim repair backup and apply', () => {
 			fixture.config,
 		);
 		expect(receipts).toEqual([]);
+		expect(fs.readdirSync(fixture.root).filter(name => name.includes('.forge-recovery-'))).toEqual([]);
 		fixture.driver.close();
 	});
 
-- 
