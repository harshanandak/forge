   cancel-in-progress: true
 
 jobs:
+  changes:
+    # Classifies the PR diff so the expensive 3-OS x 2-Node Full Matrix only runs
+    # when the change can plausibly behave differently per operating system.
+    # Anything that is not a pull_request (push to master, merge_group, schedule,
+    # workflow_dispatch) is always treated as OS-sensitive.
+    name: Classify Changed Paths
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    outputs:
+      os_sensitive: ${{ steps.filter.outputs.os_sensitive }}
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v7
+        with:
+          fetch-depth: 0
+      - name: Classify diff
+        id: filter
+        shell: bash
+        env:
+          EVENT_NAME: ${{ github.event_name }}
+          BASE_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.sha }}
+        run: |
+          set -uo pipefail
+          if [ "$EVENT_NAME" != "pull_request" ]; then
+            echo "Non-PR event ($EVENT_NAME): full matrix always runs."
+            echo "os_sensitive=true" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          if ! changed="$(git diff --name-only "$BASE_SHA...$HEAD_SHA")"; then
+            echo "::warning::Could not resolve the PR diff; failing safe to the full matrix."
+            echo "os_sensitive=true" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          # Surfaces where Windows/macOS genuinely diverge from Linux:
+          # process/CLI entry points, native + packaged deps, filesystem/path/symlink
+          # helpers, git-hook + installer plumbing, the SQLite kernel (Windows file
+          # handle/EBUSY history), and this workflow itself.
+          os_sensitive_pattern='^(bin/|packages/|test-env/|plugin/hooks/|lib/core/|lib/kernel/|lib/activation/|lib/preflight/|lib/commands/(worktree|setup|init|install)|lib/(shell-utils|symlink-utils|file-utils|file-hash|package-root|forge-lock|detect-worktree|protected-path-manifest|hook-global-installer|hook-renderer|lefthook-check|lefthook-wiring|husky-migration|setup|setup-utils|reset)\.js$|install\.sh$|scripts/install\.|lefthook\.yml$|bunfig\.toml$|package\.json$|bun\.lock$|\.github/workflows/test\.yml$)'
+          echo "Changed files:"
+          printf '%s\n' "$changed"
+          if printf '%s\n' "$changed" | grep -Eq "$os_sensitive_pattern"; then
+            echo "OS-sensitive paths changed: running the full matrix."
+            echo "os_sensitive=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "No OS-sensitive paths changed: full matrix skipped on this PR."
+            echo "Cross-OS coverage on this PR still comes from Windows Smoke, macOS Smoke"
+            echo "and the windows-node22 Targeted PR Tests lane; the full matrix re-runs on"
+            echo "merge_group, on every push to master, and on the weekly schedule."
+            echo "os_sensitive=false" >> "$GITHUB_OUTPUT"
+          fi
+
   full-matrix:
     name: Full Matrix (${{ matrix.os }} / Node ${{ matrix.node-version }})
+    needs: [changes]
+    if: ${{ needs.changes.outputs.os_sensitive == 'true' }}
     runs-on: ${{ matrix.os }}
+    timeout-minutes: 30
     strategy:
       fail-fast: false
       matrix:
@@ -88,6 +144,7 @@ jobs:
