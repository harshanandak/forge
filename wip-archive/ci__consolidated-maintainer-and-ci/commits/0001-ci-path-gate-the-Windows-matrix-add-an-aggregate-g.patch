@@ -477,6 +541,7 @@ jobs:
     if: github.event_name == 'pull_request'
     runs-on: ubuntu-latest
     needs: [unit-shard, windows-smoke, macos-smoke, coverage, e2e]
+    timeout-minutes: 15
     steps:
       - name: Checkout code
         uses: actions/checkout@v7
@@ -503,11 +568,62 @@ jobs:
             cat test-dashboard.json | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'Tests: {d[\"testCount\"]}'); print(f'Suite duration: {d[\"suiteDurationMs\"]}ms'); print(f'Integration skipped: {d[\"integrationSkipped\"]}'); print('Slowest files:'); [print(f'- {item[\"file\"]}: {item[\"durationMs\"]}ms') for item in d.get(\"slowestFiles\", [])[:5]]" >> $GITHUB_STEP_SUMMARY 2>/dev/null || echo "Dashboard generated" >> $GITHUB_STEP_SUMMARY
           fi
 
+  ci-gate:
+    # Single aggregate status for the whole Tests workflow. Mark THIS Required in
+    # branch protection instead of the individual lanes: it stays green when a lane
+    # is legitimately skipped by the path gate above, and red the moment any lane
+    # fails or is cancelled. Adding a lane to `needs` is all that is required to
+    # bring it under the gate.
+    name: CI Gate
+    if: ${{ always() }}
+    needs:
+      - changes
+      - full-matrix
+      - unit-shard
+      - windows-smoke
+      - macos-smoke
+      - cross-os-gate
+      - followup-tests
+      - coverage
+      - e2e
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - name: Aggregate lane results
+        shell: bash
+        env:
+          RESULTS: |
+            changes=${{ needs.changes.result }}
+            full-matrix=${{ needs.full-matrix.result }}
+            unit-shard=${{ needs.unit-shard.result }}
+            windows-smoke=${{ needs.windows-smoke.result }}
+            macos-smoke=${{ needs.macos-smoke.result }}
+            cross-os-gate=${{ needs.cross-os-gate.result }}
+            followup-tests=${{ needs.followup-tests.result }}
+            coverage=${{ needs.coverage.result }}
+            e2e=${{ needs.e2e.result }}
+        run: |
+          set -uo pipefail
+          echo "$RESULTS"
+          failed=0
+          while IFS='=' read -r lane result; do
+            [ -n "$lane" ] || continue
+            case "$result" in
+              success|skipped) ;;
+              *) echo "::error::Lane '$lane' finished as '$result'"; failed=1 ;;
+            esac
+          done <<< "$RESULTS"
+          if [ "$failed" -ne 0 ]; then
+            exit 1
+          fi
+          echo "All test lanes passed or were skipped by the path gate."
+
   dashboard-confidence:
     name: Test Dashboard (Confidence Lane)
     if: github.event_name != 'pull_request'
     runs-on: ubuntu-latest
