+	});
+	let terminationSignal = null;
+	const observingSpawn = (...spawnArgs) => {
+		const child = spawnAsyncFn(...spawnArgs);
+		child.once?.('close', (_status, signal) => {
+			terminationSignal = signal;
+		});
+		return child;
+	};
+	try {
+		if (cancellationSignal) return false;
+		const status = await runCommand(testCommand, testArgs, {
+			cwd: projectRoot,
+			detached: !isWindows,
+			env: processTree.envFor(isolatedEnv),
+			killSignal: TEST_RUN_KILL_SIGNAL,
+			processTree,
+			timeout: timeoutMs,
+			windowsHide: true,
+		}, observingSpawn);
+		if (cancellationSignal) {
+			reportTestRunTermination({ status: null, signal: cancellationSignal }, timeoutMs, log);
+			return false;
+		}
+		if (status === TIMEOUT_EXIT_CODE) {
+			reportTestRunTermination({
+				status: null,
+				signal: TEST_RUN_KILL_SIGNAL,
+				error: Object.assign(new Error('test run timed out'), { code: 'ETIMEDOUT' }),
+			}, timeoutMs, log);
+		}
+		if (terminationSignal) {
+			reportTestRunTermination({ status: null, signal: terminationSignal }, timeoutMs, log);
+			return false;
+		}
+		return status === 0;
+	} catch (error) {
+		reportTestRunTermination({ status: null, signal: null, error }, timeoutMs, log);
+		return false;
+	} finally {
+		removeSignalHandlers();
+		processTree.cleanup(cancellationSignal ? 'SIGKILL' : 'SIGTERM');
