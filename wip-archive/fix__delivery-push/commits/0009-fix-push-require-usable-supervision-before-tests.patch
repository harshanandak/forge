+++ b/lib/commands/push.js
@@ -339,6 +339,16 @@ async function runSupervisedTestCommand({
 		allInstances: true,
 		reconcile: false,
 	});
+	let supervisedEnv = null;
+	try {
+		supervisedEnv = processTree.envFor(isolatedEnv);
+	} catch { /* handled by the fail-closed check below */ }
+	const supervisionMarker = supervisedEnv?.[MANIFEST_ENV];
+	if (typeof supervisionMarker !== 'string' || supervisionMarker.length === 0) {
+		log('Test supervision unavailable — push aborted.');
+		processTree.cleanup('SIGKILL');
+		return false;
+	}
 	let cancellationSignal = null;
 	const removeSignalHandlers = processTree.installSignalHandlers((signal) => {
 		cancellationSignal = signal;
@@ -357,7 +367,7 @@ async function runSupervisedTestCommand({
 		const status = await runCommand(testCommand, testArgs, {
 			cwd: projectRoot,
 			detached: !isWindows,
-			env: processTree.envFor(isolatedEnv),
+			env: supervisedEnv,
 			killSignal: TEST_RUN_KILL_SIGNAL,
 			processTree,
 			timeout: timeoutMs,
