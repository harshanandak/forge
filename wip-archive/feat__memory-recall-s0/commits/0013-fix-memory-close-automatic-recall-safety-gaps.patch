diff --git a/lib/kernel/sqlite-driver.js b/lib/kernel/sqlite-driver.js
index 9e202aec..a0fa0907 100644
--- a/lib/kernel/sqlite-driver.js
+++ b/lib/kernel/sqlite-driver.js
@@ -2114,7 +2114,14 @@ function confirmedMemorySql(alias) {
 	return `(EXISTS (
 		SELECT 1 FROM json_each(${alias}.tags_json)
 		WHERE lower(json_each.value) = 'trust:confirmed'
-	) OR (${alias}.source_agent = 'forge remember' AND json_type(${alias}.value_json) = 'text'))`;
+	) OR (${alias}.source_agent = 'forge remember'
+		AND json_type(${alias}.value_json) = 'text'
+		AND NOT EXISTS (
+			SELECT 1 FROM json_each(${alias}.tags_json)
+			WHERE lower(json_each.value) LIKE 'trust:%'
+				OR lower(json_each.value) = 'forge:auto-capture'
+				OR lower(json_each.value) LIKE 'type:%'
+		)))`;
 }
 
 function projectMemoryScopeSql(alias) {
@@ -2147,10 +2154,21 @@ function searchMemoryRowsRankedScored(runtime, db, query, limit, options = {}) {
 	const supersederConfirmed = confirmedMemorySql('s');
 	// Expand eligible supersession edges once. A correlated json_each scan repeated the
 	// entire memory table for every FTS candidate and dominated the 1,000-row prompt path.
-	return allParams(
-		runtime,
-		db,
-		`WITH eligible_superseders AS MATERIALIZED (
+	// Recall temporarily waits less than the connection default so a real lock cannot outlive
+	// the prompt hook; the finally block restores the caller's normal connection behavior.
+	const previousBusyTimeout = Number(queryOne(runtime, db, 'PRAGMA busy_timeout;').timeout) || 0;
+	const requestedBusyTimeout = Number(options.busyTimeoutMs);
+	const busyTimeout = Number.isFinite(requestedBusyTimeout) && requestedBusyTimeout >= 0
+		? Math.floor(requestedBusyTimeout)
+		: Math.min(previousBusyTimeout, 2_500);
+	if (busyTimeout !== previousBusyTimeout) {
+		execSql(runtime, db, `PRAGMA busy_timeout=${busyTimeout};`);
+	}
+	try {
+		return allParams(
+			runtime,
+			db,
+			`WITH eligible_superseders AS MATERIALIZED (
 				SELECT superseded.value AS memory_key,
 					CASE WHEN ${supersederConfirmed} THEN 1 ELSE 0 END AS is_confirmed
 				FROM kernel_memories s,
@@ -2174,11 +2192,16 @@ function searchMemoryRowsRankedScored(runtime, db, query, limit, options = {}) {
 				CASE WHEN ${confirmed} THEN 0 ELSE 1 END,
 				m.source_agent ASC, m.updated_at DESC, m.key ASC
 			LIMIT ?`,
-		[projectId, cutoff, match, projectId, cutoff, ...excludeKeys, capped],
-	).map(row => normalizeRecallHit(
-		{ ...memoryRowToEntry(row), score: row.__score },
-		projectId,
-	));
+			[projectId, cutoff, match, projectId, cutoff, ...excludeKeys, capped],
+		).map(row => normalizeRecallHit(
+			{ ...memoryRowToEntry(row), score: row.__score },
+			projectId,
+		));
+	} finally {
+		if (busyTimeout !== previousBusyTimeout) {
+			execSql(runtime, db, `PRAGMA busy_timeout=${previousBusyTimeout};`);
+		}
+	}
 }
 
 function closeDatabase(db) {
diff --git a/lib/memory-recall.js b/lib/memory-recall.js
index 221a7b34..b402f414 100644
--- a/lib/memory-recall.js
+++ b/lib/memory-recall.js
@@ -1,5 +1,7 @@
 'use strict';
 
+const { fenceUntrusted } = require('./untrusted-content');
+
 /**
  * @module memory-recall
  *
@@ -65,7 +67,13 @@ function normalizeMemoryType(entry) {
 
 function memoryTrustStatus(entry) {
   const tags = Array.isArray(entry?.tags) ? entry.tags : [];
-  if (tags.some(tag => String(tag).toLowerCase() === 'trust:confirmed')) return 'confirmed';
+  const normalizedTags = tags.map(tag => String(tag).toLowerCase());
+  if (normalizedTags.includes('trust:confirmed')) return 'confirmed';
+  if (normalizedTags.some(tag => tag.startsWith('trust:')
+    || tag === 'forge:auto-capture'
+    || tag.startsWith('type:'))) return 'suggested';
+  if (entry?.sourceAgent === 'forge remember (imported)') return 'suggested';
+  if (entry?.value && typeof entry.value === 'object') return 'suggested';
   if (entry?.sourceAgent === 'forge remember' && typeof entry.value === 'string') return 'confirmed';
   return 'suggested';
 }
@@ -155,7 +163,9 @@ function selectInjection({ query, hits, scoreFloor = null, tokenBudget = DEFAULT
 
   const exclude = new Set(excludeKeys || []);
   const lines = [];
+  const entries = [];
   const injectedKeys = [];
+  const usedSections = new Set();
   let spent = 0;
 
   for (const hit of hits || []) {
@@ -167,17 +177,26 @@ function selectInjection({ query, hits, scoreFloor = null, tokenBudget = DEFAULT
       continue;
     }
     const body = String((hit.content ?? hit.value) == null ? '' : (hit.content ?? hit.value));
-    const cost = estimateTokens(body);
+    const trust = hit.trust_status === 'confirmed' ? 'confirmed' : 'suggested';
+    const source = String(hit.provenance?.source_agent || hit.sourceAgent || 'unknown').slice(0, 80);
+    const updated = String(hit.updated_at || hit.timestamp || 'unknown').slice(0, 40);
+    const labeled = `[trust=${trust} source=${source} updated=${updated}] ${body}`;
+    const line = fenceUntrusted(labeled, { source: 'memory' });
+    const heading = trust === 'confirmed'
+      ? 'Confirmed memory (project-local; provenance shown)'
+      : 'Suggested memory — verify before relying';
+    const cost = estimateTokens(line) + (usedSections.has(trust) ? 0 : estimateTokens(`${heading}\n`));
     if (spent + cost > tokenBudget) {
-      // Budget exhausted; stop rather than skip-and-continue so the strongest fit.
-      break;
+      continue;
     }
-    lines.push(body);
+    lines.push(line);
+    entries.push({ trust, line });
     injectedKeys.push(memoryId);
+    usedSections.add(trust);
     spent += cost;
   }
 
-  return { lines, injectedKeys };
+  return { lines, entries, injectedKeys };
 }
 
 module.exports = {
