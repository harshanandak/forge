 test/hook-renderer.test.js    | 28 ++++++++++++++++++++++++++++
 4 files changed, 72 insertions(+)

diff --git a/lib/hook-renderer.js b/lib/hook-renderer.js
index 9491915b..af4c6134 100644
--- a/lib/hook-renderer.js
+++ b/lib/hook-renderer.js
@@ -41,6 +41,7 @@
 const fs = require('node:fs');
 const path = require('node:path');
 const { backupFile } = require('./mcp-config-renderer');
+const { assertNoAncestorSymlinkEscape, assertNoSymlinkEscape } = require('./protected-state-surfaces');
 
 const HARNESS_HOOK_FILES = {
   claude: '.claude/settings.json',
@@ -558,6 +559,13 @@ const MERGERS = {
   cursor: mergeCursorHooks,
 };
 
+function assertSafeHookConfigPath(targetRoot, filePath) {
+  const escape =
+    assertNoAncestorSymlinkEscape(targetRoot, filePath) ||
+    assertNoSymlinkEscape(targetRoot, filePath);
+  if (escape) throw new Error(`Refusing to render hook config: ${escape.reason}`);
+}
+
 /**
  * Render (merge) Forge's native hooks into one harness's native config on disk.
  * Read → merge → write. Unparseable existing file → BACKED UP + left untouched
@@ -584,7 +592,9 @@ function renderHookConfig({ harness, targetRoot, contract = FORGE_HOOK_CONTRACT
   if (!merge || !rel) throw new Error(`Unknown hook harness: ${harness}`);
 
   const filePath = path.join(targetRoot, rel);
+  assertSafeHookConfigPath(targetRoot, filePath);
   fs.mkdirSync(path.dirname(filePath), { recursive: true });
+  assertSafeHookConfigPath(targetRoot, filePath);
   const existed = fs.existsSync(filePath);
   const existing = existed ? fs.readFileSync(filePath, 'utf-8') : '';
 
@@ -593,12 +603,14 @@ function renderHookConfig({ harness, targetRoot, contract = FORGE_HOOK_CONTRACT
     merged = merge(existing, contract);
   } catch (err) {
     if (err instanceof HookConfigParseError && existed) {
+      assertSafeHookConfigPath(targetRoot, filePath);
       const backup = backupHookConfig(filePath);
       return { file: filePath, existed, skipped: true, wrote: false, backup };
     }
     throw err;
   }
 
+  assertSafeHookConfigPath(targetRoot, filePath);
   fs.writeFileSync(filePath, merged, 'utf-8');
   return { file: filePath, existed, skipped: false, wrote: true };
 }
