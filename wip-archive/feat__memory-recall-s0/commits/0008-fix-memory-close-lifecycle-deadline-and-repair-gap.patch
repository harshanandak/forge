Subject: [PATCH] fix(memory): close lifecycle deadline and repair gaps

---
 lib/commands/hooks.js            |  6 +++++-
 lib/hook-renderer.js             | 32 +++++++++++++++++++++++++++++++-
 lib/upgrade-safety.js            |  4 ++--
 test/commands/upgrade.test.js    | 16 ++++++++++++++++
 test/hooks-memory-recall.test.js | 16 ++++++++++++++++
 5 files changed, 70 insertions(+), 4 deletions(-)

diff --git a/lib/commands/hooks.js b/lib/commands/hooks.js
index 23a265e8..97ebddd1 100644
--- a/lib/commands/hooks.js
+++ b/lib/commands/hooks.js
@@ -452,7 +452,11 @@ async function runMemoryRecall(rest, projectRoot, opts = {}) {
 
     if (!lines.length) return { success: true, output: '' };
 
-    await saveSeen(projectRoot, sessionId, injectedKeys);
+    if (opts.deadline?.expired) return { success: true, output: '', reason: 'timeout' };
+    try {
+      const pending = saveSeen(projectRoot, sessionId, injectedKeys);
+      if (pending && typeof pending.catch === 'function') pending.catch(() => {});
+    } catch { /* dedupe persistence never suppresses an injection */ }
     const fenced = lines.map(line => fenceUntrusted(line, { source: 'memory' })).join('\n');
     return { success: true, output: formatUserPromptSubmit(harness, fenced) };
   } catch {
diff --git a/lib/hook-renderer.js b/lib/hook-renderer.js
index 84a4d3c0..2f456326 100644
--- a/lib/hook-renderer.js
+++ b/lib/hook-renderer.js
@@ -451,6 +451,15 @@ function isForgeCursorEntry(entry) {
   return isForgeCommand(entry?.command);
 }
 
+function groupContains(actual, expected) {
+  if ((actual?.matcher || '') !== (expected?.matcher || '')) return false;
+  const actualHooks = Array.isArray(actual?.hooks) ? actual.hooks : [];
+  const expectedHooks = Array.isArray(expected?.hooks) ? expected.hooks : [];
+  return expectedHooks.every(expectedHook =>
+    actualHooks.some(actualHook =>
+      actualHook?.type === expectedHook?.type && actualHook?.command === expectedHook?.command));
+}
+
 function parseJsonConfig(existingText) {
   if (!existingText || !existingText.trim()) return {};
   let obj;
@@ -485,6 +494,26 @@ function mergeClaudeSettings(existingText, contract) {
   return JSON.stringify(obj, null, 2) + '\n';
 }
 
+function hasForgeClaudeHooks(existingText, contract) {
+  const obj = parseJsonConfig(existingText);
+  const hooks = obj.hooks && typeof obj.hooks === 'object' && !Array.isArray(obj.hooks)
+    ? obj.hooks
+    : {};
+  return Object.entries(renderClaudeHooks(contract)).every(([event, expectedGroups]) => {
+    const actualGroups = Array.isArray(hooks[event]) ? hooks[event] : [];
+    return expectedGroups.every(expected => actualGroups.some(actual => groupContains(actual, expected)));
+  });
+}
+
+function backupHookConfig(filePath) {
+  const source = fs.readFileSync(filePath);
+  for (let suffix = 0; ; suffix += 1) {
+    const candidate = `${filePath}.bak${suffix ? `.${suffix}` : ''}`;
+    if (!fs.existsSync(candidate)) return backupFile(filePath);
+    if (source.equals(fs.readFileSync(candidate))) return candidate;
+  }
+}
+
 /**
  * Merge Forge's hooks into an existing `.cursor/hooks.json` string.
  * Forces `version: 1`, preserves all non-Forge events and the user's own entries;
@@ -546,7 +575,7 @@ function renderHookConfig({ harness, targetRoot, contract = FORGE_HOOK_CONTRACT
     merged = merge(existing, contract);
   } catch (err) {
     if (err instanceof HookConfigParseError && existed) {
-      const backup = backupFile(filePath);
+      const backup = backupHookConfig(filePath);
       return { file: filePath, existed, skipped: true, wrote: false, backup };
     }
     throw err;
@@ -578,6 +607,7 @@ module.exports = {
   renderCodexHooksToml,
   renderHermesHooksYaml,
   mergeClaudeSettings,
+  hasForgeClaudeHooks,
   mergeCursorHooks,
   renderHookConfig,
 };
