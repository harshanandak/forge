From e4276c4e9c88c31d74425e550deda96d4aa6fc9d Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Thu, 30 Jul 2026 18:14:38 +0530
Subject: [PATCH] perf(memory): materialize supersession eligibility

---
 lib/kernel/sqlite-driver.js              | 22 +++++++++++------
 test/kernel/sqlite-driver-memory.test.js | 31 ++++++++++++++++++++++++
 2 files changed, 46 insertions(+), 7 deletions(-)

diff --git a/lib/kernel/sqlite-driver.js b/lib/kernel/sqlite-driver.js
index b599e015..9e202aec 100644
--- a/lib/kernel/sqlite-driver.js
+++ b/lib/kernel/sqlite-driver.js
@@ -2145,10 +2145,20 @@ function searchMemoryRowsRankedScored(runtime, db, query, limit, options = {}) {
 		: '';
 	const confirmed = confirmedMemorySql('m');
 	const supersederConfirmed = confirmedMemorySql('s');
+	// Expand eligible supersession edges once. A correlated json_each scan repeated the
+	// entire memory table for every FTS candidate and dominated the 1,000-row prompt path.
 	return allParams(
 		runtime,
 		db,
-		`SELECT m.*, bm25(kernel_memories_fts) AS __score FROM kernel_memories m
+		`WITH eligible_superseders AS MATERIALIZED (
+				SELECT superseded.value AS memory_key,
+					CASE WHEN ${supersederConfirmed} THEN 1 ELSE 0 END AS is_confirmed
+				FROM kernel_memories s,
+					json_each(COALESCE(s.supersedes_json, '[]')) superseded
+				WHERE ${projectMemoryScopeSql('s')}
+				AND (${supersederConfirmed} OR s.updated_at >= ?)
+			)
+			SELECT m.*, bm25(kernel_memories_fts) AS __score FROM kernel_memories m
 			JOIN kernel_memories_fts ON kernel_memories_fts.rowid = m.rowid
 			WHERE kernel_memories_fts MATCH ?
 			AND ${projectMemoryScopeSql('m')}
@@ -2156,17 +2166,15 @@ function searchMemoryRowsRankedScored(runtime, db, query, limit, options = {}) {
 			${seenSql}
 			AND NOT EXISTS (
 				SELECT 1
-				FROM kernel_memories s, json_each(COALESCE(s.supersedes_json, '[]')) superseded
-				WHERE superseded.value = m.key
-				AND ${projectMemoryScopeSql('s')}
-				AND (${supersederConfirmed} OR s.updated_at >= ?)
-				AND (${supersederConfirmed} OR NOT ${confirmed})
+				FROM eligible_superseders superseder
+				WHERE superseder.memory_key = m.key
+				AND (superseder.is_confirmed = 1 OR NOT ${confirmed})
 			)
 			ORDER BY bm25(kernel_memories_fts),
 				CASE WHEN ${confirmed} THEN 0 ELSE 1 END,
 				m.source_agent ASC, m.updated_at DESC, m.key ASC
 			LIMIT ?`,
-		[match, projectId, cutoff, ...excludeKeys, projectId, cutoff, capped],
+		[projectId, cutoff, match, projectId, cutoff, ...excludeKeys, capped],
 	).map(row => normalizeRecallHit(
 		{ ...memoryRowToEntry(row), score: row.__score },
 		projectId,
diff --git a/test/kernel/sqlite-driver-memory.test.js b/test/kernel/sqlite-driver-memory.test.js
index 05914353..0b8381ba 100644
--- a/test/kernel/sqlite-driver-memory.test.js
+++ b/test/kernel/sqlite-driver-memory.test.js
@@ -8,6 +8,7 @@ const { afterEach, describe, expect, test } = require('bun:test');
 const fs = require('node:fs');
 const os = require('node:os');
 const path = require('node:path');
+const { performance } = require('node:perf_hooks');
 
 const { createBuiltinSQLiteDriver } = require('../../lib/kernel/sqlite-driver');
 
@@ -147,6 +148,36 @@ describe('Kernel SQLite driver — project-memory read model', () => {
 });
 
 describe('Kernel SQLite driver — FTS5 memory recall (token-efficient read layer)', () => {
+	test('keeps 1,000-record scored recall p95 within the prompt budget', () => {
+		const driver = makeDriver();
+		const projectId = 'c:/repo/.git';
+		for (let index = 0; index < 1_000; index += 1) {
+			driver.recordMemory({
+				key: `performance-${index}`,
+				value: `auth token policy record ${index}`,
+				sourceAgent: 'forge remember',
+				scope: projectId,
+				tags: [],
+				timestamp: '2026-07-30T00:00:00.000Z',
+			});
+		}
+		const search = () => driver.searchMemoriesRankedScored('auth token', 25, {
+			projectId,
+			now: '2026-07-30T12:00:00.000Z',
+		});
+		for (let index = 0; index < 10; index += 1) search();
+		const samples = [];
+		for (let index = 0; index < 100; index += 1) {
+			const startedAt = performance.now();
+			const hits = search();
+			samples.push(performance.now() - startedAt);
+			expect(hits).toHaveLength(25);
+		}
+		samples.sort((left, right) => left - right);
+		const p95 = samples[Math.ceil(samples.length * 0.95) - 1];
+		expect(p95).toBeLessThanOrEqual(250);
+	}, 20_000);
+
 	test('filters foreign and already-seen rows before the scored candidate limit', () => {
 		const driver = makeDriver();
 		const projectId = 'c:/repo/.git';
-- 
