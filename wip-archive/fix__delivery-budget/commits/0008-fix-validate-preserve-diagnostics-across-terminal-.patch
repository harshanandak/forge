Date: Thu, 24 Sep 2026 14:58:05 +0530
Subject: [PATCH] fix(validate): preserve diagnostics across terminal outcomes

---
 .../2026-09-18-delivery-budget/decisions.md   |  10 ++
 lib/commands/validate.js                      |  13 +-
 test/commands/validate.test.js                | 112 +++++++++++++++++-
 3 files changed, 129 insertions(+), 6 deletions(-)

diff --git a/docs/work/2026-09-18-delivery-budget/decisions.md b/docs/work/2026-09-18-delivery-budget/decisions.md
index ec6e7f07..0f4407c2 100644
--- a/docs/work/2026-09-18-delivery-budget/decisions.md
+++ b/docs/work/2026-09-18-delivery-budget/decisions.md
@@ -81,6 +81,16 @@ The revised validate test file passed 67 tests with 13 skips, zero failures and
 168 assertions in 14.42s; strict file lint passed. Sonar's nested-ternary and
 generic-error findings were corrected without suppressions or message changes.
 
+Further review exposed a shared formatting gap: a passing test message could
+become the error for a failed lint check, and accepted budget evidence disappeared
+when tests failed. Terminal diagnostics must derive from actual failed checks,
+including caught exceptions, while ignoring intentionally skipped checks. Budget
+evidence is independent of the overall outcome. Verify this outcome matrix at
+the public handler boundary rather than adding isolated example-specific fixes.
+The four missed scenarios reproduced before the shared correction. The outcome
+matrix then passed 18 tests; the complete focused file passed 73 tests with
+13 skips, zero failures and 178 assertions in 15.55s. Strict file lint passed.
+
 The largest attributed test file was `test/protected-state-surfaces.test.js`
 at 99.037s. Repeated Git fixture setup is a hypothesis to measure separately in
 issue `6eb0147a-ea09-4c8a-83dd-ed8c74acb7bc`, preserving all isolation and authority
diff --git a/lib/commands/validate.js b/lib/commands/validate.js
index e3e37736..2af2bde0 100644
--- a/lib/commands/validate.js
+++ b/lib/commands/validate.js
@@ -1025,18 +1025,21 @@ module.exports = {
 			rootDir: projectRoot,
 			resourceBudget,
 		});
-		if (!result.success) {
-			const error = result.error || result.message || result.checks?.tests?.message;
-			return error ? { ...result, error } : result;
+		const errorParts = Array.isArray(result.errors) ? result.errors.filter(Boolean) : [];
+		for (const check of Object.values(result.checks || {})) {
+			if (check?.success !== false || check.skipped === true || !check.message) continue;
+			if (!errorParts.some(error => error.endsWith(check.message))) errorParts.push(check.message);
 		}
-
 		const budget = result.checks?.tests?.resourceBudget;
 		const budgetOutput = Number.isInteger(budget?.effective)
 			? `Full suite resource budget: requested=${budget.requested ?? 'default'} effective=${budget.effective}`
 			: null;
+		const output = [result.success ? result.summary : null, budgetOutput].filter(Boolean).join('\n');
+		const error = result.error || result.message || errorParts.join('; ') || result.summary;
 		return {
 			...result,
-			output: [result.summary, budgetOutput].filter(Boolean).join('\n'),
+			...(output ? { output } : {}),
+			...(!result.success && error ? { error } : {}),
 		};
 	},
 	runTypeCheck,
