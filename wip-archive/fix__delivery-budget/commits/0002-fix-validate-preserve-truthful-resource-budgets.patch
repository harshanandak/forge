-    0,
-  );
+  const minimumBudget = minimumResourceBudget(lanes, platform);
   if (workerBudget < minimumBudget) {
-    throw new Error(`Full suite minimum resource budget is ${minimumBudget} for the required lanes`);
+    throw new Error(
