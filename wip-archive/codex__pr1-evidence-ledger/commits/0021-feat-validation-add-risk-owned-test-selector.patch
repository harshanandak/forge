+schema_id: forge.validation.risk-manifest.v1
+revision: 1
+
+risks:
+  - id: authority-integrity
+    severity: S0
+    non_quarantinable: true
+    gate_ids: [G0, G1, G4]
+  - id: contract-compatibility
+    severity: S1
+    non_quarantinable: true
+    gate_ids: [G0, G1, G3]
+  - id: facade-routing
+    severity: S1
+    non_quarantinable: false
+    gate_ids: [G0, G1, G7]
+  - id: memory-data-integrity
+    severity: S0
+    non_quarantinable: true
+    gate_ids: [G0, G1, G5]
+  - id: monitor-cleanup
+    severity: S1
+    non_quarantinable: true
+    gate_ids: [G0, G1, G4, G6]
+  - id: validation-selection
+    severity: S0
+    non_quarantinable: true
+    gate_ids: [G0, G1]
+
+owners:
+  - id: facade-cli
+    product: facade
+    package: forge-workflow
+    package_roots: [bin, lib/commands]
+    selectors:
+      - { kind: path, prefix: "bin/" }
+      - { kind: path, prefix: "lib/commands/" }
+      - { kind: command, prefix: "forge " }
+    risk_ids: [facade-routing]
+    canonical_test_ids: ["test/commands/**/*.test.js"]
+    dependent_routes: [installed-cli]
+    platform_runtime_additions: [windows-shell]
+    lanes: [facade-package]
+  - id: kernel-authority
+    product: memory
+    package: forge-kernel
