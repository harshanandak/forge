new file mode 100644
index 00000000..1bdf02c0
--- /dev/null
+++ b/validation/risk-manifest.v1.schema.json
@@ -0,0 +1,99 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://forge.dev/schemas/validation/risk-manifest.v1.schema.json",
+  "title": "Forge risk-to-test ownership manifest",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema_id",
+    "revision",
+    "source_hash",
+    "manifest_hash",
+    "generator_version",
+    "risks",
+    "owners",
+    "unknown_owner_fallback"
+  ],
+  "properties": {
+    "schema_id": { "const": "forge.validation.risk-manifest.v1" },
+    "revision": { "type": "integer", "minimum": 1 },
+    "source_hash": { "$ref": "#/$defs/digest" },
+    "manifest_hash": { "$ref": "#/$defs/digest" },
+    "generator_version": { "type": "string", "minLength": 1 },
+    "risks": {
+      "type": "array",
+      "minItems": 1,
+      "items": { "$ref": "#/$defs/risk" }
+    },
+    "owners": {
+      "type": "array",
+      "minItems": 1,
+      "items": { "$ref": "#/$defs/owner" }
+    },
+    "unknown_owner_fallback": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["lane", "required_gates"],
+      "properties": {
+        "lane": { "const": "repository-baseline" },
+        "required_gates": { "$ref": "#/$defs/nonEmptyStrings" }
+      }
+    }
+  },
+  "$defs": {
+    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
+    "nonEmptyStrings": {
+      "type": "array",
+      "minItems": 1,
+      "items": { "type": "string", "minLength": 1 }
+    },
+    "risk": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["id", "severity", "non_quarantinable", "gate_ids"],
+      "properties": {
+        "id": { "type": "string", "minLength": 1 },
+        "severity": { "enum": ["S0", "S1", "S2", "S3"] },
+        "non_quarantinable": { "type": "boolean" },
+        "gate_ids": { "$ref": "#/$defs/nonEmptyStrings" }
+      }
+    },
+    "selector": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["kind", "prefix"],
+      "properties": {
+        "kind": { "enum": ["path", "command", "schema"] },
+        "prefix": { "type": "string", "minLength": 1 }
+      }
+    },
+    "owner": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "id",
+        "product",
+        "package",
+        "package_roots",
+        "selectors",
+        "risk_ids",
+        "canonical_test_ids",
+        "dependent_routes",
+        "platform_runtime_additions",
+        "lanes"
+      ],
+      "properties": {
+        "id": { "type": "string", "minLength": 1 },
+        "product": { "type": "string", "minLength": 1 },
+        "package": { "type": "string", "minLength": 1 },
+        "package_roots": { "$ref": "#/$defs/nonEmptyStrings" },
+        "selectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/selector" } },
+        "risk_ids": { "$ref": "#/$defs/nonEmptyStrings" },
+        "canonical_test_ids": { "$ref": "#/$defs/nonEmptyStrings" },
+        "dependent_routes": { "type": "array", "items": { "type": "string" } },
+        "platform_runtime_additions": { "type": "array", "items": { "type": "string" } },
+        "lanes": { "$ref": "#/$defs/nonEmptyStrings" }
+      }
+    }
+  }
+}
