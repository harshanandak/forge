Date: Sun, 9 Aug 2026 14:57:06 +0530
Subject: [PATCH] fix(gate): renew terminal approvals

---
 lib/commands/gate.js                     |  6 +-
 lib/gate-events.js                       | 73 +++++++++++++++++++-----
 lib/kernel/sqlite-driver.js              |  7 ++-
 test/commands/gate-events.test.js        | 54 ++++++++++++++++++
 test/kernel/sqlite-driver-events.test.js | 24 ++++++++
 5 files changed, 147 insertions(+), 17 deletions(-)

diff --git a/lib/commands/gate.js b/lib/commands/gate.js
index 86352e71..39b84acc 100644
--- a/lib/commands/gate.js
+++ b/lib/commands/gate.js
@@ -60,9 +60,13 @@ function parseGateTtl(raw, issuedAt) {
   if (!Number.isFinite(issuedMillis)) return { ok: false, error: 'Cannot issue a TTL approval without a valid clock.' };
   const expiresMillis = issuedMillis + ttlMs;
   if (!Number.isFinite(expiresMillis)) return { ok: false, error: 'TTL expiry is outside the supported date range.' };
+  const expiryDate = new Date(expiresMillis);
+  if (!Number.isFinite(expiryDate.getTime())) {
+    return { ok: false, error: 'TTL expiry is outside the supported date range.' };
+  }
   return {
     ok: true,
-    expiresAt: new Date(expiresMillis).toISOString(),
+    expiresAt: expiryDate.toISOString(),
     requestIdentity: `ttl-ms=${ttlMs}`,
   };
 }
diff --git a/lib/gate-events.js b/lib/gate-events.js
index 53107bd4..db9d0574 100644
--- a/lib/gate-events.js
+++ b/lib/gate-events.js
@@ -81,6 +81,8 @@ function parseGateEvent(row) {
     view.decision = row.event_type === GATE_APPROVED_EVENT ? 'approved' : 'rejected';
     view.issued_at = row.created_at;
     view.expires_at = payload.expires_at ?? null;
+    view.request_identity = payload.request_identity ?? null;
+    view.generation = Number.isInteger(payload.generation) ? payload.generation : 0;
   }
   if (payload.reason !== undefined) view.reason = payload.reason;
   return view;
@@ -91,10 +93,43 @@ function isIdempotencyRace(error) {
   return /UNIQUE constraint failed/i.test(message) && /idempotency_key/i.test(message);
 }
 
+function isActiveApproval(event, now) {
+  if (!event || event.event_type !== GATE_APPROVED_EVENT) return false;
+  if (!event.expires_at) return true;
+  const nowMillis = Date.parse(now);
+  const expiryMillis = Date.parse(event.expires_at);
+  return Number.isFinite(nowMillis) && Number.isFinite(expiryMillis) && nowMillis < expiryMillis;
+}
+
+function planGateGeneration(events, params) {
+  const { gateId, decision, actor, requestIdentity, now } = params;
+  const gateEvents = events.filter(event => event.gate === gateId);
+  const latest = gateEvents.at(-1);
+  const maxGeneration = gateEvents.reduce(
+    (max, event) => Math.max(max, Number.isInteger(event.generation) ? event.generation : 0),
+    -1,
+  );
+
+  if (decision === 'approved') {
+    const identicalActive = latest
+      && latest.actor === actor
+      && latest.request_identity === requestIdentity
+      && isActiveApproval(latest, now);
+    if (identicalActive) return { duplicateEvent: latest, generation: latest.generation };
+    return { duplicateEvent: null, generation: maxGeneration + 1 };
+  }
+
+  if (latest?.event_type === GATE_REJECTED_EVENT && latest.actor === actor) {
+    return { duplicateEvent: latest, generation: latest.generation };
+  }
+  return { duplicateEvent: null, generation: Math.max(maxGeneration, 0) };
+}
+
 /**
- * Record a gate decision as a kernel event on the issue. Idempotent per
- * issue+gate+actor+decision. Validates the issue exists (the caller validates the
- * gate id against the known-gate set before calling).
+ * Record a gate decision as a kernel event on the issue. Active identical
+ * requests are idempotent; expiry/rejection advances the durable generation so
+ * a later approval can become authoritative. Validates the issue exists (the
+ * caller validates the gate id against the known-gate set before calling).
  *
  * @param {string} projectRoot
  * @param {Object} params
@@ -124,12 +159,27 @@ async function recordGateEvent(projectRoot, params = {}) {
       return { ok: false, issueMissing: true, actor };
     }
 
+    const createdAt = now || new Date().toISOString();
+    const stableRequestIdentity = requestIdentity ?? expiresAt ?? null;
+    const rows = await driver.listKernelEvents(ISSUE_ENTITY_TYPE, issueId, {}, config);
+    const generationPlan = planGateGeneration((rows || []).map(parseGateEvent), {
+      gateId,
+      decision,
+      actor,
+      requestIdentity: stableRequestIdentity,
+      now: createdAt,
+    });
+    if (generationPlan.duplicateEvent) {
+      return { ok: true, duplicate: true, event: generationPlan.duplicateEvent, actor };
+    }
+    const keyParts = [stableRequestIdentity];
+    if (generationPlan.generation > 0) keyParts.push(`generation=${generationPlan.generation}`);
     const idempotencyKey = gateIdempotencyKey(
       eventType,
       issueId,
       gateId,
       actor,
-      requestIdentity ?? expiresAt,
+      keyParts.filter(Boolean).join(':') || undefined,
     );
 
     const existing = await driver.loadKernelEventByIdempotencyKey(idempotencyKey, {}, config);
@@ -142,6 +192,8 @@ async function recordGateEvent(projectRoot, params = {}) {
       actor,
       control_id: gateControlId(issueId, gateId),
       expires_at: expiresAt ?? null,
+      request_identity: stableRequestIdentity,
+      generation: generationPlan.generation,
     };
     if (typeof reason === 'string' && reason.length > 0) payload.reason = reason;
 
@@ -154,7 +206,7 @@ async function recordGateEvent(projectRoot, params = {}) {
       actor,
       origin: GATE_EVENT_ORIGIN,
       payload,
-      created_at: now || new Date().toISOString(),
+      created_at: createdAt,
     };
 
     try {
@@ -195,14 +247,7 @@ async function listGateEvents(projectRoot, issueId, options = {}) {
 function evaluateGateApproval(events, gateId, now = new Date().toISOString()) {
   const decisions = events.filter(event => event.gate === gateId);
   const event = decisions.at(-1);
-  if (!event || event.event_type !== GATE_APPROVED_EVENT) return { approved: false, event };
-  if (!event.expires_at) return { approved: true, event };
-  const nowMillis = Date.parse(now);
-  const expiryMillis = Date.parse(event.expires_at);
-  return {
-    approved: Number.isFinite(nowMillis) && Number.isFinite(expiryMillis) && nowMillis < expiryMillis,
-    event,
-  };
+  return { approved: isActiveApproval(event, now), event };
 }
 
 /**
@@ -225,6 +270,8 @@ module.exports = {
   GATE_EVENT_TYPES,
   gateIdempotencyKey,
   gateControlId,
+  isActiveApproval,
+  planGateGeneration,
   parseGateEvent,
   recordGateEvent,
   listGateEvents,
diff --git a/lib/kernel/sqlite-driver.js b/lib/kernel/sqlite-driver.js
index 47f7ebff..67559175 100644
--- a/lib/kernel/sqlite-driver.js
+++ b/lib/kernel/sqlite-driver.js
@@ -790,13 +790,14 @@ function loadKernelEntityRow(runtime, db, entityType, entityId) {
 }
 
 // Read the full event stream for one entity, oldest first (matches
-// idx_kernel_events_entity_created; there is no seq column, so created_at is the
-// ordering key).
+// idx_kernel_events_entity_created. SQLite rowid is the authoritative local
+// insertion sequence when timestamps tie; event ids are random and cannot order
+// same-clock approval/rejection decisions.
 function listKernelEventRows(runtime, db, entityType, entityId) {
 	return allParams(
 		runtime,
 		db,
-		'SELECT * FROM kernel_events WHERE entity_type = ? AND entity_id = ? ORDER BY created_at ASC',
+		'SELECT * FROM kernel_events WHERE entity_type = ? AND entity_id = ? ORDER BY created_at ASC, rowid ASC',
 		[entityType, entityId],
 	);
 }
diff --git a/test/commands/gate-events.test.js b/test/commands/gate-events.test.js
index 2f485d57..6636b506 100644
--- a/test/commands/gate-events.test.js
+++ b/test/commands/gate-events.test.js
@@ -278,4 +278,58 @@ describe('forge gate events (approve/reject/status/check)', () => {
     const updated = await gateCommand.handler(['status', issue], { json: true }, root, opts(deps));
     expect(JSON.parse(updated.output).events).toHaveLength(2);
   });
+
+  test('expired or rejected approval starts a new authoritative generation', async () => {
+    const root = makeProject();
+    const deps = await freshKernel();
+    const issue = await seedIssue(deps, 'forge-gate-generations');
+    const args = ['approve', issue, 'gate.merge', '--ttl', '1m'];
+
+    const first = await gateCommand.handler(args, {}, root, opts(deps));
+    const activeRetry = await gateCommand.handler(args, {}, root, {
+      ...opts(deps), now: '2026-08-09T10:00:30.000Z',
+    });
+    expect(first.duplicate).toBe(false);
+    expect(activeRetry.duplicate).toBe(true);
+
+    const afterExpiry = await gateCommand.handler(args, {}, root, {
+      ...opts(deps), now: '2026-08-09T10:01:00.000Z',
+    });
+    expect(afterExpiry.duplicate).toBe(false);
+    expect(afterExpiry.event.expires_at).toBe('2026-08-09T10:02:00.000Z');
+
+    // Same timestamp is intentionally adversarial: authoritative insertion order
+    // must make reject terminal, then the renewal authoritative after it.
+    await gateCommand.handler(['reject', issue, 'gate.merge'], {}, root, {
+      ...opts(deps), now: '2026-08-09T10:01:30.000Z',
+    });
+    const afterReject = await gateCommand.handler(args, {}, root, {
+      ...opts(deps), now: '2026-08-09T10:01:30.000Z',
+    });
+    expect(afterReject.duplicate).toBe(false);
+    const check = await gateCommand.handler(['check', issue, 'gate.merge'], {}, root, {
+      ...opts(deps), now: '2026-08-09T10:01:31.000Z',
+    });
+    expect(check.success).toBe(true);
+    expect(check.event.issued_at).toBe('2026-08-09T10:01:30.000Z');
+
+    const status = await gateCommand.handler(['status', issue], { json: true }, root, opts(deps));
+    expect(JSON.parse(status.output).events.map(event => event.decision)).toEqual([
+      'approved', 'approved', 'rejected', 'approved',
+    ]);
+  });
+
+  test('TTL expiry outside the JS Date range fails closed without throwing or writing', async () => {
+    const root = makeProject();
+    const deps = await freshKernel();
+    const issue = await seedIssue(deps, 'forge-gate-date-range');
+    const result = await gateCommand.handler(
+      ['approve', issue, 'gate.merge', '--ttl', '1d'], {}, root,
+      { ...opts(deps), now: '+275760-09-12T23:59:59.999Z' },
+    );
+    expect(result.success).toBe(false);
+    expect(result.error).toMatch(/date range/i);
+    const status = await gateCommand.handler(['status', issue], { json: true }, root, opts(deps));
+    expect(JSON.parse(status.output).events).toHaveLength(0);
+  });
 });
