From ad227466a7c58bb50b02e8f53b6785f8f8c9d4dd Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Thu, 16 Jul 2026 14:34:36 +0530
Subject: [PATCH] fix(monitor): refresh on thread-resolution + jq-safe degraded
 bundle (CodeRabbit #403)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Addresses the two CodeRabbit findings that carried over from the discarded
duplicate revision (logic moved to pr-monitor.yml, not gone):

- T1 (refresh on thread resolution): add `pull_request_review_thread`
  [resolved, unresolved] trigger + PR-number resolution case. Without it,
  resolving the LAST unresolved thread left a stale `pr-verdict:blocked-threads`
  label + sticky until an unrelated event re-ran the monitor. Also react to
  `pull_request_review: dismissed`.
- T2 (jq-safe degraded bundle): the fail-closed gather-failure path built
  bundle.json with printf + manual quote/newline escaping — backslashes, tabs,
  control chars, or a truncated multibyte from gather.err made it invalid JSON,
  so the fail-closed path itself failed. Now built with `jq -n --arg` (escapes
  everything). Verified: control-char input now yields valid JSON that
  render-sticky consumes as a degraded/unreadable surface.

Also reworded the reconcile comment to match the impl (strips the full
pr-verdict:* enum, not a single presumed sibling).

T3 (non-CLEAN → "checks running") targeted the deleted lib/pr-verdict.js catch-all;
the current single-source code uses lib/pr-pull.js canonical rungs with distinct
per-verdict headlines (no catch-all), and the BEHIND part is fixed in e01e7418.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .github/workflows/pr-monitor.yml | 32 ++++++++++++++++++++++++++------
 1 file changed, 26 insertions(+), 6 deletions(-)

diff --git a/.github/workflows/pr-monitor.yml b/.github/workflows/pr-monitor.yml
index 50c0cb04..3565d8a9 100644
--- a/.github/workflows/pr-monitor.yml
+++ b/.github/workflows/pr-monitor.yml
@@ -20,9 +20,15 @@ on:
   pull_request:
     types: [opened, synchronize, reopened]
   pull_request_review:
-    types: [submitted]
+    types: [submitted, dismissed]
   pull_request_review_comment:
     types: [created]
+  # Resolving/unresolving a review thread is what clears (or re-raises) the
+  # threads-open signal — without this trigger, closing the LAST unresolved thread
+  # would leave a stale `pr-verdict:blocked-threads` label + sticky until some
+  # unrelated event happened to re-run the monitor (CodeRabbit PR #403).
+  pull_request_review_thread:
+    types: [resolved, unresolved]
   issue_comment:
     types: [created]
   check_suite:
@@ -68,7 +74,7 @@ jobs:
           # jq errors are swallowed (|| true): a monitor must never red-X itself on an
           # unrelated or malformed event — no PR context means a clean no-op, not a fail.
           case "$EVENT_NAME" in
-            pull_request|pull_request_review|pull_request_review_comment)
+            pull_request|pull_request_review|pull_request_review_comment|pull_request_review_thread)
               PR=$(jq -r '.pull_request.number // empty' "$EVENT_PATH" 2>/dev/null || true) ;;
             issue_comment)
               # Only PR comments carry .issue.pull_request; plain issue comments are skipped.
@@ -135,8 +141,21 @@ jobs:
             # Fail-closed degraded bundle: NEITHER threads NOR checks were read, so
             # both availability flags are false — the renderer surfaces both as
             # unreadable rather than a false "zero unresolved / no failing checks".
-            ERR=$(head -c 300 gather.err 2>/dev/null | tr '\n' ' ' | sed 's/"/\\"/g')
-            printf '{"pr":"%s","unresolvedComments":[],"unresolvedCommentsAvailable":false,"unresolvedCommentsError":"gather failed: %s","ciAvailable":false,"ci":{"checks":[],"failing":[],"pending":[]},"branch":{"ahead":0,"behind":0}}' "$PR" "$ERR" > bundle.json
+            # Build with `jq --arg` (NOT manual escaping): gather.err can contain
+            # backslashes, tabs, control chars, or a truncated multibyte sequence that
+            # hand-escaping only quotes/newlines would turn into invalid JSON — making
+            # the fail-closed path itself fail (CodeRabbit PR #403).
+            ERR=$(head -c 300 gather.err 2>/dev/null || true)
+            jq -n --arg pr "$PR" --arg err "gather failed: $ERR" '{
+              pr: $pr,
+              unresolvedComments: [],
+              unresolvedCommentsAvailable: false,
+              unresolvedCommentsError: $err,
+              ciAvailable: false,
+              mergeState: { mergeable: "UNKNOWN", mergeStateStatus: "UNKNOWN", state: "OPEN" },
+              ci: { checks: [], failing: [], pending: [] },
+              branch: { ahead: 0, behind: 0 }
+            }' > bundle.json
           fi
 
       - name: Gather merge verdict (single source — forge shepherd --pull)
@@ -227,8 +246,9 @@ jobs:
           set -uo pipefail
           # Keep EXACTLY ONE pr-verdict:* label on the PR — the cheap agent-agnostic
           # read (`gh pr view <pr> --json labels`). Ensure the chosen label exists
-          # (upsert), strip any stale sibling, then add the chosen one. Surface only:
-          # a LABEL never merges, never resolves threads, never blocks.
+          # (upsert), then remove EVERY OTHER label in the pr-verdict:* enum (not just
+          # a presumed single sibling, so multiple stale ones can't linger), and add
+          # the chosen one. Surface only: a LABEL never merges, resolves, or blocks.
           gh label create "$LABEL" --repo "$GH_REPO" --force --color BFD4F2 \
             --description "Forge PR verdict (auto, surface only)" > /dev/null 2>&1 || true
           IFS=',' read -ra LABELS <<< "$ALL_LABELS"
-- 
