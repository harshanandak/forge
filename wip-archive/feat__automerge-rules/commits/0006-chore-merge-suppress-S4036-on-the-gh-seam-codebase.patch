From 5c445b7bbb5aa340b5420f98db3d4082aa28a5fb Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Sat, 4 Jul 2026 17:55:47 +0530
Subject: [PATCH] chore(merge): suppress S4036 on the gh seam (codebase
 convention)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The gh execFileSync in defaultGh trips SonarCloud S4036 (PATH-resolved binary)
only because this PR shifted it into new-code scope. Match the established repo
convention (plan.js/doc-gate.js): // NOSONAR S4036 — hardcoded CLI, args array
(no shell), developer-tool context.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 lib/commands/merge.js | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/commands/merge.js b/lib/commands/merge.js
index 4f1fc70a..24ca1fd9 100644
--- a/lib/commands/merge.js
+++ b/lib/commands/merge.js
@@ -46,7 +46,7 @@ const { evaluateMergeRules } = require('../merge-rules');
 
 /** Default `gh` runner. Only reached by the default fetch/merge seams (never in unit tests). */
 function defaultGh(args, options = {}) {
-  return execFileSync('gh', args, { encoding: 'utf8', ...options });
+  return execFileSync('gh', args, { encoding: 'utf8', ...options }); // NOSONAR S4036 - hardcoded CLI (gh), args array (no shell), developer-tool context
 }
 
 /** Parse `gh ... --json` output, returning `null` on any failure (callers fail closed). */
-- 
2.51.0.windows.1

