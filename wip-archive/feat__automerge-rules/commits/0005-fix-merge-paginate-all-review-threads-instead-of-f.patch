From 02ce00875d1f162925d35a9640f65706872f3552 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Sat, 4 Jul 2026 17:50:55 +0530
Subject: [PATCH] fix(merge): paginate all review threads instead of failing
 closed at 100

Following up the truncation guard: rather than returning undefined when a PR has
>100 review threads (which would make a large PR permanently un-mergeable and
could miss newer unresolved threads on page 2+), walk the GraphQL cursor through
every page and sum the true unresolved count. Unreadable page / missing cursor /
page-cap exceeded still fail closed.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 lib/commands/merge.js | 32 +++++++++++++++++++++-----------
 1 file changed, 21 insertions(+), 11 deletions(-)

diff --git a/lib/commands/merge.js b/lib/commands/merge.js
index 132d6bf1..4f1fc70a 100644
--- a/lib/commands/merge.js
+++ b/lib/commands/merge.js
@@ -69,17 +69,27 @@ function fetchUnresolvedThreadCount(gh, pr) {
     const owner = repo && repo.owner && repo.owner.login;
     const name = repo && repo.name;
     if (!owner || !name) return undefined;
-    const query = 'query($o:String!,$n:String!,$pr:Int!){repository(owner:$o,name:$n)'
-      + '{pullRequest(number:$pr){reviewThreads(first:100){pageInfo{hasNextPage}nodes{isResolved isOutdated}}}}}';
-    const out = gh(['api', 'graphql', '-f', `query=${query}`,
-      '-F', `o=${owner}`, '-F', `n=${name}`, '-F', `pr=${Number(pr)}`]);
-    const data = JSON.parse(out || '{}');
-    const threads = (((data.data || {}).repository || {}).pullRequest || {}).reviewThreads;
-    // >100 threads → the returned page is truncated and the count unreliable;
-    // return undefined so threads_resolved fails closed rather than trusting it.
-    if (threads && threads.pageInfo && threads.pageInfo.hasNextPage) return undefined;
-    const list = (threads && threads.nodes) || [];
-    return list.filter((t) => t && t.isResolved === false && t.isOutdated === false).length;
+    // Paginate through ALL review threads — a PR can have >100, and the ones on
+    // later pages could be the unresolved/newest ones. Stopping at page 1 would
+    // both miss them and make a large PR un-mergeable. Loop on the GraphQL cursor
+    // until hasNextPage is false; any unreadable page → undefined (fail closed).
+    const query = 'query($o:String!,$n:String!,$pr:Int!,$after:String){repository(owner:$o,name:$n)'
+      + '{pullRequest(number:$pr){reviewThreads(first:100,after:$after){pageInfo{hasNextPage endCursor}nodes{isResolved isOutdated}}}}}';
+    let after = '';
+    let count = 0;
+    for (let page = 0; page < 100; page += 1) { // 100-page cap = 10k threads backstop
+      const args = ['api', 'graphql', '-f', `query=${query}`,
+        '-F', `o=${owner}`, '-F', `n=${name}`, '-F', `pr=${Number(pr)}`];
+      if (after) args.push('-F', `after=${after}`);
+      const data = JSON.parse(gh(args) || '{}');
+      const threads = (((data.data || {}).repository || {}).pullRequest || {}).reviewThreads;
+      if (!threads) return undefined; // unreadable page → fail closed
+      count += (threads.nodes || []).filter((t) => t && t.isResolved === false && t.isOutdated === false).length;
+      if (!threads.pageInfo || !threads.pageInfo.hasNextPage) return count;
+      after = threads.pageInfo.endCursor;
+      if (!after) return undefined; // hasNextPage but no cursor → fail closed
+    }
+    return undefined; // exceeded the page cap → fail closed rather than undercount
   } catch (_err) {
     return undefined;
   }
