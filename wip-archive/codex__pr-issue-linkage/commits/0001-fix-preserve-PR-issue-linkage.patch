@@ -199,11 +208,19 @@ async function gatherDesired(gitCommonDir, opts = {}) {
 	if (!repo) return { openPrs: [], gitCommonDir, listingOk: false, repositoryOk: false };
 
 	let prRows = [];
+	let worktreeRows = [];
 	try {
 		if (broker) prRows = await broker.listOpenPrs(gitCommonDir);
 	} catch {
 		/* kernel unavailable → treat as no linkage; the GitHub-driven desired set still stands */
 	}
+	try {
+		if (broker && typeof broker.listWorktrees === 'function') {
+			worktreeRows = await broker.listWorktrees({ state: 'active' });
+		}
+	} catch {
+		/* older/unavailable registry → preserve the existing PR-row linkage behavior */
+	}
 	// Key by canonical (repo, number). A single bare-name row is accepted
 	// only as a one-way compatibility bridge; it is rewritten under the canonical key
 	// and retired by the same reconcile pass. The common-dir natural key plus an exact
@@ -270,16 +287,34 @@ async function gatherDesired(gitCommonDir, opts = {}) {
 		const exact = exactRows.get(String(p.number)) || [];
 		return exact.length === 1 ? exact[0] : null;
 	};
+	const worktreesForBranch = (branch) => (Array.isArray(worktreeRows) ? worktreeRows : [])
+		.filter((row) => row && row.state === 'active' && row.branch === branch);
+	for (const pr of ghPrs) {
+		const candidates = worktreesForBranch(pr && pr.headRefName);
+		if (candidates.length === 0) continue;
+		if (candidates.length !== 1 || !sameGitCommonDir(candidates[0].git_common_dir, gitCommonDir)) {
+			return { openPrs: [], gitCommonDir, listingOk: false, repositoryOk: false };
+		}
+		const candidate = candidates[0];
+		const existing = rowForPr(pr);
+		if (
+			(existing?.issue_id != null && candidate.issue_id != null && existing.issue_id !== candidate.issue_id)
+			|| (existing?.worktree_id != null && candidate.id != null && existing.worktree_id !== candidate.id)
+		) {
+			return { openPrs: [], gitCommonDir, listingOk: false, repositoryOk: false };
+		}
+	}
 
 	const openPrs = ghPrs.map((p) => {
 		const row = rowForPr(p);
+		const worktree = worktreesForBranch(p.headRefName)[0] || null;
 		return {
 			repo: canonicalRepo || repo,
 			number: p.number,
 			branch: p.headRefName ?? null,
 			headSha: p.headRefOid ?? null,
-			issueId: row?.issue_id ?? null,
-			worktreeId: row?.worktree_id ?? null,
+			issueId: row?.issue_id ?? worktree?.issue_id ?? null,
+			worktreeId: row?.worktree_id ?? worktree?.id ?? null,
 			journalPtr: row?.journal_ptr ?? null,
 		};
 	});
