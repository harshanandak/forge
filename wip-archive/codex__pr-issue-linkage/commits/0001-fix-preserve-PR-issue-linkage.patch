 const { getResolvedRuntimeGraph } = require('../core/runtime-graph');
+const { resolveGitCommonDir } = require('../kernel/broker');
 
 const AUTO_SHEPHERD_RAIL = 'rail.auto_shepherd';
+const FORGE_ISSUE_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
 
 /**
  * Whether the default-ON `rail.auto_shepherd` rail permits auto-starting the PR
@@ -510,6 +512,61 @@ async function createPR(options) { // NOSONAR S3776
 	}
 }
 
+function samePath(left, right) {
+	if (typeof left !== 'string' || typeof right !== 'string') return false;
+	const normalized = (value) => {
+		const resolved = path.resolve(value);
+		return process.platform === 'win32' ? resolved.toLowerCase() : resolved;
+	};
+	return normalized(left) === normalized(right);
+}
+
+async function registerShipIssueLinkage({ projectRoot, issueId, exec = execFileSync, buildDeps } = {}) {
+	if (!FORGE_ISSUE_ID.test(issueId || '')) {
+		return { success: false, error: '--issue requires a full Forge issue id.' };
+	}
+	try {
+		const branch = exec('git', ['rev-parse', '--abbrev-ref', 'HEAD'], getGitExecOptions(projectRoot)).trim();
+		if (!branch || branch === 'HEAD') return { success: false, error: 'Cannot link a detached HEAD to an issue.' };
+		const gitCommonDir = resolveGitCommonDir(projectRoot, { execFileSync: exec });
+		const factory = buildDeps || (async (options) => {
+			const { buildMigratedKernelIssueDeps } = require('../kernel/cli-broker-factory');
+			return buildMigratedKernelIssueDeps(options);
+		});
+		const { kernelDriver: driver } = await factory({ projectRoot, gitCommonDir });
+		const issueMatches = await driver.findIssueIdsByPrefix(issueId, 6, {}, {});
+		if (!Array.isArray(issueMatches) || !issueMatches.some((row) => (row?.id ?? row) === issueId)) {
+			return { success: false, error: `Forge issue ${issueId} does not exist.` };
+		}
+		const matches = (driver.listWorktrees({ state: 'active' }) || [])
+			.filter((row) => row?.branch === branch);
+		if (matches.length > 1) return { success: false, error: `Branch ${branch} has ambiguous active worktree linkage.` };
+		const existing = matches[0] || null;
+		if (existing && (!samePath(existing.git_common_dir, gitCommonDir) || !samePath(existing.path, projectRoot))) {
+			return { success: false, error: `Branch ${branch} is registered to a different repository or worktree.` };
+		}
+		if (existing?.issue_id && existing.issue_id !== issueId) {
+			return { success: false, error: `Branch ${branch} is already linked to issue ${existing.issue_id}.` };
+		}
+		if (!existing?.issue_id) {
+			driver.registerWorktree({
+				id: existing?.id,
+				git_common_dir: gitCommonDir,
+				path: projectRoot,
+				branch,
+				actor: process.env.FORGE_ACTOR || null,
+				issue_id: issueId,
+				work_folder: existing?.work_folder ?? null,
+				registered_at: new Date().toISOString(),
+				state: 'active',
+			});
+		}
+		return { success: true, issueId };
+	} catch (error) {
+		return { success: false, error: `Failed to register PR issue linkage: ${error.message}` };
+	}
+}
+
 /**
  * Best-effort wake of the repository-wide singleton after a successful real ship.
  * The shared trigger owns containment and gate checks; dry-run skips before it.
