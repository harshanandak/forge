From 3f7d0d863716edbc320a8cb9bdb3e97f59dd1bdd Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Wed, 15 Jul 2026 15:58:16 +0530
Subject: [PATCH] feat(migrate): report unmapped Beads sidecars as honest
 field-gaps (a7e1443c, 0df2879e)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Beads→Kernel migrator loaded only the six sidecars it maps
(issues/comments/dependencies/events/interactions/labels) and silently
dropped any other *.jsonl in the store — e.g. config.jsonl. That is
exactly the unread-sidecar data-loss class the migrator exists to close,
and the "honest field-gap report for anything that doesn't map"
requirement (0df2879e) was not met for these files.

loadBeadsSnapshotFromDirectory now scans the same locations
readBeadsSidecar reads (the dir, a backup/ subdir, and the parent) for
*.jsonl files outside the handled set and records them on
snapshot.unmigratedSidecars. importBeadsSnapshot surfaces each as a
`sidecar.<name>` gap, so `forge migrate --from beads` (dry-run and real)
reports them in both human and --json output instead of dropping them
without a word. Generalizes to unknown/future sidecars, not just config.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 lib/adapters/beads-kernel-compat.js       | 43 +++++++++++++++++++++++
 test/adapters/beads-kernel-compat.test.js | 16 +++++++++
 2 files changed, 59 insertions(+)

diff --git a/lib/adapters/beads-kernel-compat.js b/lib/adapters/beads-kernel-compat.js
index ffeab640..1ee0a0b9 100644
--- a/lib/adapters/beads-kernel-compat.js
+++ b/lib/adapters/beads-kernel-compat.js
@@ -95,6 +95,42 @@ function readBeadsSidecar(beadsDir, file) {
   return found ? parseJsonl(fs.readFileSync(found, 'utf8'), path.basename(found)) : [];
 }
 
+// The *.jsonl sidecars this migrator knows how to map into the Kernel. Any other *.jsonl
+// present in the store is unmapped data; the loader records it so the import can report it
+// as an honest gap rather than dropping it silently.
+const HANDLED_SIDECARS = new Set([
+  'issues.jsonl',
+  'comments.jsonl',
+  'dependencies.jsonl',
+  'events.jsonl',
+  'interactions.jsonl',
+  'labels.jsonl',
+]);
+
+// Scan the same locations readBeadsSidecar reads (the dir itself, a `backup/` subdir, and the
+// parent) for *.jsonl files this migrator does NOT map. Returns their sorted, de-duplicated
+// basenames so importBeadsSnapshot can surface each as a `sidecar.<name>` field-gap — closing
+// the "an unknown/config sidecar was dropped without a word" data-loss class.
+function detectUnmigratedSidecars(beadsDir) {
+  const dirs = [beadsDir, path.join(beadsDir, 'backup'), path.dirname(beadsDir)];
+  const unmigrated = new Set();
+  for (const dir of dirs) {
+    let entries;
+    try {
+      entries = fs.readdirSync(dir);
+    } catch (_err) {
+      /* intentional: an unreadable candidate dir contributes no sidecars */ // NOSONAR S2486
+      continue;
+    }
+    for (const entry of entries) {
+      if (entry.endsWith('.jsonl') && !HANDLED_SIDECARS.has(entry)) {
+        unmigrated.add(entry);
+      }
+    }
+  }
+  return [...unmigrated].sort();
+}
+
 function loadBeadsSnapshotFromDirectory(beadsDir) {
   if (!beadsDir || typeof beadsDir !== 'string') {
     throw new TypeError('beadsDir must be a directory path');
@@ -108,6 +144,7 @@ function loadBeadsSnapshotFromDirectory(beadsDir) {
     events: readBeadsSidecar(beadsDir, 'events.jsonl'),
     interactions: readBeadsSidecar(beadsDir, 'interactions.jsonl'),
     labels: readBeadsSidecar(beadsDir, 'labels.jsonl'),
+    unmigratedSidecars: detectUnmigratedSidecars(beadsDir),
   };
 }
 
@@ -725,6 +762,12 @@ function importBeadsSnapshot(snapshot = {}, options = {}) {
     ...(Array.isArray(snapshot.events) ? snapshot.events : []).map(event => mapBeadsActivityEventToKernel(event, importedAt)),
     ...(Array.isArray(snapshot.interactions) ? snapshot.interactions : []).map(interaction => mapBeadsInteractionToKernel(interaction, importedAt)),
   ];
+  // Honest field-gap report: any *.jsonl sidecar present in the store that this migrator does
+  // not map (e.g. config.jsonl, or a future/unknown sidecar) is surfaced here rather than
+  // silently dropped. The loader records these on `unmigratedSidecars`.
+  for (const sidecar of Array.isArray(snapshot.unmigratedSidecars) ? snapshot.unmigratedSidecars : []) {
+    addGap(gaps, seenGaps, `sidecar.${sidecar}`, 'present in the Beads store but has no Kernel target — not migrated');
+  }
   const kernel = {
     issues: sourceIssues.map(issue => mapBeadsIssueToKernel(issue, importedAt, gaps, seenGaps)),
     dependencies: collectDependencies(normalizedSnapshot)
diff --git a/test/adapters/beads-kernel-compat.test.js b/test/adapters/beads-kernel-compat.test.js
index e935aa9e..2923cd1e 100644
--- a/test/adapters/beads-kernel-compat.test.js
+++ b/test/adapters/beads-kernel-compat.test.js
@@ -563,6 +563,22 @@ describe('Beads Kernel compatibility adapter', () => {
 		});
 	});
 
+	test('surfaces an unmigrated Beads sidecar (config.jsonl) as an honest gap', () => {
+		const snapshot = loadBeadsSnapshotFromDirectory(LEGACY_BACKUP_DIR);
+		const result = importBeadsSnapshot(snapshot, { importedAt: IMPORTED_AT });
+
+		// config.jsonl is present in the store but has no Kernel target. It must be
+		// reported honestly, never silently dropped — that unread-sidecar data loss is
+		// exactly the class this migrator exists to close.
+		expect(snapshot.unmigratedSidecars).toContain('config.jsonl');
+		const gap = result.report.gaps.find(entry => entry.field === 'sidecar.config.jsonl');
+		expect(gap).toBeDefined();
+		expect(gap.reason).toMatch(/no Kernel target|not migrated/i);
+		// Handled sidecars are never falsely reported as unmigrated.
+		expect(snapshot.unmigratedSidecars).not.toContain('issues.jsonl');
+		expect(snapshot.unmigratedSidecars).not.toContain('interactions.jsonl');
+	});
+
 	test('imports label sidecars and issue notes with explicit fidelity coverage', () => {
 		const snapshot = {
 			issues: [{
