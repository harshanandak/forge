+}
+
 function decodePendingBatch(value, ctx, subjectRevision) {
   if (typeof value !== 'string' || value.length > PENDING_BATCH_LIMIT) {
     throw new FlowMonitorError('MONITOR_HISTORY_INCOMPLETE', 'Pending monitor transition batch is missing');
@@ -196,41 +208,126 @@ function segmentablePendingBatchError(error) {
     ].includes(error.message);
 }
 
-function splitPendingBatches(ctx, subjectRevision, records, snapshot) {
-  const batches = [];
-  let offset = 0;
-  while (offset < records.length) {
+function findAdaptiveBatchBoundary(maxCount, preferredCount, encode) {
+  if (!Number.isSafeInteger(maxCount) || maxCount < 1) return null;
+  let accepted = null;
+  const attempt = (count) => {
     try {
-      const encoded = encodePendingBatch(ctx, subjectRevision, records.slice(offset), snapshot);
-      appendPendingBatch(batches, { encoded, records: records.slice(offset), snapshot });
-      break;
+      accepted = { count, encoded: encode(count) };
+      return true;
     } catch (error) {
       if (!segmentablePendingBatchError(error)) throw error;
+      return false;
     }
-
+  };
+  const initialCount = Math.min(maxCount, Math.max(1, preferredCount || 1));
+  if (!attempt(initialCount)) {
     let low = 1;
-    let high = records.length - offset - 1;
-    let accepted = null;
+    let high = initialCount - 1;
     while (low <= high) {
       const count = Math.floor((low + high) / 2);
-      const candidate = records.slice(offset, offset + count);
-      try {
-        accepted = {
-          count,
-          encoded: encodePendingBatch(ctx, subjectRevision, candidate, null),
-          records: candidate,
-          snapshot: null,
-        };
-        low = count + 1;
-      } catch (error) {
-        if (!segmentablePendingBatchError(error)) throw error;
-        high = count - 1;
-      }
+      if (attempt(count)) low = count + 1;
+      else high = count - 1;
+    }
+    return accepted;
+  }
+
+  let low = initialCount + 1;
+  let probe = Math.min(maxCount, Math.max(low, initialCount * 2));
+  while (low <= maxCount) {
+    if (attempt(probe)) {
+      low = probe + 1;
+      if (probe === maxCount) break;
+      probe = Math.min(maxCount, Math.max(low, probe * 2));
+      continue;
+    }
+    let high = probe - 1;
+    while (low <= high) {
+      const count = Math.floor((low + high) / 2);
+      if (attempt(count)) low = count + 1;
+      else high = count - 1;
+    }
+    break;
+  }
+  return accepted;
+}
+
+function splitPendingBatches(
+  ctx,
+  subjectRevision,
+  records,
+  snapshot,
+  encodeBatch = encodeBoundedPendingBatch,
+) {
+  const batches = [];
+  if (records.length === 0) return batches;
+  if (records.length > PENDING_BATCH_RECORD_LIMIT) {
+    throw new FlowMonitorError('INVALID_OBSERVATION', 'Pending monitor transition batch exceeds its record bound');
+  }
+  const boundedRecords = records.map(durableMonitorRecord);
+  let offset = 0;
+  let preferredCount = 1;
+  let failedTerminalCount = null;
+  const appendTerminalBatch = (start) => {
+    const remainingCount = records.length - start;
+    try {
+      const encoded = encodeBatch(ctx, subjectRevision, boundedRecords.slice(start), snapshot);
+      appendPendingBatch(batches, { encoded, records: records.slice(start), snapshot });
+      return true;
+    } catch (error) {
+      if (!segmentablePendingBatchError(error)) throw error;
+      failedTerminalCount = remainingCount;
+      return false;
+    }
+  };
+
+  if (appendTerminalBatch(0)) return batches;
+
+  while (offset < records.length) {
+    const remainingCount = records.length - offset;
+    let accepted = findAdaptiveBatchBoundary(
+      remainingCount,
+      preferredCount,
+      count => encodeBatch(
+        ctx,
+        subjectRevision,
+        boundedRecords.slice(offset, offset + count),
+        null,
+      ),
+    );
+    if (!accepted && failedTerminalCount !== remainingCount && appendTerminalBatch(offset)) break;
+    if (accepted?.count === remainingCount && failedTerminalCount !== remainingCount) {
+      if (appendTerminalBatch(offset)) break;
+    }
+    if (accepted?.count === remainingCount) {
+      accepted = findAdaptiveBatchBoundary(
+        remainingCount - 1,
+        Math.min(preferredCount, remainingCount - 1),
+        count => encodeBatch(
+          ctx,
+          subjectRevision,
+          boundedRecords.slice(offset, offset + count),
+          null,
+        ),
+      );
+    }
+    if (accepted?.count < remainingCount
+      && batches.length === BATCH_PLAN_SEGMENT_LIMIT - 1) {
+      if (failedTerminalCount !== remainingCount && appendTerminalBatch(offset)) break;
+      throw new FlowMonitorError(
+        'INVALID_OBSERVATION',
+        'Pending monitor transition plan exceeds its segment bound',
+      );
     }
     if (!accepted) {
       throw new FlowMonitorError('INVALID_OBSERVATION', 'Pending monitor transition record exceeds its durable bound');
     }
-    appendPendingBatch(batches, accepted);
+    appendPendingBatch(batches, {
+      encoded: accepted.encoded,
+      records: records.slice(offset, offset + accepted.count),
+      snapshot: null,
+    });
+    preferredCount = accepted.count;
     offset += accepted.count;
   }
   return batches;
@@ -1418,7 +1515,9 @@ module.exports = {
     appendPendingBatch,
     decodePrivateSafeBase64,
     encodePrivateSafeBase64,
+    findAdaptiveBatchBoundary,
     remainingSegmentedRecords,
+    splitPendingBatches,
     validOrphanedPrecommitPlan,
   },
 };
