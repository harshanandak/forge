+		cwd: root,
+		encoding: 'utf8',
+		stdio: ['ignore', 'pipe', 'pipe'],
+	});
+}
+
+async function syncWorkflowHooks(options = {}) {
+	const root = path.resolve(options.root || process.cwd());
+	const runGit = options.execFileSync || execFileSync;
+	const env = options.env || process.env;
+	const actor = actorFromEnv(env);
+	const sourceHead = options.sourceHead || readSourceHead(root, runGit);
+	const issueAuthorization = options.issueAuthorization
+		|| require('./protected-state-authority').issueSetupWorkflowAuthorization;
+	const completeAuthorization = options.completeAuthorization
+		|| require('./protected-state-authority').completeSetupWorkflowAuthorization;
+	const writeFile = options.writeProtectedFile || writeProtectedFile;
+	const files = [
+		{ path: LEFTHOOK_PATH, content: renderRepositoryLefthook(readHeadLefthook(root, sourceHead, runGit)) },
+		{ path: BASE_FRESHNESS_HOOK_PATH, content: renderBaseFreshnessHookEntrypoint() },
+	];
+
+	for (const file of files) {
+		const authorization = await issueAuthorization(root, { actor, sourceHead, ...file });
+		if (!authorization.success) throw new Error(`authorization failed for ${file.path}: ${authorization.error}`);
+		const target = path.join(root, file.path);
+		const expectedContent = fs.existsSync(target) ? fs.readFileSync(target) : null;
+		const written = writeFile(root, file.path, file.content, {
+			actor,
+			surface: 'workflows',
+			viaForgeApi: true,
+			operation: 'sync_workflow_hook',
+			expectedContent,
+		});
+		if (!written.allowed) throw new Error(`protected write failed for ${file.path}: ${written.reason}`);
+		const completion = await completeAuthorization(root, {
+			actor,
+			capabilityId: authorization.capabilityId,
+			sourceHead,
+			...file,
+		});
+		if (!completion.success) throw new Error(`completion failed for ${file.path}: ${completion.error}`);
+	}
+
+	runGit('git', ['add', '--', ...files.map(file => file.path)], {
+		cwd: root,
+		stdio: ['ignore', 'ignore', 'pipe'],
+	});
+	return { success: true, actor, sourceHead, files: files.map(file => file.path) };
+}
+
+module.exports = {
+	BASE_FRESHNESS_HOOK_PATH,
+	LEFTHOOK_PATH,
+	SETUP_WORKFLOW_SOURCE_COMMAND,
+	actorFromEnv,
+	renderBaseFreshnessHookEntrypoint,
+	renderRepositoryLefthook,
+	syncWorkflowHooks,
+};
