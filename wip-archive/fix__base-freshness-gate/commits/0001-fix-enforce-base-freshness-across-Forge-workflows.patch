+		"const path = require('node:path');",
+		'',
+		"const installedImplementation = path.resolve(__dirname, '..', 'lib', 'base-freshness-check.js');",
+		"const sourceImplementation = path.resolve(__dirname, '..', '..', 'lib', 'base-freshness-check.js');",
+		'const implementation = require(fs.existsSync(installedImplementation)',
