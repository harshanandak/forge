diff --git a/lib/base-freshness-check.js b/lib/base-freshness-check.js
new file mode 100644
index 00000000..08ab473e
--- /dev/null
+++ b/lib/base-freshness-check.js
@@ -0,0 +1,55 @@
+'use strict';
+
+const fs = require('node:fs');
+const { verifyBaseFreshness } = require('./base-freshness');
+const { readFreshnessToken, isStale } = require('./freshness-token');
+
+function parseUpdates(input = '') {
+	return input.split(/\r?\n/).filter(Boolean).map(line => {
+		const [localRef, localSha, remoteRef, remoteSha] = line.trim().split(/\s+/);
+		return { localRef, localSha, remoteRef, remoteSha };
+	}).filter(update => update.localRef && update.localSha);
+}
+
+function run(projectRoot = process.cwd(), deps = {}, input = '') {
+	const verify = deps.verifyBaseFreshness || verifyBaseFreshness;
+	const readToken = deps.readFreshnessToken || readFreshnessToken;
+	const stale = deps.isFreshnessStale || isStale;
+	const token = readToken(projectRoot);
+	const updates = parseUpdates(input).filter(update => !/^0+$/.test(update.localSha));
+	const targets = updates.length > 0 ? updates : [{}];
+	let freshness;
+	for (const update of targets) {
+		const branchName = update.localRef?.startsWith('refs/heads/')
+			? update.localRef.slice('refs/heads/'.length)
+			: undefined;
+		freshness = verify({
+			cwd: projectRoot,
+			exec: deps.execFileSync,
+			...(update.localSha ? { headRef: update.localSha } : {}),
+			...(branchName ? { branchName } : {}),
+		});
+		if (!freshness.success) return freshness;
+		if (stale(token, projectRoot, freshness)) {
+			return {
+				...freshness,
+				success: false,
+				error: `Validation is stale for ${freshness.baseRef} (${freshness.baseSha}); run forge validate again before pushing.`,
+			};
+		}
+	}
+	return { ...freshness, checkedRefs: targets.length };
+}
+
+function main(projectRoot = process.cwd(), deps = {}) {
+	const input = process.stdin.isTTY ? '' : fs.readFileSync(0, 'utf8');
+	const result = run(projectRoot, deps, input);
+	if (!result.success) {
+		console.error(`Base freshness check failed: ${result.error}`);
+		return 1;
+	}
+	console.log(`Base freshness verified: ${result.baseRef} (${result.baseSha})`);
+	return 0;
+}
+
+module.exports = { main, parseUpdates, run };
diff --git a/lib/base-freshness.js b/lib/base-freshness.js
new file mode 100644
index 00000000..6c833024
--- /dev/null
+++ b/lib/base-freshness.js
@@ -0,0 +1,156 @@
+'use strict';
+
+const { execFileSync } = require('node:child_process');
+
+function gitOptions(cwd) {
+	return { encoding: 'utf8', cwd, timeout: 120000, stdio: 'pipe' };
+}
+
+function gitText(exec, args, cwd) {
+	return String(exec('git', args, gitOptions(cwd))).trim();
+}
+
+function resolveBaseRemote(exec = execFileSync, cwd = process.cwd()) {
+	for (const candidate of ['upstream', 'origin']) {
+		try {
+			gitText(exec, ['remote', 'get-url', candidate], cwd);
+			return candidate;
+		} catch (_error) {
+			// Probe the next remote.
+		}
+	}
+	throw new Error('No upstream or origin remote is configured');
+}
+
+function resolveBaseBranch(exec = execFileSync, cwd = process.cwd(), remoteName = resolveBaseRemote(exec, cwd)) {
+	const output = gitText(exec, ['ls-remote', '--symref', remoteName, 'HEAD'], cwd);
+	const match = /^ref:\s+refs\/heads\/(.+)\s+HEAD$/m.exec(output);
+	if (!match?.[1]) {
+		throw new Error(`Remote '${remoteName}' did not advertise a default branch`);
+	}
+	return match[1];
+}
+
+function refreshBaseReference(exec = execFileSync, cwd = process.cwd(), remoteName, baseBranch) {
+	gitText(exec, [
+		'fetch', '--quiet', '--no-tags', remoteName,
+		`refs/heads/${baseBranch}:refs/remotes/${remoteName}/${baseBranch}`,
+	], cwd);
+}
+
+function failure(context, error, extra = {}) {
+	return { success: false, ...context, ...extra, error };
+}
+
+function discoverBase(options, exec, cwd) {
+	try {
+		const baseRemote = options.baseRemote || resolveBaseRemote(exec, cwd);
+		const baseBranch = options.baseBranch || resolveBaseBranch(exec, cwd, baseRemote);
+		return { baseRemote, baseBranch, baseRef: `${baseRemote}/${baseBranch}` };
+	} catch (error) {
+		return failure({}, `Unable to discover the tracked default branch. Git said: ${error.message}`);
+	}
+}
+
+function resolveBranchName(options, exec, cwd, context) {
+	try {
+		const branchName = options.branchName
+			|| gitText(exec, ['rev-parse', '--abbrev-ref', 'HEAD'], cwd);
+		if (!branchName || branchName === 'HEAD') {
+			return failure({ ...context, branchName: branchName || 'HEAD' }, 'Current HEAD is detached. Check out a feature branch before continuing.');
+		}
+		return { ...context, branchName };
+	} catch (error) {
+		return failure(context, `Unable to resolve the current branch. Git said: ${error.message}`);
+	}
+}
+
+function refreshBase(exec, cwd, context) {
+	try {
+		refreshBaseReference(exec, cwd, context.baseRemote, context.baseBranch);
+		return context;
+	} catch (error) {
+		return failure(context, `Unable to refresh ${context.baseRef} before comparing branch readiness. Git said: ${error.message}`);
+	}
+}
+
+function resolveComparedCommits(exec, cwd, context, headRef) {
+	try {
+		return {
+			...context,
+			baseSha: gitText(exec, ['rev-parse', '--verify', `${context.baseRef}^{commit}`], cwd),
+			headSha: gitText(exec, ['rev-parse', '--verify', `${headRef}^{commit}`], cwd),
+		};
+	} catch (error) {
+		return failure(context, `Unable to resolve the fetched base or HEAD commit. Git said: ${error.message}`);
+	}
+}
+
+function resolveDivergence(exec, cwd, context, headRef) {
+	let counts;
+	try {
+		counts = gitText(exec, ['rev-list', '--left-right', '--count', `${context.baseRef}...${headRef}`], cwd);
+	} catch (error) {
+		return failure(context, `Unable to compare the current branch against ${context.baseRef}. Git said: ${error.message}`);
+	}
+	const match = /^(\d+)\s+(\d+)$/.exec(counts);
+	if (!match) return failure(context, `Unable to parse divergence from ${context.baseRef}: ${JSON.stringify(counts)}`);
+	return {
+		...context,
+		behind: Number.parseInt(match[1], 10),
+		ahead: Number.parseInt(match[2], 10),
+	};
+}
+
+function verifyCleanWorktree(exec, cwd, context) {
+	let conflictedFiles;
+	let status;
+	try {
+		conflictedFiles = gitText(exec, ['diff', '--name-only', '--diff-filter=U'], cwd).split(/\r?\n/).filter(Boolean);
+		status = gitText(exec, ['status', '--porcelain=v1', '--untracked-files=all'], cwd);
+	} catch (error) {
+		return failure(context, `Unable to verify whether the worktree is clean. Git said: ${error.message}`);
+	}
+	if (conflictedFiles.length > 0) {
+		return failure(context, `The working tree has unresolved conflicts: ${conflictedFiles.join(', ')}. Resolve them manually; Forge did not modify the worktree.`, { conflictedFiles });
+	}
+	const blockingStatus = status.split(/\r?\n/).filter(Boolean)
+		.filter(line => line !== '?? .forge/config.yaml');
+	return blockingStatus.length > 0
+		? failure(context, 'The working tree is dirty. Commit or stash it explicitly before beginning dev; Forge did not modify the worktree.')
+		: context;
+}
+
+/**
+ * Fetch and verify the selected remote's live default branch without changing
+ * the worktree. This function never rebases, merges, resets, checks out, or cleans.
+ */
+function verifyBaseFreshness(options = {}) {
+	const exec = options.exec || execFileSync;
+	const cwd = options.cwd || process.cwd();
+	const headRef = options.headRef || 'HEAD';
+	let context = discoverBase(options, exec, cwd);
+	if (context.success === false) return context;
+	context = resolveBranchName(options, exec, cwd, context);
+	if (context.success === false) return context;
+	context = refreshBase(exec, cwd, context);
+	if (context.success === false) return context;
+	context = resolveComparedCommits(exec, cwd, context, headRef);
+	if (context.success === false) return context;
+	context = resolveDivergence(exec, cwd, context, headRef);
+	if (context.success === false) return context;
+	if (options.requireClean) context = verifyCleanWorktree(exec, cwd, context);
+	if (context.success === false) return context;
+	if (context.behind > 0) {
+		return failure(context, `Current branch ${context.branchName} is ${context.behind} commit(s) behind ${context.baseRef}. Rebase manually, resolve conflicts yourself, then rerun the command.`);
+	}
+
+	return { success: true, ...context };
+}
+
+module.exports = {
+	resolveBaseRemote,
+	resolveBaseBranch,
+	refreshBaseReference,
+	verifyBaseFreshness,
+};
