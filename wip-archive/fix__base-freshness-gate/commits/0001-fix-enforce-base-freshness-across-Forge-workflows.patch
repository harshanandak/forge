+'use strict';
+
+const { describe, test, expect } = require('bun:test');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const {
+	resolveBaseRemote,
+	resolveBaseBranch,
+	verifyBaseFreshness,
+} = require('../lib/base-freshness');
+const { isStale } = require('../lib/freshness-token');
+const canonicalCheck = require('../lib/base-freshness-check');
+const scriptCheck = require('../scripts/base-freshness-check');
+const installedHookCheck = require('../.forge/hooks/check-base-freshness');
+const { run: runPrePushFreshness } = canonicalCheck;
+
+function makeGit(overrides = {}) {
+	const calls = [];
+	const exec = (command, args) => {
+		calls.push([...args]);
+		expect(command).toBe('git');
+
+		if (args[0] === 'remote' && args[1] === 'get-url' && args[2] === 'upstream') {
+			if (overrides.upstream) return 'https://example.test/base/repo.git\n';
+			throw new Error('no upstream');
+		}
+		if (args[0] === 'remote' && args[1] === 'get-url' && args[2] === 'origin') {
+			return 'https://example.test/fork/repo.git\n';
+		}
+		if (args[0] === 'ls-remote' && args[1] === '--symref') {
+			const remote = args[2];
+			return `ref: refs/heads/${overrides.baseBranch || 'trunk'}\tHEAD\n${remote}-sha\tHEAD\n`;
+		}
+		if (args[0] === 'rev-parse' && args[1] === '--verify') {
+			if (args[2].endsWith('^{commit}')) {
+				return args[2].startsWith('HEAD') ? 'head-sha\n' : `${overrides.baseSha || 'base-sha'}\n`;
+			}
+			return `${args[2]}\n`;
+		}
+		if (args[0] === 'rev-parse' && args[1] === '--abbrev-ref') return 'feat/freshness\n';
+		if (args[0] === 'fetch') {
+			if (overrides.fetchError) throw new Error(overrides.fetchError);
+			return '';
+		}
+		if (args[0] === 'rev-list') return overrides.counts || '0\t2\n';
+		if (args[0] === 'diff' && args[1] === '--name-only') return overrides.conflicts || '';
+		if (args[0] === 'status') return overrides.status || '';
+		throw new Error(`Unexpected git command: ${args.join(' ')}`);
+	};
+	return { exec, calls };
+}
+
+describe('base freshness gate', () => {
+	test('discovers a non-master default branch and records the fetched base SHA', () => {
+		const git = makeGit({ baseBranch: 'release/2026' });
+		const result = verifyBaseFreshness({ exec: git.exec, cwd: '/repo' });
+
+		expect(result.success).toBe(true);
+		expect(result.baseRemote).toBe('origin');
+		expect(result.baseBranch).toBe('release/2026');
+		expect(result.baseRef).toBe('origin/release/2026');
+		expect(result.baseSha).toBe('base-sha');
+		expect(result.headSha).toBe('head-sha');
+		const fetchIndex = git.calls.findIndex(args => args[0] === 'fetch');
+		const countIndex = git.calls.findIndex(args => args[0] === 'rev-list');
+		expect(fetchIndex).toBeGreaterThanOrEqual(0);
+		expect(countIndex).toBeGreaterThan(fetchIndex);
+	});
+
+	test('prefers an upstream default branch for a fork', () => {
+		const git = makeGit({ upstream: true, baseBranch: 'main' });
+		expect(resolveBaseRemote(git.exec, '/repo')).toBe('upstream');
+		expect(resolveBaseBranch(git.exec, '/repo', 'upstream')).toBe('main');
+	});
+
+	test('fails closed when the selected remote cannot be fetched', () => {
+		const result = verifyBaseFreshness({
+			exec: makeGit({ fetchError: 'network unavailable' }).exec,
+			cwd: '/repo',
+		});
+
+		expect(result.success).toBe(false);
+		expect(result.error).toContain('Unable to refresh origin/trunk');
+		expect(result.error).toContain('network unavailable');
+	});
+
+	test('refuses a behind branch without attempting a rebase', () => {
+		const git = makeGit({ counts: '3\t1\n' });
+		const result = verifyBaseFreshness({ exec: git.exec, cwd: '/repo' });
+
+		expect(result.success).toBe(false);
+		expect(result.behind).toBe(3);
+		expect(result.error).toContain('3 commit(s) behind origin/trunk');
+		expect(git.calls.some(args => args[0] === 'rebase' || args[0] === 'merge')).toBe(false);
+	});
+
+	test('preserves and refuses a dirty worktree at dev entry', () => {
+		const git = makeGit({ status: ' M lib/commands/dev.js\n' });
+		const result = verifyBaseFreshness({ exec: git.exec, cwd: '/repo', requireClean: true });
+
+		expect(result.success).toBe(false);
+		expect(result.error).toContain('working tree is dirty');
+		expect(git.calls.some(args => args[0] === 'reset' || args[0] === 'checkout' || args[0] === 'clean')).toBe(false);
+	});
+
+	test('allows only the Forge-owned activation config as untracked runtime output', () => {
+		const git = makeGit({ status: '?? .forge/config.yaml\n' });
+		const result = verifyBaseFreshness({ exec: git.exec, cwd: '/repo', requireClean: true });
+
+		expect(result.success).toBe(true);
+		expect(git.calls).toContainEqual(['status', '--porcelain=v1', '--untracked-files=all']);
+	});
+
+	test('preserves and refuses arbitrary untracked worktree files', () => {
+		const git = makeGit({ status: '?? notes.txt\n' });
+		const result = verifyBaseFreshness({ exec: git.exec, cwd: '/repo', requireClean: true });
+
+		expect(result.success).toBe(false);
+		expect(result.error).toContain('working tree is dirty');
+		expect(git.calls.some(args => args[0] === 'clean')).toBe(false);
+	});
+
+	test('refuses unresolved conflicts without modifying them', () => {
+		const git = makeGit({ conflicts: 'lib/commands/ship.js\n', status: 'UU lib/commands/ship.js\n' });
+		const result = verifyBaseFreshness({ exec: git.exec, cwd: '/repo', requireClean: true });
+
+		expect(result.success).toBe(false);
+		expect(result.error).toContain('unresolved conflicts');
+		expect(result.conflictedFiles).toEqual(['lib/commands/ship.js']);
+		expect(git.calls.some(args => args[0] === 'rebase' || args[0] === 'merge')).toBe(false);
+	});
+
+	test('fails closed on malformed divergence output', () => {
+		const result = verifyBaseFreshness({
+			exec: makeGit({ counts: 'not-a-count\n' }).exec,
+			cwd: '/repo',
+		});
+
+		expect(result.success).toBe(false);
+		expect(result.error).toContain('Unable to parse divergence');
+	});
+
+	test('invalidates validation evidence when the fetched base advances', () => {
+		const token = {
+			branch: 'feat/freshness',
+			headCommit: 'head-sha',
+			baseRemote: 'origin',
+			baseBranch: 'trunk',
+			baseCommit: 'old-base-sha',
+		};
+		const freshness = {
+			branchName: 'feat/freshness',
+			headSha: 'head-sha',
+			baseRemote: 'origin',
+			baseBranch: 'trunk',
+			baseSha: 'new-base-sha',
+		};
+
+		expect(isStale(token, '/repo', freshness)).toBe(true);
+	});
+
+	test('pre-push refuses an alternate local ref that was not validated', () => {
+		const token = {
+			version: 1,
+			branch: 'feat/current',
+			headCommit: 'current-sha',
+			baseRemote: 'origin',
+			baseBranch: 'trunk',
+			baseRef: 'origin/trunk',
+			baseCommit: 'base-sha',
+		};
+		const verify = options => ({
+			success: true,
+			branchName: options.branchName || 'feat/current',
+			headSha: options.headRef || 'current-sha',
+			baseRemote: 'origin',
+			baseBranch: 'trunk',
+			baseRef: 'origin/trunk',
+			baseSha: 'base-sha',
+			behind: 0,
+			ahead: 1,
+		});
+		const result = runPrePushFreshness('/repo', {
+			verifyBaseFreshness: verify,
+			readFreshnessToken: () => token,
+		}, 'refs/heads/alternate alternate-sha refs/heads/alternate remote-sha\n');
+
+		expect(result.success).toBe(false);
+		expect(result.error).toContain('Validation is stale');
+	});
+
+	test('compares an explicitly pushed SHA instead of the checked-out HEAD', () => {
+		const git = makeGit();
+		const result = verifyBaseFreshness({
+			exec: git.exec,
+			cwd: '/repo',
+			branchName: 'feat/alternate',
+			headRef: 'alternate-sha',
+		});
+
+		expect(result.success).toBe(true);
+		expect(git.calls).toContainEqual(['rev-parse', '--verify', 'alternate-sha^{commit}']);
+		expect(git.calls).toContainEqual(['rev-list', '--left-right', '--count', 'origin/trunk...alternate-sha']);
+		expect(git.calls).not.toContainEqual(['rev-parse', '--abbrev-ref', 'HEAD']);
+	});
+
+	test('keeps one canonical implementation behind both thin entrypoints', () => {
+		const root = path.join(__dirname, '..');
+		expect(scriptCheck.run).toBe(canonicalCheck.run);
+		expect(installedHookCheck.run).toBe(canonicalCheck.run);
+		expect(fs.readFileSync(path.join(root, '.forge', 'hooks', 'check-base-freshness.js'), 'utf8'))
+			.not.toBe(fs.readFileSync(path.join(root, 'scripts', 'base-freshness-check.js'), 'utf8'));
+	});
+});
