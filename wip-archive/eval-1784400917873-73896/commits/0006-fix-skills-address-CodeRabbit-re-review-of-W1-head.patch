@@ -886,11 +886,34 @@ function hasExistingKernelDb(projectRoot) {
   }
 }
 
+/**
+ * True when the ACTIVE issue backend would lazily create a store on read. Only the KERNEL path
+ * does that (it creates/migrates `.git/forge/kernel.sqlite`), so gate on an existing Kernel DB
+ * ONLY when the resolved backend is kernel. A Beads-backed project reads `.beads` via `bd`
+ * (non-creating) and has no kernel DB, so it must NOT be suppressed here — else `forge prime`
+ * would show "Claimed: none / Ready: none" for Beads projects that DO have live data. Never throws.
+ * @param {string} projectRoot
+ * @param {object} env
+ * @returns {boolean} true iff the read must be skipped to stay read-only.
+ */
+function shouldSkipLiveSnapshot(projectRoot, env) {
+  let backend;
+  try {
+    const { resolveIssueBackend } = require('./issue-backend');
+    backend = resolveIssueBackend({ env: env || process.env, projectRoot, warn: () => {} });
+  } catch {
+    backend = 'kernel'; // conservative default: treat as the create-on-read kernel path
+  }
+  if (backend === 'beads') return false; // bd reads existing .beads without creating it
+  return !hasExistingKernelDb(projectRoot); // kernel path: require an already-existing DB
+}
+
 /**
  * Acquire the status snapshot for live-state WITHOUT ever creating state. An injected
- * `_readSnapshot` (tests) bypasses the guards; otherwise the read is gated on a real git repo AND
- * an already-existing Kernel DB, so a fresh/un-initialized repo returns null (honest fallback)
- * and nothing is written. Never throws.
+ * `_readSnapshot` (tests) bypasses the guards; otherwise the read is gated on a real git repo and
+ * a backend-aware store check (see shouldSkipLiveSnapshot), so a fresh/un-initialized KERNEL repo
+ * returns null (honest fallback) and nothing is written, while a Beads project still reads live.
+ * Never throws.
  * @returns {Promise<object|null>}
  */
 async function acquireLiveSnapshot(projectRoot, env, options) {
@@ -898,7 +921,7 @@ async function acquireLiveSnapshot(projectRoot, env, options) {
     try { return await options._readSnapshot(); } catch { return null; }
   }
   if (!fs.existsSync(path.join(projectRoot, '.git'))) return null;
-  if (!hasExistingKernelDb(projectRoot)) return null; // read-only: never create the store
+  if (shouldSkipLiveSnapshot(projectRoot, env)) return null; // read-only: never create the store
   try {
     const { readStatusSnapshot } = require('./status/snapshot');
     return await readStatusSnapshot(projectRoot, { env });
@@ -1049,6 +1072,7 @@ module.exports = {
