From f8af33689dee68365979bfc795ec936fc71a4180 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Tue, 11 Aug 2026 01:59:29 +0530
Subject: [PATCH] refactor(review): resolve Sonar maintainability findings

---
 lib/pr-monitor/gather.js         | 102 ++++++++++++++++++++-----------
 lib/pr-monitor/render-summary.js |  21 ++++---
 lib/review-adapter.js            |   8 +--
 3 files changed, 82 insertions(+), 49 deletions(-)

diff --git a/lib/pr-monitor/gather.js b/lib/pr-monitor/gather.js
index 9ffbb2db..2a6a4c83 100644
--- a/lib/pr-monitor/gather.js
+++ b/lib/pr-monitor/gather.js
@@ -57,10 +57,13 @@ function identifiedSurface(value) {
   return null;
 }
 
-function createEvidenceTracker(initialDegraded) {
-  const degraded = [];
-  const incompleteSurfaces = new Set();
-  const add = (surface, error) => {
+function addIdentifiedSurface(value, add, error) {
+  const surface = identifiedSurface(value);
+  if (surface) add(surface, error);
+}
+
+function createEvidenceAdder(degraded, incompleteSurfaces) {
+  return (surface, error) => {
     const safeSurface = evidenceText(surface) || 'unknown';
     const safeError = evidenceText(error) || 'evidence unavailable';
     incompleteSurfaces.add(safeSurface);
@@ -69,24 +72,36 @@ function createEvidenceTracker(initialDegraded) {
       degraded.push({ surface: safeSurface, error: safeError });
     }
   };
+}
+
+function trackDegradedItem(item, add) {
+  if (!item || typeof item !== 'object' || Array.isArray(item)) {
+    add('degraded', 'degraded evidence item is malformed');
+    addIdentifiedSurface(item, add, 'degraded evidence metadata is malformed');
+    return;
+  }
+  add(item.source || item.surface || 'unknown', item.error || 'evidence unavailable');
+}
+
+function trackInitialDegraded(initialDegraded, add) {
   if (!Array.isArray(initialDegraded)) {
     add('degraded', 'degraded evidence is malformed');
-    const surface = identifiedSurface(initialDegraded);
-    if (surface) add(surface, 'degraded evidence metadata is malformed');
-  } else {
-    for (const item of initialDegraded.slice(0, SNAPSHOT_LIMITS.maxDegraded)) {
-      if (!item || typeof item !== 'object' || Array.isArray(item)) {
-        add('degraded', 'degraded evidence item is malformed');
-        const surface = identifiedSurface(item);
-        if (surface) add(surface, 'degraded evidence metadata is malformed');
-      } else {
-        add(item.source || item.surface || 'unknown', item.error || 'evidence unavailable');
-      }
-    }
-    if (initialDegraded.length > SNAPSHOT_LIMITS.maxDegraded) {
-      add('degraded', 'degraded evidence exceeded item limit');
-    }
+    addIdentifiedSurface(initialDegraded, add, 'degraded evidence metadata is malformed');
+    return;
+  }
+  for (const item of initialDegraded.slice(0, SNAPSHOT_LIMITS.maxDegraded)) {
+    trackDegradedItem(item, add);
   }
+  if (initialDegraded.length > SNAPSHOT_LIMITS.maxDegraded) {
+    add('degraded', 'degraded evidence exceeded item limit');
+  }
+}
+
+function createEvidenceTracker(initialDegraded) {
+  const degraded = [];
+  const incompleteSurfaces = new Set();
+  const add = createEvidenceAdder(degraded, incompleteSurfaces);
+  trackInitialDegraded(initialDegraded, add);
   return { add, degraded, incompleteSurfaces };
 }
 
@@ -226,6 +241,30 @@ function conflictBool(conflicts) {
   return null;
 }
 
+function objectOrEmpty(value) {
+  return value && typeof value === 'object' && !Array.isArray(value) ? value : {};
+}
+
+function createSnapshotTracker(source, state) {
+  const tracker = createEvidenceTracker(Object.hasOwn(source, 'degraded') ? source.degraded : []);
+  if (state !== source.state) tracker.add('state', 'PR state evidence is missing or malformed');
+  if (Object.hasOwn(source, 'unreadable')) trackUnreadable(source.unreadable, tracker);
+  return tracker;
+}
+
+function normalizeBehind(source, tracker) {
+  const behind = Number.isSafeInteger(source.behind) && source.behind >= 0 ? source.behind : 0;
+  if (behind !== source.behind && source.behind !== undefined) {
+    tracker.add('branch', 'branch divergence evidence is malformed');
+  }
+  return behind;
+}
+
+function deriveThreadState(tracker, openThreadCount) {
+  if (tracker.incompleteSurfaces.has('threads')) return 'INCOMPLETE';
+  return openThreadCount > 0 ? 'OPEN' : 'ZERO';
+}
+
 /**
  * Normalize a raw `gatherPrSnapshot` result into the monitor diff subject.
  *
@@ -234,29 +273,18 @@ function conflictBool(conflicts) {
  * @returns {object}
  */
 function normalizeSnapshot(snap, ctx) {
-  const source = snap && typeof snap === 'object' && !Array.isArray(snap) ? snap : {};
-  const state = source.state && typeof source.state === 'object' && !Array.isArray(source.state)
-    ? source.state
-    : {};
-  const hasDegraded = Object.prototype.hasOwnProperty.call(source, 'degraded');
-  const tracker = createEvidenceTracker(hasDegraded ? source.degraded : []);
-  if (state !== source.state) tracker.add('state', 'PR state evidence is missing or malformed');
-  if (Object.prototype.hasOwnProperty.call(source, 'unreadable')) {
-    trackUnreadable(source.unreadable, tracker);
-  }
+  const source = objectOrEmpty(snap);
+  const state = objectOrEmpty(source.state);
+  const tracker = createSnapshotTracker(source, state);
   const checks = normalizeChecks(state.checks, tracker);
   const threads = normalizeThreads(source.threads, tracker);
   const reviews = normalizeReviews(source.reviews, tracker);
   const comments = normalizeComments(source.issueComments, tracker);
-  const behind = Number.isSafeInteger(source.behind) && source.behind >= 0 ? source.behind : 0;
-  if (behind !== source.behind && source.behind !== undefined) {
-    tracker.add('branch', 'branch divergence evidence is malformed');
-  }
+  const behind = normalizeBehind(source, tracker);
   const openThreadCount = threads.filter((thread) => thread.actionable).length;
   const evidenceStatus = tracker.degraded.length === 0 ? 'COMPLETE' : 'INCOMPLETE';
-  const threadState = tracker.incompleteSurfaces.has('threads')
-    ? 'INCOMPLETE'
-    : (openThreadCount > 0 ? 'OPEN' : 'ZERO');
+  const threadState = deriveThreadState(tracker, openThreadCount);
+  const degraded = [...tracker.degraded].sort(compareBy('surface'));
   return {
     repo: evidenceText(ctx?.repo),
     pr: evidenceText(ctx?.pr),
@@ -276,7 +304,7 @@ function normalizeSnapshot(snap, ctx) {
     comments,
     behind,
     conflicts: conflictBool(source.conflicts),
-    degraded: tracker.degraded.sort(compareBy('surface')),
+    degraded,
   };
 }
 
diff --git a/lib/pr-monitor/render-summary.js b/lib/pr-monitor/render-summary.js
index 76d7fcb7..a9f41343 100644
--- a/lib/pr-monitor/render-summary.js
+++ b/lib/pr-monitor/render-summary.js
@@ -123,9 +123,11 @@ function renderThreads(bundle, lines) {
 
   if (!Array.isArray(bundle.unresolvedComments)
     || bundle.unresolvedComments.slice(0, MAX_SUMMARY_THREADS + 1).some((thread) => !validThread(thread))) {
-    lines.push('### Review threads');
-    lines.push('⚠️ Review thread evidence was **malformed** this pass — not treated as zero.');
-    lines.push('');
+    lines.push(
+      '### Review threads',
+      '⚠️ Review thread evidence was **malformed** this pass — not treated as zero.',
+      ''
+    );
     return 'INCOMPLETE';
   }
 
@@ -178,9 +180,11 @@ function renderChecks(bundle, lines) {
   if (checkArrays.some((checks) => !Array.isArray(checks))
     || checkArrays.some((checks) => checks.slice(0, MAX_SUMMARY_CHECKS + 1)
       .some((check) => !validCheck(check)))) {
-    lines.push('### Checks');
-    lines.push('⚠️ Check evidence was **malformed** this pass — not treated as green.');
-    lines.push('');
+    lines.push(
+      '### Checks',
+      '⚠️ Check evidence was **malformed** this pass — not treated as green.',
+      ''
+    );
     return false;
   }
   const failing = ci.failing;
@@ -247,8 +251,9 @@ function renderSummary(bundle = {}, opts = {}) {
   }
 
   const pr = opts.pr || bundle.pr || '<pr>';
+  const detailCommand = mdCode(`forge shepherd ${pr} --pull --json`);
   lines.push('---');
-  lines.push(`Detailed JSON: ${mdCode(`forge shepherd ${pr} --pull --json`)}`);
+  lines.push(`Detailed JSON: ${detailCommand}`);
   lines.push(`_Updated ${now.toISOString()} · summary-only monitor · labels state, never merges, never resolves threads._`);
 
   let evidenceStatus = threadState === 'INCOMPLETE' || !checksComplete ? 'INCOMPLETE' : 'COMPLETE';
@@ -266,7 +271,7 @@ function renderSummary(bundle = {}, opts = {}) {
       '',
       '_This monitor does not merge and never resolves review threads._',
       '',
-      `Detailed JSON: ${mdCode(`forge shepherd ${pr} --pull --json`)}`,
+      `Detailed JSON: ${detailCommand}`,
       `_Updated ${now.toISOString()} · summary-only monitor · labels state, never merges, never resolves threads._`,
     ].join('\n');
   }
diff --git a/lib/review-adapter.js b/lib/review-adapter.js
index 75759950..f7475840 100644
--- a/lib/review-adapter.js
+++ b/lib/review-adapter.js
@@ -15,21 +15,21 @@ const REVIEW_EVIDENCE_LIMITS = Object.freeze({
 const SECRET_PATTERNS = [
   /\bBearer\s+\S+/gi,
   /\bgh[pousr]_[A-Za-z0-9]{20,}\b/g,
-  /\bgithub_pat_[A-Za-z0-9_]{20,}\b/gi,
+  /\bgithub_pat_\w{20,}\b/gi,
   /\b(?:sk_(?:live|test)_[A-Za-z0-9]{16,}|sk-[A-Za-z0-9]{16,})\b/g,
   /\bAKIA[0-9A-Z]{16}\b/gi,
   /\b(?:api[_ -]?key|authorization|credential|password|private[_ -]?key|secret|token)\s*[:=]\s*\S{8,}/gi,
 ];
 const PRIVATE_PATH_PATTERNS = [
-  /[A-Za-z]:\\Users\\[^\\\s]+(?:\\[^\s]*)?/gi,
+  /[a-z]:\\Users\\[^\\\s]+(?:\\[^\s]*)?/gi,
   /\/(?:Users|home)\/[^/\s]+(?:\/[^\s]*)?/g,
-  /\/root\/[^\s"'<>{}\[\]]+/g,
+  /\/root\/[^\s"'<>{}[\]]+/g,
 ];
 
 function stripControlCharacters(value) {
   let output = '';
   for (const character of value) {
-    const code = character.charCodeAt(0);
+    const code = character.codePointAt(0);
     const control = (code >= 0 && code <= 8)
       || code === 11
       || code === 12
