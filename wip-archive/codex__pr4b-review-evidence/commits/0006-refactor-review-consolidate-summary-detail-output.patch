From e3937702cda75f612f1a4ea4e02241eb34c7b3af Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Tue, 11 Aug 2026 02:02:35 +0530
Subject: [PATCH] refactor(review): consolidate summary detail output

---
 lib/pr-monitor/render-summary.js | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/lib/pr-monitor/render-summary.js b/lib/pr-monitor/render-summary.js
index a9f41343..8bce401f 100644
--- a/lib/pr-monitor/render-summary.js
+++ b/lib/pr-monitor/render-summary.js
@@ -252,9 +252,11 @@ function renderSummary(bundle = {}, opts = {}) {
 
   const pr = opts.pr || bundle.pr || '<pr>';
   const detailCommand = mdCode(`forge shepherd ${pr} --pull --json`);
-  lines.push('---');
-  lines.push(`Detailed JSON: ${detailCommand}`);
-  lines.push(`_Updated ${now.toISOString()} · summary-only monitor · labels state, never merges, never resolves threads._`);
+  lines.push(
+    '---',
+    `Detailed JSON: ${detailCommand}`,
+    `_Updated ${now.toISOString()} · summary-only monitor · labels state, never merges, never resolves threads._`
+  );
 
   let evidenceStatus = threadState === 'INCOMPLETE' || !checksComplete ? 'INCOMPLETE' : 'COMPLETE';
   if (evidenceStatus === 'INCOMPLETE') lines[headlineIndex] = verdictHeadline('INCOMPLETE');
-- 
