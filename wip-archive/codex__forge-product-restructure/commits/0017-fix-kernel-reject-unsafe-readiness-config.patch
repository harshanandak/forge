From 3e8db779a5de53df8c118660e25575154f4f9e94 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Sun, 9 Aug 2026 15:46:26 +0530
Subject: [PATCH] fix(kernel): reject unsafe readiness config

---
 lib/forge-issues.js       | 50 +++++++++++++++++++++++++++++----------
 test/forge-issues.test.js | 39 ++++++++++++++++++++++++++++++
 2 files changed, 77 insertions(+), 12 deletions(-)

diff --git a/lib/forge-issues.js b/lib/forge-issues.js
index 4c54070a..77ada139 100644
--- a/lib/forge-issues.js
+++ b/lib/forge-issues.js
@@ -212,30 +212,56 @@ function resolveIssueContractPolicy(projectRoot, deps = {}) {
 	if (Array.isArray(loaded?.errors) && loaded.errors.length > 0) {
 		fail(loaded.errors.map(error => error.message || error.code || String(error)).join('; '));
 	}
-	const configured = loaded?.config?.issues?.readiness?.contracts;
+	const missing = Symbol('missing issue contract config');
+	const ownDataValue = (object, key, path) => {
+		if (!object || (typeof object !== 'object' && typeof object !== 'function')) return missing;
+		const descriptor = Object.getOwnPropertyDescriptor(object, key);
+		if (!descriptor) return missing;
+		if (!Object.prototype.hasOwnProperty.call(descriptor, 'value')) {
+			fail(`${path} must be a data property`);
+		}
+		return descriptor.value;
+	};
+	const issues = ownDataValue(loaded?.config, 'issues', 'issues');
+	const readiness = issues === missing ? missing : ownDataValue(issues, 'readiness', 'issues.readiness');
+	const configured = readiness === missing
+		? missing
+		: ownDataValue(readiness, 'contracts', 'issues.readiness.contracts');
+	if (configured === missing) return null;
 	if (configured == null) return null;
-	if (!configured || typeof configured !== 'object' || Array.isArray(configured)) {
-		fail('issues.readiness.contracts must be an object');
-	}
-	if (configured.enabled !== undefined && typeof configured.enabled !== 'boolean') {
-		fail('issues.readiness.contracts.enabled must be a boolean');
+	if (typeof configured !== 'object'
+		|| Array.isArray(configured)
+		|| Object.getPrototypeOf(configured) !== Object.prototype) {
+		fail('issues.readiness.contracts must be a plain JSON object');
 	}
-	if (configured.enabled !== true) return { enabled: false, workClasses: [] };
 	const allowedKeys = new Set(['enabled', 'workClasses']);
-	const unknownKeys = Object.keys(configured).filter(key => !allowedKeys.has(key));
+	const ownKeys = Reflect.ownKeys(configured);
+	const unknownKeys = ownKeys.filter(key => typeof key !== 'string' || !allowedKeys.has(key));
 	if (unknownKeys.length > 0) {
-		fail(`unknown issues.readiness.contracts keys: ${unknownKeys.sort().join(', ')}`);
+		fail(`unknown issues.readiness.contracts keys: ${unknownKeys.map(String).sort().join(', ')}`);
+	}
+	const values = Object.create(null);
+	for (const key of ownKeys) {
+		const descriptor = Object.getOwnPropertyDescriptor(configured, key);
+		if (!descriptor || !Object.prototype.hasOwnProperty.call(descriptor, 'value')) {
+			fail(`issues.readiness.contracts.${key} must be a data property`);
+		}
+		values[key] = descriptor.value;
+	}
+	if (values.enabled !== undefined && typeof values.enabled !== 'boolean') {
+		fail('issues.readiness.contracts.enabled must be a boolean');
 	}
-	if (!Array.isArray(configured.workClasses) || configured.workClasses.length === 0) {
+	if (values.enabled !== true) return { enabled: false, workClasses: [] };
+	if (!Array.isArray(values.workClasses) || values.workClasses.length === 0) {
 		fail('issues.readiness.contracts.workClasses must be a non-empty array');
 	}
 	const allowedClasses = new Set(ISSUE_TYPES);
-	if (configured.workClasses.some(value => typeof value !== 'string' || !allowedClasses.has(value))) {
+	if (values.workClasses.some(value => typeof value !== 'string' || !allowedClasses.has(value))) {
 		fail('issues.readiness.contracts.workClasses contains an unknown work class');
 	}
 	return {
 		enabled: true,
-		workClasses: [...new Set(configured.workClasses)],
+		workClasses: [...new Set(values.workClasses)],
 	};
 }
 
diff --git a/test/forge-issues.test.js b/test/forge-issues.test.js
index 870d889c..4438bc73 100644
--- a/test/forge-issues.test.js
+++ b/test/forge-issues.test.js
@@ -59,6 +59,45 @@ describe('forge issue service contract', () => {
 		}
 	});
 
+	test('contract policy rejects inherited activation and accessors without executing them', () => {
+		const { resolveIssueContractPolicy } = require('../lib/forge-issues');
+		const inherited = Object.create({ enabled: true, workClasses: ['task'] });
+		let getterExecuted = false;
+		const accessor = { workClasses: ['task'] };
+		Object.defineProperty(accessor, 'enabled', {
+			enumerable: true,
+			get: () => {
+				getterExecuted = true;
+				return true;
+			},
+		});
+
+		for (const contracts of [inherited, accessor]) {
+			expect(() => resolveIssueContractPolicy('/repo', {
+				loadRuntimeGraphConfig: () => ({
+					config: { issues: { readiness: { contracts } } },
+					errors: [],
+				}),
+			})).toThrow(/FORGE_ISSUE_CONTRACT_CONFIG_INVALID/);
+		}
+		expect(getterExecuted).toBe(false);
+	});
+
+	test('disabled contract policy still rejects trusted and unknown keys', () => {
+		const { resolveIssueContractPolicy } = require('../lib/forge-issues');
+		for (const contracts of [
+			{ enabled: false, trustedAdopters: ['maintainer@example.test'] },
+			{ enabled: false, unexpected: true },
+		]) {
+			expect(() => resolveIssueContractPolicy('/repo', {
+				loadRuntimeGraphConfig: () => ({
+					config: { issues: { readiness: { contracts } } },
+					errors: [],
+				}),
+			})).toThrow(/FORGE_ISSUE_CONTRACT_CONFIG_INVALID/);
+		}
+	});
+
   test('exports service factory and operation runner', () => {
     const forgeIssues = require('../lib/forge-issues');
 
-- 
2.51.0.windows.1

