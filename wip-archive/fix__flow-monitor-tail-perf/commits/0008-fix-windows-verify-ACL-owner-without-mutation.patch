-function secureWindowsPathsAcl(filePaths, options = {}) {
+function resolveWindowsSystemToolPath(toolName, environment = process.env) {
+	const systemRoot = environment.SystemRoot;
+	if (typeof systemRoot !== 'string' || !path.win32.isAbsolute(systemRoot)) {
+		throw new Error('Windows backup hardening requires an absolute SystemRoot');
+	}
+	return path.win32.join(systemRoot, 'System32', toolName);
+}
+
+function parseCurrentWindowsSid(output) {
+	const match = String(output).trim().match(/,"(S-\d+(?:-\d+)+)"$/);
+	if (!match) throw new Error('Windows backup hardening could not resolve the current user SID');
+	return match[1];
+}
+
+function parseWindowsAclFlags(serializedFlags, allowedFlags) {
+	const flags = new Set();
+	let remaining = serializedFlags;
+	while (remaining.length > 0) {
+		const flag = allowedFlags.find(candidate => remaining.startsWith(candidate));
+		if (!flag || flags.has(flag)) return null;
+		flags.add(flag);
+		remaining = remaining.slice(flag.length);
+	}
+	return flags;
+}
+
+function hasExactWindowsFullControl(rights) {
+	if (rights === 'FA') return true;
+	if (!/^0x[0-9a-f]+$/i.test(rights)) return false;
+	return BigInt(rights) === 0x1f01ffn;
+}
+
+function hasExactWindowsAclFlags(flags, expected) {
+	return flags.size === expected.length && expected.every(flag => flags.has(flag));
+}
+
+function isOwnerOnlyWindowsDacl(serializedAcl, sid, isDirectory) {
+	const descriptors = String(serializedAcl)
+		.split(/\r?\n/)
+		.map(line => line.trim())
+		.filter(line => line.startsWith('D:'));
+	if (descriptors.length !== 1) return false;
+	let descriptor = descriptors[0];
+	const saclStart = descriptor.indexOf('S:');
+	if (saclStart !== -1) {
+		const sacl = descriptor.slice(saclStart).match(/^S:([A-Z]*)$/);
+		if (!sacl || !parseWindowsAclFlags(sacl[1], ['AR', 'AI', 'P'])) return false;
+		descriptor = descriptor.slice(0, saclStart);
+	}
+	const dacl = descriptor.match(/^D:([A-Z]*)(.*)$/);
+	if (!dacl) return false;
+	const daclFlags = parseWindowsAclFlags(dacl[1], ['AR', 'AI', 'P']);
+	if (!daclFlags?.has('P')) return false;
+	const serializedAces = dacl[2].match(/\([^)]*\)/g) || [];
+	if (serializedAces.length === 0 || serializedAces.join('') !== dacl[2]) return false;
+	const aces = serializedAces.map(serializedAce => {
+		const fields = serializedAce.slice(1, -1).split(';');
+		if (fields.length !== 6) return null;
+		const [type, serializedFlags, rights, objectGuid, inheritObjectGuid, identity] = fields;
+		const flags = parseWindowsAclFlags(serializedFlags, ['OI', 'CI', 'NP', 'IO', 'ID', 'SA', 'FA']);
+		if (type !== 'A' || !flags || flags.has('NP') || flags.has('ID') || flags.has('SA') || flags.has('FA')) {
+			return null;
+		}
+		if (objectGuid !== '' || inheritObjectGuid !== '' || identity !== sid || !hasExactWindowsFullControl(rights)) {
+			return null;
+		}
+		return flags;
+	});
+	if (aces.some(ace => ace === null)) return false;
+	if (!isDirectory) return aces.length === 1 && hasExactWindowsAclFlags(aces[0], []);
+	if (aces.length === 1) return hasExactWindowsAclFlags(aces[0], ['OI', 'CI']);
+	if (aces.length !== 2) return false;
+	return aces.some(flags => hasExactWindowsAclFlags(flags, []))
+		&& aces.some(flags => hasExactWindowsAclFlags(flags, ['OI', 'CI', 'IO']));
+}
+
+let currentWindowsSid;
+
+function secureWindowsPathsAclWithNativeDacl(filePaths, options = {}) {
 	const execute = options.execFile || execFileSync;
 	const environment = options.environment || process.env;
-	const powerShellPath = resolveWindowsPowerShellPath(environment);
-	const args = ['-NoLogo', '-NoProfile', '-NonInteractive', '-Command', WINDOWS_PRIVATE_ACL_SCRIPT];
-	const childEnvironment = {
-		FORGE_PRIVATE_ACL_TARGETS: JSON.stringify(filePaths),
-		SystemRoot: environment.SystemRoot,
+	const fsApi = options.fsApi || fs;
+	const spawn = options.bunSpawnSync || globalThis.Bun.spawnSync;
+	const now = options.now || (() => performance.now());
+	const cacheSid = !options.execFile && !options.environment;
+	const systemDirectory = path.win32.dirname(resolveWindowsSystemToolPath('icacls.exe', environment));
+	const childEnvironment = { SystemRoot: environment.SystemRoot };
+	const deadline = now() + 15_000;
+	const remainingTimeout = () => {
+		const remaining = deadline - now();
+		if (remaining <= 0) throw new Error('Windows ACL hardening subprocess deadline exceeded');
+		return Math.ceil(remaining);
 	};
-	if (process.versions.bun) {
-		const spawn = options.bunSpawnSync || globalThis.Bun.spawnSync;
-		const result = spawn([powerShellPath, ...args], {
+	const executeBeforeDeadline = (command, args, stdio = 'ignore') => execute(command, args, {
+		cwd: systemDirectory,
+		encoding: 'utf8',
+		env: childEnvironment,
+		stdio,
+		timeout: remainingTimeout(),
+		windowsHide: false,
+	});
+	const sid = cacheSid && currentWindowsSid
+		? currentWindowsSid
+		: parseCurrentWindowsSid(executeBeforeDeadline(
+			resolveWindowsSystemToolPath('whoami.exe', environment),
+			['/user', '/fo', 'csv', '/nh'],
+			['ignore', 'pipe', 'ignore'],
+		));
+	if (cacheSid) currentWindowsSid = sid;
+	const icaclsPath = resolveWindowsSystemToolPath('icacls.exe', environment);
+	const proofDirectory = fsApi.mkdtempSync(path.join(os.tmpdir(), 'forge-private-acl-'));
+	try {
+		for (const [index, filePath] of filePaths.entries()) {
+			const isDirectory = fsApi.statSync(filePath).isDirectory();
+			const grant = `*${sid}:${isDirectory ? '(OI)(CI)F' : 'F'}`;
+			const proofPath = path.join(proofDirectory, `${index}.acl`);
+			executeBeforeDeadline(icaclsPath, [filePath, '/grant:r', grant, '/q']);
+			executeBeforeDeadline(icaclsPath, [filePath, '/inheritance:r', '/q']);
+			executeBeforeDeadline(icaclsPath, [filePath, '/verify', '/q']);
+			executeBeforeDeadline(icaclsPath, [filePath, '/save', proofPath, '/q']);
+			const serializedAcl = fsApi.readFileSync(proofPath, 'utf16le');
+			if (!isOwnerOnlyWindowsDacl(serializedAcl, sid, isDirectory)) {
+				throw new Error('owner-only ACL verification failed');
+			}
+		}
+		const powerShellPath = resolveWindowsPowerShellPath(environment);
+		const result = spawn([
+			powerShellPath,
+			'-NoLogo',
+			'-NoProfile',
+			'-NonInteractive',
+			'-Command',
+			WINDOWS_OWNER_READBACK_SCRIPT,
+		], {
 			cwd: path.win32.dirname(powerShellPath),
-			env: childEnvironment,
+			env: {
+				FORGE_PRIVATE_ACL_EXPECTED_SID: sid,
+				FORGE_PRIVATE_ACL_TARGETS: JSON.stringify(filePaths),
+				SystemRoot: environment.SystemRoot,
+			},
 			stderr: 'pipe',
 			stdout: 'pipe',
-			timeout: 15_000,
+			timeout: remainingTimeout(),
 		});
 		if (!result?.success) {
 			const reason = result?.exitedDueToTimeout ? 'timed out' : 'failed';
-			throw new Error(`Windows ACL hardening subprocess ${reason}`);
+			throw new Error(`Windows ACL owner verification ${reason}`);
 		}
-		return;
+	} finally {
+		fsApi.rmSync(proofDirectory, { recursive: true, force: true });
 	}
+}
