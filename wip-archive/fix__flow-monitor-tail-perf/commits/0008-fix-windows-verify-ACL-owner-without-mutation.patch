+		FORGE_PRIVATE_ACL_TARGETS: JSON.stringify(filePaths),
+		SystemRoot: environment.SystemRoot,
+	};
 	execute(
 		powerShellPath,
 		args,
@@ -4584,6 +4734,12 @@ function secureWindowsPathsAcl(filePaths, options = {}) {
 	);
