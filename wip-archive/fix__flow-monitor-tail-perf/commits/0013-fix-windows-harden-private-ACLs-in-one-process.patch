-function parseWindowsAclFlags(serializedFlags, allowedFlags) {
-	const flags = new Set();
-	let remaining = serializedFlags;
-	while (remaining.length > 0) {
-		const flag = allowedFlags.find(candidate => remaining.startsWith(candidate));
-		if (!flag || flags.has(flag)) return null;
-		flags.add(flag);
-		remaining = remaining.slice(flag.length);
-	}
-	return flags;
-}
-
-function hasExactWindowsFullControl(rights) {
-	if (rights === 'FA') return true;
-	if (!/^0x[0-9a-f]+$/i.test(rights)) return false;
-	return BigInt(rights) === 0x1f01ffn;
-}
-
-function hasExactWindowsAclFlags(flags, expected) {
-	return flags.size === expected.length && expected.every(flag => flags.has(flag));
-}
-
-function isOwnerOnlyWindowsDacl(serializedAcl, sid, isDirectory) {
-	const descriptors = String(serializedAcl)
-		.split(/\r?\n/)
-		.map(line => line.trim())
-		.filter(line => line.startsWith('D:'));
-	if (descriptors.length !== 1) return false;
-	let descriptor = descriptors[0];
-	const saclStart = descriptor.indexOf('S:');
-	if (saclStart !== -1) {
-		const sacl = descriptor.slice(saclStart).match(/^S:([A-Z]*)$/);
-		if (!sacl || !parseWindowsAclFlags(sacl[1], ['AR', 'AI', 'P'])) return false;
-		descriptor = descriptor.slice(0, saclStart);
-	}
-	const dacl = descriptor.match(/^D:([A-Z]*)(.*)$/);
-	if (!dacl) return false;
-	const daclFlags = parseWindowsAclFlags(dacl[1], ['AR', 'AI', 'P']);
-	if (!daclFlags?.has('P')) return false;
-	const serializedAces = dacl[2].match(/\([^)]*\)/g) || [];
-	if (serializedAces.length === 0 || serializedAces.join('') !== dacl[2]) return false;
-	const aces = serializedAces.map(serializedAce => {
-		const fields = serializedAce.slice(1, -1).split(';');
-		if (fields.length !== 6) return null;
-		const [type, serializedFlags, rights, objectGuid, inheritObjectGuid, identity] = fields;
-		const flags = parseWindowsAclFlags(serializedFlags, ['OI', 'CI', 'NP', 'IO', 'ID', 'SA', 'FA']);
-		if (type !== 'A' || !flags || flags.has('NP') || flags.has('ID') || flags.has('SA') || flags.has('FA')) {
-			return null;
-		}
-		if (objectGuid !== '' || inheritObjectGuid !== '' || identity !== sid || !hasExactWindowsFullControl(rights)) {
-			return null;
-		}
-		return flags;
-	});
-	if (aces.some(ace => ace === null)) return false;
-	if (!isDirectory) return aces.length === 1 && hasExactWindowsAclFlags(aces[0], []);
-	if (aces.length === 1) return hasExactWindowsAclFlags(aces[0], ['OI', 'CI']);
-	if (aces.length !== 2) return false;
-	return aces.some(flags => hasExactWindowsAclFlags(flags, []))
-		&& aces.some(flags => hasExactWindowsAclFlags(flags, ['OI', 'CI', 'IO']));
-}
