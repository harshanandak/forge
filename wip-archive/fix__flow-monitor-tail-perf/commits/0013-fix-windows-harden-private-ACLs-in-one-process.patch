-function parseCurrentWindowsSid(output) {
-	const match = String(output).trim().match(/,"(S-\d+(?:-\d+)+)"$/);
-	if (!match) throw new Error('Windows backup hardening could not resolve the current user SID');
-	return match[1];
-}
