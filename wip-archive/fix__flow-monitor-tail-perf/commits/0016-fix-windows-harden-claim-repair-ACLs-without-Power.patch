+function parseWhoamiSid(stdout) {
+	const matches = String(stdout).match(/S-1-[0-9]+(?:-[0-9]+)+/g) || [];
+	if (matches.length !== 1) throw new Error('Windows ACL hardening could not resolve the current SID');
+	return matches[0];
+}
