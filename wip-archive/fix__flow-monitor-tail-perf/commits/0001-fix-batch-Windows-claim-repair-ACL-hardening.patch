 	const sourceDriver = openDriver(options.databasePath);
 	try {
 		if (options.mode === 'dry-run') {
@@ -80,6 +85,7 @@ async function run(options, dependencies = {}) {
 				observedAt: options.observedAt,
 				openDriver,
 				hardenPath,
