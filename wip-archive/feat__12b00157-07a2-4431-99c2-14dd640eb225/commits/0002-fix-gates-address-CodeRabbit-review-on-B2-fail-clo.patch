 lib/commands/preflight.js       | 35 +++++++++++++++++++++------------
 lib/preflight/runner.js         | 15 ++++++++++----
 test/commands/preflight.test.js | 34 ++++++++++++++++++++++++++++++++
 test/preflight/runner.test.js   | 11 +++++++++++
 4 files changed, 78 insertions(+), 17 deletions(-)

diff --git a/lib/commands/preflight.js b/lib/commands/preflight.js
index 06fa1fca..b08731aa 100644
--- a/lib/commands/preflight.js
+++ b/lib/commands/preflight.js
@@ -17,7 +17,6 @@
  */
 
 const { execFileSync } = require('node:child_process');
-const { getChangedFiles } = require('./test');
 const { buildGates } = require('../preflight/gates');
 const { runGates } = require('../preflight/runner');
 
@@ -84,13 +83,19 @@ function resolveChangeSet(exec = execFileSync, { runAll = false } = {}) {
       reason: 'could not resolve a base branch (no origin/HEAD, no upstream, no main/master ref)',
     };
   }
-  let changedFiles = [];
-  try {
-    changedFiles = getChangedFiles(exec, {}) || [];
-  } catch {
-    // base resolved but diff failed — treat as no changes, still a resolved base
-  }
-  return { resolved: true, baseRef, changedFiles };
+  // Diff against the SAME base we just resolved. getChangedFiles() re-resolves
+  // its own diff ref (and can fall back to a different default branch), so use
+  // baseRef directly to keep the file list consistent with the resolved base.
+  return { resolved: true, baseRef, changedFiles: changedFilesForBase(exec, baseRef) };
+}
+
+/** Files changed between the merge-base of HEAD and `baseRef` and HEAD. */
+function changedFilesForBase(exec, baseRef) {
+  const mergeBase = gitTryOut(exec, ['merge-base', 'HEAD', baseRef]);
+  const range = mergeBase ? `${mergeBase}...HEAD` : `${baseRef}...HEAD`;
+  const out = gitTryOut(exec, ['diff', '--name-only', range]);
+  if (out == null) return [];
+  return out.split(/\r?\n/).filter(Boolean);
 }
 
 /**
@@ -149,11 +154,14 @@ module.exports = {
     // Resolve the change set AND whether a base branch could be established.
     const changeSet = selectChangeSet(deps, runAll) || {};
 
-    // B2 (N1): an unresolvable base is fail-closed. Computing "0 changed files"
+    // B2 (N1): an unresolvable base is fail-CLOSED. Computing "0 changed files"
     // from a missing base and passing every gate manufactures false confidence.
-    if (!runAll && changeSet.resolved === false) {
-      reportBaseUnresolved(log, changeSet.reason);
-      return { success: false, results: [], reason: changeSet.reason, baseUnresolved: true };
+    // Anything not EXPLICITLY resolved (including a missing `resolved` field from
+    // a future override) fails closed — never fail open on an indeterminate base.
+    if (!runAll && !changeSet.resolved) {
+      const reason = changeSet.reason || 'base branch could not be resolved';
+      reportBaseUnresolved(log, reason);
+      return { success: false, results: [], reason, baseUnresolved: true };
     }
 
     const changedFiles = changeSet.changedFiles || [];
@@ -170,7 +178,8 @@ module.exports = {
     log('');
     log('Preflight summary:');
     for (const r of results) {
-      log(`  [${gateMark(r)}] ${r.name}${r.summary ? ` — ${r.summary}` : ''}`);
+      const suffix = r.summary ? ` — ${r.summary}` : '';
+      log(`  [${gateMark(r)}] ${r.name}${suffix}`);
     }
     log('');
     log(ok
diff --git a/lib/preflight/runner.js b/lib/preflight/runner.js
index 44e01e5d..28850f2e 100644
--- a/lib/preflight/runner.js
+++ b/lib/preflight/runner.js
@@ -48,18 +48,24 @@ async function executeGate(gate) {
     outcome = { ok: false, summary: `error: ${message}` };
   }
   const durationMs = Date.now() - started;
-  const skipped = !!(outcome && outcome.skipped);
+  const skipped = !!outcome?.skipped;
   return {
     name: gate.name,
     // A skipped gate is a pass-through: it is neither a pass nor a failure, so
     // it must never short-circuit later gates (see runGates fast-fail).
-    ok: skipped ? true : !!(outcome && outcome.ok),
+    ok: skipped ? true : !!outcome?.ok,
     skipped,
-    summary: (outcome && outcome.summary) || '',
+    summary: outcome?.summary || '',
     durationMs,
   };
 }
 
+/** Live-log label for a gate result — SKIP must never read as PASS. */
+function gateLogMark(result) {
+  if (result.skipped) return 'SKIP';
+  return result.ok ? 'PASS' : 'FAIL';
+}
+
 /**
  * Run gates in order, fast-failing at the first failure.
  *
@@ -86,7 +92,8 @@ async function runGates(gates, options = {}) {
 
     const result = await executeGate(gate);
     results.push(result);
-    log(`${result.ok ? 'PASS' : 'FAIL'} ${gate.name}${result.summary ? ` — ${result.summary}` : ''}`);
+    const suffix = result.summary ? ` — ${result.summary}` : '';
+    log(`${gateLogMark(result)} ${gate.name}${suffix}`);
 
     if (!result.ok) {
       ok = false;
diff --git a/test/commands/preflight.test.js b/test/commands/preflight.test.js
index b495250d..e37ca7ad 100644
--- a/test/commands/preflight.test.js
+++ b/test/commands/preflight.test.js
@@ -64,6 +64,21 @@ describe('forge preflight — base resolvability (B2)', () => {
     expect(out).toMatch(/--all|upstream|remedy/i);
   });
 
+  test('fail-CLOSED when resolved is omitted entirely (no fail-open)', async () => {
+    const lines = [];
+    let built = false;
+    const res = await preflight.handler([], {}, '/x', {
+      log: (m) => lines.push(m),
+      // A future override that forgets `resolved` must NOT pass through.
+      resolveChangeSet: () => ({ changedFiles: [] }),
+      buildGates: () => { built = true; return []; },
+    });
+    expect(res.success).toBe(false);
+    expect(res.baseUnresolved).toBe(true);
+    expect(built).toBe(false);
+    expect(lines.join('\n')).toContain('preflight FAILED');
+  });
+
   test('resolved base with 0 changed files still runs gates (legit no-op)', async () => {
     const res = await preflight.handler([], {}, '/x', {
       log: () => {},
@@ -97,4 +112,23 @@ describe('resolveChangeSet — strict base detection (B2)', () => {
     const cs = resolveChangeSet(() => { throw new Error('x'); }, { runAll: true });
     expect(cs.resolved).toBe(true);
   });
+
+  test('diffs against the SAME resolved base (does not re-resolve a different one)', () => {
+    // Fake git: origin/HEAD -> main; merge-base HEAD main -> abc123; diff on that base.
+    const calls = [];
+    const exec = (_cmd, args) => {
+      calls.push(args.join(' '));
+      const a = args.join(' ');
+      if (a.includes('origin/HEAD')) return 'main\n';
+      if (a.startsWith('merge-base HEAD main')) return 'abc123\n';
+      if (a.startsWith('diff --name-only abc123...HEAD')) return 'lib/x.js\nlib/y.js\n';
+      throw new Error(`unexpected git: ${a}`);
+    };
+    const cs = resolveChangeSet(exec, {});
+    expect(cs.resolved).toBe(true);
+    expect(cs.baseRef).toBe('main');
+    expect(cs.changedFiles).toEqual(['lib/x.js', 'lib/y.js']);
+    // The diff must use the merge-base of the resolved base, not a re-resolved ref.
+    expect(calls.some((c) => c.startsWith('diff --name-only abc123...HEAD'))).toBe(true);
+  });
 });
