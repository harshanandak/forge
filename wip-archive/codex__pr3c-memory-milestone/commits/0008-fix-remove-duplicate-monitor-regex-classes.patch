Subject: [PATCH] fix: remove duplicate monitor regex classes

---
 lib/kernel/sqlite-driver.js | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/lib/kernel/sqlite-driver.js b/lib/kernel/sqlite-driver.js
index 7fdf645d..bb32d943 100644
--- a/lib/kernel/sqlite-driver.js
+++ b/lib/kernel/sqlite-driver.js
@@ -2420,13 +2420,13 @@ function rollbackTransaction(runtime, db) {
 const MONITOR_HASH = /^[0-9a-f]{64}$/;
 const MONITOR_TARGET = /^[A-Za-z0-9][A-Za-z0-9._:/-]*$/;
 const MONITOR_SECRET_PATTERNS = [
-	/gh[pousr]_[A-Za-z0-9]{20,}/i,
-	/sk_(?:live|test)_[A-Za-z0-9]{16,}/i,
-	/sk-[A-Za-z0-9]{16,}/i,
+	/gh[pousr]_[a-z0-9]{20,}/i,
+	/sk_(?:live|test)_[a-z0-9]{16,}/i,
+	/sk-[a-z0-9]{16,}/i,
 	/AKIA[0-9A-Z]{16}/i,
 	/(?:api[_-]?key|token|secret|password)\s*[:=]\s*\S{8,}/i,
 ];
-const MONITOR_ABSOLUTE_USER_PATH = /(?:[A-Za-z]:[\\/]Users[\\/][^\\/\s]+(?:[\\/]|$)|\/(?:Users|home)\/[^/\s]+(?:\/|$))/i;
+const MONITOR_ABSOLUTE_USER_PATH = /(?:[a-z]:[\\/]Users[\\/][^\\/\s]+(?:[\\/]|$)|\/(?:Users|home)\/[^/\s]+(?:\/|$))/i;
 const MONITOR_MAX_TARGETS = 32;
 const MONITOR_MAX_TARGET_LENGTH = 128;
 const MONITOR_MAX_ENVELOPE_BYTES = 16_384;
