+
+	test('dep.add returns FORGE_ISSUE_NOT_FOUND without writing when the blocker endpoint is missing', async () => {
+		await createIssue('dep-existing-dependent', 'Dependent');
+
+		const missing = await broker.runIssueOperation(
+			'dep.add',
