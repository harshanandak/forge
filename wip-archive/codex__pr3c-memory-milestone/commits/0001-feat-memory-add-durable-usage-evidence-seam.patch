+    expect(() => stalenessForMemory(memory, { last_used_at: '2026-05-12', use_count: 2 }, { now }))
+      .toThrow(/canonical ISO/i);
+    expect(() => stalenessForMemory(memory, { last_used_at: '2026-05-12T00:00:00.000Z', use_count: 'oops' }, { now }))
