-    const recordedEvalSet = minimalEvalSet();
-    const driftedEvalSet = minimalEvalSet();
-    driftedEvalSet.queries[0].prompt = 'changed prompt';
-    const evalSetPath = writeTmpEvalSet(driftedEvalSet);
