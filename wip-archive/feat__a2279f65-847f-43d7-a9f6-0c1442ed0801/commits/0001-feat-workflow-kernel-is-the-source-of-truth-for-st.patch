+ * @param {string} featureSlug
+ * @param {string} explicitIssueId
+ * @returns {{success: boolean, branchName?: string, reused?: boolean, warning?: string, error?: string}}
+ * @private
+ */
+function reuseOrCreateFeatureBranch(featureSlug, explicitIssueId) {
+	const current = getCurrentBranch();
+	if (!isDefaultBranch(current)) {
+		const encoded = PLAN_ISSUE_UUID_RE.exec(current);
+		const warning = encoded && explicitIssueId && encoded[0] !== explicitIssueId
+			? `Current branch ${current} appears to belong to issue ${encoded[0]}, not ${explicitIssueId}.`
+			: undefined;
+		return { success: true, branchName: current, reused: true, warning };
+	}
+	return createFeatureBranch(featureSlug);
+}
