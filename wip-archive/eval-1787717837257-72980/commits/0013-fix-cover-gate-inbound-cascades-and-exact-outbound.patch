From ea6cfcdb674d4682e805862fb8da9c74baae774a Mon Sep 17 00:00:00 2001
From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Sat, 22 Aug 2026 00:16:52 +0530
Subject: [PATCH] fix: cover gate inbound cascades and exact outbound fk test
 shape

---
 lib/kernel/sqlite-driver.js                 | 3 ++-
 test/kernel/watch-owner-transaction.test.js | 6 ++----
 2 files changed, 4 insertions(+), 5 deletions(-)

diff --git a/lib/kernel/sqlite-driver.js b/lib/kernel/sqlite-driver.js
index b5a4624a..fa192129 100644
--- a/lib/kernel/sqlite-driver.js
+++ b/lib/kernel/sqlite-driver.js
@@ -2815,7 +2815,8 @@ function hasForbiddenWatchOwnerForeignKeys(runtime, db) {
 	);
 	for (const { name } of tables) {
 		const references = allParams(runtime, db, `PRAGMA foreign_key_list("${name.replace(/"/g, '""')}")`);
-		if (references.some(reference => String(reference.table).toLowerCase() === WATCH_OWNER_TABLE)) return true;
+		if (references.some(reference => [WATCH_OWNER_TABLE, WATCH_GATE_TABLE]
+			.includes(String(reference.table).toLowerCase()))) return true;
 	}
 	for (const table of [WATCH_OWNER_TABLE, WATCH_GATE_TABLE]) {
 		if (allParams(runtime, db, `PRAGMA foreign_key_list("${table}")`).length > 0) return true;
diff --git a/test/kernel/watch-owner-transaction.test.js b/test/kernel/watch-owner-transaction.test.js
index e05a4ad6..56d6aafa 100644
--- a/test/kernel/watch-owner-transaction.test.js
+++ b/test/kernel/watch-owner-transaction.test.js
@@ -1324,7 +1324,7 @@ describe('watch owner dedicated SQLite transaction', () => {
 				id TEXT NOT NULL PRIMARY KEY
 			);
 			CREATE TABLE kernel_pr_watch_owners (
-				repo TEXT NOT NULL,
+				repo TEXT NOT NULL REFERENCES kernel_pr_watch_parent (id) ON DELETE CASCADE,
 				pr INTEGER NOT NULL,
 				version INTEGER NOT NULL,
 				generation TEXT NOT NULL,
@@ -1337,9 +1337,7 @@ describe('watch owner dedicated SQLite transaction', () => {
 				terminal_receipt_id TEXT,
 				block_reason TEXT,
 				legacy_evidence_hash TEXT,
-				parent_id TEXT NOT NULL,
-				PRIMARY KEY (repo, pr),
-				FOREIGN KEY (parent_id) REFERENCES kernel_pr_watch_parent (id) ON DELETE CASCADE
+				PRIMARY KEY (repo, pr)
 			);
 		`);
 		const result = await owner.reserveStarting({ repo: 'acme/forge', pr: 118 }, {
