+  }));
+  return createPrLifecycleAuthorityRaw({ ...options, receiptVerifier });
+}
+
 function packet(overrides = {}) {
   const basePayload = {
     issue_id: ISSUE_ID,
@@ -142,6 +150,11 @@ function provider(overrides = {}) {
