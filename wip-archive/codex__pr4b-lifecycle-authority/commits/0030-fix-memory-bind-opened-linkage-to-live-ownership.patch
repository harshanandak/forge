+const { buildClaimConflict, isLeaseExpired, isValidExpiresAt, planClaimAcquisition } = require('./lease-enforcer');
 const {
 	ISSUE_COMMAND_EXIT_CODES,
 	ISSUE_COMMAND_SCHEMA_VERSION,
@@ -455,6 +455,7 @@ function assertCompatiblePrEvidence(existingEvent, payload) {
 const PR_LINKAGE_DRIVER_METHODS = [
 	'exec', 'resolvePrLinkage', 'upsertPr', 'retirePr', 'readTrace',
 	'listKernelEvents', 'loadKernelEventByIdempotencyKey', 'insertKernelEvent', 'enqueueKernelProjection',
+	'loadActiveKernelClaim', 'loadKernelEntity',
 ];
 
 function preparePrLinkageInput(input, driver) {
@@ -533,6 +534,7 @@ function assertTerminalPrEvent(terminalPr, existingEvent) {
 function assertAtomicPrEvidence(trace, input, evidence) {
 	if (input.phase !== 'opened') return;
 	if ((trace.gaps || []).some(gap => gap === 'pull_requests:overflow'
+		|| /^pull_requests:.*:unlinked_issue$/.test(gap)
 		|| /^iterations:.*:(?:missing|incomplete|overflow)$/.test(gap))) {
 		throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage cannot prove complete semantic identity evidence');
 	}
@@ -551,6 +553,21 @@ function assertAtomicPrEvidence(trace, input, evidence) {
 	}
 }
 
+async function assertExactLifecycleOwnership(driver, evidence, context, config) {
+	if (typeof context.actor !== 'string' || !context.actor || typeof context.sessionId !== 'string' || !context.sessionId) {
+		throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordOpenedPrLinkage requires exact actor and session authority');
+	}
+	const [issue, claim] = await Promise.all([
+		driver.loadKernelEntity('issue', evidence.issue_id, context, config),
+		driver.loadActiveKernelClaim(evidence.issue_id, context, config),
+	]);
+	const now = context.now || new Date().toISOString();
+	if (!issue || isTerminalStatus(issue.status) || !claim || claim.state !== 'active'
+		|| claim.actor !== context.actor || claim.session_id !== context.sessionId || isLeaseExpired(claim, now)) {
+		throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordOpenedPrLinkage claimant no longer owns the live issue');
+	}
+}
+
 function isDatabaseLocked(error) {
 	return /database is locked|SQLITE_BUSY/i.test(String(error?.message || error));
 }
@@ -1734,11 +1751,15 @@ function createLocalBroker(options = {}) {
 			const config = getConfig();
 			await beginImmediate(driver, config);
 			try {
+				if (context.requireExactLifecycleOwnership === true) {
+					await assertExactLifecycleOwnership(driver, evidence, context, config);
+				}
 				const inferred = await driver.resolvePrLinkage({ ...linkageInput, issue_id: evidence.issue_id }, context, config);
 				assertResolvedPrLinkage(inferred, evidence);
 				const issueEvents = await driver.listKernelEvents('issue', evidence.issue_id, context, config);
 				const gateReceipts = resolveGateReceipts(issueEvents, evidence.gate_ids, linkageInput.occurred_at);
-				const issueRows = await driver.readTrace({ issue_id: evidence.issue_id }, context, config);
+				const issueRows = await driver.readTrace({ issue_id: evidence.issue_id, pr_number: linkageInput.number,
+					repo: linkageInput.repo, git_common_dir: linkageInput.git_common_dir }, context, config);
 				assertAtomicPrEvidence(issueRows, linkageInput, evidence);
 				const priorPr = findPriorPr(issueRows.pull_requests, linkageInput);
 				const worktreeId = inferred.worktree_id;
@@ -1784,6 +1805,11 @@ function createLocalBroker(options = {}) {
 			}
 		},
 
+		async recordOpenedPrLinkage(input, context = {}) {
+			if (input?.phase !== 'opened') throw traceError('FORGE_TRACE_INVALID_RECEIPT', 'recordOpenedPrLinkage requires opened phase');
+			return this.recordPrLinkage(input, { ...context, requireExactLifecycleOwnership: true });
+		},
+
 		async readTrace(target, context = {}) {
 			if (!target || (!target.issue_id && target.pr_number === undefined)) {
 				throw new Error('readTrace requires issue_id or pr_number');
