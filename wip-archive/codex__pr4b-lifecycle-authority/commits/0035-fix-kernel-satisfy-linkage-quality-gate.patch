From 067edbc73e582c57343b82ee526d94e0db82a52a Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Wed, 12 Aug 2026 17:26:20 +0530
Subject: [PATCH] fix(kernel): satisfy linkage quality gate

---
 lib/kernel/broker.js | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/lib/kernel/broker.js b/lib/kernel/broker.js
index 7ad0d485..0036c28e 100644
--- a/lib/kernel/broker.js
+++ b/lib/kernel/broker.js
@@ -547,22 +547,23 @@ function assertTerminalPrEvent(terminalPr, existingEvent) {
 
 function assertAtomicPrEvidence(trace, input, evidence) {
 	if (input.phase !== 'opened') return;
-	if ((trace.gaps || []).some(gap => gap === 'pull_requests:overflow'
+	if (trace.gaps?.some(gap => gap === 'pull_requests:overflow'
 		|| /^pull_requests:.*:unlinked_issue$/.test(gap)
 		|| /^iterations:.*:(?:missing|incomplete|overflow)$/.test(gap))) {
 		throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage cannot prove complete semantic identity evidence');
 	}
 	for (const request of trace.pull_requests || []) {
-		for (const iteration of request.iterations || []) {
-			if (iteration.type !== 'pr.opened') continue;
-			if (iteration.work_packet_identity !== evidence.work_packet_identity) continue;
+		const conflicting = (request.iterations || []).some(iteration => {
+			if (iteration.type !== 'pr.opened') return false;
+			if (iteration.work_packet_identity !== evidence.work_packet_identity) return false;
 			const sameTarget = request.git_common_dir === input.git_common_dir
 				&& request.repo === input.repo && Number(request.number) === Number(input.number);
 			const sameContent = iteration.work_packet_hash === evidence.work_packet_hash
 				&& iteration.run_receipt_hash === evidence.run_receipt_hash;
-			if (!sameTarget || !sameContent) {
-				throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage semantic identity conflicts with durable PR evidence');
-			}
+			return !sameTarget || !sameContent;
+		});
+		if (conflicting) {
+			throw traceError('FORGE_TRACE_EVIDENCE_CONFLICT', 'recordPrLinkage semantic identity conflicts with durable PR evidence');
 		}
 	}
 }
@@ -1775,8 +1776,8 @@ function createLocalBroker(options = {}) {
 			let transactionDriver;
 			try {
 				transactionDriver = driver.forkConnection();
-			} catch (error) {
-				throw traceError('FORGE_TRACE_UNAVAILABLE', 'recordPrLinkage could not create an isolated transaction connection', { cause: error });
+			} catch {
+				throw traceError('FORGE_TRACE_UNAVAILABLE', 'recordPrLinkage could not create an isolated transaction connection');
 			}
 			if (!transactionDriver || transactionDriver === driver || typeof transactionDriver.close !== 'function') {
 				throw traceError('FORGE_TRACE_UNAVAILABLE', 'recordPrLinkage received an invalid isolated transaction connection');
-- 
