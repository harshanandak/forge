@@ -681,6 +682,9 @@ function projectTrace(trace, target) {
     matches.push({
       number: dataProperty(request, 'number'),
       repo: dataProperty(request, 'repo'),
+      ...(typeof dataProperty(request, 'git_common_dir') === 'string'
