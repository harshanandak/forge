+  if (!packet.payload.allowed_mutations.some((mutation) => ['pr.opened', 'pr.merge', 'pr.merged'].includes(mutation))) fail('PR_LIFECYCLE_MUTATION_UNAUTHORIZED', 'WorkPacket does not authorize a PR lifecycle mutation');
