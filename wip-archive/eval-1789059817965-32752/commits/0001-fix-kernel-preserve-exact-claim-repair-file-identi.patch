From fee7af51e33d264bc21debbcdf1110d83c5377e8 Mon Sep 17 00:00:00 2001
From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Thu, 10 Sep 2026 21:51:20 +0530
Subject: [PATCH] fix(kernel): preserve exact claim repair file identity

---
 lib/kernel/sqlite-driver.js             | 66 ++++++++++++------------
 test/kernel/legacy-claim-repair.test.js | 68 ++++++++++++++++++++-----
 2 files changed, 89 insertions(+), 45 deletions(-)

diff --git a/lib/kernel/sqlite-driver.js b/lib/kernel/sqlite-driver.js
index b9332f88..98820355 100644
--- a/lib/kernel/sqlite-driver.js
+++ b/lib/kernel/sqlite-driver.js
@@ -4286,7 +4286,7 @@ function claimRepairSourceIdentities(databasePath) {
 	return [databasePath, `${databasePath}-wal`, `${databasePath}-shm`, `${databasePath}-journal`]
 		.filter(sourcePath => fs.existsSync(sourcePath))
 		.map(sourcePath => {
-			const stat = fs.statSync(sourcePath);
+			const stat = fs.statSync(sourcePath, { bigint: true });
 			return { device: stat.dev, inode: stat.ino };
 		});
 }
@@ -4352,15 +4352,15 @@ async function verifyClaimRepairRecovery(receipt, backupPath, databasePath, opti
 	try {
 		await (options.hardenPath || hardenBackupPermissions)(recoveryPath);
 		const sourceIdentities = claimRepairSourceIdentities(databasePath);
-		const backupIdentity = fs.existsSync(backupPath) ? fs.statSync(backupPath) : null;
+		const backupIdentity = fs.existsSync(backupPath) ? fs.statSync(backupPath, { bigint: true }) : null;
 		fileDescriptor = fs.openSync(recoveryPath, 'r');
-		const before = fs.fstatSync(fileDescriptor);
+		const before = fs.fstatSync(fileDescriptor, { bigint: true });
 		const digest = hashOpenFileDescriptor(fileDescriptor);
-		const after = fs.fstatSync(fileDescriptor);
-		const named = fs.statSync(recoveryPath);
+		const after = fs.fstatSync(fileDescriptor, { bigint: true });
+		const named = fs.statSync(recoveryPath, { bigint: true });
 		if (digest !== receipt.backup_sha256
 			|| before.size !== after.size
-			|| before.mtimeMs !== after.mtimeMs
+			|| before.mtimeNs !== after.mtimeNs
 			|| named.dev !== before.dev
 			|| named.ino !== before.ino
 			|| (backupIdentity && backupIdentity.dev === before.dev && backupIdentity.ino === before.ino)
@@ -4390,16 +4390,16 @@ async function openClaimRepairBackupFence(databasePath, backupPath, backupProof,
 		assertNoClaimRepairBackupSidecars(backupPath);
 		const sourceIdentities = claimRepairSourceIdentities(databasePath);
 		fileDescriptor = fs.openSync(backupPath, 'r');
-		const before = fs.fstatSync(fileDescriptor);
+		const before = fs.fstatSync(fileDescriptor, { bigint: true });
 		if (sourceIdentities.some(source => source.device === before.dev && source.inode === before.ino)) {
 			throw new Error('pinned backup aliases source');
 		}
 		const digest = hashOpenFileDescriptor(fileDescriptor);
-		const after = fs.fstatSync(fileDescriptor);
-		const named = fs.statSync(backupPath);
+		const after = fs.fstatSync(fileDescriptor, { bigint: true });
+		const named = fs.statSync(backupPath, { bigint: true });
 		if (digest !== backupProof.backup_sha256
 			|| before.size !== after.size
-			|| before.mtimeMs !== after.mtimeMs
+			|| before.mtimeNs !== after.mtimeNs
 			|| before.dev !== named.dev
 			|| before.ino !== named.ino) {
 			throw new Error('backup identity or content changed');
@@ -4415,21 +4415,21 @@ async function openClaimRepairBackupFence(databasePath, backupPath, backupProof,
 		}
 		copyOpenFileDescriptor(fileDescriptor, recoveryFileDescriptor);
 		syncClaimRepairRecoveryDirectory(recoveryPath);
-		const sourceAfterCopy = fs.fstatSync(fileDescriptor);
+		const sourceAfterCopy = fs.fstatSync(fileDescriptor, { bigint: true });
 		const sourceDigestAfterCopy = hashOpenFileDescriptor(fileDescriptor);
-		const namedAfterCopy = fs.statSync(backupPath);
-		const recoveryBefore = fs.fstatSync(recoveryFileDescriptor);
+		const namedAfterCopy = fs.statSync(backupPath, { bigint: true });
+		const recoveryBefore = fs.fstatSync(recoveryFileDescriptor, { bigint: true });
 		const recoveryDigest = hashOpenFileDescriptor(recoveryFileDescriptor);
-		const recoveryAfter = fs.fstatSync(recoveryFileDescriptor);
-		const recoveryNamed = fs.statSync(recoveryPath);
+		const recoveryAfter = fs.fstatSync(recoveryFileDescriptor, { bigint: true });
+		const recoveryNamed = fs.statSync(recoveryPath, { bigint: true });
 		if (sourceDigestAfterCopy !== backupProof.backup_sha256
 			|| before.size !== sourceAfterCopy.size
-			|| before.mtimeMs !== sourceAfterCopy.mtimeMs
+			|| before.mtimeNs !== sourceAfterCopy.mtimeNs
 			|| namedAfterCopy.dev !== before.dev
 			|| namedAfterCopy.ino !== before.ino
 			|| recoveryDigest !== backupProof.backup_sha256
 			|| recoveryBefore.size !== recoveryAfter.size
-			|| recoveryBefore.mtimeMs !== recoveryAfter.mtimeMs
+			|| recoveryBefore.mtimeNs !== recoveryAfter.mtimeNs
 			|| recoveryNamed.dev !== recoveryBefore.dev
 			|| recoveryNamed.ino !== recoveryBefore.ino
 			|| (recoveryBefore.dev === before.dev && recoveryBefore.ino === before.ino)) {
@@ -4446,7 +4446,7 @@ async function openClaimRepairBackupFence(databasePath, backupPath, backupProof,
 			recoveryDevice: recoveryBefore.dev,
 			recoveryInode: recoveryBefore.ino,
 			recoverySize: recoveryBefore.size,
-			recoveryMtimeMs: recoveryBefore.mtimeMs,
+			recoveryMtimeNs: recoveryBefore.mtimeNs,
 			recoveryPath,
 		};
 	} catch {
@@ -4467,17 +4467,17 @@ async function assertClaimRepairBackupFenceCurrent(fence, options = {}) {
 		await (options.hardenPath || hardenBackupPermissions)(fence.backupPath);
 		assertSafeBackupDestination(fence.databasePath, fence.backupPath);
 		if (!options.sidecarsBlocked) assertNoClaimRepairBackupSidecars(fence.backupPath);
-		const before = fs.fstatSync(fence.fileDescriptor);
+		const before = fs.fstatSync(fence.fileDescriptor, { bigint: true });
 		const digest = hashOpenFileDescriptor(fence.fileDescriptor);
-		const after = fs.fstatSync(fence.fileDescriptor);
-		const named = fs.statSync(fence.backupPath);
-		const recoveryBefore = fs.fstatSync(fence.recoveryFileDescriptor);
+		const after = fs.fstatSync(fence.fileDescriptor, { bigint: true });
+		const named = fs.statSync(fence.backupPath, { bigint: true });
+		const recoveryBefore = fs.fstatSync(fence.recoveryFileDescriptor, { bigint: true });
 		const recoveryDigest = hashOpenFileDescriptor(fence.recoveryFileDescriptor);
-		const recoveryAfter = fs.fstatSync(fence.recoveryFileDescriptor);
-		const recoveryNamed = fs.statSync(fence.recoveryPath);
+		const recoveryAfter = fs.fstatSync(fence.recoveryFileDescriptor, { bigint: true });
+		const recoveryNamed = fs.statSync(fence.recoveryPath, { bigint: true });
 		if (digest !== fence.backupSha256
 			|| before.size !== after.size
-			|| before.mtimeMs !== after.mtimeMs
+			|| before.mtimeNs !== after.mtimeNs
 			|| before.dev !== fence.device
 			|| before.ino !== fence.inode
 			|| named.dev !== fence.device
@@ -4485,8 +4485,8 @@ async function assertClaimRepairBackupFenceCurrent(fence, options = {}) {
 			|| recoveryDigest !== fence.backupSha256
 			|| recoveryBefore.size !== recoveryAfter.size
 			|| recoveryBefore.size !== fence.recoverySize
-			|| recoveryBefore.mtimeMs !== recoveryAfter.mtimeMs
-			|| recoveryBefore.mtimeMs !== fence.recoveryMtimeMs
+			|| recoveryBefore.mtimeNs !== recoveryAfter.mtimeNs
+			|| recoveryBefore.mtimeNs !== fence.recoveryMtimeNs
 			|| recoveryBefore.dev !== fence.recoveryDevice
 			|| recoveryBefore.ino !== fence.recoveryInode
 			|| recoveryNamed.dev !== fence.recoveryDevice
@@ -4509,7 +4509,7 @@ function assertClaimRepairBackupSidecarsRemainAbsent(backupPath) {
 		for (const suffix of ['-wal', '-shm', '-journal']) {
 			const sidecarPath = `${backupPath}${suffix}`;
 			fs.mkdirSync(sidecarPath);
-			const stat = fs.statSync(sidecarPath);
+			const stat = fs.statSync(sidecarPath, { bigint: true });
 			blockers.push({ path: sidecarPath, device: stat.dev, inode: stat.ino });
 		}
 		return blockers;
@@ -4523,7 +4523,7 @@ function assertClaimRepairBackupSidecarsRemainAbsent(backupPath) {
 
 function assertClaimRepairBackupSidecarBlockersCurrent(blockers = []) {
 	for (const blocker of blockers) {
-		const stat = fs.statSync(blocker.path);
+		const stat = fs.statSync(blocker.path, { bigint: true });
 		if (!stat.isDirectory() || stat.dev !== blocker.device || stat.ino !== blocker.inode) {
 			throw new Error('backup sidecar blocker changed');
 		}
@@ -4533,7 +4533,7 @@ function assertClaimRepairBackupSidecarBlockersCurrent(blockers = []) {
 function removeClaimRepairBackupSidecarBlockers(blockers = []) {
 	for (const blocker of blockers) {
 		try {
-			const stat = fs.statSync(blocker.path);
+			const stat = fs.statSync(blocker.path, { bigint: true });
 			if (stat.isDirectory() && stat.dev === blocker.device && stat.ino === blocker.inode) {
 				fs.rmdirSync(blocker.path);
 			}
@@ -4547,7 +4547,7 @@ function closeClaimRepairBackupFence(fence, options = {}) {
 	try { fs.closeSync(fence.recoveryFileDescriptor); } catch { /* descriptor cleanup cannot change a committed receipt */ }
 	if (options.removeRecovery) {
 		try {
-			const recovery = fs.statSync(fence.recoveryPath);
+			const recovery = fs.statSync(fence.recoveryPath, { bigint: true });
 			if (recovery.dev === fence.recoveryDevice && recovery.ino === fence.recoveryInode) {
 				fs.rmSync(fence.recoveryPath);
 			}
@@ -5531,10 +5531,10 @@ function assertSafeBackupDestination(databasePath, backupPath) {
 		throw new Error('Backup destination must not alias the live SQLite database or its sidecars');
 	}
 	if (fs.existsSync(backupPath)) {
-		const destinationStat = fs.statSync(backupPath);
+		const destinationStat = fs.statSync(backupPath, { bigint: true });
 		for (const sourcePath of [databasePath, `${databasePath}-wal`, `${databasePath}-shm`, `${databasePath}-journal`]) {
 			if (!fs.existsSync(sourcePath)) continue;
-			const sourceStat = fs.statSync(sourcePath);
+			const sourceStat = fs.statSync(sourcePath, { bigint: true });
 			if (sourceStat.dev === destinationStat.dev && sourceStat.ino === destinationStat.ino) {
 				throw new Error('Backup destination must not alias the live SQLite database or its sidecars');
 			}
diff --git a/test/kernel/legacy-claim-repair.test.js b/test/kernel/legacy-claim-repair.test.js
index cb7cff4a..1941f346 100644
--- a/test/kernel/legacy-claim-repair.test.js
+++ b/test/kernel/legacy-claim-repair.test.js
@@ -5,7 +5,7 @@ const { EventEmitter } = require('node:events');
 const os = require('node:os');
 const path = require('node:path');
 const { PassThrough } = require('node:stream');
-const { afterEach, describe, expect, test } = require('bun:test');
+const { afterEach, describe, expect, spyOn, test } = require('bun:test');
 
 const { createLocalBroker } = require('../../lib/kernel/broker');
 const { extractEmbeddedAssets } = require('../../lib/package-root');
@@ -1486,17 +1486,61 @@ describe('legacy claim repair backup and apply', () => {
 			backupPath,
 			actor: 'approved-operator',
 		}, fixture.config)).rejects.toThrow('simulated response loss');
-		const replay = await fixture.driver.applyLegacyClaimRepair({
-			observedAt: OBSERVED_AT,
-			approvedDigest: preflight.digest,
-			backupPath,
-			actor: 'approved-operator',
-		}, fixture.config);
-		expect(replay.replayed).toBe(true);
-		expect(replay.recovery_ref).toMatch(/^[0-9a-f-]{36}$/);
-		expect(typeof replay.recovery_path).toBe('string');
-		expect(fs.existsSync(replay.recovery_path)).toBe(true);
-		fixture.driver.close();
+		const originalStatSync = fs.statSync;
+		const originalFstatSync = fs.fstatSync;
+		const backupInode = 9_007_199_254_740_992n;
+		const recoveryInode = backupInode + 1n;
+		const sourceInode = backupInode + 4n;
+		expect(backupInode).not.toBe(recoveryInode);
+		expect(Number(backupInode)).toBe(Number(recoveryInode));
+		const withIdentity = (stat, inode) => ({
+			...stat,
+			dev: typeof stat.dev === 'bigint' ? 1n : 1,
+			ino: typeof stat.ino === 'bigint' ? inode : Number(inode),
+		});
+		const statSpy = spyOn(fs, 'statSync').mockImplementation((filePath, options) => {
+			const stat = originalStatSync.call(fs, filePath, options);
+			if (filePath === backupPath) return withIdentity(stat, backupInode);
+			if (String(filePath).includes('.forge-recovery-')) return withIdentity(stat, recoveryInode);
+			return withIdentity(stat, sourceInode);
+		});
+		const fstatSpy = spyOn(fs, 'fstatSync').mockImplementation((descriptor, options) => (
+			withIdentity(originalFstatSync.call(fs, descriptor, options), recoveryInode)
+		));
+		try {
+			const replay = await fixture.driver.applyLegacyClaimRepair({
+				observedAt: OBSERVED_AT,
+				approvedDigest: preflight.digest,
+				backupPath,
+				actor: 'approved-operator',
+			}, fixture.config);
+			expect(replay.replayed).toBe(true);
+			expect(replay.recovery_ref).toMatch(/^[0-9a-f-]{36}$/);
+			expect(typeof replay.recovery_path).toBe('string');
+			expect(fs.existsSync(replay.recovery_path)).toBe(true);
+		} finally {
+			fstatSpy.mockRestore();
+			statSpy.mockRestore();
+		}
+
+		let fstatCall = 0n;
+		const mtimeSpy = spyOn(fs, 'fstatSync').mockImplementation((descriptor, options) => {
+			const stat = originalFstatSync.call(fs, descriptor, options);
+			if (typeof stat.mtimeNs !== 'bigint') return stat;
+			fstatCall += 1n;
+			return { ...stat, mtimeNs: stat.mtimeNs + fstatCall };
+		});
+		try {
+			await expect(fixture.driver.applyLegacyClaimRepair({
+				observedAt: OBSERVED_AT,
+				approvedDigest: preflight.digest,
+				backupPath,
+				actor: 'approved-operator',
+			}, fixture.config)).rejects.toMatchObject({ code: 'CLAIM_REPAIR_RECOVERY_INVALID' });
+		} finally {
+			mtimeSpy.mockRestore();
+			fixture.driver.close();
+		}
 	});
 
 	test('rejects replay when the retained recovery copy is missing or corrupted', async () => {
