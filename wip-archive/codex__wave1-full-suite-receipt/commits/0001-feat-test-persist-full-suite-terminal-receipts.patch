+        if (existing >= 0) shardResults[existing] = next;
+        else shardResults.push(next);
+        persistReceipt();
+      },
     })));
 
     completed = true;
-    return signal ? signalExitCode(signal) : (results.some((code) => code !== 0) ? 1 : 0);
+    finalExitStatus = signal ? signalExitCode(signal) : (results.some((code) => code !== 0) ? 1 : 0);
+    completionState = signal ? 'terminated' : 'completed';
+    persistReceipt(finalExitStatus, now());
+    return finalExitStatus;
+  } catch (error) {
+    finalExitStatus = signal ? signalExitCode(signal) : 1;
+    completionState = signal ? 'terminated' : 'failed';
+    persistReceipt(finalExitStatus, now());
+    throw error;
   } finally {
     removeSignalHandlers();
     processTree.cleanup(signal || !completed ? 'SIGKILL' : 'SIGTERM');
