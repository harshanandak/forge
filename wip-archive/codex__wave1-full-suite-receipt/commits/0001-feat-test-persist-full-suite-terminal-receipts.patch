+
+describe('full-suite terminal receipts', () => {
+  test('builds a reconstructable PASS receipt from exact head, shard coverage, and JUnit totals', () => {
+    const receipt = buildTerminalReceipt({
+      runId: 'run-pass',
+      headSha: 'a'.repeat(40),
+      startedAt: '2026-08-07T08:00:00.000Z',
+      completedAt: '2026-08-07T08:01:00.000Z',
+      parentExitStatus: 0,
+      completionState: 'completed',
+      shardSpecs: [{
+        index: 0,
+        source: 'modulo',
+        files: ['test/a.test.js'],
+      }],
+      shardResults: [{
+        index: 0,
+        exitStatus: 0,
+        reportPath: 'test-results/local-full-shard-0.xml',
+        report: {
+          complete: true,
+          tests: 3,
+          assertions: 5,
+          skipped: 1,
+          failures: 0,
+        },
+      }],
+    });
+
+    expect(receipt).toMatchObject({
+      schemaVersion: 1,
+      kind: 'full-suite.terminal',
+      runId: 'run-pass',
+      headSha: 'a'.repeat(40),
+      parentExitStatus: 0,
+      completionState: 'completed',
+      result: 'PASS',
+      totals: { tests: 3, assertions: 5, skipped: 1, failures: 0 },
+    });
+    expect(receipt.shards).toEqual([{
+      index: 0,
+      source: 'modulo',
+      files: ['test/a.test.js'],
+      exitStatus: 0,
+      reportPath: 'test-results/local-full-shard-0.xml',
+      coverage: 'complete',
+    }]);
+  });
+
+  test('aggregates Bun JUnit reports and fails closed when a report is missing or truncated', () => {
+    const fixtureRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-full-suite-receipt-'));
+    try {
+      const completePath = path.join(fixtureRoot, 'complete.xml');
+      fs.writeFileSync(completePath, `<testsuites tests="3" assertions="5" skipped="1" failures="0">
+  <testsuite tests="3" assertions="5" skipped="1" failures="0">
+    <testcase assertions="2" />
+    <testcase assertions="3" />
+  </testsuite>
+</testsuites>`, 'utf8');
+      expect(aggregateJUnitReports([completePath])).toEqual({
+        complete: true,
+        tests: 3,
+        assertions: 5,
+        skipped: 1,
+        failures: 0,
+      });
+      expect(aggregateJUnitReports([
+        completePath,
+        path.join(fixtureRoot, 'missing.xml'),
+      ])).toMatchObject({ complete: false, reason: 'missing-report' });
+
+      const truncatedPath = path.join(fixtureRoot, 'truncated.xml');
+      fs.writeFileSync(truncatedPath, '<testsuites tests="3" assertions="5"', 'utf8');
+      expect(aggregateJUnitReports([truncatedPath])).toMatchObject({
+        complete: false,
+        reason: 'truncated-report',
+      });
+    } finally {
+      fs.rmSync(fixtureRoot, { recursive: true, force: true });
+    }
+  });
+  test('successful runner writes a terminal PASS receipt from shard JUnit output', async () => {
+    const receiptRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-full-suite-pass-'));
+    const receiptPath = path.join(receiptRoot, 'receipt.json');
+    const processTree = {
+      reserveChild: () => ({ id: 'pass' }),
+      registerChild: () => true,
+      unregisterChild: () => {},
+      installSignalHandlers: () => () => {},
+      cleanup: () => {},
+    };
+    const spawn = (_command, args) => {
+      const child = new EventEmitter();
+      child.pid = 9500;
+      const reportPath = args[args.indexOf('--reporter-outfile') + 1];
+      fs.writeFileSync(reportPath, `<testsuites tests="2" assertions="3" skipped="0" failures="0">
+  <testsuite tests="2" assertions="3" skipped="0" failures="0">
+    <testcase assertions="1" />
+    <testcase assertions="2" />
+  </testsuite>
+</testsuites>`, 'utf8');
+      process.nextTick(() => child.emit('close', 0));
+      return child;
+    };
+
+    try {
+      const status = await runFullSuiteInParallel({ shards: 1 }, {
+        allTests: ['test/a.test.js'],
+        durationMap: new Map([['test/a.test.js', 1]]),
+        headSha: 'c'.repeat(40),
+        processTree,
+        receiptPath,
+        spawn,
+      });
+
+      expect(status).toBe(0);
+      expect(readTerminalReceipt(receiptPath)).toMatchObject({
+        headSha: 'c'.repeat(40),
+        parentExitStatus: 0,
+        completionState: 'completed',
+        result: 'PASS',
+        totals: { tests: 2, assertions: 3, skipped: 0, failures: 0 },
+      });
+    } finally {
+      fs.rmSync(receiptRoot, { recursive: true, force: true });
+    }
+  });
+
+
+  test('persists terminal receipts atomically and observes termination as INCOMPLETE', async () => {
+    const receiptPath = path.join(os.tmpdir(), `forge-full-suite-${Date.now()}-receipt.json`);
+    let onSignal;
+    const processTree = {
+      reserveChild: () => ({ id: 'termination' }),
+      registerChild: () => true,
+      unregisterChild: () => {},
+      installSignalHandlers: (callback) => {
+        onSignal = callback;
+        return () => {};
+      },
+      cleanup: () => {},
+    };
+    const spawn = () => {
+      const child = new EventEmitter();
+      child.pid = 9400;
+      process.nextTick(() => {
+        onSignal('SIGTERM');
+        child.emit('close', null);
+      });
+      return child;
+    };
+
+    try {
+      const status = await runFullSuiteInParallel({ shards: 1 }, {
+        allTests: ['test/a.test.js'],
+        durationMap: new Map([['test/a.test.js', 1]]),
+        headSha: 'b'.repeat(40),
+        processTree,
+        receiptPath,
+        spawn,
+      });
+
+      expect(status).toBe(143);
+      expect(readTerminalReceipt(receiptPath)).toMatchObject({
+        headSha: 'b'.repeat(40),
+        parentExitStatus: 143,
+        completionState: 'terminated',
+        result: 'INCOMPLETE',
+      });
+    } finally {
+      fs.rmSync(receiptPath, { force: true });
+      fs.rmSync(`${receiptPath}.tmp`, { force: true });
+    }
+  });
+});
