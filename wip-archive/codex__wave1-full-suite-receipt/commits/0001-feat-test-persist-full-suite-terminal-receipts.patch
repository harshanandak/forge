@@ -212,8 +385,37 @@ async function runFullSuiteInParallel(args = {}, deps = {}) {
   const processTree = deps.processTree || createProcessTree({ env, platform });
   let signal = null;
   let completed = false;
+  const runId = deps.runId || randomUUID();
