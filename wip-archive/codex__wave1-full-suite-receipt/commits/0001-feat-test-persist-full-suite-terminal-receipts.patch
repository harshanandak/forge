@@ -15,9 +16,174 @@ const {
 } = require('./test-ci-shard');
 const { createProcessTree, signalExitCode } = require('./process-tree');
 const { stripGitHookEnv } = require('./test');
+const { parseAttributes } = require('./test-profile');
 
 const rootDir = path.join(__dirname, '..');
 const reportDir = path.join(rootDir, 'test-results');
+const RECEIPT_SCHEMA_VERSION = 1;
+const RECEIPT_KIND = 'full-suite.terminal';
+const FULL_HEAD_SHA = /^[0-9a-f]{40}$/;
+
+function numberAttribute(attributes, key) {
+  const value = Number.parseInt(attributes[key], 10);
+  return Number.isSafeInteger(value) && value >= 0 ? value : null;
+}
+
+function sumAttributes(attributes, key) {
+  const values = attributes.map((item) => numberAttribute(item, key));
+  return values.every((value) => value !== null)
+    ? values.reduce((total, value) => total + value, 0)
+    : null;
+}
+
+function aggregateJUnitReports(reportPaths) {
+  if (!Array.isArray(reportPaths) || reportPaths.length === 0) {
+    return { complete: false, reason: 'no-reports' };
+  }
+
+  const totals = { tests: 0, assertions: 0, skipped: 0, failures: 0 };
+  for (const reportPath of reportPaths) {
+    let content;
+    try {
+      content = fs.readFileSync(reportPath, 'utf8');
+    } catch {
+      return { complete: false, reason: 'missing-report' };
+    }
+
+    const normalized = content.trim();
+    const rootMatch = normalized.match(/<testsuites\b([^>]*)>/);
+    const suiteMatches = [...normalized.matchAll(/<testsuite\b([^>]*)>/g)];
+    if (!rootMatch || (!normalized.endsWith('</testsuites>') && !normalized.endsWith('/>'))) {
+      return { complete: false, reason: 'truncated-report' };
+    }
+
+    const rootAttributes = parseAttributes(rootMatch[1]);
+    const suiteAttributes = suiteMatches.map((match) => parseAttributes(match[1]));
+    const testcaseCount = (normalized.match(/<testcase\b/g) || []).length;
+    const testcaseAssertions = [...normalized.matchAll(/<testcase\b([^>]*)>/g)]
+      .map((match) => numberAttribute(parseAttributes(match[1]), 'assertions'));
+    const rootOrSuites = (key) => {
+      const rootValue = numberAttribute(rootAttributes, key);
+      if (rootValue !== null) return rootValue;
+      return sumAttributes(suiteAttributes, key);
+    };
+    const values = {
+      tests: rootOrSuites('tests') ?? testcaseCount,
+      assertions: rootOrSuites('assertions')
+        ?? (testcaseAssertions.length > 0 && testcaseAssertions.every((value) => value !== null)
+          ? testcaseAssertions.reduce((total, value) => total + value, 0)
+          : null),
+      skipped: rootOrSuites('skipped')
+        ?? (normalized.match(/<skipped\b/g) || []).length,
+      failures: rootOrSuites('failures')
+        ?? ((normalized.match(/<(?:failure|error)\b/g) || []).length),
+    };
+    if (Object.values(values).some((value) => value === null)) {
+      return { complete: false, reason: 'non-reconstructable-report' };
+    }
+    if (values.tests === 0) {
+      return { complete: false, reason: 'zero-tests' };
+    }
+    for (const key of Object.keys(totals)) totals[key] += values[key];
+  }
+
+  return { complete: true, ...totals };
+}
+
+function buildTerminalReceipt({
+  runId,
+  headSha,
+  startedAt,
+  completedAt = null,
+  parentExitStatus = null,
+  completionState = 'running',
+  shardSpecs = [],
+  shardResults = [],
+}) {
+  const resultByIndex = new Map(shardResults.map((result) => [result.index, result]));
+  const shards = shardSpecs.map((spec) => {
+    const result = resultByIndex.get(spec.index);
+    const report = result?.report;
+    return {
+      index: spec.index,
+      source: spec.source || null,
+      files: [...spec.files],
+      exitStatus: Number.isSafeInteger(result?.exitStatus) ? result.exitStatus : null,
+      reportPath: result?.reportPath || null,
+      coverage: report?.complete === true ? 'complete' : 'incomplete',
+    };
+  });
+  const completeReports = shardResults.length === shardSpecs.length
+    && shardResults.every((result) => result.report?.complete === true);
+  const totals = completeReports
+    ? shardResults.reduce((sum, result) => {
+      for (const key of ['tests', 'assertions', 'skipped', 'failures']) sum[key] += result.report[key];
+      return sum;
+    }, { tests: 0, assertions: 0, skipped: 0, failures: 0 })
+    : { tests: null, assertions: null, skipped: null, failures: null };
+  const reconstructable = FULL_HEAD_SHA.test(headSha || '')
+    && Number.isSafeInteger(parentExitStatus)
+    && shardSpecs.length > 0
+    && shards.every((shard) => shard.coverage === 'complete' && Number.isSafeInteger(shard.exitStatus))
+    && completeReports
+    && totals.tests > 0;
+  const result = reconstructable
+    ? (parentExitStatus === 0 && totals.failures === 0 ? 'PASS' : 'FAIL')
+    : 'INCOMPLETE';
+  return {
+    schemaVersion: RECEIPT_SCHEMA_VERSION,
+    kind: RECEIPT_KIND,
+    runId: runId || null,
+    headSha: FULL_HEAD_SHA.test(headSha || '') ? headSha : null,
+    startedAt: startedAt || null,
+    completedAt,
+    parentExitStatus: Number.isSafeInteger(parentExitStatus) ? parentExitStatus : null,
+    completionState,
+    result,
+    totals,
+    shards,
+  };
+}
+
+function writeTerminalReceipt(receipt, receiptPath) {
+  if (!receiptPath || typeof receiptPath !== 'string') throw new Error('receipt path is required');
+  fs.mkdirSync(path.dirname(receiptPath), { recursive: true });
+  const tempPath = `${receiptPath}.tmp`;
+  fs.writeFileSync(tempPath, `${JSON.stringify(receipt, null, 2)}\n`, 'utf8');
+  try {
+    fs.renameSync(tempPath, receiptPath);
+  } catch (error) {
+    if (!['EEXIST', 'EPERM', 'ENOTEMPTY'].includes(error?.code)) throw error;
+    fs.rmSync(receiptPath, { force: true });
+    fs.renameSync(tempPath, receiptPath);
+  }
+  return receiptPath;
+}
+
+function readTerminalReceipt(receiptPath) {
+  try {
+    const receipt = JSON.parse(fs.readFileSync(receiptPath, 'utf8'));
+    return receipt && receipt.schemaVersion === RECEIPT_SCHEMA_VERSION
+      && receipt.kind === RECEIPT_KIND ? receipt : null;
+  } catch {
+    return null;
+  }
+}
+
+function resolveHeadSha(options = {}) {
+  if (Object.hasOwn(options, 'headSha')) return options.headSha;
+  try {
+    return execFileSync('git', ['rev-parse', 'HEAD'], {
+      cwd: rootDir,
+      encoding: 'utf8',
+      stdio: ['ignore', 'pipe', 'ignore'],
+      windowsHide: true,
+    }).trim();
+  } catch {
+    return null;
+  }
+}
+
 
