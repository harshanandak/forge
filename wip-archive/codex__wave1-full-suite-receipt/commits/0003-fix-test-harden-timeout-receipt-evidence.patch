+  while ((match = tokenPattern.exec(normalized)) !== null) {
+    const between = normalized.slice(cursor, match.index);
+    if (between.includes('<') || (stack.length === 0 && between.trim() !== '')) return null;
+    cursor = match.index + match[0].length;
+    const token = match[0];
+    if (token.startsWith('<!--') || token.startsWith('<?')) continue;
+
+    if (token.startsWith('</')) {
+      const closing = new RegExp(`^</(${XML_NAME_PATTERN})\\s*>$`).exec(token);
+      if (!closing || stack.length === 0 || stack[stack.length - 1] !== closing[1]) return null;
+      stack.pop();
+      if (closing[1] === 'testsuites') rootClosed = true;
+      continue;
+    }
+
+    const selfClosing = /\/\s*>$/.test(token);
+    const body = token.slice(1, token.length - (selfClosing ? 2 : 1));
+    const opening = new RegExp(`^(${XML_NAME_PATTERN})([\\s\\S]*)$`).exec(body);
+    if (!opening || !allowedTags.has(opening[1])) return null;
+    const name = opening[1];
+    const attributes = parseStrictXmlAttributes(opening[2]);
+    if (!attributes) return null;
+    for (const key of JUNIT_NUMERIC_KEYS) {
+      if (Object.hasOwn(attributes, key) && numberAttribute(attributes, key) === null) return null;
+    }
+
+    if (name === 'testsuites') {
+      if (rootAttributes || stack.length > 0 || rootClosed) return null;
+      rootAttributes = attributes;
+      if (selfClosing) rootClosed = true;
+      else stack.push(name);
+      continue;
+    }
+    if (!rootAttributes || rootClosed) return null;
+    const parent = stack[stack.length - 1];
+    if (name === 'testsuite') {
+      if (parent !== 'testsuites') return null;
+      suites.push(attributes);
+    } else if (name === 'testcase') {
+      if (parent !== 'testsuite') return null;
+      testcases.push(attributes);
+    } else if (name === 'skipped') {
+      if (parent !== 'testcase') return null;
+      skippedCount += 1;
+    } else if (name === 'failure') {
+      if (parent !== 'testcase') return null;
+      failureCount += 1;
+    } else if (name === 'error') {
+      return null;
+    }
+    if (!selfClosing) stack.push(name);
+  }
+
+  const trailing = normalized.slice(cursor);
+  if (trailing.includes('<') || (stack.length === 0 && trailing.trim() !== '')
+    || stack.length > 0 || !rootAttributes || !rootClosed) return null;
+  return {
+    rootAttributes,
+    suiteAttributes: suites,
+    testcaseAttributes: testcases,
+    skippedCount,
+    failureCount,
+  };
