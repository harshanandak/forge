+function parseStrictXmlAttributes(raw) {
+  const attributes = {};
+  let offset = 0;
+  while (offset < raw.length) {
+    while (/\s/.test(raw[offset] || '')) offset += 1;
+    if (offset >= raw.length) break;
+    const nameMatch = new RegExp(`^(${XML_NAME_PATTERN})`).exec(raw.slice(offset));
+    if (!nameMatch) return null;
+    const name = nameMatch[1];
+    offset += name.length;
+    while (/\s/.test(raw[offset] || '')) offset += 1;
+    if (raw[offset] !== '=') return null;
+    offset += 1;
+    while (/\s/.test(raw[offset] || '')) offset += 1;
+    const quote = raw[offset];
+    if (quote !== '"' && quote !== "'") return null;
+    offset += 1;
+    const end = raw.indexOf(quote, offset);
+    if (end < 0 || Object.hasOwn(attributes, name)) return null;
+    attributes[name] = raw.slice(offset, end);
+    offset = end + 1;
+  }
+  return attributes;
+}
