+function parseStrictJUnitXml(normalized) {
+  const tokenPattern = /<!--[\s\S]*?-->|<\?[\s\S]*?\?>|<\/?[A-Za-z_][A-Za-z0-9_.:-]*(?:\s+[^<>]*?)?\s*\/?>/g;
+  const allowedTags = new Set(['testsuites', 'testsuite', 'testcase', 'failure', 'skipped', 'error']);
