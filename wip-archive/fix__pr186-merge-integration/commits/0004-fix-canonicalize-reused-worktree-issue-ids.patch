From 9cb1f0b2b130f8731757cdd85aaa7f5a5390522e Mon Sep 17 00:00:00 2001
From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Thu, 27 Aug 2026 13:23:40 +0530
Subject: [PATCH] fix: canonicalize reused worktree issue ids

---
 lib/commands/worktree.js               | 42 ++++++++++--
 test/commands/worktree-linkage.test.js | 90 ++++++++++++++++++++++++++
 2 files changed, 126 insertions(+), 6 deletions(-)

diff --git a/lib/commands/worktree.js b/lib/commands/worktree.js
index 44f83c20..f7ab9824 100644
--- a/lib/commands/worktree.js
+++ b/lib/commands/worktree.js
@@ -4,6 +4,7 @@ const { execFileSync, spawnSync } = require('node:child_process');
 const fs = require('node:fs');
 const path = require('node:path');
 const { detectDefaultBranch } = require('../git-defaults');
+const { resolveIssueId } = require('../kernel/issue-id-resolver');
 const {
   resolveRepoRelativePath,
   assertNoAncestorSymlinkEscape,
@@ -305,13 +306,13 @@ function validateMarkerTarget(projectRoot, workFolder, fsApi) {
   return { folderAbs: resolved.target, markerPath, folderExists: Boolean(folderStat) };
 }
 
-function reconcileIssueMarker({ target, linkedIssue, linkedFolder, fsApi }) {
+function reconcileIssueMarker({ target, linkedIssue, linkedFolder, priorEquivalentIssue, fsApi }) {
   if (!target || !linkedIssue || !target.folderExists) return null;
   let markerIssue = null;
   try {
     if (fsApi.existsSync(target.markerPath)) markerIssue = fsApi.readFileSync(target.markerPath, 'utf8').trim() || null;
   } catch { /* unreadable marker — let the write below repair it */ }
-  if (markerIssue && markerIssue !== linkedIssue) {
+  if (markerIssue && markerIssue !== linkedIssue && markerIssue !== priorEquivalentIssue) {
     return {
       issueId: linkedIssue,
       workFolder: linkedFolder,
@@ -323,6 +324,22 @@ function reconcileIssueMarker({ target, linkedIssue, linkedFolder, fsApi }) {
   return null;
 }
 
+async function resolveEquivalentIssueId(driver, storedIssue, requestedIssue) {
+  if (!storedIssue || !requestedIssue) return null;
+  if (storedIssue === requestedIssue) return requestedIssue;
+  if (!driver || typeof driver.findIssueIdsByPrefix !== 'function') return null;
+  try {
+    const lookup = (prefix, limit) => driver.findIssueIdsByPrefix(prefix, limit, {}, {});
+    const [stored, requested] = await Promise.all([
+      resolveIssueId(storedIssue, lookup),
+      resolveIssueId(requestedIssue, lookup),
+    ]);
+    return !stored.error && !requested.error && stored.id === requested.id ? stored.id : null;
+  } catch {
+    return null;
+  }
+}
+
 /**
  * Best-effort: record the issue → worktree → work-folder linkage in the Kernel so
  * `forge worktree list` and orientation READ it instead of guessing the work-folder by
@@ -360,18 +377,31 @@ async function registerWorktreeLinkage({ projectRoot, worktreePath, branch, issu
     }
 
     const existing = readExistingWorktreeLinkage(driver, worktreePath, reuse);
-    const linkageConflict = detectLinkageConflict({ projectRoot, existing, issueId, workFolder, reuse });
+    const existingIssue = existing?.issue_id || null;
+    const equivalentIssueId = await resolveEquivalentIssueId(driver, existingIssue, issueId);
+    const requestedIssue = equivalentIssueId || issueId;
+    const comparableExisting = equivalentIssueId && existingIssue !== requestedIssue
+      ? { ...existing, issue_id: requestedIssue }
+      : existing;
+    const linkageConflict = detectLinkageConflict({
+      projectRoot, existing: comparableExisting, issueId: requestedIssue, workFolder, reuse,
+    });
     if (linkageConflict) return { registered: false, ...linkageConflict };
 
-    const existingIssue = existing?.issue_id || null;
     const existingFolder = existing?.work_folder || null;
-    const linkedIssue = issueId || (reuse ? existingIssue : null);
+    const linkedIssue = requestedIssue || (reuse ? existingIssue : null);
     const linkedFolder = workFolder || (reuse ? existingFolder : null);
     const markerTarget = validateMarkerTarget(projectRoot, linkedFolder, fsApi);
     if (markerTarget?.conflict) {
       return { registered: false, issueId: linkedIssue || null, workFolder: linkedFolder || null, ...markerTarget };
     }
-    const markerConflict = reconcileIssueMarker({ target: markerTarget, linkedIssue, linkedFolder, fsApi });
+    const markerConflict = reconcileIssueMarker({
+      target: markerTarget,
+      linkedIssue,
+      linkedFolder,
+      priorEquivalentIssue: equivalentIssueId ? existingIssue : null,
+      fsApi,
+    });
     if (markerConflict) {
       return { registered: false, ...markerConflict };
     }
diff --git a/test/commands/worktree-linkage.test.js b/test/commands/worktree-linkage.test.js
index d0e701fb..c6d9abf3 100644
--- a/test/commands/worktree-linkage.test.js
+++ b/test/commands/worktree-linkage.test.js
@@ -25,6 +25,7 @@ const { buildMigratedKernelIssueDeps } = require('../../lib/kernel/cli-broker-fa
 const TIMEOUT = 15000;
 const cleanups = [];
 const DIRECTORY_LINK_UNSUPPORTED_ERRORS = new Set(['EPERM', 'ENOSYS', 'ENOTSUP', 'EOPNOTSUPP']);
+const CANONICAL_ISSUE = '619e1cd4-9a5f-47c2-a3b7-1b8a5e6f0c42';
 
 function probeDirectoryLinkSupport() {
   const probeRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-linkage-link-probe-'));
@@ -92,6 +93,15 @@ async function setup() {
   return { root, gitCommonDir, driver: deps.kernelDriver };
 }
 
+async function seedIssues(driver, ids) {
+  const createdAt = '2026-08-27T00:00:00.000Z';
+  for (const [index, id] of ids.entries()) {
+    await driver.exec(
+      `INSERT INTO kernel_issues (id, title, created_at, updated_at) VALUES ('${id}', 'Issue ${index}', '${createdAt}', '${createdAt}');`,
+    );
+  }
+}
+
 afterEach(() => {
   while (cleanups.length > 0) cleanups.pop()();
 });
@@ -194,6 +204,86 @@ describe('P0 kernel linkage: forge worktree create writes kernel_worktrees', ()
     expect(rows[0].work_folder).toBe(workFolder);
   }, TIMEOUT);
 
+  test('canonicalizes a uniquely resolved short issue id on worktree reuse', async () => {
+    const { root, gitCommonDir, driver } = await setup();
+    await seedIssues(driver, [CANONICAL_ISSUE]);
+    const worktreePath = path.resolve(root, '.worktrees', 'canonical');
+    const workFolder = 'docs/work/2026-07-04-linked';
+    const markerPath = path.join(root, workFolder, '.forge-issue');
+    const opts = { _exec: gitStub(gitCommonDir, root), _spawn: () => ({ status: 0 }), _platform: 'linux', _kernelDriver: driver };
+
+    const first = await worktree.handler(
+      ['create', 'canonical', '--branch', 'feat/canonical', '--issue', '619e1cd4', '--work-folder', workFolder],
+      {}, root, opts,
+    );
+    expect(first.success).toBe(true);
+    fs.mkdirSync(worktreePath, { recursive: true });
+    const original = (await driver.queryAll('SELECT * FROM kernel_worktrees'))[0];
+    expect(fs.readFileSync(markerPath, 'utf8').trim()).toBe('619e1cd4');
+
+    const repaired = await worktree.handler(
+      ['create', 'canonical', '--branch', 'feat/canonical', '--issue', CANONICAL_ISSUE, '--work-folder', workFolder],
+      {}, root, opts,
+    );
+
+    expect(repaired.success).toBe(true);
+    expect(repaired.reused).toBe(true);
+    const rows = await driver.queryAll('SELECT * FROM kernel_worktrees');
+    expect(rows).toHaveLength(1);
+    expect(rows[0].id).toBe(original.id);
+    expect(rows[0].issue_id).toBe(CANONICAL_ISSUE);
+    expect(fs.readFileSync(markerPath, 'utf8').trim()).toBe(CANONICAL_ISSUE);
+
+    const shortReuse = await worktree.handler(
+      ['create', 'canonical', '--branch', 'feat/canonical', '--issue', '619e1cd4', '--work-folder', workFolder],
+      {}, root, opts,
+    );
+    expect(shortReuse.success).toBe(true);
+    expect((await driver.queryAll('SELECT issue_id FROM kernel_worktrees'))[0].issue_id).toBe(CANONICAL_ISSUE);
+    expect(fs.readFileSync(markerPath, 'utf8').trim()).toBe(CANONICAL_ISSUE);
+  }, TIMEOUT);
+
+  test('refuses ambiguous, different, and unknown short issue ids without rewriting linkage', async () => {
+    const cases = [
+      {
+        slug: 'ambiguous',
+        stored: '619e1cd4',
+        issues: [CANONICAL_ISSUE, '619e1cd4-1111-4111-8111-111111111111'],
+      },
+      {
+        slug: 'different',
+        stored: 'deadbeef',
+        issues: [CANONICAL_ISSUE, 'deadbeef-1111-4111-8111-111111111111'],
+      },
+      { slug: 'unknown', stored: 'cafebabe', issues: [CANONICAL_ISSUE] },
+    ];
+
+    for (const entry of cases) {
+      const { root, gitCommonDir, driver } = await setup();
+      await seedIssues(driver, entry.issues);
+      const worktreePath = path.resolve(root, '.worktrees', entry.slug);
+      const workFolder = `docs/work/${entry.slug}`;
+      const markerPath = path.join(root, workFolder, '.forge-issue');
+      fs.mkdirSync(path.join(root, workFolder), { recursive: true });
+      const opts = { _exec: gitStub(gitCommonDir, root), _spawn: () => ({ status: 0 }), _platform: 'linux', _kernelDriver: driver };
+      const originalArgs = ['create', entry.slug, '--branch', `feat/${entry.slug}`, '--issue', entry.stored, '--work-folder', workFolder];
+
+      expect((await worktree.handler(originalArgs, {}, root, opts)).success).toBe(true);
+      fs.mkdirSync(worktreePath, { recursive: true });
+      const before = await driver.queryAll('SELECT * FROM kernel_worktrees');
+
+      const result = await worktree.handler(
+        ['create', entry.slug, '--branch', `feat/${entry.slug}`, '--issue', CANONICAL_ISSUE, '--work-folder', workFolder],
+        {}, root, opts,
+      );
+
+      expect(result.success).toBe(false);
+      expect(result.error).toMatch(/mismatch/i);
+      expect(await driver.queryAll('SELECT * FROM kernel_worktrees')).toEqual(before);
+      expect(fs.readFileSync(markerPath, 'utf8').trim()).toBe(entry.stored);
+    }
+  }, TIMEOUT);
+
   test('rejects mismatched issue or work-folder on reuse without rewriting linkage', async () => {
     const { root, gitCommonDir, driver } = await setup();
     const worktreePath = path.resolve(root, '.worktrees', 'mismatch');
