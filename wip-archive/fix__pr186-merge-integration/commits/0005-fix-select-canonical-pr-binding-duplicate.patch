From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Thu, 27 Aug 2026 13:25:43 +0530
Subject: [PATCH] fix: select canonical pr binding duplicate

---
 lib/commands/merge.js                 |  28 ++++++-
 test/commands/merge-authority.test.js | 107 ++++++++++++++++++++++++++
 2 files changed, 132 insertions(+), 3 deletions(-)

diff --git a/lib/commands/merge.js b/lib/commands/merge.js
index 6f34d15e..425fad2d 100644
--- a/lib/commands/merge.js
+++ b/lib/commands/merge.js
@@ -124,6 +124,25 @@ function normalizeCommonDir(value) {
   return process.platform === 'win32' ? resolved.toLowerCase() : resolved;
 }
 
+function sameDuplicatePrIdentity(rows) {
+  const first = rows[0];
+  const branch = typeof first?.branch === 'string' && first.branch ? first.branch : null;
+  const head = normalizeFullHeadSha(first?.head_sha);
+  const state = typeof first?.state === 'string' && first.state ? first.state : null;
+  return Boolean(branch && head && state) && rows.every(row => row?.branch === branch
+    && normalizeFullHeadSha(row?.head_sha) === head && row?.state === state);
+}
+
+function selectCanonicalCommonDirRow(rows, gitCommonDir) {
+  if (!sameDuplicatePrIdentity(rows) || typeof gitCommonDir !== 'string' || !gitCommonDir) return null;
+  const canonicalRaw = path.resolve(gitCommonDir);
+  const canonical = rows.filter(row => row?.git_common_dir === canonicalRaw);
+  if (canonical.length === 1) return canonical[0];
+  if (canonical.length > 1 || canonicalRaw === gitCommonDir) return null;
+  const currentRaw = rows.filter(row => row?.git_common_dir === gitCommonDir);
+  return currentRaw.length === 1 ? currentRaw[0] : null;
+}
+
 function defaultResolveLocalRepository({ projectRoot, git = execFileSync }) {
   try {
     const remote = git('git', ['remote', 'get-url', 'origin'], {
@@ -296,10 +315,13 @@ function selectPrBindingRow(rows, repository, number, gitCommonDir = null, issue
   if (matches.length === 0) return { missing: true, error: 'Kernel PR linkage is missing.' };
   const conflicting = issueId && matches.some(row => row.issue_id != null && row.issue_id !== issueId);
   const linked = issueId ? matches.filter(row => row.issue_id === issueId) : matches;
-  if (conflicting || linked.length > 1 || (linked.length === 0 && matches.length > 1)) {
+  if (conflicting || (linked.length === 0 && matches.length > 1)) {
     return { error: 'Kernel PR linkage is ambiguous.' };
   }
-  const row = linked[0] || matches[0];
+  const row = linked.length > 1
+    ? selectCanonicalCommonDirRow(linked, gitCommonDir)
+    : (linked[0] || matches[0]);
+  if (!row) return { error: 'Kernel PR linkage is ambiguous.' };
   if (!normalizeRepository(row?.repo)) return { error: 'Kernel PR repository identity is unreadable.' };
   return { row };
 }
@@ -392,7 +414,7 @@ async function defaultVerifyPrIssueBinding({
       rows,
       repository,
       number,
-      allowRetired ? built.gitCommonDir : null,
+      built.gitCommonDir,
       issueId,
     );
     if (!selection.row) {
diff --git a/test/commands/merge-authority.test.js b/test/commands/merge-authority.test.js
