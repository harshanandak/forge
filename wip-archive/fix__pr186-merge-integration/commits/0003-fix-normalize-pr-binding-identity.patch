+          gaps: [],
+          pull_requests: [{
+            id: 'pr-linked', repo: 'acme/forge', number: 42, issue_id: ISSUE,
+            git_common_dir: '/repo/.git', state: 'open', iterations: [],
+          }, {
+            id: 'pr-conflict', repo: 'acme/forge', number: 42,
+            issue_id: '11111111-1111-4111-8111-111111111111',
+            git_common_dir: '/repo/.git', state: 'open', iterations: [],
+          }],
+        }) },
+      }),
+    });
