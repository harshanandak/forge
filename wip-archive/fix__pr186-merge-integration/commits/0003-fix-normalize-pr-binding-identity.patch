 const { execFileSync } = require('node:child_process');
+const path = require('node:path');
 
 const { loadRawConfig } = require('../config-writer');
 const { evaluateMergeRules } = require('../merge-rules');
@@ -117,6 +118,12 @@ function normalizeRepository(value) {
   return typeof value === 'string' && REPOSITORY_NAME.test(value) ? value.toLowerCase() : null;
 }
 
+function normalizeCommonDir(value) {
+  if (typeof value !== 'string' || !value) return null;
+  const resolved = path.resolve(value);
+  return process.platform === 'win32' ? resolved.toLowerCase() : resolved;
+}
+
 function defaultResolveLocalRepository({ projectRoot, git = execFileSync }) {
   try {
     const remote = git('git', ['remote', 'get-url', 'origin'], {
@@ -274,22 +281,27 @@ async function defaultVerifyIssueOwnership({
   };
 }
 
-function selectPrBindingRow(rows, repository, number, gitCommonDir = null) {
+function selectPrBindingRow(rows, repository, number, gitCommonDir = null, issueId = null) {
   if (!Array.isArray(rows)) return { error: 'Kernel PR linkage is unreadable.' };
   const repositoryRows = repository
     ? rows.filter(row => normalizeRepository(row?.repo) === repository)
     : rows;
   const candidateRows = gitCommonDir
-    ? repositoryRows.filter(row => row?.git_common_dir === gitCommonDir)
+    ? repositoryRows.filter(row => normalizeCommonDir(row?.git_common_dir) === normalizeCommonDir(gitCommonDir))
     : repositoryRows;
   if (candidateRows.some(row => !normalizeKernelPrNumber(row.number))) {
     return { error: 'Kernel PR linkage contains a malformed PR number.' };
   }
   const matches = candidateRows.filter(row => normalizeKernelPrNumber(row.number) === number);
   if (matches.length === 0) return { missing: true, error: 'Kernel PR linkage is missing.' };
-  if (matches.length > 1) return { error: 'Kernel PR linkage is ambiguous.' };
-  if (!normalizeRepository(matches[0]?.repo)) return { error: 'Kernel PR repository identity is unreadable.' };
-  return { row: matches[0] };
+  const conflicting = issueId && matches.some(row => row.issue_id != null && row.issue_id !== issueId);
+  const linked = issueId ? matches.filter(row => row.issue_id === issueId) : matches;
+  if (conflicting || linked.length > 1 || (linked.length === 0 && matches.length > 1)) {
+    return { error: 'Kernel PR linkage is ambiguous.' };
+  }
+  const row = linked[0] || matches[0];
+  if (!normalizeRepository(row?.repo)) return { error: 'Kernel PR repository identity is unreadable.' };
+  return { row };
 }
 
 async function openPrBindingBroker(projectRoot, buildBroker) {
