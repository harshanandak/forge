@@ -5037,6 +5041,10 @@ function createDriver(runtime, configuredDatabasePath, driverOptions = {}) {
 			if (!persisted) {
 				throw new Error(`Kernel SQLite driver upsertPr: no kernel_pr row after upsert for ${row.repo}#${row.number}`);
