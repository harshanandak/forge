       errors.push({
-        code: 'UNKNOWN_PLAN_SUBSKILL',
-        message: `Unknown planning sub-skill '${id}' in ${CONFIG_SOURCE}.`,
+        code: unknownCode,
+        message: `Unknown ${noun} '${id}' in ${CONFIG_SOURCE}.`,
