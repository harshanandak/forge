+  const noun = owner === 'plan' ? 'planning sub-skill' : `${owner} sub-skill`;
+
   if (!assertStringList(
     value,
     errors,
-    'INVALID_PLAN_SUBSKILL_LIST',
-    `${path} must be a list of planning sub-skill IDs.`
+    listCode,
+    `${path} must be a list of ${noun} IDs.`
   )) {
     return undefined;
