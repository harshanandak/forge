-        const id = r.id ? String(r.id) : '';
-        const author = String(r.author?.login || '').toLowerCase();
-        if (!id) throw new Error('Review is missing stable GraphQL id');
-        if (!author) throw new Error(`Review ${id} is missing author identity`);
-        if (!GITHUB_ACTOR_TYPENAMES.has(String(r.author?.__typename || ''))) {
+        if (typeof r.id !== 'string' || !r.id) {
