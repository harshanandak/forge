+const MERGE_READY_PROVIDER_STATES = new Set(['CLEAN', 'HAS_HOOKS', 'UNSTABLE']);
 
 // Review threads are classified BY MECHANISM, not by a bot-name list: a GitHub
 // review THREAD is opened by a reviewer (a human OR any bot) and stays open until
@@ -490,6 +491,13 @@ async function runShepherdPass(ctx) {
 
   // --- Terminal: all required green + not behind → merge-ready handoff. ---
   if (allRequiredGreen) {
+    const providerMergeState = String(startState.mergeStateStatus || '').toUpperCase();
+    if (!MERGE_READY_PROVIDER_STATES.has(providerMergeState)) {
+      return result('ESCALATE', {
+        actions,
+        reason: `Provider merge state ${providerMergeState || 'UNKNOWN'} does not authorize merge readiness.`,
+      });
+    }
     return result('MERGE_READY', {
       actions,
       reason: 'All required checks are green and the branch is up to date. Handing off to the human to merge in the GitHub UI — the shepherd never merges.',
