+// 007: the kernel linkage backbone. Two additive ADD COLUMNs on kernel_worktrees so a
+// worktree row records the issue it serves (issue_id) and the work-folder that issue
+// owns (work_folder, repo-relative). This is what turns `kernel_worktrees` from a
+// schema-only/never-written table into the queryable issue → worktree → work-folder
+// chain, so orientation resolves the work-folder from the kernel instead of the
+// "most-complete folder" filesystem heuristic. Plain ADD COLUMNs — the 001 initial
+// schema omits these columns (getInitialKernelSchema/MIGRATION_ADDED_COLUMNS) and the
+// broker's per-migration ledger + guarded ADD COLUMN apply them exactly once.
+function buildWorktreeLinkageColumnsMigration() {
+	return {
+		id: '007_kernel_worktrees_linkage_columns',
+		apply: [
+			'ALTER TABLE kernel_worktrees ADD COLUMN issue_id TEXT;',
+			'ALTER TABLE kernel_worktrees ADD COLUMN work_folder TEXT;',
+		],
+		rollback: [
+			'ALTER TABLE kernel_worktrees DROP COLUMN work_folder;',
+			'ALTER TABLE kernel_worktrees DROP COLUMN issue_id;',
+		],
+	};
+}
