-    if (arg.startsWith('--branch=')) {
-      const value = arg.slice('--branch='.length);
+    const eqFlag = WORKTREE_VALUE_FLAGS.find(flag => arg.startsWith(`${flag}=`));
+    if (eqFlag) {
