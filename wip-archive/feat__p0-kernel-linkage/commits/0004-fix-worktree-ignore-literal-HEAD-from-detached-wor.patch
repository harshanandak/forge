From c837558fd8f63d00572c7792f5451f2b9199d7cb Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Sat, 4 Jul 2026 16:29:11 +0530
Subject: [PATCH] fix(worktree): ignore literal HEAD from detached worktree
 when recording branch

CodeRabbit #287: `git rev-parse --abbrev-ref HEAD` returns "HEAD" for a detached
worktree; that would be persisted into kernel_worktrees.branch. Now only adopt a
real branch name (not "HEAD"/empty), else keep branchName.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 lib/commands/worktree.js | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/lib/commands/worktree.js b/lib/commands/worktree.js
index f393cc6a..da799016 100644
--- a/lib/commands/worktree.js
+++ b/lib/commands/worktree.js
@@ -238,7 +238,9 @@ async function handleCreate(slug, flags, projectRoot, opts) {
     // requested branchName — read the actual HEAD so the kernel row is accurate.
     let existingBranch = branchName;
     try {
-      existingBranch = runFile('git', ['-C', worktreePath, 'rev-parse', '--abbrev-ref', 'HEAD'], { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] }).trim() || branchName;
+      const head = runFile('git', ['-C', worktreePath, 'rev-parse', '--abbrev-ref', 'HEAD'], { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] }).trim();
+      // A detached worktree reports the literal "HEAD" — don't persist that; keep branchName.
+      if (head && head !== 'HEAD') existingBranch = head;
     } catch (_error) { /* not a resolvable worktree HEAD — fall back to branchName */ }
     const linkage = await registerWorktreeLinkage({ projectRoot, worktreePath, branch: existingBranch, issueId, workFolder, opts });
     return {
