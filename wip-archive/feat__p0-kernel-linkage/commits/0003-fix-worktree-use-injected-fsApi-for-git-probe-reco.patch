From 4ba5bc5d550173c467eecd4b7517fc6c6f62fba9 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Sat, 4 Jul 2026 15:26:02 +0530
Subject: [PATCH] fix(worktree): use injected fsApi for .git probe; record
 actual HEAD for reused worktrees

CodeRabbit #287: the .git existence probe used the raw fs module instead of the
injected fsApi (breaks test injection); and a pre-existing worktree registered
the requested branchName, which can be stale vs the actual checked-out branch.
Now reads HEAD from the worktree path before recording the kernel row.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 lib/commands/worktree.js | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/lib/commands/worktree.js b/lib/commands/worktree.js
index 56021df2..f393cc6a 100644
--- a/lib/commands/worktree.js
+++ b/lib/commands/worktree.js
@@ -160,7 +160,7 @@ async function registerWorktreeLinkage({ projectRoot, worktreePath, branch, issu
     if (!driver) {
       // No reachable git repo → no shared Kernel; skip quietly (orientation still works
       // off the folder heuristic). Avoids spawning `git` in a non-repo directory.
-      if (!fs.existsSync(path.join(projectRoot, '.git'))) {
+      if (!fsApi.existsSync(path.join(projectRoot, '.git'))) {
         return { registered: false, issueId: issueId || null, workFolder: workFolder || null, reason: 'no git repository' };
       }
       // Lazy require: keep the worktree command light and avoid paying kernel setup
@@ -234,7 +234,13 @@ async function handleCreate(slug, flags, projectRoot, opts) {
 
   // Step 0: Check if worktree already exists
   if (fsApi.existsSync(worktreePath)) {
-    const linkage = await registerWorktreeLinkage({ projectRoot, worktreePath, branch: branchName, issueId, workFolder, opts });
+    // A pre-existing worktree may be checked out on a different branch than the
+    // requested branchName — read the actual HEAD so the kernel row is accurate.
+    let existingBranch = branchName;
+    try {
+      existingBranch = runFile('git', ['-C', worktreePath, 'rev-parse', '--abbrev-ref', 'HEAD'], { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] }).trim() || branchName;
+    } catch (_error) { /* not a resolvable worktree HEAD — fall back to branchName */ }
+    const linkage = await registerWorktreeLinkage({ projectRoot, worktreePath, branch: existingBranch, issueId, workFolder, opts });
     return {
       success: true,
       reused: true,
-- 
