diff --git a/test/pr-state-adapter.test.js b/test/pr-state-adapter.test.js
index ac868c52..511897c4 100644
--- a/test/pr-state-adapter.test.js
+++ b/test/pr-state-adapter.test.js
@@ -858,14 +858,13 @@ describe('PrStateAdapter — lease-bound rebase', () => {
         headReads += 1;
         return `${headReads === 1 ? previousHead : nextHead}\n`;
       }
-      if (args.join(' ') === 'rev-parse --abbrev-ref --symbolic-full-name @{upstream}') {
-        return 'origin/feature\n';
-      }
       return '';
     };
     const adapter = new PrStateAdapter({ gh: () => '', git, cwd: '/wt' });
 
-    const result = await adapter.rebaseOntoBase({ baseRef: 'upstream/master', expectedHead: previousHead });
+    const result = await adapter.rebaseOntoBase({
+      baseRef: 'upstream/master', expectedHead: previousHead, headRef: 'feature', pushRemote: 'origin',
+    });
 
     expect(result).toEqual({ previousHead, headSha: nextHead });
     expect(calls).toContainEqual({ cmd: 'git', args: ['rebase', 'upstream/master'], opts: { cwd: '/wt' } });
@@ -880,4 +879,24 @@ describe('PrStateAdapter — lease-bound rebase', () => {
       opts: { cwd: '/wt' },
     });
   });
+
+  test('aborts a conflicted rebase before returning the original failure', async () => {
+    const previousHead = 'a'.repeat(40);
+    const calls = [];
+    const conflict = new Error('conflict');
+    const git = (cmd, args, opts) => {
+      calls.push({ cmd, args, opts });
+      if (args.join(' ') === 'rev-parse HEAD') return `${previousHead}\n`;
+      if (args[0] === 'check-ref-format') return '';
+      if (args[0] === 'rebase' && args[1] === 'upstream/master') throw conflict;
+      return '';
+    };
+    const adapter = new PrStateAdapter({ gh: () => '', git, cwd: '/wt' });
+
+    await expect(adapter.rebaseOntoBase({
+      baseRef: 'upstream/master', expectedHead: previousHead, headRef: 'feature', pushRemote: 'origin',
+    })).rejects.toBe(conflict);
+    expect(calls).toContainEqual({ cmd: 'git', args: ['rebase', '--abort'], opts: { cwd: '/wt' } });
+    expect(calls.some(({ args }) => args[0] === 'push')).toBe(false);
+  });
 });
