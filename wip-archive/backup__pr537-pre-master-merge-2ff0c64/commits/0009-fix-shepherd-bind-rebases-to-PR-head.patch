     autoRebase = false,
@@ -491,7 +493,7 @@ async function runShepherdPass(ctx) {
   if (behind > 0) {
     return handleBehindBase({
       behind, autoRebase: dryRun ? false : autoRebase, cleanTree, adapter, baseRef,
-      expectedHead: startSha, headUnchanged, actions,
+      expectedHead: startSha, headRef, pushRemote, headUnchanged, actions,
     });
   }
 
