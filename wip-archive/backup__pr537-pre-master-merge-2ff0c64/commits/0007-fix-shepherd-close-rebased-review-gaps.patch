@@ -398,6 +398,45 @@ class PrStateAdapter {
     this._git('git', ['fetch', remote, branch], cwd ? { cwd } : undefined);
   }
 
+  /** Rebase the checked-out PR head and force-push only under its exact prior-head lease. */
+  async rebaseOntoBase({ baseRef, expectedHead }) {
+    const fullHead = String(expectedHead || '').toLowerCase();
+    if (!/^[0-9a-f]{40}$/.test(fullHead)) throw new Error('Rebase requires one exact expected head.');
+    const opts = this._cwd ? { cwd: this._cwd } : undefined;
+    const previousHead = this._git('git', ['rev-parse', 'HEAD'], opts).trim().toLowerCase();
+    if (previousHead !== fullHead) {
+      const error = new Error('HEAD changed before the rebase lease was armed.');
+      error.leaseRejected = true;
+      throw error;
+    }
+    const upstream = this._git(
+      'git',
+      ['rev-parse', '--abbrev-ref', '--symbolic-full-name', '@{upstream}'],
+      opts,
+    ).trim();
+    const slash = upstream.indexOf('/');
+    if (slash <= 0 || slash === upstream.length - 1) throw new Error('The PR branch has no pushable upstream.');
+    const remote = upstream.slice(0, slash);
+    const branch = upstream.slice(slash + 1);
+    this._git('git', ['rebase', baseRef], opts);
+    const headSha = this._git('git', ['rev-parse', 'HEAD'], opts).trim().toLowerCase();
+    if (!/^[0-9a-f]{40}$/.test(headSha)) throw new Error('Rebase did not produce one exact head.');
+    try {
+      this._git('git', [
+        'push',
+        `--force-with-lease=refs/heads/${branch}:${previousHead}`,
+        remote,
+        `HEAD:refs/heads/${branch}`,
+      ], opts);
+    } catch (error) {
+      if (/stale info|rejected|force-with-lease/i.test(`${error?.message || ''} ${error?.stderr || ''}`)) {
+        error.leaseRejected = true;
+      }
+      throw error;
+    }
+    return { previousHead, headSha };
+  }
+
   /**
    * Post a status reply to a review thread via the existing shell helper.
    * Reply ONLY — never resolve (resolution is the semantic `/review` agent's job).
