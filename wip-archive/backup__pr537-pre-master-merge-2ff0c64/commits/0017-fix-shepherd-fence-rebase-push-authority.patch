--- a/lib/pr-monitor/shepherd-lease.js
+++ b/lib/pr-monitor/shepherd-lease.js
@@ -42,8 +42,8 @@ const { resolveGitCommonDir } = require('../kernel/broker');
 const STALE_MS = 90000;
 const LOCK_FILE_MODE = 0o600;
 const MAX_WATCHER_PAYLOAD_BYTES = 1024 * 1024;
-const WATCHER_UPDATE_CAPACITY_EXCEEDED = 'capacity-exceeded';
-const WATCHER_UPDATE_INVALID_PAYLOAD = 'invalid-payload';
+const WATCHER_CHECKPOINT_CAPACITY_EXCEEDED = 'WATCHER_CHECKPOINT_CAPACITY_EXCEEDED';
+const WATCHER_CHECKPOINT_INVALID_PAYLOAD = 'WATCHER_CHECKPOINT_INVALID_PAYLOAD';
 
 /**
  * Resolve the shared lock path. `gitCommonDir` may be injected (tests, or a
@@ -220,9 +220,15 @@ function updateWatchers(projectRoot, prNumbers, { gitCommonDir, token, pid = pro
   try {
     watcherBytes = Buffer.byteLength(JSON.stringify(watchers), 'utf8');
   } catch {
-    return WATCHER_UPDATE_INVALID_PAYLOAD;
+    const error = new TypeError('Watcher checkpoint payload is not serializable');
+    error.code = WATCHER_CHECKPOINT_INVALID_PAYLOAD;
+    throw error;
+  }
+  if (watcherBytes > MAX_WATCHER_PAYLOAD_BYTES) {
+    const error = new RangeError('Watcher checkpoint payload exceeds the lock-file capacity');
+    error.code = WATCHER_CHECKPOINT_CAPACITY_EXCEEDED;
+    throw error;
   }
-  if (watcherBytes > MAX_WATCHER_PAYLOAD_BYTES) return WATCHER_UPDATE_CAPACITY_EXCEEDED;
   held.watchers = watchers;
   writeLock(file, held);
   return true;
@@ -252,8 +258,8 @@ function owns(projectRoot, { gitCommonDir, token, pid = process.pid } = {}) {
 module.exports = {
   STALE_MS,
   MAX_WATCHER_PAYLOAD_BYTES,
-  WATCHER_UPDATE_CAPACITY_EXCEEDED,
-  WATCHER_UPDATE_INVALID_PAYLOAD,
+  WATCHER_CHECKPOINT_CAPACITY_EXCEEDED,
+  WATCHER_CHECKPOINT_INVALID_PAYLOAD,
   lockFilePath,
   pidAlive,
   ownsLock,
