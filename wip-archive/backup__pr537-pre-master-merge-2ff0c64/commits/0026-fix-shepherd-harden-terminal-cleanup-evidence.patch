-    return finalizePass(ctx, bridge, spec, { state, snapshot: next, receiptIds, createdAt: now(), records: [] });
+    return finalizePass(ctx, bridge, spec, { state, snapshot: next, receiptIds, records: [] });
   }
   const timestamp = now();
   const records = finalizeRecords(candidates, {
@@ -1146,7 +1146,7 @@ async function persistFreshSnapshot(ctx, bridge, spec, {
   }
   receiptIds.push(...persisted.receiptIds);
   return finalizePass(ctx, bridge, spec, {
-    state: persisted.state, snapshot: next, receiptIds, createdAt: timestamp, records: persisted.records || records,
