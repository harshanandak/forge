diff --git a/lib/pr-monitor/reconcile-executor.js b/lib/pr-monitor/reconcile-executor.js
index 7c953f8f..a564a70f 100644
--- a/lib/pr-monitor/reconcile-executor.js
+++ b/lib/pr-monitor/reconcile-executor.js
@@ -50,6 +50,8 @@ const GH_COMMAND_TIMEOUT_MS = 30_000;
 const LINKAGE_FIELDS = ['issue_id', 'worktree_id', 'journal_ptr'];
 const MAX_ACTIONS_PER_PASS = 128;
 const MAX_PROCESS_EVENTS = 8;
+const NEW_WATCHER_KILL_ATTEMPTS = 3;
+const NEW_WATCHER_KILL_RETRY_MS = 10;
 
 function normalizeRepository(value) {
 	return typeof value === 'string' && CANONICAL_REPOSITORY.test(value.trim())
@@ -616,10 +618,37 @@ function buildExecutionState(ctx) {
 	};
 }
 
-function cleanupNewWatchers(s, seedIdentities) {
+async function cleanupNewWatchers(s, seedIdentities) {
+	const survivors = [];
+	const isAlive = s.ctx.isAlive || shepherdLease.pidAlive;
+	const waitForRetry = s.ctx.waitForKillRetry
+		|| (delayMs => new Promise(resolve => setTimeout(resolve, delayMs)));
 	for (const entry of s.watchers.filter(watcher => !seedIdentities.has(processIdentity(watcher)))) {
-		if (verifiedKill(entry, s.ctx, 'SIGKILL')) s.removeClaim(entry);
+		let terminated = false;
+		for (let attempt = 0; attempt < NEW_WATCHER_KILL_ATTEMPTS; attempt += 1) {
+			verifiedKill(entry, s.ctx, 'SIGKILL');
+			if (!isAlive(entry.pid)) {
+				s.removeClaim(entry);
+				terminated = true;
+				break;
+			}
+			if (attempt + 1 < NEW_WATCHER_KILL_ATTEMPTS) await waitForRetry(NEW_WATCHER_KILL_RETRY_MS);
+		}
+		if (!terminated) survivors.push(entry);
+	}
+	if (survivors.length === 0) return;
+	try {
+		if (s.persistLifecycleCheckpoint(s.watchers) !== false) return;
+	} catch (cause) {
+		const error = new Error('New watcher cleanup failed and the surviving watcher checkpoint was not persisted', { cause });
+		error.code = 'WATCHER_CLEANUP_FAILED';
+		error.watchers = survivors.map(normalizeWatcher);
+		throw error;
 	}
+	const error = new Error('New watcher cleanup failed and the surviving watcher checkpoint was rejected');
+	error.code = 'WATCHER_CLEANUP_FAILED';
+	error.watchers = survivors.map(normalizeWatcher);
+	throw error;
 }
 
 /**
@@ -644,7 +673,7 @@ async function execute(actions, ctx = {}) {
 			if (handler && (await handler(action, s)) === false) break;
 		}
 	} catch (error) {
-		cleanupNewWatchers(s, seedIdentities);
+		await cleanupNewWatchers(s, seedIdentities);
 		throw error;
 	}
 	return s.watchers;
