 }) {
-  const terminalReceiptId = await recordTerminalHandoff(ctx, bridge, spec, state, snapshot, createdAt);
+  const terminalReceiptId = await recordTerminalHandoff(ctx, bridge, spec, state, snapshot);
   if (terminalReceiptId) receiptIds.push(terminalReceiptId);
   return {
     events: records,
@@ -1079,7 +1079,7 @@ async function resumeSegmentedBatch(ctx, bridge, spec, state, segmented, subject
   });
   receiptIds.push(...persisted.receiptIds);
   return finalizePass(ctx, bridge, spec, {
-    state: persisted.state, snapshot: segmented.snapshot, receiptIds, createdAt: timestamp, records: remaining,
+    state: persisted.state, snapshot: segmented.snapshot, receiptIds, records: remaining,
   });
 }
 
@@ -1111,7 +1111,7 @@ async function resumeRetainedBatch(ctx, bridge, spec, state, pendingEvents, subj
   });
   receiptIds.push(...persisted.receiptIds);
   return finalizePass(ctx, bridge, spec, {
-    state: persisted.state, snapshot: batch.snapshot, receiptIds, createdAt: timestamp, records: remaining,
+    state: persisted.state, snapshot: batch.snapshot, receiptIds, records: remaining,
