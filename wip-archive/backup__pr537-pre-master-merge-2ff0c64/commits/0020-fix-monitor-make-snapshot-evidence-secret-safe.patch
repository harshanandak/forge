From 41c6f801c359a2e8e55d6cd5d7ab47c6e0ac480b Mon Sep 17 00:00:00 2001
From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Wed, 19 Aug 2026 01:39:06 +0530
Subject: [PATCH] fix(monitor): make snapshot evidence secret-safe

---
 lib/pr-monitor/flow-monitor.js       |  9 +++++++--
 test/pr-monitor/flow-monitor.test.js | 25 +++++++++++++++++++++++--
 2 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/lib/pr-monitor/flow-monitor.js b/lib/pr-monitor/flow-monitor.js
index 09c7adf7..eb7a7bee 100644
--- a/lib/pr-monitor/flow-monitor.js
+++ b/lib/pr-monitor/flow-monitor.js
@@ -29,6 +29,7 @@ const EVENT_VALIDATION_CACHE_LIMIT = MAX_HISTORY * 8;
 const MONITOR_STATE_CACHE_LIMIT = 64;
 const MAX_REOPEN_DEPTH = 8;
 const SNAPSHOT_FORMAT = 'digest-v1';
+const SNAPSHOT_EVIDENCE_ENCODING = 'gzip-hex-v1';
 const SNAPSHOT_EVIDENCE_KEYS = new Set(['checks', 'threads', 'reviews', 'comments', 'degraded']);
 const EVENT_VALIDATION_CACHES = new WeakMap();
 const MONITOR_STATE_CACHES = new WeakMap();
@@ -286,7 +287,8 @@ function compactSnapshot(value) {
     _snapshotIdentity: crypto.createHash('sha256')
       .update(JSON.stringify({ snapshot: durableScalar, evidence }))
       .digest('hex'),
-    _snapshotEvidence: zlib.gzipSync(evidenceJson, { level: 9 }).toString('base64url'),
+    _snapshotEvidence: zlib.gzipSync(evidenceJson, { level: 9 }).toString('hex'),
+    _snapshotEvidenceEncoding: SNAPSHOT_EVIDENCE_ENCODING,
   };
 }
 
@@ -300,7 +302,10 @@ function comparableSnapshot(compact, source = null) {
   if (compact?._snapshotFormat !== SNAPSHOT_FORMAT) return compact;
   let evidence;
   try {
-    evidence = JSON.parse(zlib.gunzipSync(Buffer.from(compact._snapshotEvidence, 'base64url')));
+    const encoding = compact._snapshotEvidenceEncoding === SNAPSHOT_EVIDENCE_ENCODING
+      ? 'hex'
+      : 'base64url';
+    evidence = JSON.parse(zlib.gunzipSync(Buffer.from(compact._snapshotEvidence, encoding)));
   } catch {
     throw new FlowMonitorError('MONITOR_HISTORY_INCOMPLETE', 'Durable monitor snapshot evidence is malformed');
   }
diff --git a/test/pr-monitor/flow-monitor.test.js b/test/pr-monitor/flow-monitor.test.js
index 5d7eb6b0..b348d6ec 100644
--- a/test/pr-monitor/flow-monitor.test.js
+++ b/test/pr-monitor/flow-monitor.test.js
@@ -171,6 +171,25 @@ describe('Flow-backed PR monitor authority', () => {
     expect(delivered).toHaveLength(1);
   });
 
+  test('reads legacy base64url snapshot evidence after switching durable evidence to hex', async () => {
+    const store = durableStore();
+    const next = snapshot();
+    await runFlowMonitorPass(context(store, async () => next, async () => {}));
+
+    const stored = store.events[0];
+    const durableSnapshot = stored.payload.bounded_payload.snapshot;
+    durableSnapshot._snapshotEvidence = Buffer.from(durableSnapshot._snapshotEvidence, 'hex').toString('base64url');
+    delete durableSnapshot._snapshotEvidenceEncoding;
+    stored.content_hash = computeContentHash(stored);
+
+    const restarted = await runFlowMonitorPass(context(
+      store, async () => structuredClone(next), async () => {},
+    ));
+
+    expect(restarted.events).toEqual([]);
+    expect(store.events).toHaveLength(1);
+  });
+
   test('normalizes a legacy raw snapshot before comparing compact transition identities', async () => {
     const store = durableStore();
     const current = snapshot({
@@ -201,9 +220,9 @@ describe('Flow-backed PR monitor authority', () => {
     const before = store.events.length;
     const event = store.events.at(-1);
     const evidence = zlib.gunzipSync(Buffer.from(
-      event.payload.bounded_payload.snapshot._snapshotEvidence, 'base64url',
+      event.payload.bounded_payload.snapshot._snapshotEvidence, 'hex',
     ));
-    event.payload.bounded_payload.snapshot._snapshotEvidence = zlib.gzipSync(evidence, { level: 1 }).toString('base64url');
+    event.payload.bounded_payload.snapshot._snapshotEvidence = zlib.gzipSync(evidence, { level: 1 }).toString('hex');
     event.content_hash = computeContentHash(event);
 
     const restarted = await runFlowMonitorPass(context(store, async () => current, async () => {}));
@@ -711,9 +730,11 @@ describe('Flow-backed PR monitor authority', () => {
 
     const durable = store.events.find(event => event.payload.type === 'monitor.degraded')
       ?.payload.bounded_payload.record.data.error;
+    const encodedEvidence = store.events.at(-1).payload.bounded_payload.snapshot._snapshotEvidence;
     const legacy = delivered.find(record => record.type === 'monitor.degraded')?.data.error;
     expect(durable).toBe('[provider diagnostic redacted]');
     expect(legacy).toBe('[provider diagnostic redacted]');
+    expect(encodedEvidence).toMatch(/^[0-9a-f]+$/);
   });
 
   test('preserves valid enriched job URLs longer than the generic snapshot text bound', async () => {
