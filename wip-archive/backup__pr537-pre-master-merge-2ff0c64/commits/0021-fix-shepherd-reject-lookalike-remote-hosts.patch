Subject: [PATCH] fix(shepherd): reject lookalike remote hosts

---
 lib/commands/shepherd.js       | 16 ++++++++++++++--
 test/commands/shepherd.test.js | 25 +++++++++++++++++++++++++
 2 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/lib/commands/shepherd.js b/lib/commands/shepherd.js
index dbe91055..0f56482a 100644
--- a/lib/commands/shepherd.js
+++ b/lib/commands/shepherd.js
@@ -64,8 +64,20 @@ function rootMonitorId(owner, repo, pr) {
 const defaultGhRunner = (cmd, a) => execFileSync(cmd, a, { encoding: 'utf8', timeout: 30000, windowsHide: true });
 
 function repositoryFromRemoteUrl(url) {
-  const match = /(?:github\.com[/:])([^/]+)\/([^/]+?)(?:\.git)?$/i.exec(String(url || '').trim());
-  return match ? `${match[1]}/${match[2]}`.toLowerCase() : null;
+  const value = String(url || '').trim();
+  const scpMatch = /^(?:[^@/:\s]+@)?github\.com:([^/\s]+)\/([^/\s]+?)(?:\.git)?\/?$/i.exec(value);
+  if (scpMatch) return `${scpMatch[1]}/${scpMatch[2]}`.toLowerCase();
+
+  try {
+    const parsed = new URL(value);
+    if (parsed.hostname.toLowerCase() !== 'github.com' || parsed.search || parsed.hash) return null;
+    const parts = parsed.pathname.replace(/^\/+|\/+$/g, '').split('/');
+    if (parts.length !== 2 || parts.some(part => !part)) return null;
+    const repository = parts[1].replace(/\.git$/i, '');
+    return repository ? `${parts[0]}/${repository}`.toLowerCase() : null;
+  } catch {
+    return null;
+  }
 }
 
 function findRepositoryRemote(git, repository, { push = false } = {}) {
