+        const remote = args.at(-1);
+        if (remote === 'upstream') return 'https://github.com/acme/widget.git\n';
+        if (remote === 'fork') return `${hostilePushUrl}\n`;
+        return '';
+      };
+
+      const ctx = await shepherdCmd.defaultBuildContext({ pr: '42', gh, git });
+      expect(ctx.pushRemote).toBeNull();
+    });
+  }
+
