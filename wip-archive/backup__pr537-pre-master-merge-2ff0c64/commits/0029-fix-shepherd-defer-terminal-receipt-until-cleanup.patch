   const createdAt = (ctx.now || defaultNow)();
   const terminating = reduceMonitor(spec, state, { kind: 'subject-terminal', terminalState }).state;
   const terminal = reduceMonitor(spec, terminating, {
     kind: 'cleanup-complete',
-    processCleanup: { status: 'not-required', owner: 'repo-singleton-shepherd' },
-    leaseCleanup: { status: 'checkpointed', continuing_authority: false },
+    processCleanup: cleanup.processCleanup,
+    leaseCleanup: cleanup.leaseCleanup,
   }).state;
   const receipt = createMonitorReceipt(spec, terminal, {
     objectId: uuidFrom(`terminal:${ctx.monitorId}:${terminalState}:${terminal.lastSequence}`),
diff --git a/lib/pr-monitor/shepherd-lease.js b/lib/pr-monitor/shepherd-lease.js
index 088924d4..179538d1 100644
--- a/lib/pr-monitor/shepherd-lease.js
+++ b/lib/pr-monitor/shepherd-lease.js
@@ -66,6 +66,18 @@ function readLock(file) {
   }
 }
 
+function inspect(projectRoot, opts = {}) {
+  const file = lockFilePath(projectRoot, opts);
+  if (!fs.existsSync(file)) return { status: 'absent', watchers: [] };
+  const held = readLock(file);
+  if (!held || !Array.isArray(held.watchers)) return { status: 'invalid', watchers: [] };
+  try {
+    return { status: 'valid', watchers: structuredClone(held.watchers) };
+  } catch {
+    return { status: 'invalid', watchers: [] };
+  }
+}
+
 // Is `pid` a live process? `process.kill(pid, 0)` sends no signal but throws
 // ESRCH when the pid is gone. EPERM means it exists but isn't ours — still live.
 function pidAlive(pid) {
@@ -261,6 +273,7 @@ module.exports = {
   WATCHER_CHECKPOINT_CAPACITY_EXCEEDED,
   WATCHER_CHECKPOINT_INVALID_PAYLOAD,
   lockFilePath,
+  inspect,
   pidAlive,
   ownsLock,
   acquire,
