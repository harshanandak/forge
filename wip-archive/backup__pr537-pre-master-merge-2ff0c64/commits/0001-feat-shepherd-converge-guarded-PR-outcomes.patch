+      authority: { kind: 'kernel-live-lease', issue_revision: revision },
+      allowed_mutations: ['pr.merged'],
+      prohibited_actions: ['pr.opened', 'review-thread.resolve'],
+      workflow_config_revision: workflowConfigRevision,
