+  let malformed = rawLines.length === 0;
+  for (const line of rawLines) {
+    try {
+      const event = JSON.parse(line);
+      if (!event || typeof event !== 'object' || Array.isArray(event)) malformed = true;
+      else events.push(event);
+    } catch {
