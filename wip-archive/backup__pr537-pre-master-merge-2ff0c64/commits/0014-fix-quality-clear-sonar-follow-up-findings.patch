+  state, previousSnapshot, durableEvents, subjectRevision, receiptIds, now,
+}) {
   const gathered = await ctx.gather();
   const next = compactSnapshot(gathered);
   const previous = previousSnapshot == null ? null : comparableSnapshot(compactSnapshot(previousSnapshot));
@@ -1191,7 +1199,9 @@ async function runFlowMonitorPass(ctx, reopenDepth = 0) {
       return resumeRetainedBatch(ctx, bridge, spec, state, pendingEvents, subjectRevision, receiptIds);
     }
   }
-  return persistFreshSnapshot(ctx, bridge, spec, state, previousSnapshot, durableEvents, subjectRevision, receiptIds, now);
+  return persistFreshSnapshot(ctx, bridge, spec, {
+    state, previousSnapshot, durableEvents, subjectRevision, receiptIds, now,
+  });
 }
 
 module.exports = { FlowMonitorError, runFlowMonitorPass };
