   return { state, receiptIds };
 }
 
+function pendingBatchEvidence(ctx, subjectRevision, batchRecords, snapshot, pendingBatch, batchPlan) {
+  if (batchPlan) return null;
+  if (pendingBatch) return pendingBatch;
+  return batchRecords.length > 1
+    ? encodePendingBatch(ctx, subjectRevision, batchRecords, snapshot)
+    : null;
+}
+
