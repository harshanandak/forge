-    batchEvidence = encodePendingBatch(ctx, subjectRevision, batchRecords, snapshot);
-  }
+  const batchEvidence = pendingBatchEvidence(
+    ctx, subjectRevision, batchRecords, snapshot, pendingBatch, batchPlan,
+  );
