--- a/lib/commands/merge.js
+++ b/lib/commands/merge.js
@@ -140,6 +140,53 @@ function terminalEvidenceFromTrace(row, { issueId, repository, number, expectedH
   };
 }
 
+function validMergeAuthorityIteration(iteration, { issueId, repository, number, expectedHead }) {
+  const packet = iteration?.work_packet;
+  const validation = packet && typeof packet === 'object' ? validateContractStructure(packet) : { ok: false };
+  return [
+    iteration?.issue_id === issueId,
+    Number.isInteger(iteration?.issue_revision),
+    iteration?.issue_revision >= 0,
+    normalizeFullHeadSha(iteration?.head_sha) === expectedHead,
+    typeof iteration?.at === 'string' && Number.isFinite(Date.parse(iteration.at)),
+    typeof iteration?.actor === 'string' && iteration.actor.length > 0,
+    validation.ok,
+    packet?.schema_id === 'forge.memory.work-packet.v1',
+    packet ? computeContentHash(packet) === packet.content_hash : false,
+    packet?.content_hash === iteration?.work_packet_hash,
+    packet?.payload?.issue_id === issueId,
+    packet?.payload?.expected_issue_revision === iteration?.issue_revision,
+    normalizeRepository(packet?.payload?.repository_id) === repository,
+    normalizeFullHeadSha(packet?.payload?.target_head) === expectedHead,
+    packet?.payload?.target?.pr_number === number,
+    packet?.payload?.allowed_mutations?.includes('pr.merged'),
+  ].every(Boolean);
+}
+
+function canRecoverMergeAuthority(binding, authority, actor, sessionId) {
+  return [
+    authority?.actor === actor,
+    typeof sessionId === 'string' && sessionId.length > 0,
+    authority?.packet?.object_id,
+    authority?.packet?.content_hash,
+    typeof binding?.branch === 'string' && binding.branch.length > 0,
+    typeof binding?.gitCommonDir === 'string' && binding.gitCommonDir.length > 0,
+  ].every(Boolean);
+}
+
+function mergeAuthorityFromTrace(row, identity) {
+  const expectedHead = normalizeFullHeadSha(identity.expectedHead);
+  if (!expectedHead) return { invalid: true };
+  const authority = (Array.isArray(row?.iterations) ? row.iterations : [])
+    .filter(iteration => iteration?.type === 'pr.merge-authorized');
+  if (authority.length === 0) return null;
+  const exact = authority.filter(iteration => validMergeAuthorityIteration(iteration, {
+    ...identity, expectedHead,
+  }));
+  if (exact.length !== 1) return { invalid: true };
+  return { actor: exact[0].actor, occurredAt: exact[0].at, packet: exact[0].work_packet };
+}
+
 function parseMergeArgs(argv) {
   const values = { auto: false, pr: null, expectedHead: null, issueId: null, error: null };
   const seen = new Set();
