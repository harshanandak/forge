+          ended_at: '2026-08-01T12:00:05.000Z',
+          mutations_authorized: ['pr.merged'],
+        },
+      },
     });
     expect(calls[0][1]).toEqual({
       actor: 'release-actor',
@@ -375,6 +417,7 @@ describe('merge command — mandatory release authority', () => {
     await mergeCmd.defaultRecordMergeDecision({
       decision,
       mergeResult: { merged: true, recovered: true },
+      completedAt: '2026-08-01T12:00:05.000Z',
       pr: 42,
       expectedHead: HEAD,
       repository: 'acme/forge',
