+    expect(merged.error).toMatch(/pre-merge authority/i);
 
     const closed = await mergeCmd.handler(args(), {}, process.cwd(), deps({
       fetchPrContext: async () => context({ state: 'CLOSED' }),
diff --git a/test/commands/merge-authority.test.js b/test/commands/merge-authority.test.js
index ffe44558..6b527df9 100644
--- a/test/commands/merge-authority.test.js
+++ b/test/commands/merge-authority.test.js
@@ -175,7 +175,37 @@ describe('merge command — mandatory release authority', () => {
     expect(out.error).toContain('terminal linkage failed');
   });
 
-  test('reconciles missing terminal linkage when GitHub already reports the exact PR merged', async () => {
+  test('does not mint guarded terminal evidence after an unproven external merge', async () => {
+    let decisions = 0;
+    let records = 0;
+    const out = await mergeCmd.handler(args(), {}, process.cwd(), deps({
+      fetchPrContext: async () => context({ state: 'MERGED' }),
+      prepareMergeDecision: async () => { decisions += 1; return { decisionId: 'late-decision' }; },
+      recordMergeDecision: async () => { records += 1; return { receiptId: 'late-receipt' }; },
+    }));
+
+    expect(out).toMatchObject({ success: false, merged: true, replayMissing: true });
+    expect(out.error).toMatch(/pre-merge authority/i);
+    expect(decisions).toBe(0);
+    expect(records).toBe(0);
+  });
+
+  test('timestamps successful terminal evidence after the provider confirms the merge', async () => {
+    const instants = [
+      Date.parse('2026-08-01T12:00:00.000Z'),
+      Date.parse('2026-08-01T12:00:05.000Z'),
+    ];
+    let recorded;
+    const out = await mergeCmd.handler(args(), {}, process.cwd(), deps({
+      now: () => instants.shift(),
+      recordMergeDecision: async (input) => { recorded = input; return { receiptId: 'receipt-1' }; },
+    }));
+
+    expect(out).toMatchObject({ success: true, merged: true });
+    expect(recorded.completedAt).toBe('2026-08-01T12:00:05.000Z');
+  });
+
+  test('keeps missing terminal linkage incomplete when GitHub already reports the exact PR merged', async () => {
     let merges = 0;
     let records = 0;
     const out = await mergeCmd.handler(args(), {}, process.cwd(), deps({
@@ -184,9 +214,10 @@ describe('merge command — mandatory release authority', () => {
       recordMergeDecision: async () => { records += 1; return { receiptId: 'receipt-recovered' }; },
     }));
 
-    expect(out).toMatchObject({ success: true, merged: true, recovered: true, receiptId: 'receipt-recovered' });
+    expect(out).toMatchObject({ success: false, merged: true, replayMissing: true });
+    expect(out.error).toMatch(/pre-merge authority/i);
     expect(merges).toBe(0);
-    expect(records).toBe(1);
+    expect(records).toBe(0);
   });
 
   test('replays existing terminal evidence without regenerating retry-time receipts', async () => {
@@ -298,16 +329,18 @@ describe('merge command — mandatory release authority', () => {
     expect(records).toBe(0);
   });
 
-  test('fails closed before recovery evidence when a disabled gate cannot satisfy the broker contract', async () => {
+  test('does not treat a retry-time gate state as pre-merge recovery authority', async () => {
     let decisions = 0;
+    let gateChecks = 0;
     const out = await mergeCmd.handler(args(), {}, process.cwd(), deps({
       fetchPrContext: async () => context({ state: 'MERGED' }),
-      verifyMergeGate: async () => ({ success: true, disabled: true }),
+      verifyMergeGate: async () => { gateChecks += 1; return { success: true, disabled: true }; },
       prepareMergeDecision: async () => { decisions += 1; },
     }));
 
-    expect(out).toMatchObject({ success: false, merged: true });
-    expect(out.error).toMatch(/disabled.*terminal authority/i);
+    expect(out).toMatchObject({ success: false, merged: true, replayMissing: true });
+    expect(out.error).toMatch(/pre-merge authority/i);
+    expect(gateChecks).toBe(0);
     expect(decisions).toBe(0);
   });
 
@@ -348,6 +381,7 @@ describe('merge command — mandatory release authority', () => {
     broker.readTrace = async () => [];
     const terminal = await mergeCmd.defaultRecordMergeDecision({
       decision,
+      completedAt: '2026-08-01T12:00:05.000Z',
       pr: 42,
       expectedHead: HEAD,
       repository: 'acme/forge',
@@ -363,7 +397,15 @@ describe('merge command — mandatory release authority', () => {
       number: 42,
       branch: 'feature/merge',
