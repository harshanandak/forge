From d77b160ceca72b2685aecbe34df707ae32214d60 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Mon, 13 Jul 2026 12:50:28 +0530
Subject: [PATCH] fix(memory): move lazy require inside fail-open try
 (CodeRabbit #370)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

autoFileBackingIssue (worktree) and autoFileBackingIssueForPush (push) resolved
`require('../kernel/backing-issue')` OUTSIDE their try — a module-load failure
would throw synchronously and crash `forge worktree create` / abort the push,
violating the documented non-blocking guarantee. Moved the require inside the try
in both (mirrors registerWorktreeLinkage). Added tests for the kernel-unavailable
degrade-to-null path.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 lib/commands/push.js                |  4 +++-
 lib/commands/worktree.js            |  4 +++-
 test/push-backing-issue.test.js     |  6 ++++++
 test/worktree-backing-issue.test.js | 11 +++++++++++
 4 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/lib/commands/push.js b/lib/commands/push.js
index a06f4aa1..1ba97ee4 100644
--- a/lib/commands/push.js
+++ b/lib/commands/push.js
@@ -89,8 +89,10 @@ function resolveGitToplevel(execFn, fallback) {
  * @returns {Promise<object|null>}
  */
 async function autoFileBackingIssueForPush(projectRoot, execFn, deps = {}) {
-  const ensure = deps._ensureBackingIssue || require('../kernel/backing-issue').ensureBackingIssue;
   try {
+    // Lazy require INSIDE the try: a module-load failure must degrade to null and
+    // NEVER abort the push (mirrors the worktree helper; CodeRabbit #370).
+    const ensure = deps._ensureBackingIssue || require('../kernel/backing-issue').ensureBackingIssue;
     const branch = getCurrentBranch(execFn);
     if (!branch || branch === 'unknown') return null;
     let driver = deps._kernelDriver;
diff --git a/lib/commands/worktree.js b/lib/commands/worktree.js
index 24d7dfdb..39f8e216 100644
--- a/lib/commands/worktree.js
+++ b/lib/commands/worktree.js
@@ -220,8 +220,10 @@ async function registerWorktreeLinkage({ projectRoot, worktreePath, branch, issu
 async function autoFileBackingIssue({ projectRoot, worktreePath, branch, issueId, opts }) {
   if (issueId) return null; // explicit --issue already links a real issue.
   const fsApi = opts._fs || fs;
-  const ensureFn = opts._ensureBackingIssue || require('../kernel/backing-issue').ensureBackingIssue;
   try {
+    // Lazy require INSIDE the try: a module-load failure (missing file / broken
+    // sub-dependency) must degrade to null, never crash `forge worktree create`.
+    const ensureFn = opts._ensureBackingIssue || require('../kernel/backing-issue').ensureBackingIssue;
     let driver = opts._kernelDriver;
     let broker = opts._kernelBroker;
     if (!driver || !broker) {
diff --git a/test/push-backing-issue.test.js b/test/push-backing-issue.test.js
index aa17d4f5..fbe49cce 100644
--- a/test/push-backing-issue.test.js
+++ b/test/push-backing-issue.test.js
@@ -39,6 +39,12 @@ describe('push auto-file rail (autoFileBackingIssueForPush)', () => {
     expect(await autoFileBackingIssueForPush('/r', fakeExec(), deps)).toBeNull();
   });
 
+  test('degrades to null (no throw) when kernel is unavailable, nothing injected', async () => {
+    // No _ensureBackingIssue / driver / broker; '/no/such/repo/.git' does not exist.
+    // Confirms the reorganized require-inside-try never aborts a push (CodeRabbit #370).
+    expect(await autoFileBackingIssueForPush('/no/such/repo', fakeExec('feat/foo'), {})).toBeNull();
+  });
+
   test("returns null on an unresolved branch ('unknown')", async () => {
     const deps = { _kernelDriver: FAKE_DRIVER, _kernelBroker: FAKE_BROKER, _ensureBackingIssue: () => ({}) };
     const execUnknown = () => { throw new Error('no branch'); }; // getCurrentBranch → 'unknown'
diff --git a/test/worktree-backing-issue.test.js b/test/worktree-backing-issue.test.js
index 3db5a2eb..b464242c 100644
--- a/test/worktree-backing-issue.test.js
+++ b/test/worktree-backing-issue.test.js
@@ -39,6 +39,17 @@ describe('worktree auto-file rail (autoFileBackingIssue)', () => {
     expect(result).toBeNull();
   });
 
+  test('degrades to null (no throw) when kernel is unavailable and nothing is injected', async () => {
+    // Real module loads, but no driver/broker injected and no .git → returns null.
+    // Exercises the reorganized code where the lazy require lives INSIDE the try
+    // (CodeRabbit #370: a require failure must never crash worktree create).
+    const result = await autoFileBackingIssue({
+      projectRoot: '/no/such/repo', worktreePath: '/no/such/repo/wt', branch: 'feat/foo', issueId: null,
+      opts: { _fs: { existsSync: () => false } },
+    });
+    expect(result).toBeNull();
+  });
+
   test('idempotent pass-through: an existing link is returned, not duplicated', async () => {
     const opts = baseOpts({ _ensureBackingIssue: () => ({ issueId: 'x', branch: 'feat/foo', created: false, existed: true }) });
     const result = await autoFileBackingIssue({ projectRoot: '/r', worktreePath: '/r/wt', branch: 'feat/foo', issueId: null, opts });
