diff --git a/lib/commands/setup.js b/lib/commands/setup.js
index b873c44a..acad0795 100644
--- a/lib/commands/setup.js
+++ b/lib/commands/setup.js
@@ -2101,25 +2101,29 @@ async function createAgentLinkFile(agent, symlinkOnly = false) {
   }
   if (agent.linkFile !== 'CLAUDE.md' || result !== 'existing-import') return;
 
-  const sourceHead = resolveCurrentSourceHead();
-  const content = normalizeClaudePointerContent(fs.readFileSync(path.join(projectRoot, 'CLAUDE.md')));
-  const actor = process.env.FORGE_PROTECTED_STATE_ACTOR || process.env.FORGE_ACTOR || process.env.USER || process.env.USERNAME || 'forge';
-  const authorization = await issueGeneratedHarnessClaudeAuthorization(projectRoot, {
-    actor,
-    content,
-    sourceHead,
-  });
-  if (!authorization.success) {
-    console.warn(`  Warning: Could not authorize existing CLAUDE.md import: ${authorization.error}`);
-    return;
-  }
-  const completion = await completeGeneratedHarnessClaudeAuthorization(projectRoot, {
-    actor,
-    capabilityId: authorization.capabilityId,
-    sourceHead,
-  });
-  if (!completion.success) {
-    console.warn(`  Warning: Could not complete CLAUDE.md import authorization: ${completion.error}`);
+  try {
+    const sourceHead = resolveCurrentSourceHead();
+    const content = normalizeClaudePointerContent(fs.readFileSync(path.join(projectRoot, 'CLAUDE.md')));
+    const actor = process.env.FORGE_PROTECTED_STATE_ACTOR || process.env.FORGE_ACTOR || process.env.USER || process.env.USERNAME || 'unknown';
+    const authorization = await issueGeneratedHarnessClaudeAuthorization(projectRoot, {
+      actor,
+      content,
+      sourceHead,
+    });
+    if (!authorization.success) {
+      console.warn(`  Warning: Could not authorize existing CLAUDE.md import: ${authorization.error}`);
+      return;
+    }
+    const completion = await completeGeneratedHarnessClaudeAuthorization(projectRoot, {
+      actor,
+      capabilityId: authorization.capabilityId,
+      sourceHead,
+    });
+    if (!completion.success) {
+      console.warn(`  Warning: Could not complete CLAUDE.md import authorization: ${completion.error}`);
+    }
+  } catch (error) {
+    console.warn(`  Warning: Could not record CLAUDE.md import authorization: ${error.message}`);
   }
 }
 
