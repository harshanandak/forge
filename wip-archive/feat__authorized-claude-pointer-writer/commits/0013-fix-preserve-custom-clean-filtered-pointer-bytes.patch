From 2bd94b7bca9af0f95118a29dec489320817708fa Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Tue, 18 Aug 2026 16:18:31 +0530
Subject: [PATCH] fix: preserve custom clean-filtered pointer bytes

---
 lib/commands/setup.js                  | 30 +++++++++++++++-----------
 test/setup-claude-pointer-head.test.js | 23 +++++++++++---------
 2 files changed, 30 insertions(+), 23 deletions(-)

diff --git a/lib/commands/setup.js b/lib/commands/setup.js
index b50d4cf8..9fe5b99e 100644
--- a/lib/commands/setup.js
+++ b/lib/commands/setup.js
@@ -200,24 +200,28 @@ function isExactClaudePointerBytes(content) {
 }
 
 function readCleanClaudePointerWorktreeContent(cwd, commandRunner) {
-	const worktreeContent = fs.readFileSync(path.join(cwd, 'CLAUDE.md'));
-	const normalizedContent = normalizeClaudePointerContent(worktreeContent);
+	const tempIndexDir = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-claude-index-'));
+	const tempIndex = path.join(tempIndexDir, 'index');
+	const env = { ...process.env, GIT_INDEX_FILE: tempIndex };
 	try {
-		const cleanHash = String(commandRunner('git', ['hash-object', '--path=CLAUDE.md', '--stdin'], {
+		commandRunner('git', ['read-tree', 'HEAD'], {
 			cwd,
-			input: worktreeContent,
-			encoding: 'utf8',
+			env,
 			stdio: 'pipe',
-		})).trim();
-		const normalizedHash = String(commandRunner('git', ['hash-object', '--stdin'], {
+		});
+		commandRunner('git', ['add', '--', 'CLAUDE.md'], {
+			cwd,
+			env,
+			stdio: 'pipe',
+		});
+		return commandRunner('git', ['show', ':CLAUDE.md'], {
 			cwd,
-			input: normalizedContent,
-			encoding: 'utf8',
+			env,
+			encoding: null,
 			stdio: 'pipe',
-		})).trim();
-		return cleanHash === normalizedHash ? normalizedContent : worktreeContent;
-	} catch (_hashError) {
-		return worktreeContent;
+		});
+	} finally {
+		fs.rmSync(tempIndexDir, { recursive: true, force: true });
 	}
 }
 
diff --git a/test/setup-claude-pointer-head.test.js b/test/setup-claude-pointer-head.test.js
index aff3b7d0..b3419005 100644
--- a/test/setup-claude-pointer-head.test.js
+++ b/test/setup-claude-pointer-head.test.js
@@ -58,15 +58,16 @@ describe('CLAUDE.md pointer authorization source head', () => {
 			const calls = [];
 			const content = setupCommand.readStagedClaudePointerContent(cwd, (file, args, options) => {
 				calls.push({ file, args, options });
-				if (args[0] === 'show') return Buffer.from('previous-content\n');
-				return Buffer.from('clean-pointer-hash\n');
+				if (args[0] === 'show') return calls.length === 1 ? Buffer.from('previous-content\n') : Buffer.from('@AGENTS.md\r\n');
+				return Buffer.alloc(0);
 			});
 
-			expect(content).toEqual(Buffer.from('@AGENTS.md\n'));
+			expect(content).toEqual(Buffer.from('@AGENTS.md\r\n'));
 			expect(calls.map(call => call.args)).toEqual([
 				['show', ':CLAUDE.md'],
-				['hash-object', '--path=CLAUDE.md', '--stdin'],
-				['hash-object', '--stdin'],
+				['read-tree', 'HEAD'],
+				['add', '--', 'CLAUDE.md'],
+				['show', ':CLAUDE.md'],
 			]);
 		} finally {
 			fs.rmSync(cwd, { recursive: true, force: true });
@@ -80,7 +81,7 @@ describe('CLAUDE.md pointer authorization source head', () => {
 			const calls = [];
 			const content = setupCommand.readStagedClaudePointerContent(cwd, (file, args, options) => {
 				calls.push({ file, args, options });
-				if (args[0] === 'show') {
+				if (args[0] === 'show' && calls.length === 1) {
 					const error = new Error('untracked');
 					error.status = 128;
 					throw error;
@@ -90,15 +91,17 @@ describe('CLAUDE.md pointer authorization source head', () => {
 					error.status = 1;
 					throw error;
 				}
-				return Buffer.from('clean-pointer-hash\n');
+				if (args[0] === 'show') return Buffer.from('@AGENTS.md\r\n');
+				return Buffer.alloc(0);
 			});
 
-			expect(content).toEqual(Buffer.from('@AGENTS.md\n'));
+			expect(content).toEqual(Buffer.from('@AGENTS.md\r\n'));
 			expect(calls.map(call => call.args)).toEqual([
 				['show', ':CLAUDE.md'],
 				['ls-files', '--error-unmatch', '--', 'CLAUDE.md'],
-				['hash-object', '--path=CLAUDE.md', '--stdin'],
-				['hash-object', '--stdin'],
+				['read-tree', 'HEAD'],
+				['add', '--', 'CLAUDE.md'],
+				['show', ':CLAUDE.md'],
 			]);
 		} finally {
 			fs.rmSync(cwd, { recursive: true, force: true });
-- 
