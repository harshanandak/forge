From 0fff5d654457e1eb7e2a0c7de536cdaadeff5bfd Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Mon, 13 Jul 2026 16:09:33 +0530
Subject: [PATCH] chore(dist): address CodeRabbit review on #375 (3 quick wins)

- Security: set `persist-credentials: false` on both checkout steps so
  GITHUB_TOKEN is not left in .git/config where a `bun install` lifecycle
  script could read it (neither job pushes back to the repo).
- Maintainability: the unreachable `echo "setup --quick exit=$?"` (dead under
  bash -e, only ever prints exit=0) is replaced with an honest "setup --quick
  OK" that prints only after the command succeeds.
- Docs: remove hardcoded dynamic output from design.md (byte-size table,
  fingerprint value, file counts) per the no-stale-output guideline; reference
  the generating commands instead.

Authored the workflow edit via the 'workflows' protected-state surface (hook ON).
Issue: f13b5073-3b9f-4098-bbe4-432b7bd69485

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .github/workflows/build-binary.yml          | 12 +++++-
 docs/work/2026-07-13-binary-step3/design.md | 46 ++++++++++++---------
 2 files changed, 37 insertions(+), 21 deletions(-)

diff --git a/.github/workflows/build-binary.yml b/.github/workflows/build-binary.yml
index 40f6b8f2..7d61fc13 100644
--- a/.github/workflows/build-binary.yml
+++ b/.github/workflows/build-binary.yml
@@ -63,6 +63,10 @@ jobs:
     steps:
       - name: Checkout code
         uses: actions/checkout@v6
+        with:
+          # No pushes back to the repo; don't leave GITHUB_TOKEN in .git/config
+          # where a dependency lifecycle script (bun install) could read it.
+          persist-credentials: false
 
       - name: Setup Node.js
         uses: actions/setup-node@v6
@@ -123,8 +127,10 @@ jobs:
           echo "== $BIN setup --quick --yes (temp git dir) =="
           TMP="$(mktemp -d)"
           git -C "$TMP" init -q
+          # Under `bash -eo pipefail` a failure here aborts the step, so reaching
+          # the next line means setup succeeded — no exit-code echo needed.
           ( cd "$TMP" && "$BIN" setup --quick --yes )
-          echo "setup --quick exit=$?"
+          echo "setup --quick OK"
 
           echo "== $BIN ready (temp git dir) =="
           ( cd "$TMP" && "$BIN" ready ) \
@@ -149,6 +155,10 @@ jobs:
     steps:
       - name: Checkout code
         uses: actions/checkout@v6
+        with:
+          # No pushes back to the repo; don't leave GITHUB_TOKEN in .git/config
+          # where a dependency lifecycle script (bun install) could read it.
+          persist-credentials: false
 
       - name: Setup Node.js
         uses: actions/setup-node@v6
diff --git a/docs/work/2026-07-13-binary-step3/design.md b/docs/work/2026-07-13-binary-step3/design.md
