From 85906664ffd8da4926eca70c6c343b6b70470fdd Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Mon, 13 Jul 2026 12:56:57 +0530
Subject: [PATCH] fix(pr-monitor): journal data-integrity (CodeRabbit
 journal.js:220)

---
 lib/pr-monitor/journal.js       | 24 ++++++++++++++++++++++--
 test/pr-monitor/journal.test.js | 32 ++++++++++++++++++++++++++++++++
 2 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/lib/pr-monitor/journal.js b/lib/pr-monitor/journal.js
index 780e399a..33208182 100644
--- a/lib/pr-monitor/journal.js
+++ b/lib/pr-monitor/journal.js
@@ -190,14 +190,27 @@ function releaseLock(lock) {
  * steal a lock whose owner died or that out-lived `staleMs`. The lock is always
  * released in a `finally`, on success or throw.
  *
+ * A heartbeat refreshes the owner timestamp for the whole duration of the
+ * awaited `fn()`, at `staleMs / 3` intervals. Without this, `lockIsStale()`
+ * only looks at the ONE timestamp written at acquisition time — a live but
+ * slow pass (close to or past `staleMs`) would look stale to a competing
+ * caller purely on age, even though its owner PID is alive, and get its lock
+ * stolen mid-flight, letting two passes interleave journal appends and reuse a
+ * sequence number. The heartbeat is stopped in the existing `finally` cleanup
+ * alongside the lock release.
+ *
  * @param {string} dir - journal directory.
  * @param {() => Promise<T>|T} fn - critical section.
- * @param {{ staleMs?: number, retries?: number, waitMs?: number }} [opts]
+ * @param {{ staleMs?: number, retries?: number, waitMs?: number, heartbeatMs?: number }} [opts]
+ *   `heartbeatMs` defaults to `staleMs / 3` (floor 10ms) and is exposed mainly
+ *   so tests can exercise the heartbeat without waiting out a full-size
+ *   `staleMs` window.
  * @returns {Promise<T>}
  * @template T
  */
 async function withJournalLock(dir, fn, opts = {}) {
   const { staleMs = 30000, retries = 600, waitMs = 25 } = opts;
+  const heartbeatMs = opts.heartbeatMs ?? Math.max(10, Math.floor(staleMs / 3));
   const lock = lockPath(dir);
   let acquired = false;
   for (let i = 0; i < retries && !acquired; i += 1) {
@@ -211,10 +224,17 @@ async function withJournalLock(dir, fn, opts = {}) {
     }
   }
   if (!acquired) throw new Error(`journal lock busy after ${retries} tries: ${lock}`);
+  const ownerFile = path.join(lock, 'owner');
+  const stampOwner = () => {
+    try { fs.writeFileSync(ownerFile, `${process.pid}:${Date.now()}`); } catch { /* lock released/stolen underneath us */ }
+  };
+  stampOwner();
+  const heartbeat = setInterval(stampOwner, heartbeatMs);
+  if (typeof heartbeat.unref === 'function') heartbeat.unref();
   try {
-    fs.writeFileSync(path.join(lock, 'owner'), `${process.pid}:${Date.now()}`);
     return await fn();
   } finally {
+    clearInterval(heartbeat);
     releaseLock(lock);
   }
 }
diff --git a/test/pr-monitor/journal.test.js b/test/pr-monitor/journal.test.js
index 3bfa7741..71a040f2 100644
--- a/test/pr-monitor/journal.test.js
+++ b/test/pr-monitor/journal.test.js
@@ -106,4 +106,36 @@ describe('withJournalLock (cross-process serialization)', () => {
     const got = await journal.withJournalLock(dir, () => 'recovered', { retries: 5, waitMs: 5 });
     expect(got).toBe('recovered');
   });
+
+  test('heartbeats the owner timestamp so a healthy long pass is never mistaken for stale', async () => {
+    // A pass that outlives staleMs several times over — without the heartbeat,
+    // the single acquisition-time timestamp would age well past staleMs and a
+    // competing caller would see (and steal) the lock as stale mid-flight.
+    const staleMs = 30;
+    const heartbeatMs = 10;
+    let sawStaleMidFlight = false;
+    const longPass = journal.withJournalLock(dir, async () => {
+      await new Promise((r) => { setTimeout(r, staleMs * 4); });
+    }, { staleMs, heartbeatMs });
+    // Sample staleness mid-flight, well past the original staleMs window, while
+    // the heartbeat should be keeping the owner timestamp fresh.
+    await new Promise((r) => { setTimeout(r, staleMs * 2); });
+    if (fs.existsSync(journal.lockPath(dir))) {
+      sawStaleMidFlight = lockIsStaleForTest(journal.lockPath(dir), staleMs);
+    }
+    await longPass;
+    expect(sawStaleMidFlight).toBe(false);
+    expect(fs.existsSync(journal.lockPath(dir))).toBe(false);
+  });
 });
+
+/** Mirrors journal.js's internal lockIsStale age check for the owner file, without requiring an internal export. */
+function lockIsStaleForTest(lock, staleMs) {
+  try {
+    const [, tsStr] = fs.readFileSync(path.join(lock, 'owner'), 'utf8').split(':');
+    const stampedAt = Number.parseInt(tsStr, 10);
+    return Date.now() - stampedAt > staleMs;
+  } catch {
+    return true;
+  }
+}
