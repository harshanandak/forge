-  const pr = positional[0];
+  const pr = rawArgs.find((a, idx) => !String(a).startsWith('--') && a !== 'events' && idx !== sinceIdx + 1);
   if (!pr) {
     return { success: false, error: 'Usage: forge shepherd events <pr> --since <seq> [--json]' };
   }
