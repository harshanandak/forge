 					journal_ptr = coalesce(excluded.journal_ptr, kernel_pr.journal_ptr),
-					-- Existing reconcile callers keep REOPEN semantics. The trace seam passes
-					-- preserve_terminal so a delayed/replayed opened event cannot regress a
-					-- terminal row or clear its retirement evidence.
-					state = CASE
-						WHEN ? = 1 AND kernel_pr.state IN ('merged', 'closed') THEN kernel_pr.state
-						ELSE 'open'
