+				repo: input.repo,
+				git_common_dir: input.git_common_dir,
+			}, context, config);
+			const priorPr = priorRows.pull_requests.find(candidate => (
+				candidate.git_common_dir === input.git_common_dir
+				&& candidate.repo === input.repo
+				&& Number(candidate.number) === Number(input.number)
+			)) || null;
+			const issueId = input.issue_id ?? inferred.issue_id;
+			const worktreeId = input.worktree_id ?? inferred.worktree_id ?? priorPr?.worktree_id ?? null;
+			const eventType = `pr.${input.phase}`;
+			const payload = {
+				issue_id: issueId,
+				issue_revision: input.issue_revision,
+				worktree_id: worktreeId,
+				repo: input.repo,
+				number: input.number,
+				url: input.url ?? null,
+				head_sha: input.head_sha,
+				work_packet_hash: input.work_packet_hash,
+				risk_manifest_digest: input.risk_manifest_digest,
+				gate_receipts: input.gate_receipts,
+			};
+
+			const terminalPr = priorPr && ['merged', 'closed'].includes(priorPr.state) ? priorPr : null;
+			if (terminalPr) {
+				const conflicts = input.head_sha !== priorPr.head_sha
+					|| (input.branch != null && input.branch !== priorPr.branch)
+					|| issueId !== priorPr.issue_id
+					|| (worktreeId != null && worktreeId !== priorPr.worktree_id)
+					|| (input.journal_ptr != null && input.journal_ptr !== priorPr.journal_ptr);
+				if (conflicts) throw new Error('recordPrLinkage terminal PR linkage conflict');
+			}
+
+			const existingEventKey = priorPr ? `${eventType}:${priorPr.id}:${input.head_sha}` : null;
+			const existingEvent = existingEventKey
+				? await driver.loadKernelEventByIdempotencyKey(existingEventKey, context, config)
+				: null;
+			assertCompatiblePrEvidence(existingEvent, payload);
+			if (terminalPr && !existingEvent) {
+				throw new Error('recordPrLinkage terminal PR linkage conflict');
+			}
+
+			const linked = terminalPr
+				? { ok: true, ...terminalPr }
