diff --git a/test/kernel/trace.test.js b/test/kernel/trace.test.js
index 527b3d46..cb676f2f 100644
--- a/test/kernel/trace.test.js
+++ b/test/kernel/trace.test.js
@@ -271,4 +271,103 @@ describe('Kernel trace backbone', () => {
 		expect(await driver.queryAll("SELECT * FROM kernel_events WHERE entity_type = 'pr';", config)).toEqual([]);
 		expect(await driver.queryAll('SELECT * FROM kernel_outbox;', config)).toEqual([]);
 	});
+
+	test('rejects delayed conflicting opened events without replacing terminal PR authority', async () => {
+		const gitCommonDir = path.join(root, '.git');
+		const now = '2026-08-09T14:00:00.000Z';
+		for (const [index, terminalState] of ['merged', 'closed'].entries()) {
+			const issueId = `issue-terminal-${terminalState}`;
+			const worktreeId = `worktree-terminal-${terminalState}`;
+			const branch = `codex/terminal-${terminalState}`;
+			const number = 510 + index;
+			await driver.exec(
+				`INSERT INTO kernel_issues (id, title, created_at, updated_at)
+				 VALUES ('${issueId}', '${issueId}', '${now}', '${now}');`,
+				config,
+			);
+			driver.registerWorktree({
+				id: worktreeId,
+				git_common_dir: gitCommonDir,
+				path: path.join(root, '.worktrees', terminalState),
+				branch,
+				issue_id: issueId,
+				registered_at: now,
+			}, config);
+			const opened = {
+				phase: 'opened',
+				git_common_dir: gitCommonDir,
+				repo: 'owner/forge',
+				number,
+				branch,
+				...validEvidence(),
+				occurred_at: now,
+			};
+			await broker.recordPrLinkage(opened);
+			if (terminalState === 'merged') {
+				await broker.recordPrLinkage({ ...opened, phase: 'merged' });
+			} else {
+				await broker.retirePr({ git_common_dir: gitCommonDir, repo: 'owner/forge', number }, {
+					state: 'closed',
+					retired_at: '2026-08-09T14:05:00.000Z',
+				});
+			}
+			await broker.updatePrVerdict({ git_common_dir: gitCommonDir, repo: 'owner/forge', number }, {
+				verdict: 'CLEAN-MERGEABLE',
+				verdict_source: 'local',
+				verdict_at: '2026-08-09T14:06:00.000Z',
+				head_sha: FULL_HEAD_SHA,
+			});
+			const before = (await driver.queryAll(`SELECT * FROM kernel_pr WHERE number = ${number};`, config))[0];
+			await broker.recordPrLinkage({
+				...opened,
+				phase: terminalState === 'merged' ? 'merged' : 'opened',
+				occurred_at: '2026-08-09T14:10:00.000Z',
+			});
+			const afterExactReplay = (await driver.queryAll(`SELECT * FROM kernel_pr WHERE number = ${number};`, config))[0];
+			expect(afterExactReplay).toEqual(before);
+			await expect(broker.recordPrLinkage({
+				...opened,
+				branch: `codex/delayed-${terminalState}`,
+				head_sha: 'd'.repeat(40),
+				issue_id: issueId,
+				worktree_id: worktreeId,
+			})).rejects.toThrow('terminal PR linkage conflict');
+			const after = (await driver.queryAll(`SELECT * FROM kernel_pr WHERE number = ${number};`, config))[0];
+			expect(after).toEqual(before);
+		}
+	});
+
+	test('same semantic iteration key with different evidence is INCOMPLETE and unchanged', async () => {
+		const now = '2026-08-09T15:00:00.000Z';
+		await driver.exec(
+			`INSERT INTO kernel_issues (id, title, created_at, updated_at)
+			 VALUES ('issue-idempotency-conflict', 'Conflict issue', '${now}', '${now}');`,
+			config,
+		);
+		const input = {
+			phase: 'opened',
+			git_common_dir: path.join(root, '.git'),
+			repo: 'owner/forge',
+			number: 520,
+			issue_id: 'issue-idempotency-conflict',
+			...validEvidence(),
+			occurred_at: now,
+		};
+		await broker.recordPrLinkage({ ...input, number: 519 });
+		await broker.recordPrLinkage(input);
+		await expect(broker.recordPrLinkage(input)).resolves.toBeDefined();
+		const beforePr = await driver.queryAll('SELECT * FROM kernel_pr;', config);
+		const beforeEvents = await driver.queryAll("SELECT * FROM kernel_events WHERE entity_type = 'pr';", config);
+		const beforeOutbox = await driver.queryAll('SELECT * FROM kernel_outbox;', config);
+
+		await expect(broker.recordPrLinkage({
+			...input,
+			work_packet_hash: 'e'.repeat(64),
+			risk_manifest_digest: 'f'.repeat(64),
+			gate_receipts: ['gate-receipt-conflicting'],
+		})).rejects.toThrow('INCOMPLETE: conflicting evidence for idempotency key');
+		expect(await driver.queryAll('SELECT * FROM kernel_pr;', config)).toEqual(beforePr);
+		expect(await driver.queryAll("SELECT * FROM kernel_events WHERE entity_type = 'pr';", config)).toEqual(beforeEvents);
+		expect(await driver.queryAll('SELECT * FROM kernel_outbox;', config)).toEqual(beforeOutbox);
+	});
 });
