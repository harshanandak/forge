--- a/lib/kernel/sqlite-driver.js
+++ b/lib/kernel/sqlite-driver.js
@@ -2463,8 +2463,6 @@ function createDriver(runtime, configuredDatabasePath) {
 		// ON CONFLICT on the unique idx_pr_common_dir_repo_number: a re-upsert updates the
 		// mutable columns and coalesces soft links (a later null never clobbers an existing
 		// issue_id/worktree_id). registered_at is set on INSERT only; state defaults 'open'.
-		// Existing callers retain reopen behavior. The trace writer opts into
-		// preserve_terminal so a delayed opened replay cannot regress merged/closed state.
 		async upsertPr(row, _context = {}, config = {}) {
 			const id = row.id || randomUUID();
 			const registeredAt = row.registered_at || new Date().toISOString();
@@ -2483,17 +2481,12 @@ function createDriver(runtime, configuredDatabasePath) {
