+const { buildConflict, evaluateKernelEvent, normalizePayload, stableStringify } = require('./evaluators');
 const { CONFLICT_SIGNAL, classifyConflictSignal } = require('./conflict-signal');
 const { buildKernelMigrationPlan } = require('./migrations');
 const { buildClaimConflict, isValidExpiresAt, planClaimAcquisition } = require('./lease-enforcer');
@@ -185,6 +185,15 @@ function assertValidPrEvidence(input) {
 	}
 }
 
+function assertCompatiblePrEvidence(existingEvent, payload) {
+	if (!existingEvent
+		|| stableStringify(normalizePayload(existingEvent)) === stableStringify(payload)) return;
+	const conflict = new Error('INCOMPLETE: conflicting evidence for idempotency key');
+	conflict.code = 'FORGE_TRACE_EVIDENCE_CONFLICT';
+	conflict.status = 'INCOMPLETE';
+	throw conflict;
+}
+
 // The migration ledger records which migration ids have been applied so initialize()
 // applies each migration AT MOST ONCE — no full re-run, no blanket duplicate-error
