-				issue_id: input.issue_id ?? inferred.issue_id,
-				worktree_id: input.worktree_id ?? inferred.worktree_id,
+				issue_id: issueId,
+				worktree_id: worktreeId,
 				registered_at: input.occurred_at,
-				preserve_terminal: true,
