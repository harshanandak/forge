+function readTraceArtifact(projectRoot, workFolder, filename) {
+	if (!workFolder) return null;
+	const root = fs.realpathSync(path.resolve(projectRoot));
+	const candidateFolder = path.resolve(root, workFolder);
+	if (!fs.existsSync(candidateFolder)) return null;
+	const folder = fs.realpathSync(candidateFolder);
+	const relativeFolder = path.relative(root, folder);
+	if (relativeFolder.startsWith('..') || path.isAbsolute(relativeFolder)) return null;
+	const file = path.join(folder, filename);
+	if (!fs.existsSync(file) || !fs.statSync(file).isFile()) return null;
+	return {
+		path: path.posix.join(String(workFolder).replaceAll('\\', '/'), filename),
+		content: fs.readFileSync(file, 'utf8'),
+	};
+}
+
+function buildTraceEnvelope(projectRoot, target, rows) {
+	const artifacts = {
+		plan: readTraceArtifact(projectRoot, rows.work_folder, 'plan.md'),
+		tasks: readTraceArtifact(projectRoot, rows.work_folder, 'tasks.md'),
+		decisions: readTraceArtifact(projectRoot, rows.work_folder, 'decisions.md'),
+	};
+	const gaps = [];
+	if (!rows.issue) gaps.push('issue');
+	if (!rows.worktree) gaps.push('worktree');
+	if (!rows.work_folder) gaps.push('work_folder');
+	for (const name of ['plan', 'tasks', 'decisions']) {
+		if (!artifacts[name]) gaps.push(name);
+	}
+	if (rows.pull_requests.length === 0) gaps.push('pull_requests');
+	return {
+		schema_version: 'forge.trace.v1',
+		target: target.issue_id
+			? { kind: 'issue', id: target.issue_id }
+			: { kind: 'pr', number: Number(target.pr_number), repo: target.repo ?? null },
+		issue: rows.issue,
+		worktree: rows.worktree,
+		work_folder: rows.work_folder,
+		artifacts,
+		pull_requests: rows.pull_requests,
+		gaps,
+	};
+}
+
 // The migration ledger records which migration ids have been applied so initialize()
 // applies each migration AT MOST ONCE — no full re-run, no blanket duplicate-error
 // swallow. The ledger table is broker-managed bookkeeping (created before the plan is
@@ -1211,6 +1256,79 @@ function createLocalBroker(options = {}) {
 			return driver.upsertPr(row, context, getConfig());
 		},
 
+		// Ship/merge linkage fixture: infer the issue/worktree from the active branch
+		// registration, upsert the single PR row, and append one idempotent iteration
+		// event. Replaying either phase keeps one linkage row and one event per head.
+		async recordPrLinkage(input, context = {}) {
+			if (!input || !['opened', 'merged'].includes(input.phase)) {
+				throw new Error('recordPrLinkage phase must be opened or merged');
+			}
+			for (const field of ['git_common_dir', 'repo', 'number']) {
+				if (input[field] === undefined || input[field] === null || input[field] === '') {
+					throw new Error(`recordPrLinkage requires ${field}`);
+				}
+			}
+			requireDriverMethod(driver, 'resolvePrLinkage');
+			requireDriverMethod(driver, 'upsertPr');
+			requireDriverMethod(driver, 'retirePr');
+			const config = getConfig();
+			const inferred = await driver.resolvePrLinkage(input, context, config);
+			if (input.issue_revision !== undefined
+				&& (inferred.issue_revision === null
+					|| Number(input.issue_revision) !== Number(inferred.issue_revision))) {
+				throw new Error(`recordPrLinkage stale issue revision: expected ${input.issue_revision}, actual ${inferred.issue_revision}`);
+			}
+			const linked = await driver.upsertPr({
+				...input,
+				issue_id: input.issue_id ?? inferred.issue_id,
+				worktree_id: input.worktree_id ?? inferred.worktree_id,
+				registered_at: input.occurred_at,
+			}, context, config);
+			const eventType = `pr.${input.phase}`;
+			const event = await runGuardedEventImpl({
+				entity_type: 'pr',
+				entity_id: linked.id,
+				event_type: eventType,
+				idempotency_key: `${eventType}:${linked.id}:${input.head_sha || 'headless'}`,
+				expected_revision: 0,
+				actor: context.actor || 'forge',
+				origin: context.origin || 'cli',
+				created_at: input.occurred_at || new Date().toISOString(),
+				payload: {
+					issue_id: linked.issue_id ?? null,
+					issue_revision: input.issue_revision ?? inferred.issue_revision ?? null,
+					worktree_id: linked.worktree_id ?? null,
+					repo: linked.repo,
+					number: linked.number,
+					url: input.url ?? null,
+					head_sha: input.head_sha ?? null,
+					work_packet_hash: input.work_packet_hash ?? null,
+					risk_manifest_digest: input.risk_manifest_digest ?? null,
+					gate_receipts: input.gate_receipts ?? null,
+				},
+			}, context);
+			if (input.phase === 'merged') {
+				await driver.retirePr({
+					git_common_dir: linked.git_common_dir,
+					repo: linked.repo,
+					number: linked.number,
+				}, {
+					state: 'merged',
+					retired_at: input.occurred_at,
+				}, context, config);
+			}
+			return { link: linked, iteration: event };
+		},
+
+		async readTrace(target, context = {}) {
+			if (!target || (!target.issue_id && target.pr_number === undefined)) {
+				throw new Error('readTrace requires issue_id or pr_number');
+			}
+			requireDriverMethod(driver, 'readTrace');
+			const rows = await driver.readTrace(target, context, getConfig());
+			return buildTraceEnvelope(getConfig().projectRoot, target, rows);
+		},
+
 		async updatePrVerdict(key, patch = {}, context = {}) {
 			requireDriverMethod(driver, 'updatePrVerdict');
 			return driver.updatePrVerdict(key, patch, context, getConfig());
