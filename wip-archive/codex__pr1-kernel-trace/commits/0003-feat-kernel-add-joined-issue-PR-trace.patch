+'use strict';
+
+const { describe, test, expect, beforeEach, afterEach } = require('bun:test');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+
+const { createLocalBroker } = require('../../lib/kernel/broker');
+const { createBuiltinSQLiteDriver } = require('../../lib/kernel/sqlite-driver');
+
+describe('Kernel trace backbone', () => {
+	let root;
+	let driver;
+	let broker;
+	let config;
+
+	beforeEach(async () => {
+		root = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-trace-'));
+		const gitCommonDir = path.join(root, '.git');
+		fs.mkdirSync(gitCommonDir, { recursive: true });
+		config = { databasePath: path.join(root, 'kernel.sqlite') };
+		driver = createBuiltinSQLiteDriver({});
+		broker = createLocalBroker({
+			projectRoot: root,
+			gitCommonDir,
+			databasePath: config.databasePath,
+			driver,
+		});
+		await broker.initialize();
+	});
+
+	afterEach(() => {
+		driver?.close();
+		try {
+			fs.rmSync(root, { recursive: true, force: true, maxRetries: 5, retryDelay: 50 });
+		} catch {
+			// Bun's Windows SQLite handle can linger briefly after close; temp cleanup is best effort.
+		}
+	});
+
+	test('ship and merge replay one inferred PR link and expose its joined trace', async () => {
+		const issueId = 'issue-trace-1';
+		const worktreeId = 'worktree-trace-1';
+		const workFolder = 'docs/work/2026-08-09-trace';
+		const worktreePath = path.join(root, '.worktrees', 'trace');
+		const branch = 'codex/trace';
+		const gitCommonDir = path.join(root, '.git');
+		const now = '2026-08-09T09:00:00.000Z';
+
+		await driver.exec(
+			`INSERT INTO kernel_issues (id, title, created_at, updated_at)
+			 VALUES ('${issueId}', 'Trace backbone', '${now}', '${now}');`,
+			config,
+		);
+		driver.registerWorktree({
+			id: worktreeId,
+			git_common_dir: gitCommonDir,
+			path: worktreePath,
+			branch,
+			issue_id: issueId,
+			work_folder: workFolder,
+			registered_at: now,
+		}, config);
+		for (const [name, content] of [
+			['plan.md', '# Plan\n'],
+			['tasks.md', '# Tasks\n'],
+			['decisions.md', '# Decisions\n'],
+		]) {
+			const file = path.join(root, workFolder, name);
+			fs.mkdirSync(path.dirname(file), { recursive: true });
+			fs.writeFileSync(file, content, 'utf8');
+		}
+
+		const ship = {
+			phase: 'opened',
+			git_common_dir: gitCommonDir,
+			repo: 'owner/forge',
+			number: 501,
+			url: 'https://github.com/owner/forge/pull/501',
+			branch,
+			head_sha: 'a'.repeat(40),
+			issue_revision: 0,
+			work_packet_hash: 'work-packet-hash',
+			risk_manifest_digest: 'risk-manifest-digest',
+			gate_receipts: ['gate-receipt-1'],
+			occurred_at: '2026-08-09T09:10:00.000Z',
+		};
+		const merge = {
+			...ship,
+			phase: 'merged',
+			occurred_at: '2026-08-09T09:20:00.000Z',
+		};
+		await broker.recordPrLinkage(ship);
+		await broker.recordPrLinkage(ship);
+		await broker.recordPrLinkage(merge);
+		await broker.recordPrLinkage(merge);
+
+		const trace = await broker.readTrace({ issue_id: issueId });
+		expect(trace.schema_version).toBe('forge.trace.v1');
+		expect(trace.issue.id).toBe(issueId);
+		expect(trace.worktree.id).toBe(worktreeId);
+		expect(trace.work_folder).toBe(workFolder);
+		expect(trace.artifacts).toEqual({
+			plan: { path: `${workFolder}/plan.md`, content: '# Plan\n' },
+			tasks: { path: `${workFolder}/tasks.md`, content: '# Tasks\n' },
+			decisions: { path: `${workFolder}/decisions.md`, content: '# Decisions\n' },
+		});
+		expect(trace.pull_requests).toHaveLength(1);
+		expect(trace.pull_requests[0]).toMatchObject({
+			number: 501,
+			issue_id: issueId,
+			worktree_id: worktreeId,
+			state: 'merged',
+		});
+		expect(trace.pull_requests[0].iterations.map(event => event.type)).toEqual([
+			'pr.opened',
+			'pr.merged',
+		]);
+		expect(trace.pull_requests[0].iterations[0]).toMatchObject({
+			issue_revision: 0,
+			head_sha: 'a'.repeat(40),
+			work_packet_hash: 'work-packet-hash',
+			risk_manifest_digest: 'risk-manifest-digest',
+			gate_receipts: ['gate-receipt-1'],
+		});
+		expect(trace.gaps).toEqual([]);
+		const prTrace = await broker.readTrace({
+			pr_number: 501,
+			repo: 'owner/forge',
+			git_common_dir: gitCommonDir,
+		});
+		expect(prTrace.target).toEqual({ kind: 'pr', number: 501, repo: 'owner/forge' });
+		expect(prTrace.issue.id).toBe(issueId);
+
+		const prRows = await driver.queryAll('SELECT * FROM kernel_pr;', config);
+		const prEvents = await driver.queryAll("SELECT * FROM kernel_events WHERE entity_type = 'pr';", config);
+		expect(prRows).toHaveLength(1);
+		expect(prEvents).toHaveLength(2);
+	});
+
+	test('returns explicit null gaps for a partial historical issue', async () => {
+		const now = '2026-08-09T10:00:00.000Z';
+		await driver.exec(
+			`INSERT INTO kernel_issues (id, title, created_at, updated_at)
+			 VALUES ('issue-with-gaps', 'Historical issue', '${now}', '${now}');`,
+			config,
+		);
+
+		const trace = await broker.readTrace({ issue_id: 'issue-with-gaps' });
+		expect(trace).toMatchObject({
+			worktree: null,
+			work_folder: null,
+			artifacts: { plan: null, tasks: null, decisions: null },
+			pull_requests: [],
+			gaps: ['worktree', 'work_folder', 'plan', 'tasks', 'decisions', 'pull_requests'],
+		});
+	});
+
+	test('rejects stale issue linkage before writing a PR row or iteration', async () => {
+		const now = '2026-08-09T11:00:00.000Z';
+		await driver.exec(
+			`INSERT INTO kernel_issues (id, title, created_at, updated_at)
+			 VALUES ('issue-stale', 'Stale issue', '${now}', '${now}');`,
+			config,
+		);
+
+		expect(broker.recordPrLinkage({
+			phase: 'opened',
+			git_common_dir: path.join(root, '.git'),
+			repo: 'owner/forge',
+			number: 502,
+			issue_id: 'issue-stale',
+			issue_revision: 1,
+		})).rejects.toThrow('stale issue revision');
+		expect(await driver.queryAll('SELECT * FROM kernel_pr;', config)).toEqual([]);
+		expect(await driver.queryAll("SELECT * FROM kernel_events WHERE entity_type = 'pr';", config)).toEqual([]);
+	});
+});
