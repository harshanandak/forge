diff --git a/test/agents-renderer.test.js b/test/agents-renderer.test.js
new file mode 100644
index 00000000..c2714652
--- /dev/null
+++ b/test/agents-renderer.test.js
@@ -0,0 +1,129 @@
+const { describe, test, expect } = require('bun:test');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+
+const {
+  CANONICAL_ROLES_DIR,
+  HARNESS_AGENT_DIRS,
+  splitFrontmatter,
+  loadRoleManifest,
+  renderSubagentFile,
+  renderSubagentRoles,
+} = require('../lib/agents-renderer');
+
+// Parse a rendered subagent file with the renderer's own frontmatter splitter,
+// which is backed by the `yaml` production dependency (never gray-matter).
+function parse(raw) {
+  const { data, body } = splitFrontmatter(raw);
+  return { data, content: body };
+}
+
+// The Forge package root — the canonical `agents/` role manifest lives here and is
+// the single source for every harness's native subagent files.
+const PACKAGE_ROOT = path.join(__dirname, '..');
+
+// The real roles used by the /dev TDD loop (lib/commands/dev.js audit events).
+const EXPECTED_ROLE_IDS = ['implementer', 'quality_reviewer', 'spec_reviewer'];
+
+function tmp() {
+  return fs.mkdtempSync(path.join(os.tmpdir(), 'forge-agents-'));
+}
+
+describe('agents-renderer — canonical role manifest', () => {
+  test('canonical agents/ dir is the source of truth for the real dev.js roles', () => {
+    expect(CANONICAL_ROLES_DIR).toBe('agents');
+    const roles = loadRoleManifest(PACKAGE_ROOT);
+    expect(roles.map((r) => r.id).sort()).toEqual(EXPECTED_ROLE_IDS);
+  });
+
+  test('every role has a name matching its id, a non-empty description, and a body', () => {
+    for (const role of loadRoleManifest(PACKAGE_ROOT)) {
+      expect(role.name).toBe(role.id);
+      expect(typeof role.description).toBe('string');
+      expect(role.description.length).toBeGreaterThan(0);
+      // Keep descriptions within the context-cost budget (well under the 1024 cap).
+      expect(role.description.length).toBeLessThanOrEqual(1024);
+      expect(role.body.trim().length).toBeGreaterThan(0);
+    }
+  });
+
+  test('empty manifest dir yields no roles (no throw)', () => {
+    const root = tmp();
+    try {
+      expect(loadRoleManifest(root)).toEqual([]);
+    } finally {
+      fs.rmSync(root, { recursive: true, force: true });
+    }
+  });
+});
+
+describe('agents-renderer — per-harness subagent files', () => {
+  test('renderSubagentFile emits valid name+description frontmatter and a body', () => {
+    const [role] = loadRoleManifest(PACKAGE_ROOT);
+    const rendered = renderSubagentFile(role);
+    const { data, content } = parse(rendered);
+    expect(data.name).toBe(role.id);
+    expect(data.description).toBe(role.description);
+    // Symmetric contract: ONLY the fields both Claude Code and Cursor recognize.
+    expect(Object.keys(data).sort()).toEqual(['description', 'name']);
+    expect(content.trim().length).toBeGreaterThan(0);
+  });
+
+  test('forge setup path writes symmetric .claude/agents + .cursor/agents from one manifest', () => {
+    const root = tmp();
+    try {
+      const result = renderSubagentRoles({ packageRoot: PACKAGE_ROOT, targetRoot: root });
+      for (const id of EXPECTED_ROLE_IDS) {
+        const claudeFile = path.join(root, HARNESS_AGENT_DIRS.claude, `${id}.md`);
+        const cursorFile = path.join(root, HARNESS_AGENT_DIRS.cursor, `${id}.md`);
+        expect(fs.existsSync(claudeFile)).toBe(true);
+        expect(fs.existsSync(cursorFile)).toBe(true);
+
+        const claudeRaw = fs.readFileSync(claudeFile, 'utf8');
+        const cursorRaw = fs.readFileSync(cursorFile, 'utf8');
+        // SYMMETRY: identical file content across the two harnesses.
+        expect(claudeRaw).toBe(cursorRaw);
+
+        // Frontmatter actually parses and carries the required fields.
+        const { data } = parse(claudeRaw);
+        expect(data.name).toBe(id);
+        expect(typeof data.description).toBe('string');
+        expect(data.description.length).toBeGreaterThan(0);
+      }
+      expect(result.claude.written.length).toBe(EXPECTED_ROLE_IDS.length);
+      expect(result.cursor.written.length).toBe(EXPECTED_ROLE_IDS.length);
+    } finally {
+      fs.rmSync(root, { recursive: true, force: true });
+    }
+  });
+
+  test('codex delivery is skill-backed: .codex/skills/<role>/SKILL.md with frontmatter', () => {
+    const root = tmp();
+    try {
+      renderSubagentRoles({ packageRoot: PACKAGE_ROOT, targetRoot: root });
+      for (const id of EXPECTED_ROLE_IDS) {
+        const skillFile = path.join(root, '.codex', 'skills', id, 'SKILL.md');
+        expect(fs.existsSync(skillFile)).toBe(true);
+        const { data } = parse(fs.readFileSync(skillFile, 'utf8'));
+        expect(data.name).toBe(id);
+        expect(data.description.length).toBeGreaterThan(0);
+      }
+    } finally {
+      fs.rmSync(root, { recursive: true, force: true });
+    }
+  });
+
+  test('rendering is idempotent (rerun overwrites cleanly, same bytes)', () => {
+    const root = tmp();
+    try {
+      renderSubagentRoles({ packageRoot: PACKAGE_ROOT, targetRoot: root });
+      const file = path.join(root, HARNESS_AGENT_DIRS.claude, 'implementer.md');
+      const first = fs.readFileSync(file, 'utf8');
+      renderSubagentRoles({ packageRoot: PACKAGE_ROOT, targetRoot: root });
+      expect(fs.readFileSync(file, 'utf8')).toBe(first);
+    } finally {
+      fs.rmSync(root, { recursive: true, force: true });
+    }
+  });
+});
