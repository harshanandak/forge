+  const written = (result[harness] && result[harness].written) || [];
+  if (written.length) {
+    const surface = harness === 'codex' ? '.codex/skills/<role>' : `.${harness}/agents`;
+    console.log(`  Created: ${written.length} subagent role files in ${surface}/`);
+  }
+}
