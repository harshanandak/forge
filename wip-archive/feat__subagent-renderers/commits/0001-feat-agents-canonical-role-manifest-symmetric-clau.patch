diff --git a/lib/agents-renderer.js b/lib/agents-renderer.js
new file mode 100644
index 00000000..3e0a6211
--- /dev/null
+++ b/lib/agents-renderer.js
@@ -0,0 +1,190 @@
+'use strict';
+
+/**
+ * Subagent (role) renderer.
+ *
+ * Emits SYMMETRIC subagent files for every supported harness from ONE canonical
+ * role manifest (`agents/<role>.md` at the Forge package root). This closes the
+ * "agents" capability gap: before this renderer no harness delivered a subagent
+ * surface (kernel issue 802aa4d8 downgraded every row to not-delivered/unsupported).
+ *
+ * Canonical source — `agents/<role>.md`:
+ *
+ *   ---
+ *   name: <role>            # must equal the filename base (the dev.js audit role id)
+ *   description: <trigger>  # when the harness should delegate to this subagent
+ *   ---
+ *   <markdown system prompt body>
+ *
+ * The roles are the REAL roles the /dev TDD loop already emits as runtime audit
+ * events (lib/commands/dev.js): implementer, spec_reviewer, quality_reviewer.
+ *
+ * Harness targets — the frontmatter contract is the shared intersection that BOTH
+ * Claude Code and Cursor subagent files recognize (name + description + a markdown
+ * system-prompt body), verified from vendor docs, so ONE rendered file is valid in
+ * both. Codex has no native subagent surface, so the role is delivered as a skill.
+ *
+ *   - Claude : `.claude/agents/<role>.md`   (YAML frontmatter: name, description)
+ *   - Cursor : `.cursor/agents/<role>.md`   (same frontmatter shape)
+ *   - Codex  : `.codex/skills/<role>/SKILL.md` (skill-backed role fallback)
+ *
+ * Built on the `yaml` production dependency (never gray-matter, which Forge does
+ * not depend on) so it runs under `bun test` and the release gates.
+ *
+ * @module agents-renderer
+ */
+
+const fs = require('node:fs');
+const path = require('node:path');
+const YAML = require('yaml');
+
+/** Canonical role-manifest directory, relative to the Forge package root. */
+const CANONICAL_ROLES_DIR = 'agents';
+
+/**
+ * Native subagent output directory per harness. Claude Code and Cursor share the
+ * SAME frontmatter contract, so both render from the one canonical manifest.
+ */
+const HARNESS_AGENT_DIRS = {
+  claude: '.claude/agents',
+  cursor: '.cursor/agents',
+};
+
+/** Codex delivers roles as skills (no native subagent surface). */
+const CODEX_ROLE_SKILLS_DIR = '.codex/skills';
+
+/** The only harnesses this renderer targets (hermes has no subagent contract). */
+const AGENT_HARNESSES = ['claude', 'cursor', 'codex'];
+
+/** Thrown when a canonical role file is malformed (missing name/description). */
+class RoleManifestError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'RoleManifestError';
+  }
+}
+
+/** Split a markdown file into its YAML frontmatter block and body. */
+function splitFrontmatter(raw) {
+  const match = String(raw).match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
+  if (!match) {
+    return { data: {}, body: String(raw) };
+  }
+  const data = YAML.parse(match[1]) || {};
+  return { data: typeof data === 'object' && data ? data : {}, body: match[2] };
+}
+
+/**
+ * Load the canonical role manifest.
+ * @param {string} packageRoot - Forge package root (contains `agents/`).
+ * @returns {{ id, name, description, body }[]} roles sorted by id.
+ */
+function loadRoleManifest(packageRoot) {
+  const dir = path.join(packageRoot, CANONICAL_ROLES_DIR);
+  if (!fs.existsSync(dir)) return [];
+  return fs.readdirSync(dir)
+    .filter((f) => f.endsWith('.md'))
+    .sort()
+    .map((file) => {
+      const id = path.basename(file, '.md');
+      const raw = fs.readFileSync(path.join(dir, file), 'utf8');
+      const { data, body } = splitFrontmatter(raw);
+      const name = typeof data.name === 'string' && data.name.trim() ? data.name.trim() : id;
+      const description = typeof data.description === 'string' ? data.description.trim() : '';
+      if (!description) {
+        throw new RoleManifestError(`role '${id}' (${file}) is missing a frontmatter description`);
+      }
+      if (name !== id) {
+        throw new RoleManifestError(`role '${id}' frontmatter name '${name}' must match its filename`);
+      }
+      return { id, name, description, body: `${body.trim()}\n` };
+    });
+}
+
+/**
+ * Render one role into a subagent file string. The frontmatter carries ONLY the
+ * fields both Claude Code and Cursor recognize (name + description), so the exact
+ * same bytes are valid across harnesses — the guarantee the symmetry test checks.
+ * @param {{ name, description, body }} role
+ * @returns {string}
+ */
+function renderSubagentFile(role) {
+  const frontmatter = YAML.stringify({ name: role.name, description: role.description }).trimEnd();
+  return `---\n${frontmatter}\n---\n\n${role.body.trim()}\n`;
+}
+
+/** Codex role skill = the same rendered content, written to a SKILL.md path. */
+function renderCodexRoleSkill(role) {
+  return renderSubagentFile(role);
+}
+
+/**
+ * Write per-harness subagent files for `.claude/agents` / `.cursor/agents`.
+ * Idempotent: rerun overwrites Forge-owned role files with identical bytes.
+ * @param {{ harness, targetRoot, roles }} params
+ * @returns {{ written: string[] }}
+ */
+function writeAgentFiles({ harness, targetRoot, roles }) {
+  const rel = HARNESS_AGENT_DIRS[harness];
+  if (!rel) throw new Error(`Unknown subagent harness: ${harness}`);
+  const dir = path.join(targetRoot, rel);
+  fs.mkdirSync(dir, { recursive: true });
+  const written = [];
+  for (const role of roles) {
+    const file = path.join(dir, `${role.id}.md`);
+    fs.writeFileSync(file, renderSubagentFile(role), 'utf8');
+    written.push(file);
+  }
+  return { written };
+}
+
+/** Write Codex skill-backed role files at `.codex/skills/<role>/SKILL.md`. */
+function writeCodexRoleSkills({ targetRoot, roles }) {
+  const written = [];
+  for (const role of roles) {
+    const dir = path.join(targetRoot, CODEX_ROLE_SKILLS_DIR, role.id);
+    fs.mkdirSync(dir, { recursive: true });
+    const file = path.join(dir, 'SKILL.md');
+    fs.writeFileSync(file, renderCodexRoleSkill(role), 'utf8');
+    written.push(file);
+  }
+  return { written };
+}
+
+/**
+ * Render all (or the requested) harness subagent surfaces from the one manifest.
+ * This is the function `forge setup` calls.
+ * @param {object} params
+ * @param {string} params.packageRoot - Forge package root (contains `agents/`).
+ * @param {string} params.targetRoot - Project root to write into.
+ * @param {string[]} [params.harnesses] - Subset of AGENT_HARNESSES (default: all).
+ * @returns {{ roles, claude?, cursor?, codex? }}
+ */
+function renderSubagentRoles({ packageRoot, targetRoot, harnesses }) {
+  const roles = loadRoleManifest(packageRoot);
+  const set = harnesses || AGENT_HARNESSES;
+  const result = { roles };
+  for (const harness of set) {
+    if (harness === 'codex') {
+      result.codex = writeCodexRoleSkills({ targetRoot, roles });
+    } else if (HARNESS_AGENT_DIRS[harness]) {
+      result[harness] = writeAgentFiles({ harness, targetRoot, roles });
+    }
+  }
+  return result;
+}
+
+module.exports = {
+  CANONICAL_ROLES_DIR,
+  HARNESS_AGENT_DIRS,
+  CODEX_ROLE_SKILLS_DIR,
+  AGENT_HARNESSES,
+  RoleManifestError,
+  splitFrontmatter,
+  loadRoleManifest,
+  renderSubagentFile,
+  renderCodexRoleSkill,
+  writeAgentFiles,
+  writeCodexRoleSkills,
+  renderSubagentRoles,
+};
