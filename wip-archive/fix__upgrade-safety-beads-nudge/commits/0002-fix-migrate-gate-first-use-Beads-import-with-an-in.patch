-      // Write the sentinel LAST so a concurrent first run is a benign idempotent skip.
-      writeSentinelFile(fsImpl, sentinel, { migratedAt: stampedAt(), inserted, skipped });
+      // Record the marker LAST so a concurrent first run is a benign idempotent skip.
+      await recordImportMarker(markerDriver, markerConfig, appliedAt);
