From 2ef290730371cdb4608487662e53306ee379e59b Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Mon, 6 Jul 2026 00:01:11 +0530
Subject: [PATCH] fix(migrate): move migrate require() inside the safety-net
 try; share one helper
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

CodeRabbit (PR #298): in the kernel issue branch, `require('./migrate')` was resolved
BEFORE the try, so a require() failure would propagate out of resolveCommandOpts and
break every kernel-backed command — contradicting the "never breaks" guarantee. Extract
a shared `runRuntimeAutoMigrate(deps, kernelDeps)` helper with the require INSIDE the
try, used by both the issue and KERNEL_TOOL_COMMANDS branches (no more duplicated
require/invoke/swallow logic that could drift). Add a test that exercises the real
require path (no injection) to cover the previously-untested branch.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 lib/commands/_resolve-command-opts.js      | 50 +++++++++++-----------
 test/commands/runtime-auto-migrate.test.js | 20 +++++++++
 2 files changed, 44 insertions(+), 26 deletions(-)

diff --git a/lib/commands/_resolve-command-opts.js b/lib/commands/_resolve-command-opts.js
index 51622cfd..fe4f6581 100644
--- a/lib/commands/_resolve-command-opts.js
+++ b/lib/commands/_resolve-command-opts.js
@@ -142,6 +142,27 @@ function resolveFlagBackend(flags = {}) {
   return fromKernel || fromBackend || null;
 }
 
+// Run the first-use Beads import safety net for a kernel-routed command. Resolving the
+// migrate module lives INSIDE the try so even a require() failure (missing/corrupt
+// module) can never break command-opts resolution — the whole point of the safety net.
+// Shared by both kernel branches (issue + KERNEL_TOOL_COMMANDS) so the two call sites
+// cannot drift.
+async function runRuntimeAutoMigrate(deps, kernelDeps) {
+  try {
+    const autoMigrate = deps.autoMigrateBeadsAtRuntime
+      || require('./migrate').autoMigrateBeadsAtRuntime;
+    await autoMigrate({
+      projectRoot: deps.projectRoot,
+      databasePath: kernelDeps.kernelDatabasePath,
+      broker: kernelDeps.kernelBroker,
+      driver: kernelDeps.kernelDriver,
+    });
+  } catch {
+    // A migration-hook failure (including a require() failure) must never break the
+    // command it rides on.
+  }
+}
+
 /**
  * Resolve the command opts and selector-stripped args for a dispatched command.
  *
@@ -173,18 +194,7 @@ async function resolveCommandOpts(command, rawArgs = [], deps = {}) {
       });
       // Same first-use safety net as the issue branch: an export-first upgrader would
       // otherwise drain an EMPTY kernel and never trigger the one-time Beads import.
-      const autoMigrate = deps.autoMigrateBeadsAtRuntime
-        || require('./migrate').autoMigrateBeadsAtRuntime;
-      try {
-        await autoMigrate({
-          projectRoot: deps.projectRoot,
-          databasePath: kernelDeps.kernelDatabasePath,
-          broker: kernelDeps.kernelBroker,
-          driver: kernelDeps.kernelDriver,
-        });
-      } catch {
-        // export must run even if the one-time import hook throws.
-      }
+      await runRuntimeAutoMigrate(deps, kernelDeps);
       return { commandOpts: { _broker: kernelDeps.kernelBroker }, args: rawArgs };
     } catch {
       return { commandOpts: {}, args: rawArgs };
@@ -227,20 +237,8 @@ async function resolveCommandOpts(command, rawArgs = [], deps = {}) {
   // only from `forge setup`/`init`. An existing repo whose user merely upgrades forge
   // would read an EMPTY kernel here and their existing Beads issues would appear to
   // vanish. Import them ONCE on first kernel use (idempotent, gated by an in-DB marker
-  // that shares the kernel DB lifecycle, stderr only). Wrapped so a safety-net failure
-  // NEVER breaks command-opts resolution.
-  const autoMigrate = deps.autoMigrateBeadsAtRuntime
-    || require('./migrate').autoMigrateBeadsAtRuntime;
-  try {
-    await autoMigrate({
-      projectRoot: deps.projectRoot,
-      databasePath: kernelDeps.kernelDatabasePath,
-      broker: kernelDeps.kernelBroker,
-      driver: kernelDeps.kernelDriver,
-    });
-  } catch {
-    // The command must run even if the one-time import hook throws.
-  }
+  // that shares the kernel DB lifecycle, stderr only).
+  await runRuntimeAutoMigrate(deps, kernelDeps);
 
   return {
     commandOpts: {
diff --git a/test/commands/runtime-auto-migrate.test.js b/test/commands/runtime-auto-migrate.test.js
index 46718795..38bd9d7b 100644
--- a/test/commands/runtime-auto-migrate.test.js
+++ b/test/commands/runtime-auto-migrate.test.js
@@ -294,4 +294,24 @@ describe('resolveCommandOpts wires the runtime auto-migrate on the kernel path o
 		});
 		expect(commandOpts.issueBackend).toBe('kernel');
 	});
+
+	test('runs the REAL migrate require() path (no injection) without ever throwing', async () => {
+		// With no autoMigrateBeadsAtRuntime injected, the shared helper resolves
+		// require('./migrate') INSIDE its try — a bare temp dir has no jsonl store, so the
+		// real hook is a safe no-op and command-opts resolution still succeeds.
+		const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-real-require-'));
+		cleanups.push(() => fs.rmSync(tmp, { recursive: true, force: true }));
+		const dbPath = path.join(tmp, 'kernel.sqlite');
+		const { commandOpts } = await resolveCommandOpts('list', [], {
+			env: {},
+			projectRoot: tmp,
+			buildKernelIssueDeps: async () => ({
+				useKernelBroker: true,
+				kernelBroker: { id: 'broker' },
+				kernelDriver: { id: 'driver' },
+				kernelDatabasePath: dbPath,
+			}),
+		});
+		expect(commandOpts.issueBackend).toBe('kernel');
+	});
 });
