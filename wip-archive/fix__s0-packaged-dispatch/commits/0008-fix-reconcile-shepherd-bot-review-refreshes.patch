+  const login = String(comment?.author || '').toLowerCase();
+  const body = String(comment?.body || '').trim();
+  return CODERABBIT_LOGINS.has(login)
+    && isFullHeadOid(headOid)
+    && body.includes(String(headOid))
+    && body.startsWith('<!-- This is an auto-generated comment: summarize by coderabbit.ai -->')
+    && /No actionable comments were generated in the recent review\./i.test(body)
+    && body.endsWith('<!-- tips_end -->')
+    && !hasExplicitActionableFinding(body);
