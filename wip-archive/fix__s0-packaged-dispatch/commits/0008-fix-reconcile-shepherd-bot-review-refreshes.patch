+    && body.startsWith('<!-- This is an auto-generated reply by CodeRabbit -->')
+    && /<!-- CodeRabbit review command invocation: [^\r\n]+ -->/i.test(body)
+    && /<summary>✅ Action performed<\/summary>/i.test(body)
+    && /\bReview finished\./i.test(body)
+    && /CodeRabbit is an incremental review system/i.test(body)
+    && body.endsWith('</details>')
