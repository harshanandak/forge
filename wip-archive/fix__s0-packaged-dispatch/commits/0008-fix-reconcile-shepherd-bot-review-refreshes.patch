+
+/** Full exact heads only; abbreviated or non-hex tokens cannot clear a review. */
+function isFullHeadOid(headOid) {
+  return /^[0-9a-f]{40}$/i.test(String(headOid || ''));
+}
+
+/** True when a Qodo finding summary is not explicitly struck and resolved. Parse
+ * one summary line at a time; a negative-lookahead regex can backtrack through
+ * whitespace and misclassify `<s>…</s> ✓ Resolved` historical findings. */
+function hasUnresolvedQodoFinding(body) {
+  const summaries = String(body || '').match(/<summary>\s*\d+\.[^\r\n]*/gi) || [];
+  return summaries.some((line) => /(?:🐞\s*Bug|Rule violation)/i.test(line)
+    && !/<s>[\s\S]*<\/s>\s*<code>✓ Resolved<\/code>/i.test(line));
+}
+
+/** Explicit contradiction markers that must defeat an otherwise-clean provider
+ * envelope. Keep this deliberately narrow so resolved historical findings in a
+ * Qodo summary do not create a permanent false block. */
+function hasExplicitActionableFinding(body) {
+  const text = String(body || '');
+  return /Actionable comments posted:\s*[1-9]\d*/i.test(text)
+    || /(?:^|\n)\s*(?:[-*]\s*)?(?:(?:critical|major|security|actionable)(?:\s+(?:finding|issue|bug))?|finding|bug|vulnerability)\s*:/im.test(text)
+    || hasUnresolvedQodoFinding(text);
+}
+
+/** CodeRabbit edits its review-command acknowledgement into this terminal
