--- /dev/null
+++ b/lib/commands/profile.js
@@ -0,0 +1,263 @@
+'use strict';
+
+/**
+ * `forge profile list|show|apply|create|save|dump|export|import|delete`
+ *
+ * One command flips a repo's whole operating regime. A profile is a named
+ * snapshot of the entire settings surface (`lib/settings-registry.js`); the
+ * verbs here are a thin, honest shell over `lib/settings-profiles.js`:
+ *
+ *  - `apply` writes through the canonical `.forge/config.yaml` and stores no
+ *    marker of its own, so the flip is a real config change, not a label.
+ *  - `show` DERIVES the answer by comparing resolved state to saved profiles;
+ *    a hand-tuned repo reads `custom` (with its nearest profile and drift).
+ *  - `dump` prints the fully-resolved regime, every setting, defaults included.
+ *  - `save` folds adjustments back into the active profile, or `--as <name>`
+ *    saves them as a new one. Doing neither leaves you honestly on `custom`.
+ *
+ * Profiles are per-user files under `<home>/.forge/profiles` (override the home
+ * with `FORGE_HOME`), so a regime exports, imports and travels across machines.
+ */
+
+const {
+  listProfiles,
+  readProfile,
+  profileExists,
+  writeProfile,
+  deleteProfile,
+  applyProfile,
+  deriveActiveProfile,
+  dumpRegime,
+  saveCurrentProfile,
+  exportProfile,
+  importProfile,
+} = require('../settings-profiles');
+const { listSettings, readOverrides } = require('../settings-registry');
+
+const SUBCOMMANDS = ['list', 'show', 'apply', 'create', 'save', 'dump', 'export', 'import', 'delete'];
+
+function usage() {
+  return [
+    'Usage: forge profile <subcommand>',
+    '  forge profile list                   Saved profiles, active one marked',
+    '  forge profile show                   Which regime this repo is actually in',
+    '  forge profile apply <name>           Flip the whole regime to <name>',
+    '  forge profile create <name>          Save the current regime as <name>',
+    '  forge profile save [--as <name>]     Fold adjustments back into a profile',
+    '  forge profile dump                   Print the fully-resolved regime',
+    '  forge profile export <name> <path>   Write a shareable profile bundle',
+    '  forge profile import <path>          Install a bundle on this machine',
+    '  forge profile delete <name>          Remove a user profile',
+    'Flags: --json, --as <name>, --force',
+  ].join('\n');
+}
+
+/**
+ * Split this command's own flags out of `args`. Global `forge` flag parsing is a
+ * closed set that does not know `--json`/`--as`, so they arrive here as raw
+ * tokens; the pre-parsed `flags` object is honored too (that is how tests and
+ * any future global parsing reach the same code path).
+ */
+function parseArgs(args = [], flags = {}) {
+  const positional = [];
+  const parsed = {
+    json: flags.json === true,
+    force: flags.force === true,
+    as: typeof flags.as === 'string' ? flags.as : null,
+  };
+  for (let i = 0; i < args.length; i += 1) {
+    const token = args[i];
+    if (token === '--json') parsed.json = true;
+    else if (token === '--force') parsed.force = true;
+    else if (token === '--as') {
+      if (i + 1 >= args.length) return { error: '--as requires a profile name.' };
+      parsed.as = args[i + 1];
+      i += 1;
+    } else if (token.startsWith('--as=')) parsed.as = token.slice('--as='.length);
+    else if (token.startsWith('-')) return { error: `Unknown flag '${token}'.` };
+    else positional.push(token);
+  }
+  return { parsed, positional };
+}
+
+function ok(output) {
+  return { success: true, output };
+}
+
+function fail(error) {
+  return { success: false, error };
+}
+
+function json(value) {
+  return ok(JSON.stringify(value, null, 2));
+}
+
+function renderList(profiles, active) {
+  const lines = [`Profiles (active: ${active}):`];
+  for (const profile of profiles) {
+    const marker = profile.name === active ? '*' : ' ';
+    lines.push(`${marker} ${profile.name.padEnd(16)} ${profile.source.padEnd(8)} ${profile.description}`);
+  }
+  if (active === 'custom') {
+    lines.push('', 'This repo matches no saved profile. `forge profile show` names the nearest one.');
+  }
+  return lines.join('\n');
+}
+
+function renderShow(derived) {
+  const lines = [`Active profile: ${derived.active}`];
+  if (derived.name === null) {
+    lines.push(`Nearest profile: ${derived.nearest === null ? '(none)' : derived.nearest}`);
+    const driftIds = Object.keys(derived.drift).sort();
+    lines.push(`Drift from nearest (${driftIds.length} setting${driftIds.length === 1 ? '' : 's'}):`);
+    for (const id of driftIds) {
+      lines.push(`  ${id}: ${JSON.stringify(derived.drift[id].from)} -> ${JSON.stringify(derived.drift[id].to)}`);
+    }
+    lines.push('', 'Save it with `forge profile save --as <name>`, or apply a profile to flip back.');
+  }
+  return lines.join('\n');
+}
+
+function renderDump(dumped) {
+  const groups = new Map();
+  for (const descriptor of listSettings()) {
+    if (!groups.has(descriptor.group)) groups.set(descriptor.group, []);
+    groups.get(descriptor.group).push(descriptor);
+  }
+  const lines = [`Resolved regime (profile: ${dumped.profile})`];
+  for (const [group, descriptors] of groups) {
+    lines.push('', `[${group}]`);
+    for (const descriptor of descriptors) {
+      const value = JSON.stringify(dumped.settings[descriptor.id]);
+      const marks = [];
+      if (Object.hasOwn(dumped.overrides, descriptor.id)) marks.push('set');
+      if (descriptor.locked) marks.push('locked');
+      lines.push(`  ${descriptor.id.padEnd(28)} ${value}${marks.length > 0 ? `  (${marks.join(', ')})` : ''}`);
+    }
+  }
+  return lines.join('\n');
+}
+
+function runList({ projectRoot, parsed }) {
+  const derived = deriveActiveProfile({ projectRoot });
+  const profiles = listProfiles();
+  if (parsed.json) return json({ active: derived.active, nearest: derived.nearest, profiles });
+  return ok(renderList(profiles, derived.active));
+}
+
+function runShow({ projectRoot, parsed }) {
+  const derived = deriveActiveProfile({ projectRoot });
+  if (parsed.json) {
+    return json({
+      active: derived.active,
+      name: derived.name,
+      nearest: derived.nearest,
+      drift: derived.drift,
+    });
+  }
+  return ok(renderShow(derived));
+}
+
+function runApply({ projectRoot, positional, parsed }) {
+  const name = positional[1];
+  if (!name) return fail(`Which profile? Pass a name.\n${usage()}`);
+  const result = applyProfile({ projectRoot, name });
+  if (parsed.json) return json(result);
+  const changed = result.changed.length;
+  const reset = result.reset.length;
+  return ok(`Applied profile '${result.name}' (${result.source}): ${changed} setting${changed === 1 ? '' : 's'} set, ${reset} reset to default.`);
+}
+
+function runCreate({ projectRoot, positional, parsed }) {
+  const name = positional[1];
+  if (!name) return fail(`Which name? Pass one.\n${usage()}`);
+  if (profileExists(name) && parsed.force !== true) {
+    return fail(`Profile '${name}' already exists. Re-run with --force to overwrite it.`);
+  }
+  const settings = readOverrides({ projectRoot });
+  const filePath = writeProfile(name, { settings, description: `Saved from this repo's regime.` });
+  if (parsed.json) return json({ name, path: filePath, settings });
+  const count = Object.keys(settings).length;
+  return ok(`Created profile '${name}' from the current regime (${count} setting${count === 1 ? '' : 's'} away from defaults).\n${filePath}`);
+}
+
+function runSave({ projectRoot, parsed }) {
+  const saved = parsed.as
+    ? saveCurrentProfile({ projectRoot, mode: 'new', name: parsed.as })
+    : saveCurrentProfile({ projectRoot, mode: 'update' });
+  if (parsed.json) return json(saved);
+  return ok(`Saved the current regime into profile '${saved.name}'.\n${saved.path}`);
+}
+
+function runDump({ projectRoot, parsed }) {
+  const dumped = dumpRegime({ projectRoot });
+  if (parsed.json) return json(dumped);
+  return ok(renderDump(dumped));
+}
+
+function runExport({ positional, parsed }) {
+  const name = positional[1];
+  const dest = positional[2];
+  if (!name) return fail(`Which profile? Pass a name.\n${usage()}`);
+  if (!dest) return fail(`Where to? Pass a destination path.\n${usage()}`);
+  const written = exportProfile(name, dest);
+  if (parsed.json) return json({ name, path: written });
+  return ok(`Exported profile '${name}' to ${written}`);
+}
+
+function runImport({ positional, parsed }) {
+  const src = positional[1];
+  if (!src) return fail(`Which bundle? Pass a path.\n${usage()}`);
+  const imported = importProfile(src, { name: parsed.as || undefined });
+  if (parsed.json) return json(imported);
+  return ok(`Imported profile '${imported.name}' to ${imported.path}`);
+}
+
+function runDelete({ positional, parsed }) {
+  const name = positional[1];
+  if (!name) return fail(`Which profile? Pass a name.\n${usage()}`);
+  if (!profileExists(name)) return fail(`Unknown profile '${name}'.`);
+  if (readProfile(name).source === 'builtin') {
+    return fail(`'${name}' is a builtin preset and cannot be deleted. Shadow it instead: forge profile create ${name} --force.`);
+  }
+  const removed = deleteProfile(name);
+  if (!removed) return fail(`Nothing to delete — no user profile named '${name}'.`);
+  if (parsed.json) return json({ name, deleted: true });
+  return ok(`Deleted user profile '${name}'.`);
+}
+
+const HANDLERS = {
+  list: runList,
+  show: runShow,
+  apply: runApply,
+  create: runCreate,
+  save: runSave,
+  dump: runDump,
+  export: runExport,
+  import: runImport,
+  delete: runDelete,
+};
+
+async function handler(args = [], flags = {}, projectRoot = process.cwd()) {
+  const { parsed, positional, error } = parseArgs(args, flags);
+  if (error) return fail(`${error}\n${usage()}`);
+
+  const subcommand = positional[0];
+  if (!subcommand) return fail(usage());
+  if (!Object.hasOwn(HANDLERS, subcommand)) {
+    return fail(`Unknown subcommand '${subcommand}'. Try: ${SUBCOMMANDS.join(', ')}.\n${usage()}`);
+  }
+
+  try {
+    return HANDLERS[subcommand]({ projectRoot, positional, parsed });
+  } catch (err) {
+    return fail(err?.message ?? String(err));
+  }
+}
+
+module.exports = {
+  name: 'profile',
+  description: 'Flip the repo between saved settings profiles (speed, strict, knowledge-base, or your own)',
+  usage: usage(),
+  handler,
+};
