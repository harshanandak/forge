diff --git a/test/commands/profile.test.js b/test/commands/profile.test.js
new file mode 100644
index 00000000..d6b698de
--- /dev/null
+++ b/test/commands/profile.test.js
@@ -0,0 +1,302 @@
+'use strict';
+
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { afterEach, beforeEach, describe, expect, test } = require('bun:test');
+
+const profileCommand = require('../../lib/commands/profile');
+const { resolveSettings, applySettings } = require('../../lib/settings-registry');
+
+const temps = [];
+let savedForgeHome;
+
+function makeDir(prefix) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), prefix));
+  temps.push(dir);
+  return dir;
+}
+
+function makeProject() {
+  const root = makeDir('forge-profile-cmd-');
+  fs.mkdirSync(path.join(root, '.forge'), { recursive: true });
+  return root;
+}
+
+/** Point the per-user profile store at a temp home so tests never touch ~/. */
+function useTempHome() {
+  const home = makeDir('forge-profile-home-');
+  process.env.FORGE_HOME = home;
+  return home;
+}
+
+beforeEach(() => {
+  savedForgeHome = process.env.FORGE_HOME;
+});
+
+afterEach(() => {
+  if (savedForgeHome === undefined) delete process.env.FORGE_HOME;
+  else process.env.FORGE_HOME = savedForgeHome;
+  for (const dir of temps.splice(0)) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+describe('forge profile — command surface', () => {
+  test('exports the command interface the registry requires', () => {
+    expect(profileCommand.name).toBe('profile');
+    expect(typeof profileCommand.description).toBe('string');
+    expect(typeof profileCommand.handler).toBe('function');
+    expect(profileCommand.usage).toContain('forge profile');
+  });
+
+  test('no subcommand prints usage rather than guessing', async () => {
+    const root = makeProject();
+    useTempHome();
+    const result = await profileCommand.handler([], {}, root);
+    expect(result.success).toBe(false);
+    expect(result.error).toContain('forge profile');
+  });
+
+  test('an unknown subcommand names the ones that exist', async () => {
+    const root = makeProject();
+    useTempHome();
+    const result = await profileCommand.handler(['frobnicate'], {}, root);
+    expect(result.success).toBe(false);
+    expect(result.error).toMatch(/list/);
+  });
+});
+
+describe('forge profile list', () => {
+  test('lists the three presets and marks the derived one', async () => {
+    const root = makeProject();
+    useTempHome();
+    await profileCommand.handler(['apply', 'speed'], {}, root);
+    const result = await profileCommand.handler(['list'], {}, root);
+    expect(result.success).toBe(true);
+    expect(result.output).toContain('speed');
+    expect(result.output).toContain('strict');
+    expect(result.output).toContain('knowledge-base');
+    expect(result.output).toMatch(/\*\s*speed|speed.*\(active\)/);
+  });
+
+  test('--json returns machine-readable profiles', async () => {
+    const root = makeProject();
+    useTempHome();
+    const result = await profileCommand.handler(['list'], { json: true }, root);
+    expect(result.success).toBe(true);
+    const parsed = JSON.parse(result.output);
+    expect(parsed.profiles.map(p => p.name)).toContain('strict');
+    expect(parsed.active).toBe('custom');
+  });
+});
+
+describe('forge profile apply', () => {
+  test('flips the regime and reports what changed', async () => {
+    const root = makeProject();
+    useTempHome();
+    const result = await profileCommand.handler(['apply', 'strict'], {}, root);
+    expect(result.success).toBe(true);
+    expect(result.output).toContain('strict');
+    expect(resolveSettings({ projectRoot: root }).protectedPaths).toContain('AGENTS.md');
+  });
+
+  test('a bad profile name is a clean error, not a stack trace', async () => {
+    const root = makeProject();
+    useTempHome();
+    const result = await profileCommand.handler(['apply', 'nope'], {}, root);
+    expect(result.success).toBe(false);
+    expect(result.error).toMatch(/unknown profile/i);
+  });
+
+  test('apply with no name asks for one', async () => {
+    const root = makeProject();
+    useTempHome();
+    const result = await profileCommand.handler(['apply'], {}, root);
+    expect(result.success).toBe(false);
+    expect(result.error).toMatch(/name/i);
+  });
+
+  test('two commands flip speed -> strict -> speed with zero hand-edits', async () => {
+    const root = makeProject();
+    useTempHome();
+    await profileCommand.handler(['apply', 'speed'], {}, root);
+    const first = fs.readFileSync(path.join(root, '.forge', 'config.yaml'), 'utf8');
+    await profileCommand.handler(['apply', 'strict'], {}, root);
+    await profileCommand.handler(['apply', 'speed'], {}, root);
+    expect(fs.readFileSync(path.join(root, '.forge', 'config.yaml'), 'utf8')).toBe(first);
+  });
+});
+
+describe('forge profile show', () => {
+  test('derives the active profile instead of reading a stored marker', async () => {
+    const root = makeProject();
+    useTempHome();
+    await profileCommand.handler(['apply', 'knowledge-base'], {}, root);
+    const result = await profileCommand.handler(['show'], {}, root);
+    expect(result.success).toBe(true);
+    expect(result.output).toContain('knowledge-base');
+  });
+
+  test('says custom after a hand-edit, and names the nearest profile', async () => {
+    const root = makeProject();
+    useTempHome();
+    await profileCommand.handler(['apply', 'strict'], {}, root);
+    applySettings({
+      projectRoot: root,
+      settings: { ...resolveSettings({ projectRoot: root }), 'gate.cite': false },
+    });
+    const result = await profileCommand.handler(['show'], { json: true }, root);
+    const parsed = JSON.parse(result.output);
+    expect(parsed.active).toBe('custom');
+    expect(parsed.nearest).toBe('strict');
+    expect(parsed.drift['gate.cite']).toEqual({ from: true, to: false });
+  });
+});
+
+describe('forge profile dump', () => {
+  test('prints the fully-resolved regime, every setting', async () => {
+    const root = makeProject();
+    useTempHome();
+    await profileCommand.handler(['apply', 'speed'], {}, root);
+    const result = await profileCommand.handler(['dump'], { json: true }, root);
+    const parsed = JSON.parse(result.output);
+    expect(parsed.profile).toBe('speed');
+    expect(parsed.settings['rail.tdd_intent']).toBe(false);
+    expect(parsed.settings['rail.secret_scan']).toBe(true);
+  });
+
+  test('the text form lists settings grouped and readable', async () => {
+    const root = makeProject();
+    useTempHome();
+    const result = await profileCommand.handler(['dump'], {}, root);
+    expect(result.success).toBe(true);
+    expect(result.output).toContain('rail.tdd_intent');
+    expect(result.output).toContain('protectedPaths');
+  });
+});
+
+describe('forge profile create / save', () => {
+  test('create snapshots the current regime under a new name', async () => {
+    const root = makeProject();
+    const home = useTempHome();
+    await profileCommand.handler(['apply', 'speed'], {}, root);
+    const result = await profileCommand.handler(['create', 'my-speed'], {}, root);
+    expect(result.success).toBe(true);
+    expect(fs.existsSync(path.join(home, '.forge', 'profiles', 'my-speed.yaml'))).toBe(true);
+    const shown = await profileCommand.handler(['show'], { json: true }, root);
+    expect(['speed', 'my-speed']).toContain(JSON.parse(shown.output).active);
+  });
+
+  test('create refuses to clobber an existing profile without --force', async () => {
+    const root = makeProject();
+    useTempHome();
+    await profileCommand.handler(['create', 'mine'], {}, root);
+    const again = await profileCommand.handler(['create', 'mine'], {}, root);
+    expect(again.success).toBe(false);
