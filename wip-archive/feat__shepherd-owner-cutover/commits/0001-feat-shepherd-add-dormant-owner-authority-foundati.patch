+		expect(await driver.queryAll('SELECT * FROM kernel_pr_watch_owners WHERE pr = 85')).toEqual([]);
+	});
+
+	test('a killed holder rolls back and the next process acquires', async () => {
+		const holder = await startKilledHolder(databasePath);
