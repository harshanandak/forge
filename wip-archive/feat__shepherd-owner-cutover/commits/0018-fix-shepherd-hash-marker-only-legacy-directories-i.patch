From 6bc004e95fc7c4d047cdd95b00e0f6a4b5d87c26 Mon Sep 17 00:00:00 2001
From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Wed, 26 Aug 2026 20:03:54 +0530
Subject: [PATCH] fix(shepherd): hash marker-only legacy directories in the
 cutover gate

An interrupted legacy cleanup can leave a directory holding nothing but a
generation or cleanup marker. The emptiness check ran before marker
discovery, so the marker reached neither the migration snapshot nor its
hash and the gate could complete as if no legacy lifecycle authority
existed. Enumerate markers first and keep marker-only directories in the
snapshot so they are hashed and fail closed as unmappable.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 lib/pr-monitor/reconcile-executor.js          | 15 ++++++++----
 .../reconcile-migration-gate.test.js          | 23 +++++++++++++++++++
 2 files changed, 33 insertions(+), 5 deletions(-)

diff --git a/lib/pr-monitor/reconcile-executor.js b/lib/pr-monitor/reconcile-executor.js
index c1198d2c..47adb517 100644
--- a/lib/pr-monitor/reconcile-executor.js
+++ b/lib/pr-monitor/reconcile-executor.js
@@ -667,11 +667,11 @@ function defaultReadLegacySnapshot(projectRoot, opts = {}) {
 			const snapshotRaw = readOptionalFile(path.join(dir, 'snapshot.json'));
 			const pidRaw = readOptionalFile(path.join(dir, 'watch.pid'));
 			const startedAtRaw = readOptionalFile(path.join(dir, 'watch.startedat'));
-			if (snapshotRaw == null && pidRaw == null && startedAtRaw == null) continue;
-			const sourcePrefix = `${candidate.label}/${directory.name}`;
-			sources.push({ path: `${sourcePrefix}/snapshot.json`, content: snapshotRaw });
-			sources.push({ path: `${sourcePrefix}/watch.pid`, content: pidRaw });
-			sources.push({ path: `${sourcePrefix}/watch.startedat`, content: startedAtRaw });
+			// Discover generation/cleanup markers BEFORE the emptiness check. An
+			// interrupted legacy cleanup can leave a directory holding nothing but a
+			// marker; skipping it would keep that marker out of the snapshot and its
+			// hash, letting the gate complete as if no legacy lifecycle authority
+			// existed and a new owner generation start beside an unresolved legacy one.
 			let markerFiles = [];
 			try {
 				markerFiles = readDirectory(dir, { withFileTypes: true })
@@ -680,6 +680,11 @@ function defaultReadLegacySnapshot(projectRoot, opts = {}) {
 			} catch (error) {
 				if (error?.code !== 'ENOENT') return { entries, sources, corrupt: true, unmappable };
 			}
+			if (snapshotRaw == null && pidRaw == null && startedAtRaw == null && markerFiles.length === 0) continue;
+			const sourcePrefix = `${candidate.label}/${directory.name}`;
+			sources.push({ path: `${sourcePrefix}/snapshot.json`, content: snapshotRaw });
+			sources.push({ path: `${sourcePrefix}/watch.pid`, content: pidRaw });
+			sources.push({ path: `${sourcePrefix}/watch.startedat`, content: startedAtRaw });
 			for (const marker of markerFiles) {
 				sources.push({ path: `${sourcePrefix}/${marker.name}`, content: readOptionalFile(path.join(dir, marker.name)) });
 			}
diff --git a/test/pr-monitor/reconcile-migration-gate.test.js b/test/pr-monitor/reconcile-migration-gate.test.js
index a61872b8..a680aec7 100644
--- a/test/pr-monitor/reconcile-migration-gate.test.js
+++ b/test/pr-monitor/reconcile-migration-gate.test.js
@@ -237,6 +237,29 @@ describe('one-release watcher authority migration gate', () => {
 		}
 	});
 
+	test('hashes a leftover generation marker in an otherwise empty legacy directory', () => {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-legacy-marker-only-'));
+		const gitCommonDir = path.join(root, '.git');
+		try {
+			const monitorDir = path.join(root, '.forge', 'pr-monitor', 'acme-repo-7');
+			fs.mkdirSync(monitorDir, { recursive: true });
+			const empty = defaultReadLegacySnapshot(root, { gitCommonDir, repo: 'acme/repo' });
+			expect(empty).toMatchObject({ corrupt: false, unmappable: false });
+
+			// An interrupted cleanup left only the generation marker behind. It still
+			// proves unresolved legacy lifecycle authority, so it must reach both the
+			// snapshot and its hash instead of being skipped as an empty directory.
+			fs.writeFileSync(path.join(monitorDir, 'watch.generation'), 'generation-a');
+			const value = defaultReadLegacySnapshot(root, { gitCommonDir, repo: 'acme/repo' });
+			expect(value.sources.some(source => source.path.endsWith('acme-repo-7/watch.generation'))).toBe(true);
+			expect(hashLegacySnapshot(value)).not.toBe(hashLegacySnapshot(empty));
+			// No parseable identity accompanies the marker, so the gate must fail closed.
+			expect(value.unmappable).toBe(true);
+		} finally {
+			fs.rmSync(root, { recursive: true, force: true });
+		}
+	});
+
 	test('assigns distinct stable hashes to each canonical migrated entry', async () => {
 		const legacy = snapshot([
 			entry('zeta/repo', 2, { pid: 102 }),
