From 5378cb9782e12585a01992a41a086d5591878145 Mon Sep 17 00:00:00 2001
From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Wed, 26 Aug 2026 20:01:09 +0530
Subject: [PATCH] fix(shepherd): recover terminal receipt before legacy release

A legacy watcher imported while its PR was open carries no terminal
receipt. If the PR later closed and the legacy process exited,
recheckLegacyBlocked released the row and the terminal receipt was lost:
the PR is absent from the open-PR listing, so no replacement watcher ever
records it. Re-read the on-disk legacy evidence, complete with the
recovered receipt, and fail closed when no single receipt is recoverable.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 lib/pr-monitor/reconcile-executor.js          | 36 ++++++++++++-
 ...reconcile-executor-owner-authority.test.js | 50 +++++++++++++++++++
 2 files changed, 84 insertions(+), 2 deletions(-)

diff --git a/lib/pr-monitor/reconcile-executor.js b/lib/pr-monitor/reconcile-executor.js
index 02aad08a..c1198d2c 100644
--- a/lib/pr-monitor/reconcile-executor.js
+++ b/lib/pr-monitor/reconcile-executor.js
@@ -266,6 +266,24 @@ async function bindSpawned(reservation, pr, s) {
 	}, s.options);
 }
 
+// Re-reads the on-disk legacy evidence for one blocked legacy row and returns the
+// terminal receipt the legacy watcher wrote after the migration snapshot was taken.
+// Ambiguous or unreadable evidence returns null so the caller fails closed.
+async function recoverLegacyTerminalReceipt(owner, s) {
+	let snapshot;
+	try { snapshot = await s.readLegacySnapshot(); } catch { return null; }
+	if (!snapshot || snapshot.corrupt === true) return null;
+	const repo = normalizeRepository(owner?.repo);
+	const pr = Number(owner?.pr);
+	if (!repo || !Number.isSafeInteger(pr) || pr <= 0) return null;
+	const receipts = new Set();
+	for (const entry of Array.isArray(snapshot.entries) ? snapshot.entries : []) {
+		if (normalizeRepository(entry?.repo) !== repo || Number(entry?.pr) !== pr) continue;
+		if (entry?.terminalReceiptId) receipts.add(String(entry.terminalReceiptId));
+	}
+	return receipts.size === 1 ? [...receipts][0] : null;
+}
+
 const ACTION_HANDLERS = {
 	async reserveWatcher(action, s) {
 		const result = await s.authority.reserveStarting(identity(action.pr), {
@@ -324,14 +342,27 @@ const ACTION_HANDLERS = {
 		}, s.options);
 	},
 	async recheckLegacyBlocked(action, s) {
-		const complete = action.providerState === 'terminal' && action.owner.terminalReceiptId;
+		const terminal = action.providerState === 'terminal';
+		// A legacy watcher imported while its PR was still open carries no terminal
+		// receipt. If the PR later reaches a terminal state and the legacy process
+		// exits, releasing the row plainly drops the terminal receipt on the floor:
+		// the PR is already absent from the open-PR listing, so no replacement watcher
+		// will ever record it. Recover the receipt the exiting legacy watcher wrote and
+		// complete instead; fail closed (leave the row blocked for the next pass) when
+		// no single unambiguous receipt can be recovered.
+		let terminalReceiptId = terminal ? action.owner.terminalReceiptId || null : null;
+		if (terminal && !terminalReceiptId) {
+			terminalReceiptId = await recoverLegacyTerminalReceipt(action.owner, s);
+			if (!terminalReceiptId) return { ok: false, reason: 'terminal_receipt_unrecovered' };
+		}
+		const complete = terminal && Boolean(terminalReceiptId);
 		return s.authority.recheckLegacyBlocked(identity(action.owner), {
 			generation: action.owner.generation,
 			legacyEvidenceHash: action.owner.legacyEvidenceHash,
 			pid: action.owner.watcherPid,
 			pidReuseProven: action.owner.watcherPidReuseProven === true,
 			action: complete ? 'complete' : 'release',
-			...(complete ? { terminalReceiptId: action.owner.terminalReceiptId } : {}),
+			...(complete ? { terminalReceiptId } : {}),
 		}, s.options);
 	},
 	async upsertPrRow(action, s) {
@@ -374,6 +405,7 @@ async function execute(actions, ctx = {}) {
 		broker: ctx.broker || null,
 		projectRoot: ctx.projectRoot,
 		gitCommonDir: ctx.gitCommonDir,
+		readLegacySnapshot: ctx.readLegacySnapshot || (() => defaultReadLegacySnapshot(ctx.projectRoot, ctx)),
 		now: ctx.now || (() => Date.now()),
 	};
 	let changed = false;
diff --git a/test/pr-monitor/reconcile-executor-owner-authority.test.js b/test/pr-monitor/reconcile-executor-owner-authority.test.js
index 700c947d..631297b2 100644
--- a/test/pr-monitor/reconcile-executor-owner-authority.test.js
+++ b/test/pr-monitor/reconcile-executor-owner-authority.test.js
@@ -290,4 +290,54 @@ describe('reconcile executor owner-row authority', () => {
 		expect(await execute([action], { authority })).toMatchObject({ ok: true, changed: true });
 		expect(attempts).toBe(2);
 	});
+
+	test('recovers the terminal receipt before releasing a blocked legacy owner', async () => {
+		const blocked = {
+			...RECORD, phase: 'blocked', blockReason: 'legacy_live_pid', controllerPid: null,
+			watcherPid: 44, heartbeatAt: null, terminalReceiptId: null,
+			legacyEvidenceHash: 'a'.repeat(64),
+		};
+		const action = { type: 'recheckLegacyBlocked', owner: blocked, providerState: 'terminal' };
+		const inputs = [];
+		const authority = {
+			recheckLegacyBlocked: async (_ctx, input) => {
+				inputs.push(input);
+				return { ok: true, changed: true, reason: input.action, record: null };
+			},
+		};
+
+		// The legacy watcher wrote its terminal receipt after the migration snapshot,
+		// so it is on disk even though the imported row never carried it.
+		const recovered = await execute([action], {
+			authority,
+			controllerPid: 12,
+			readLegacySnapshot: () => ({
+				corrupt: false,
+				entries: [{ repo: PR.repo, pr: PR.number, terminalReceiptId: 'receipt-late' }],
+				sources: [],
+			}),
+		});
+		expect(recovered).toMatchObject({ ok: true, changed: true });
+		expect(inputs).toHaveLength(1);
+		expect(inputs[0]).toMatchObject({ action: 'complete', terminalReceiptId: 'receipt-late' });
+
+		// No recoverable receipt must fail closed: the row stays blocked rather than
+		// being released with its terminal evidence silently lost.
+		inputs.length = 0;
+		const failedClosed = await execute([action], {
+			authority,
+			controllerPid: 12,
+			readLegacySnapshot: () => ({ corrupt: false, entries: [], sources: [] }),
+		});
+		expect(failedClosed).toMatchObject({ ok: false, changed: false });
+		expect(failedClosed.results[0].result).toMatchObject({ ok: false, reason: 'terminal_receipt_unrecovered' });
+		expect(inputs).toHaveLength(0);
+
+		// An open PR still releases the stale legacy row exactly as before.
+		const released = await execute([{ ...action, providerState: 'open' }], {
+			authority, controllerPid: 12, readLegacySnapshot: () => ({ corrupt: false, entries: [], sources: [] }),
+		});
+		expect(released).toMatchObject({ ok: true, changed: true });
+		expect(inputs[0]).toMatchObject({ action: 'release' });
+	});
 });
-- 
