+  test('BLOCKED-CHECKS beats an open thread (checks precede threads)', () => {
+    const out = computeVerdict({ ...cleanBase, mergeStateStatus: 'UNSTABLE', unresolvedThreadCount: 3 });
+    expect(out.verdict).toBe('BLOCKED-CHECKS');
+  });
+
