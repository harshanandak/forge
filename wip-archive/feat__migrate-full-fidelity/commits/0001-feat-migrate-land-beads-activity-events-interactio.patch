+    event_type: `beads.interaction.${kind}`,
+    idempotency_key: `beads-interaction:${source}`,
+    expected_revision: 0,
+    actor: interaction.actor || 'beads',
+    origin: 'beads_import',
+    payload_json: JSON.stringify({ kind, ...extra }),
+    created_at: createdAt,
