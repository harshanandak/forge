+// Serialize the Kernel `metadata` column for an imported issue, ALSO preserving the beads
+// `owner` when it is not already captured on created_by/assignee (otherwise it would be
+// silently dropped). owner primarily maps to the Kernel assignee; for an issue that carries a
+// DISTINCT explicit assignee AND author, the owner is retained here as metadata.beads_owner so
+// no field is lost. A raw (non-object) metadata blob that must coexist with beads_owner is
+// nested under metadata.beads_metadata rather than discarded.
+function serializeIssueMetadata(issue, resolved = {}) {
+  const base = serializeBeadsMetadata(issue.metadata);
+  let metadata = {};
+  let rawPreserved = null;
+  if (base !== null) {
+    try {
+      const parsed = JSON.parse(base);
+      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
+        metadata = parsed;
+      } else {
+        rawPreserved = base;
+      }
+    } catch (_error) { // NOSONAR S2486 — non-JSON metadata is preserved via beads_metadata below
+      rawPreserved = base;
+    }
+  }
+
+  const owner = typeof issue.owner === 'string' ? issue.owner.trim() : issue.owner;
+  const ownerCaptured = owner && (owner === resolved.createdBy || owner === resolved.assignee);
+  if (owner && !ownerCaptured) {
+    metadata.beads_owner = issue.owner;
+  }
+
+  if (rawPreserved !== null) {
+    if (Object.keys(metadata).length === 0) return rawPreserved;
+    metadata.beads_metadata = rawPreserved;
+  }
+  return Object.keys(metadata).length > 0 ? JSON.stringify(metadata) : null;
+}
