 function ensureWorkflowShellPolicy(selectedAgents, options = {}) {
   const shellPolicy = resolveWorkflowShellPolicy(selectedAgents, options);
 
-  if (shellPolicy.required && shellPolicy.platform === 'win32' && !shellPolicy.available) {
