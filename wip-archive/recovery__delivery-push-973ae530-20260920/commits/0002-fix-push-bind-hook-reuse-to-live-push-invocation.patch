+const PUSH_PROOF_SCHEMA_VERSION = 1;
+const PUSH_MODES = Object.freeze({
+	full: Object.freeze(['branch-protection', 'lint', 'tests']),
+	quick: Object.freeze(['branch-protection', 'lint']),
+});
 
