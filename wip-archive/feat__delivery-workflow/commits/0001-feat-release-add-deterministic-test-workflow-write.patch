+            echo "Non-PR event ($EVENT_NAME): full matrix always runs."
+            echo "os_sensitive=true" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          if ! changed="$(git diff --name-only "$BASE_SHA...$HEAD_SHA")"; then
