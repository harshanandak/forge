+            echo "OS-sensitive paths changed: running the full matrix."
+            echo "os_sensitive=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "No OS-sensitive paths changed: full matrix skipped on this PR."
+            echo "Cross-OS coverage on this PR still comes from Windows Smoke, macOS Smoke"
+            echo "and the windows-node22 Targeted PR Tests lane; the full matrix re-runs on"
+            echo "merge_group, on every push to master, and on the weekly schedule."
