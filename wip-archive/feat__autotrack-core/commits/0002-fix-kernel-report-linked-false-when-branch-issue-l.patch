From 9f803c54937163f6beadbe1c786323a39286d2eb Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Mon, 6 Jul 2026 18:39:50 +0530
Subject: [PATCH] fix(kernel): report linked:false when branch->issue link
 fails to persist
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ensureBackingIssue ignored linkBranchToIssue's null-on-failure return, so a
transient registerWorktree throw left the branch unlinked while still
reporting success — silently breaking the idempotency guarantee (next call
re-creates a duplicate). Now both call sites capture the result and report
`linked` honestly; a test locks linked:false when the link write throws.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 lib/kernel/backing-issue.js       | 12 ++++++++----
 test/kernel/backing-issue.test.js | 18 ++++++++++++++++++
 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/lib/kernel/backing-issue.js b/lib/kernel/backing-issue.js
index 665848ba..39793542 100644
--- a/lib/kernel/backing-issue.js
+++ b/lib/kernel/backing-issue.js
@@ -264,8 +264,12 @@ async function ensureBackingIssue(options = {}) {
         entity = null;
       }
       if (entity) {
-        linkBranchToIssue(driver, { ...linkParams, issueId: encodedId });
-        return { issueId: encodedId, branch, created: false, existed: true, linked: true };
+        // Report link persistence honestly: if registerWorktree failed (returns null),
+        // linked:false surfaces that the branch->issue link did NOT persist, so the
+        // idempotency guarantee is degraded (a later call may re-create) rather than
+        // silently claiming success. Callers/hooks can warn on linked:false.
+        const linked = linkBranchToIssue(driver, { ...linkParams, issueId: encodedId });
+        return { issueId: encodedId, branch, created: false, existed: true, linked: linked !== null };
       }
     }
 
@@ -280,8 +284,8 @@ async function ensureBackingIssue(options = {}) {
     );
     if (createResult && createResult.ok === false) return null;
 
-    linkBranchToIssue(driver, { ...linkParams, issueId });
-    return { issueId, branch, created: true, existed: false, label: AUTO_STUB_LABEL };
+    const linked = linkBranchToIssue(driver, { ...linkParams, issueId });
+    return { issueId, branch, created: true, existed: false, linked: linked !== null, label: AUTO_STUB_LABEL };
   } catch {
     // Best-effort: a hook must never be broken by tracking. Degrade to null.
     return null;
diff --git a/test/kernel/backing-issue.test.js b/test/kernel/backing-issue.test.js
index a050cd5f..c52a930d 100644
--- a/test/kernel/backing-issue.test.js
+++ b/test/kernel/backing-issue.test.js
@@ -174,6 +174,24 @@ describe('ensureBackingIssue', () => {
     expect(row.branch).toBe('feat/add-widget');
   }, TIMEOUT);
 
+  test('reports linked:false when the branch->issue link fails to persist (idempotency honesty)', async () => {
+    const k = makeFakeKernel();
+    // Stub creation succeeds, but the link write throws transiently.
+    k.driver.registerWorktree = () => { throw new Error('transient link failure'); };
+    const result = await ensureBackingIssue({
+      ...BASE,
+      branch: 'feat/add-widget',
+      driver: k.driver,
+      broker: k.broker,
+      generateId: () => 'issue-4',
+    });
+    // Never throws; the stub was created + returned, but the failed link is reported
+    // honestly (linked:false) rather than a false success that hides a future duplicate.
+    expect(result).not.toBeNull();
+    expect(result.created).toBe(true);
+    expect(result.linked).toBe(false);
+  }, TIMEOUT);
+
   test('dedupes to an existing issue encoded in the branch name instead of creating a stub', async () => {
     const k = makeFakeKernel();
     k.issues.set('kap-7', { id: 'kap-7', labels: [] });
-- 
