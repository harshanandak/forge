index d090fa42..a6292775 100644
--- a/test/npm-publish-workflow.test.js
+++ b/test/npm-publish-workflow.test.js
@@ -15,6 +15,7 @@ const {
 const {
 	PROTECTED_STATE_AUDIT_LOG,
 } = require('../lib/protected-state-surfaces');
