+++ b/lib/npm-publish-workflow.js
@@ -9,8 +9,7 @@ const {
 	writeProtectedFile,
 } = require('./protected-state-surfaces');
 const {
-	NPM_WORKFLOW_SOURCE_COMMAND,
-	issueProtectedStateAuthorization,
+	issueNpmPublishWorkflowAuthorization,
 } = require('./protected-state-authority');
 
 const NPM_PUBLISH_WORKFLOW_PATH = '.github/workflows/npm-publish.yml';
@@ -181,7 +180,7 @@ async function generateNpmPublishWorkflow(projectRoot, options = {}) {
 	const actor = options.actor || options.env?.FORGE_ACTOR || process.env.FORGE_ACTOR || process.env.USER || process.env.USERNAME || 'unknown';
 	const protectedWriter = options.writeProtectedFile || writeProtectedFile;
 	const auditWriter = options.recordProtectedStateAuditEvent || recordProtectedStateAuditEvent;
-	const authorizationWriter = options.issueProtectedStateAuthorization || issueProtectedStateAuthorization;
+	const authorizationWriter = options.issueNpmPublishWorkflowAuthorization || issueNpmPublishWorkflowAuthorization;
 	const snapshot = snapshotWorkflow(projectRoot);
 	const writeOptions = {
 		actor,
@@ -229,14 +228,11 @@ async function generateNpmPublishWorkflow(projectRoot, options = {}) {
 
 	let trustedAuthorization;
 	try {
-		trustedAuthorization = await authorizationWriter(projectRoot, {
-			actor,
-			surface: 'workflows',
-			path: NPM_PUBLISH_WORKFLOW_PATH,
-			content,
-			operation: 'generate_npm_workflow',
-			sourceCommand: NPM_WORKFLOW_SOURCE_COMMAND,
-		}, { deps: options.kernelDeps });
+		trustedAuthorization = await authorizationWriter(
+			projectRoot,
+			{ actor },
+			{ deps: options.kernelDeps },
+		);
 	} catch (error) {
 		trustedAuthorization = { success: false, error: error.message };
 	}
diff --git a/lib/protected-state-authority.js b/lib/protected-state-authority.js
index f1168b85..07f4ec19 100644
--- a/lib/protected-state-authority.js
+++ b/lib/protected-state-authority.js
@@ -212,6 +212,21 @@ async function issueProtectedStateAuthorization(projectRoot, request = {}, optio
 	}
 }
 
+async function issueNpmPublishWorkflowAuthorization(projectRoot, params = {}, options = {}) {
+	const {
+		NPM_PUBLISH_WORKFLOW_PATH,
+		renderNpmPublishWorkflow,
+	} = require('./npm-publish-workflow');
+	return issueProtectedStateAuthorization(projectRoot, {
+		actor: params.actor,
+		surface: 'workflows',
+		path: NPM_PUBLISH_WORKFLOW_PATH,
+		content: renderNpmPublishWorkflow(),
+		operation: 'generate_npm_workflow',
+		sourceCommand: NPM_WORKFLOW_SOURCE_COMMAND,
+	}, options);
+}
+
 async function authorizeAndConsumeProtectedStateWrites(projectRoot, requests = [], options = {}) {
 	if (requests.length === 0) return { success: true, decisions: [] };
 	const worktreeScope = options.worktreeScope || resolveWorktreeScope(projectRoot);
@@ -273,11 +288,10 @@ module.exports = {
 	PROTECTED_STATE_ENTITY_TYPE,
 	PROTECTED_STATE_AUTHORIZATION_ISSUED,
 	PROTECTED_STATE_AUTHORIZATION_CONSUMED,
-	NPM_WORKFLOW_SOURCE_COMMAND,
 	resolveWorktreeScope,
 	authorizationEntityId,
 	parseAuthorizationEvent,
 	evaluateAuthorization,
-	issueProtectedStateAuthorization,
+	issueNpmPublishWorkflowAuthorization,
 	authorizeAndConsumeProtectedStateWrites,
 };
