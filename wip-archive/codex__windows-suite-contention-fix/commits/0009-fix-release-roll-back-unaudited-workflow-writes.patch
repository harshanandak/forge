From d6877d363c7b485fc6fcf0f3965c2a38d24a6dc7 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Sat, 8 Aug 2026 16:19:57 +0530
Subject: [PATCH] fix(release): roll back unaudited workflow writes

---
 lib/npm-publish-workflow.js       | 64 +++++++++++++++++++++++++++----
 test/npm-publish-workflow.test.js | 46 ++++++++++++++++++++++
 2 files changed, 103 insertions(+), 7 deletions(-)

diff --git a/lib/npm-publish-workflow.js b/lib/npm-publish-workflow.js
index 1e8a5ceb..abb5a98c 100644
--- a/lib/npm-publish-workflow.js
+++ b/lib/npm-publish-workflow.js
@@ -1,5 +1,8 @@
 'use strict';
 
+const fs = require('node:fs');
+const path = require('node:path');
+
 const {
 	createProtectedStateAuthorization,
 	recordProtectedStateAuditEvent,
@@ -8,6 +11,38 @@ const {
 
 const NPM_PUBLISH_WORKFLOW_PATH = '.github/workflows/npm-publish.yml';
 
+function snapshotWorkflow(projectRoot) {
+	const fullPath = path.resolve(projectRoot, NPM_PUBLISH_WORKFLOW_PATH);
+	try {
+		const stat = fs.lstatSync(fullPath);
+		return {
+			fullPath,
+			existed: true,
+			content: stat.isFile() ? fs.readFileSync(fullPath) : null,
+		};
+	} catch (error) {
+		if (error.code === 'ENOENT') return { fullPath, existed: false, content: null };
+		throw error;
+	}
+}
+
+function rollbackWorkflow(snapshot, projectRoot, protectedWriter, writeOptions) {
+	if (!snapshot.existed) {
+		fs.rmSync(snapshot.fullPath, { force: true });
+		return;
+	}
+	if (!Buffer.isBuffer(snapshot.content)) {
+		throw new Error('Previous workflow was not a regular file');
+	}
+	const restored = protectedWriter(
+		projectRoot,
+		NPM_PUBLISH_WORKFLOW_PATH,
+		snapshot.content,
+		writeOptions,
+	);
+	if (!restored.allowed) throw new Error(restored.reason || 'Protected workflow restore was denied');
+}
+
 function renderNpmPublishWorkflow() {
 	return `# Generated by \`forge release generate-npm-workflow\`. Do not edit directly.
 name: Bun Package
@@ -142,14 +177,16 @@ function generateNpmPublishWorkflow(projectRoot, options = {}) {
 	const actor = options.actor || options.env?.FORGE_ACTOR || process.env.FORGE_ACTOR || process.env.USER || process.env.USERNAME || 'unknown';
 	const protectedWriter = options.writeProtectedFile || writeProtectedFile;
 	const auditWriter = options.recordProtectedStateAuditEvent || recordProtectedStateAuditEvent;
+	const snapshot = snapshotWorkflow(projectRoot);
+	const writeOptions = {
+		actor,
+		operation: 'generate_npm_workflow',
+		viaForgeApi: true,
+		surface: 'workflows',
+	};
 	let write;
 	try {
-		write = protectedWriter(projectRoot, NPM_PUBLISH_WORKFLOW_PATH, content, {
-			actor,
-			operation: 'generate_npm_workflow',
-			viaForgeApi: true,
-			surface: 'workflows',
-		});
+		write = protectedWriter(projectRoot, NPM_PUBLISH_WORKFLOW_PATH, content, writeOptions);
 	} catch (error) {
 		return { success: false, error: error.message };
 	}
@@ -164,11 +201,24 @@ function generateNpmPublishWorkflow(projectRoot, options = {}) {
 		content,
 		operation: 'generate_npm_workflow',
 	});
-	const audit = auditWriter(authorization, { cwd: projectRoot });
+	let audit;
+	try {
+		audit = auditWriter(authorization, { cwd: projectRoot });
+	} catch (error) {
+		audit = { success: false, error: error.message };
+	}
 	if (!audit.success) {
+		let rollbackError;
+		try {
+			rollbackWorkflow(snapshot, projectRoot, protectedWriter, writeOptions);
+		} catch (error) {
+			rollbackError = error.message;
+		}
 		return {
 			success: false,
 			error: `Could not record protected-state authorization: ${audit.error}`,
+			audit,
+			rollbackError,
 		};
 	}
 
diff --git a/test/npm-publish-workflow.test.js b/test/npm-publish-workflow.test.js
index ef733c34..6ec270ab 100644
--- a/test/npm-publish-workflow.test.js
+++ b/test/npm-publish-workflow.test.js
@@ -180,6 +180,52 @@ describe('Forge-owned npm publish workflow', () => {
 		}
 	});
 
+	test('restores previous workflow bytes when authorization audit persistence fails', () => {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-npm-audit-failure-'));
+		const workflowPath = path.join(root, NPM_PUBLISH_WORKFLOW_PATH);
+		const previous = Buffer.from('previous workflow bytes\r\n', 'utf8');
+		try {
+			fs.mkdirSync(path.dirname(workflowPath), { recursive: true });
+			fs.writeFileSync(workflowPath, previous);
+			const result = generateNpmPublishWorkflow(root, {
+				actor: 'release-test',
+				recordProtectedStateAuditEvent: () => ({
+					success: false,
+					error: 'audit sink unavailable',
+				}),
+			});
+
+			expect(result).toMatchObject({
+				success: false,
+				error: 'Could not record protected-state authorization: audit sink unavailable',
+			});
+			expect(fs.readFileSync(workflowPath)).toEqual(previous);
+		} finally {
+			fs.rmSync(root, { recursive: true, force: true });
+		}
+	});
+
+	test('removes a newly created workflow when authorization audit persistence throws', () => {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-npm-audit-throw-'));
+		const workflowPath = path.join(root, NPM_PUBLISH_WORKFLOW_PATH);
+		try {
+			const result = generateNpmPublishWorkflow(root, {
+				actor: 'release-test',
+				recordProtectedStateAuditEvent: () => {
+					throw new Error('audit sink exploded');
+				},
+			});
+
+			expect(result).toMatchObject({
+				success: false,
+				error: 'Could not record protected-state authorization: audit sink exploded',
+			});
+			expect(fs.existsSync(workflowPath)).toBe(false);
+		} finally {
+			fs.rmSync(root, { recursive: true, force: true });
+		}
+	});
+
 	test('hook accepts exact generator evidence but denies raw edits and missing evidence', async () => {
 		const root = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-npm-hook-'));
 		const actor = 'release-hook-test';
-- 
