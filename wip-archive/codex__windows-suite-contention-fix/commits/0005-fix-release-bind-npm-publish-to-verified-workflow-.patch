+const NPM_PUBLISH_WORKFLOW_PATH = '.github/workflows/npm-publish.yml';
+
+function renderNpmPublishWorkflow() {
+	return `# Generated by \`forge release generate-npm-workflow\`. Do not edit directly.
+name: Bun Package
+
+on:
+  release:
+    types: [created]
+
+permissions:
+  contents: read
+
+jobs:
+  resolve-release:
+    name: Resolve immutable release SHA
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    outputs:
+      commitSha: \${{ steps.resolve.outputs.commitSha }}
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          ref: \${{ github.event.release.tag_name }}
+          fetch-depth: 0
+      - name: Resolve release tag
+        id: resolve
+        shell: bash
+        env:
+          RELEASE_TAG: \${{ github.event.release.tag_name }}
+        run: |
+          set -euo pipefail
+          COMMIT_SHA="$(git rev-parse "\${RELEASE_TAG}^{commit}")"
+          if [ -z "$COMMIT_SHA" ] || [ "$COMMIT_SHA" != "$(git rev-parse HEAD)" ]; then
+            echo "::error::Release tag did not resolve to the checked out commit"
+            exit 1
+          fi
+          echo "commitSha=$COMMIT_SHA" >> "$GITHUB_OUTPUT"
+
+  build:
+    needs: resolve-release
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    outputs:
+      commitSha: \${{ steps.evidence.outputs.commitSha }}
+      receipt: \${{ steps.evidence.outputs.receipt }}
+      receiptSubject: \${{ steps.evidence.outputs.receiptSubject }}
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          ref: \${{ needs.resolve-release.outputs.commitSha }}
+          fetch-depth: 1
+      - uses: actions/setup-node@v7
+        with:
+          node-version: 22
+      - uses: oven-sh/setup-bun@v2
+        with:
+          bun-version: 1.3.12
+      - run: bun install --frozen-lockfile
+      - name: Setup test fixtures
+        shell: bash
+        run: bash test-env/automation/setup-fixtures.sh --force
+      - name: Run complete release suite
+        shell: bash
+        run: |
+          set -euo pipefail
+          node scripts/test-full-suite.js --label-prefix release-full
+          bun test --timeout 15000 test-env/
+      - name: Emit attributable release suite receipt
+        id: evidence
+        shell: bash
+        env:
+          EXPECTED_SHA: \${{ needs.resolve-release.outputs.commitSha }}
+        run: |
+          set -euo pipefail
+          ACTUAL_SHA="$(git rev-parse HEAD)"
+          if [ -z "$EXPECTED_SHA" ] || [ "$EXPECTED_SHA" != "$ACTUAL_SHA" ]; then
+            echo "::error::Verification checkout SHA ($ACTUAL_SHA) != resolved release SHA ($EXPECTED_SHA)"
+            exit 1
+          fi
+          RECEIPT_SUBJECT="\${GITHUB_REPOSITORY}|\${GITHUB_WORKFLOW_REF}|\${GITHUB_RUN_ID}|\${GITHUB_RUN_ATTEMPT}|build|\${ACTUAL_SHA}|release-full|true"
+          RECEIPT="$(printf '%s' "$RECEIPT_SUBJECT" | sha256sum | awk '{print $1}')"
+          echo "commitSha=$ACTUAL_SHA" >> "$GITHUB_OUTPUT"
+          echo "receipt=$RECEIPT" >> "$GITHUB_OUTPUT"
+          echo "receiptSubject=$RECEIPT_SUBJECT" >> "$GITHUB_OUTPUT"
+
+  publish-npm:
+    needs: [resolve-release, build]
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      id-token: write
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          ref: \${{ needs.resolve-release.outputs.commitSha }}
+          fetch-depth: 1
+      - name: Verify exact release suite receipt
+        shell: bash
+        env:
+          EXPECTED_SHA: \${{ needs.resolve-release.outputs.commitSha }}
+          VERIFIED_SHA: \${{ needs.build.outputs.commitSha }}
+          RECEIPT: \${{ needs.build.outputs.receipt }}
+          RECEIPT_SUBJECT: \${{ needs.build.outputs.receiptSubject }}
+        run: |
+          set -euo pipefail
+          for field in EXPECTED_SHA VERIFIED_SHA RECEIPT RECEIPT_SUBJECT; do
+            if [ -z "\${!field}" ]; then
+              echo "::error::Missing release suite evidence field: $field"
+              exit 1
+            fi
+          done
+          ACTUAL_SHA="$(git rev-parse HEAD)"
+          if [ "$EXPECTED_SHA" != "$VERIFIED_SHA" ] || [ "$EXPECTED_SHA" != "$ACTUAL_SHA" ]; then
+            echo "::error::Publish checkout SHA ($ACTUAL_SHA) or verified SHA ($VERIFIED_SHA) != resolved release SHA ($EXPECTED_SHA)"
+            exit 1
+          fi
+          EXPECTED_SUBJECT="\${GITHUB_REPOSITORY}|\${GITHUB_WORKFLOW_REF}|\${GITHUB_RUN_ID}|\${GITHUB_RUN_ATTEMPT}|build|\${EXPECTED_SHA}|release-full|true"
+          EXPECTED_RECEIPT="$(printf '%s' "$EXPECTED_SUBJECT" | sha256sum | awk '{print $1}')"
+          if [ "$RECEIPT_SUBJECT" != "$EXPECTED_SUBJECT" ] || [ "$RECEIPT" != "$EXPECTED_RECEIPT" ]; then
+            echo "::error::Release suite receipt mismatch"
+            exit 1
+          fi
+      - uses: oven-sh/setup-bun@v2
+        with:
+          bun-version: 1.3.12
+      - uses: actions/setup-node@v7
+        with:
+          node-version: 22
+          registry-url: https://registry.npmjs.org/
+      - run: bun install --frozen-lockfile
+      - name: Release tag matches package.json version
+        shell: bash
+        run: |
+          set -euo pipefail
+          PKG="$(node -p "require('./package.json').version")"
+          TAG="\${GITHUB_REF_NAME#v}"
+          if [ "$PKG" != "$TAG" ]; then
+            echo "::error::Release tag ($TAG) != package.json version ($PKG). Bump package.json before releasing."
+            exit 1
+          fi
+      - name: Release-readiness gate
+        run: node bin/forge.js release check --target "$(node -p "require('./package.json').version.split('-')[0]")"
+      - name: Verify package contents
+        run: npm pack --dry-run
+      - name: Ensure OIDC-capable npm
+        run: npm install -g npm@latest && npm --version
+      - name: Publish to npm
+        shell: bash
+        run: |
+          set -euo pipefail
+          VERSION="$(node -p "require('./package.json').version")"
+          if echo "$VERSION" | grep -q '-'; then
+            echo "Prerelease $VERSION -> publishing under the beta dist-tag"
+            npm publish --provenance --tag beta
+          else
+            npm publish --provenance
+          fi
+`;
+}
+
+function generateNpmPublishWorkflow(projectRoot, options = {}) {
+	const content = renderNpmPublishWorkflow();
+	const actor = options.actor || options.env?.FORGE_ACTOR || process.env.FORGE_ACTOR || process.env.USER || process.env.USERNAME || 'unknown';
+	const authorization = createProtectedStateAuthorization({
+		actor,
+		surface: 'workflows',
+		path: NPM_PUBLISH_WORKFLOW_PATH,
+		content,
+		operation: 'generate_npm_workflow',
+	});
+	const audit = recordProtectedStateAuditEvent(authorization, { cwd: projectRoot });
+	if (!audit.success) {
+		return {
+			success: false,
+			error: `Could not record protected-state authorization: ${audit.error}`,
+		};
+	}
+
+	const write = writeProtectedFile(projectRoot, NPM_PUBLISH_WORKFLOW_PATH, content, {
+		actor,
+		operation: 'generate_npm_workflow',
+		viaForgeApi: true,
+		surface: 'workflows',
+	});
+	if (!write.allowed) {
+		return { success: false, error: write.reason, write, audit };
+	}
+
+	return { success: true, path: NPM_PUBLISH_WORKFLOW_PATH, contentHash: write.contentHash, write, audit };
+}
+
+module.exports = {
+	NPM_PUBLISH_WORKFLOW_PATH,
+	renderNpmPublishWorkflow,
+	generateNpmPublishWorkflow,
+};
diff --git a/lib/protected-state-surfaces.js b/lib/protected-state-surfaces.js
index e382e82c..b409e772 100644
--- a/lib/protected-state-surfaces.js
+++ b/lib/protected-state-surfaces.js
