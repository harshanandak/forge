 const fs = require('node:fs');
 const path = require('node:path');
+const crypto = require('node:crypto');
 const { redact } = require('./audit-evidence');
 const { appendCappedJsonlRecord } = require('./capped-jsonl-log');
 
@@ -19,6 +20,71 @@ function normalizeRepoPath(filePath) {
 		.replace(/\/+/g, '/');
 }
 
+function hashProtectedContent(content) {
+	const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');
+	return `sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}`;
+}
+
+function createProtectedStateAuthorization({ actor, surface, path: filePath, content, operation = 'generate' }) {
+	if (!actor || !surface || !filePath || content === undefined) {
+		throw new TypeError('Protected state authorization requires actor, surface, path, and content');
+	}
+
+	return {
+		kind: 'protected_state_write',
+		actor,
+		path: normalizeRepoPath(filePath),
+		decision: 'allowed',
+		requiredSurface: surface,
+		declaredSurface: surface,
+		operation,
+		contentHash: hashProtectedContent(content),
+		reason: `Forge API generated content for protected surface: ${surface}.`,
+		repairHint: null,
+	};
+}
+
+function verifyProtectedStateAuthorization(request, records = []) {
+	const expected = createProtectedStateAuthorization(request);
+	const matched = [...records].reverse().find(record =>
+		record?.decision === 'allowed' &&
+		record.actor === expected.actor &&
+		record.requiredSurface === expected.requiredSurface &&
+		record.declaredSurface === expected.declaredSurface &&
+		normalizeRepoPath(record.path) === expected.path &&
+		record.contentHash === expected.contentHash,
+	);
+
+	if (!matched) {
+		return {
+			allowed: false,
+			decision: 'blocked',
+			actor: expected.actor,
+			path: expected.path,
+			operation: request.operation || 'staged_edit',
+			requiredSurface: expected.requiredSurface,
+			declaredSurface: expected.declaredSurface,
+			contentHash: expected.contentHash,
+			reason: 'No matching content-bound authorization record exists for this actor, surface, path, and content hash.',
+			repairHint: 'Regenerate the protected file through its owning Forge command, then stage that exact output.',
+		};
+	}
+
+	return {
+		allowed: true,
+		decision: 'allowed',
+		actor: expected.actor,
+		path: expected.path,
+		operation: request.operation || 'staged_edit',
+		requiredSurface: expected.requiredSurface,
+		declaredSurface: expected.declaredSurface,
+		contentHash: expected.contentHash,
+		authorization: matched,
+		reason: 'Staged content matches its Forge-owned protected-state authorization record.',
+		repairHint: null,
+	};
+}
+
 function startsWithAny(filePath, prefixes) {
 	return prefixes.some(prefix => filePath === prefix || filePath.startsWith(`${prefix}/`));
 }
