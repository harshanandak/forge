+      }
+      const head = spawnSync('git', ['rev-parse', 'HEAD'], { cwd: root, encoding: 'utf8' }).stdout.trim();
+      const result = spawnSync(process.execPath, [
+        FORGE_BIN, 'skill', 'eval', 'demo', '--full', '--tier', '30', '--json',
