+function readFlagValue(rest, flags, name) {
+  const direct = flags[name] ?? flags[`--${name}`];
+  if (direct !== undefined && direct !== true) return direct;
+  const exact = rest.indexOf(`--${name}`);
+  if (exact >= 0) return rest[exact + 1];
+  const prefix = `--${name}=`;
+  const joined = rest.find(arg => typeof arg === 'string' && arg.startsWith(prefix));
+  return joined ? joined.slice(prefix.length) : undefined;
+}
+
+function hasFlag(rest, flags, name) {
+  return flags[name] === true || flags[`--${name}`] === true ||
+    rest.includes(`--${name}`) || rest.some(arg => typeof arg === 'string' && arg.startsWith(`--${name}=`));
+}
+
+async function handleFullEval(rest, flags, projectRoot, opts) {
+  const json = hasFlag(rest, flags, 'json');
+  const name = typeof rest[0] === 'string' && !rest[0].startsWith('--') ? rest[0] : undefined;
+  if (!name) return { success: false, error: 'Behavioral evaluation requires a skill name.\n' + USAGE };
+  const tierValue = readFlagValue(rest, flags, 'tier');
+  const tier = Number(tierValue);
+  if (!['30', '100', '300'].includes(String(tierValue))) {
+    return { success: false, error: 'Behavioral evaluation requires --tier 30|100|300.\n' + USAGE };
+  }
+
+  const ctx = skillEval.resolveSkillsContext(projectRoot);
+  if (!ctx || !fs.existsSync(path.join(ctx.skillsDir, name, 'SKILL.md'))) {
+    return { success: false, error: `Skill '${name}' not found.` };
+  }
+
+  const runner = opts.runBehavioralEvaluation || runBehavioralEvaluation;
+  const result = await runner({
+    ...(opts.behavioralOptions || {}),
+    projectRoot,
+    skillName: name,
+    tier,
+  });
+  const success = result.status === 'PASS';
+  const error = success ? undefined : `Behavioral evaluation ${result.status}.`;
+  const output = json
+    ? JSON.stringify(result, null, 2) + '\n'
+    : `Behavioral evaluation: ${result.status}\nTier: ${tier}\nCompleted: ${result.completedRuns}/${result.expectedRuns}`;
+  return { success, error, behavioral: result, output };
+}
+
 /**
  * "forge skill eval [name] --static [--json]" -- compute + persist the DETERMINISTIC scorecard(s).
- * All skills when no name. --static is the only tier today (behavioral is W5); it is accepted (and
- * implied) so the flag reads honestly and future tiers can branch here.
+ * All skills when no name. --static is accepted and implied; behavioral execution is isolated
+ * behind the explicit --full branch above so existing static scoring remains unchanged.
