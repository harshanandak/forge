@@ -97,14 +101,29 @@ function hasFlag(rest, flags, name) {
     rest.includes(`--${name}`) || rest.some(arg => typeof arg === 'string' && arg.startsWith(`--${name}=`));
 }
 
+function positionalArgs(rest, valueFlags = []) {
+  const positional = [];
+  for (let index = 0; index < rest.length; index += 1) {
+    const arg = rest[index];
+    if (typeof arg !== 'string') continue;
+    if (!arg.startsWith('--')) {
+      positional.push(arg);
+      continue;
+    }
+    const flagName = arg.slice(2).split('=', 1)[0];
+    if (valueFlags.includes(flagName) && !arg.includes('=')) index += 1;
+  }
+  return positional;
+}
