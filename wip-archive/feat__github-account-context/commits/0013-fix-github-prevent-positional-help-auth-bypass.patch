From 4dd43d42e01bd95b6809ceeb6c563f364b07891d Mon Sep 17 00:00:00 2001
From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Tue, 8 Sep 2026 23:20:04 +0530
Subject: [PATCH] fix(github): prevent positional help auth bypass

---
 lib/commands/_registry.js                     |  4 +--
 .../commands/_registry-github-context.test.js | 26 ++++++++++++++++++-
 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/lib/commands/_registry.js b/lib/commands/_registry.js
index c9596ba8..87b40343 100644
--- a/lib/commands/_registry.js
+++ b/lib/commands/_registry.js
@@ -14,7 +14,6 @@ const path = require('node:path');
 const { normalizeStageId } = require('../workflow/stages');
 const { ensureForgeHome, isMutatingVerb } = require('../activation/ensure-forge-home');
 const { createGithubContext } = require('../github-context');
-const { firstPositionalIndex } = require('../global-flags');
 
 // Static command manifest (bundleable fast path). This is a static require so
 // `bun build --compile` can bundle the command graph; the file is generated by
@@ -185,8 +184,7 @@ function isHelpInvocation(args, flags) {
   // Child arguments belong to the launcher, including its help flags.
   const delimiter = args.indexOf('--');
   const ownArgs = delimiter === -1 ? args : args.slice(0, delimiter);
-  return ownArgs.includes('--help') || ownArgs.includes('-h') ||
-    ownArgs[firstPositionalIndex(ownArgs)] === 'help';
+  return ownArgs.includes('--help') || ownArgs.includes('-h');
 }
 
 async function executeCommand(commands, commandName, args, flags, projectRoot, options = {}) {
diff --git a/test/commands/_registry-github-context.test.js b/test/commands/_registry-github-context.test.js
index 75764cef..134c41f1 100644
--- a/test/commands/_registry-github-context.test.js
+++ b/test/commands/_registry-github-context.test.js
@@ -65,12 +65,36 @@ describe('registry GitHub context', () => {
   });
 
   test.each([
-    [['--help'], {}], [['-h'], {}], [['help'], {}], [['--path', '/repo', 'help'], {}], [[], { help: true }], [[], { '--help': true }],
+    [['--help'], {}], [['-h'], {}], [['--path', '/repo', '--help'], {}], [[], { help: true }], [[], { '--help': true }], [[], { '-h': true }],
   ])('help bypasses predicate and preparation: %j', async (args, flags) => {
     const mod = command({ githubAuth: () => { throw new Error('predicate must not run'); } });
     expect((await execute(mod, args, flags, { prepareGithubContext: () => { throw new Error('must not prepare'); } })).success).toBe(true);
   });
 
+  test.each([[['help']], [['--path', '/repo', 'help']]])('positional help remains an operational ship invocation: %j', async args => {
+    const order = [];
+    const context = { bound: true };
+    const mod = command({ name: 'ship', githubAuth: true, handler: (_a, _f, _r, opts) => {
+      order.push('handler');
+      expect(opts.githubContext).toBe(context);
+      return { success: true };
+    } });
+    const result = await execute(mod, args, {}, {
+      prepareGithubContext: () => { order.push('context'); return context; },
+    });
+    expect(result.success).toBe(true);
+    expect(order).toEqual(['context', 'handler']);
+  });
+
+  test('positional help cannot bypass an account mismatch', async () => {
+    let entered = false;
+    const result = await execute(command({ name: 'ship', githubAuth: true, handler: () => { entered = true; } }), ['help'], {}, {
+      prepareGithubContext: () => { throw new GithubContextError('GITHUB_ACCOUNT_MISMATCH', 'mismatch'); },
+    });
+    expect(result.success).toBe(false);
+    expect(entered).toBe(false);
+  });
+
   test('child help after a delimiter is not a registry help bypass', async () => {
     let prepared = false;
     await execute(command({ githubAuth: true }), ['run', '--', 'program', '--help'], {}, {
-- 
