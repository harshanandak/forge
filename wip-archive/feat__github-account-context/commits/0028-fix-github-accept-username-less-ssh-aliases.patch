     ]) {
       const calls = [];
@@ -89,6 +90,7 @@ describe('merge command — mandatory release authority', () => {
     }
     for (const remote of [
       'C:/repo/Acme/Forge.git',
+      'C:Acme/Forge.git',
       '/repo/Acme/Forge.git',
       'file:///repo/Acme/Forge.git',
       'ssh:/Acme/Forge.git',
