From dfa4902bc5964160be73b37e0320fe21c6b08084 Mon Sep 17 00:00:00 2001
From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Tue, 8 Sep 2026 21:45:43 +0530
Subject: [PATCH] fix(github): close context secret boundary gaps

---
 lib/github-context.js       | 32 ++++++++++------
 test/github-context.test.js | 76 +++++++++++++++++++++++++++++++++----
 2 files changed, 90 insertions(+), 18 deletions(-)

diff --git a/lib/github-context.js b/lib/github-context.js
index eadcb326..233e4002 100644
--- a/lib/github-context.js
+++ b/lib/github-context.js
@@ -126,6 +126,10 @@ function selectedEnvironment(baseEnv, token, additions = {}) {
   return result;
 }
 
+function passthroughEnvironment(baseEnv, additions = {}) {
+  return { ...baseEnv, ...additions };
+}
+
 function retrieveGithubToken(login, options) {
   if (!validateGithubLogin(login)) {
     throw safeCommandFailure('INVALID_GITHUB_LOGIN', 'GitHub login must be 1-39 letters, numbers, or internal hyphens.');
@@ -191,45 +195,51 @@ function createPublicContext(status, token, baseEnv, options) {
     account: status.account,
     login: status.login,
   };
-  const childEnv = (additions = {}) => selectedEnvironment(baseEnv, token, additions);
-  const runGh = (args, runOptions = {}) => {
-    if (!Array.isArray(args) || args.some((arg) => typeof arg !== 'string')) {
+  const secrets = [token, ...Object.entries(baseEnv)
+    .filter(([key]) => GITHUB_ENV_NAMES.has(key.toLowerCase()))
+    .map(([, value]) => value)]
+    .filter((value) => typeof value === 'string' && value);
+  const runChild = (command, args, runOptions = {}) => {
+    if (typeof command !== 'string' || !Array.isArray(args) || args.some((arg) => typeof arg !== 'string')) {
       throw safeCommandFailure('INVALID_GH_ARGUMENTS', 'GitHub CLI arguments must be an array of strings.');
     }
     try {
-      const output = runnerFor(options)('gh', args, {
+      const output = runnerFor(options)(command, args, {
         ...runOptions,
-        env: childEnv(runOptions.env),
+        env: status.state === 'unbound'
+          ? passthroughEnvironment(baseEnv, runOptions.env)
+          : selectedEnvironment(baseEnv, token, runOptions.env),
         encoding: 'utf8',
         stdio: ['ignore', 'pipe', 'pipe'],
         windowsHide: true,
       });
-      return redactToken(output, token);
+      return redactTokens(output, secrets);
     } catch (_error) {
       throw safeCommandFailure('GITHUB_COMMAND_FAILED', 'The GitHub CLI command failed without exposing its output.');
     }
   };
+  const runGh = (args, runOptions = {}) => runChild('gh', args, runOptions);
   Object.defineProperties(context, {
-    buildChildEnv: { value: childEnv, enumerable: false },
+    runChild: { value: runChild, enumerable: false },
     runGh: { value: runGh, enumerable: false },
     getStatus: { value: () => ({ ...status }), enumerable: false },
   });
   return context;
 }
 
-function redactToken(value, token) {
+function redactTokens(value, tokens) {
   if (value == null) return value;
-  return value.toString().split(token).join('[REDACTED]');
+  return tokens.reduce((redacted, token) => redacted.split(token).join('[REDACTED]'), value.toString());
 }
 
 function createGithubContext(projectRoot, options = {}) {
+  const baseEnv = { ...(options.baseEnv || options.env || process.env) };
   const account = readGithubAccount(projectRoot, options);
-  if (!account) return createPublicContext(publicStatus('unbound', null, null), null, {}, options);
+  if (!account) return createPublicContext(publicStatus('unbound', null, null), null, baseEnv, options);
   if (!validateGithubLogin(account)) {
     throw safeCommandFailure('INVALID_GITHUB_LOGIN', 'The clone-local github.account value is not a valid GitHub login.');
   }
 
-  const baseEnv = { ...(options.baseEnv || options.env || process.env) };
   const token = retrieveGithubToken(account, { ...options, baseEnv });
   const login = resolveGithubLogin(token, baseEnv, options);
   if (login.toLowerCase() !== account.toLowerCase()) {
diff --git a/test/github-context.test.js b/test/github-context.test.js
index fca97d35..eec9652b 100644
--- a/test/github-context.test.js
+++ b/test/github-context.test.js
@@ -21,7 +21,7 @@ function fakeRunner(calls, { account = null, liveLogin = account, token = 'token
     if (command === 'git' && args[0] === 'config') return '';
     if (command === 'gh' && args[0] === 'auth') return `${token}\n`;
     if (command === 'gh' && args[0] === 'api') return `${liveLogin}\n`;
-    throw new Error(`unexpected ${command}`);
