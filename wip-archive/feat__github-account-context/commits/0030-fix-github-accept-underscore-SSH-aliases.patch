diff --git a/lib/commands/_registry.js b/lib/commands/_registry.js
index 87b40343..de371b66 100644
--- a/lib/commands/_registry.js
+++ b/lib/commands/_registry.js
@@ -187,6 +187,23 @@ function isHelpInvocation(args, flags) {
   return ownArgs.includes('--help') || ownArgs.includes('-h');
 }
 
+async function enforceCommandStage(options, commandName, args, flags, projectRoot, command) {
+  if (typeof options.enforceStage !== 'function' || !isStageCommand(commandName)) return null;
+  return options.enforceStage({ commandName, args, flags, projectRoot, command });
+}
+
+async function resolveCommandOptions(command, commandName, args, flags, projectRoot, options) {
+  const commandOpts = options.commandOpts ?? {};
+  if (!command.githubAuth || isHelpInvocation(args, flags)) return commandOpts;
+  const required = typeof command.githubAuth === 'function'
+    ? await command.githubAuth(args, flags, { commandName, projectRoot, command })
+    : command.githubAuth;
+  if (typeof required !== 'boolean') throw new TypeError('Invalid GitHub auth predicate result');
+  if (!required) return commandOpts;
+  const githubContext = await (options.prepareGithubContext || createGithubContext)(projectRoot);
+  return { ...commandOpts, githubContext };
+}
+
 async function executeCommand(commands, commandName, args, flags, projectRoot, options = {}) {
   const command = commands.get(commandName);
   if (!command) {
@@ -194,23 +211,13 @@ async function executeCommand(commands, commandName, args, flags, projectRoot, o
   }
 
   try {
-    let enforcement = null;
-    if (typeof options.enforceStage === 'function' && isStageCommand(commandName)) {
-      enforcement = await options.enforceStage({
-        commandName,
-        args,
-        flags,
-        projectRoot,
-        command,
-      });
-
-      if (enforcement?.allowed === false) {
-        return {
-          success: false,
-          error: enforcement.error ?? `Stage ${commandName} is blocked.`,
-          enforcement,
-        };
-      }
+    const enforcement = await enforceCommandStage(options, commandName, args, flags, projectRoot, command);
+    if (enforcement?.allowed === false) {
+      return {
+        success: false,
+        error: enforcement.error ?? `Stage ${commandName} is blocked.`,
+        enforcement,
+      };
     }
 
     // Lazy `.forge/` home (activation foundation): the FIRST mutating verb in a
@@ -230,24 +237,15 @@ async function executeCommand(commands, commandName, args, flags, projectRoot, o
     // alias handlers read it (shouldUseKernelBroker(opts)); other handlers ignore
     // it. Backward-compatible: defaults to {} so existing 3-arg handlers are
     // unaffected.
-    let commandOpts = options.commandOpts ?? {};
-    if (command.githubAuth && !isHelpInvocation(args, flags)) {
-      try {
-        const required = typeof command.githubAuth === 'function'
-          ? await command.githubAuth(args, flags, { commandName, projectRoot, command })
-          : command.githubAuth;
-        if (typeof required !== 'boolean') throw new TypeError('Invalid GitHub auth predicate result');
-        if (required) {
-          const githubContext = await (options.prepareGithubContext || createGithubContext)(projectRoot);
-          commandOpts = { ...commandOpts, githubContext };
-        }
-      } catch (_err) {
-        // Even injected errors can contain subprocess output or credentials.
-        return {
-          success: false,
-          error: 'Unable to verify this clone\'s GitHub account. Run forge github status for recovery.',
-        };
-      }
+    let commandOpts;
+    try {
+      commandOpts = await resolveCommandOptions(command, commandName, args, flags, projectRoot, options);
+    } catch {
+      // Even injected errors can contain subprocess output or credentials.
+      return {
+        success: false,
+        error: 'Unable to verify this clone\'s GitHub account. Run forge github status for recovery.',
+      };
     }
     const result = await command.handler(args, flags, projectRoot, commandOpts);
 
