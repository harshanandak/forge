--- /dev/null
+++ b/test/capabilities/executor.test.js
@@ -0,0 +1,60 @@
+'use strict';
+
+const { afterEach, describe, expect, test } = require('bun:test');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+
+const { executeHarnessProbe } = require('../../lib/capabilities/executor');
+
+const tempDirs = [];
+
+function makeExecutable(output) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'forge-capability-executor-'));
+  tempDirs.push(root);
+  if (process.platform === 'win32') {
+    const executable = path.join(root, 'forge-probe.cmd');
+    fs.writeFileSync(executable, `@echo off\r\necho ${output}\r\n`);
+    return { root, executable };
+  }
+  const executable = path.join(root, 'forge-probe');
+  fs.writeFileSync(executable, `#!/bin/sh\nprintf '%s\\n' '${output}'\n`, { mode: 0o755 });
+  return { root, executable };
+}
+
+function request() {
+  return {
+    command: 'forge-probe',
+    args: ['--version'],
+    maxOutputBytes: 1024,
+    timeoutMs: 1000,
+  };
+}
+
+afterEach(() => {
+  while (tempDirs.length > 0) fs.rmSync(tempDirs.pop(), { recursive: true, force: true });
+});
+
+describe('default harness probe executor', () => {
+  test('executes the resolved file without a shell string and binds identity to file contents', async () => {
+    const { root, executable } = makeExecutable('forge-probe 1.0.0');
+    const first = await executeHarnessProbe(request(), { env: { PATH: root } });
+    expect(first.exitCode).toBe(0);
+    expect(first.stdout).toContain('forge-probe 1.0.0');
+    expect(first.executableIdentity).toMatch(/^[0-9a-f]{64}$/);
+
+    if (process.platform === 'win32') {
+      fs.writeFileSync(executable, '@echo off\r\necho forge-probe 1.0.1\r\n');
+    } else {
+      fs.writeFileSync(executable, "#!/bin/sh\nprintf '%s\\n' 'forge-probe 1.0.1'\n", { mode: 0o755 });
+    }
+    const second = await executeHarnessProbe(request(), { env: { PATH: root } });
+    expect(second.exitCode).toBe(0);
+    expect(second.executableIdentity).not.toBe(first.executableIdentity);
+  });
+
+  test('reports an absent executable without starting a process', async () => {
+    const result = await executeHarnessProbe(request(), { env: { PATH: '' } });
+    expect(result).toEqual({ exitCode: null, stdout: '', stderr: '', errorCode: 'ENOENT' });
+  });
+});
