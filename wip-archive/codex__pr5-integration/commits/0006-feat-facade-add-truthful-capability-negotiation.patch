diff --git a/test/capabilities/delivery.test.js b/test/capabilities/delivery.test.js
new file mode 100644
index 00000000..90ccdd9d
--- /dev/null
+++ b/test/capabilities/delivery.test.js
@@ -0,0 +1,241 @@
+'use strict';
+
+const { describe, expect, test } = require('bun:test');
+
+const {
+  createHarnessDeliveryAdapter,
+  projectDeliveryTiers,
+} = require('../../lib/capabilities/delivery');
+
+function probeResult(available = []) {
+  return {
+    harness_id: 'codex',
+    result_hash: 'a'.repeat(64),
+    capabilities: [
+      'bounded_background_tasks',
+      'human_notification',
+      'initiating_agent_delivery',
+      'native_streaming_monitor',
+      'wake_resume',
+    ].map((id) => ({
+      id,
+      available: available.includes(id),
+      status: available.includes(id) ? 'AVAILABLE' : 'UNAVAILABLE',
+      reason: available.includes(id) ? 'PROBED_SUPPORTED' : 'PROBED_UNSUPPORTED',
+    })),
+  };
+}
+
+describe('capability-negotiated harness delivery', () => {
+  test('projects every tier and a bounded freedom envelope without overstating support', () => {
+    const tiers = projectDeliveryTiers(
+      probeResult(['initiating_agent_delivery', 'native_streaming_monitor']),
+      { T0: () => {}, T1: () => {}, T2: () => {} },
+    );
+
+    expect(tiers.map(({ id, available }) => [id, available])).toEqual([
+      ['T0', true],
+      ['T1', true],
+      ['T2', true],
+      ['T3', false],
+      ['T4', false],
+    ]);
+    for (const tier of tiers) {
+      expect(['deterministic', 'bounded-adaptive', 'agentic']).toContain(tier.freedom_envelope.mode);
+      expect(tier.freedom_envelope.allowed_actions.length).toBeGreaterThan(0);
+      expect(tier.freedom_envelope.forbidden_actions.length).toBeGreaterThan(0);
+      expect(tier.freedom_envelope.decision_points.length).toBeGreaterThan(0);
+      expect(tier.freedom_envelope.budgets).toEqual(expect.objectContaining({
+        time_ms: expect.any(Number),
+        token_count: expect.any(Number),
+        action_count: expect.any(Number),
+      }));
+      expect(Array.isArray(tier.freedom_envelope.approval_requirements)).toBe(true);
+      expect(tier.freedom_envelope.rollback_strategy).toBe('degrade_to_T0');
+      expect(tier.freedom_envelope.evidence_requirements).toContain('delivery_receipt');
+      expect(tier.freedom_envelope.escalation_conditions.length).toBeGreaterThan(0);
+    }
+  });
+
+  test('does not advertise durable pull without a registered durable handler', () => {
+    const tiers = projectDeliveryTiers(probeResult(['initiating_agent_delivery']));
+
+    expect(tiers.every((tier) => tier.available === false)).toBe(true);
+    expect(tiers.find(({ id }) => id === 'T0').reason).toBe('ADAPTER_UNAVAILABLE');
+  });
+
+  test('does not advertise native delivery without a registered durable handler', () => {
+    const tiers = projectDeliveryTiers(
+      probeResult(['initiating_agent_delivery']),
+      { T1: () => {} },
+    );
+
+    expect(tiers.find(({ id }) => id === 'T1')).toEqual(expect.objectContaining({
+      available: false,
+      status: 'UNAVAILABLE',
+      reason: 'DURABLE_HANDLER_UNAVAILABLE',
+    }));
+  });
+
+  test('does not claim T4 human notification from background-task delivery alone', () => {
+    const tiers = projectDeliveryTiers(probeResult([
+      'bounded_background_tasks',
+      'initiating_agent_delivery',
+    ]));
+
+    expect(tiers.find(({ id }) => id === 'T4')).toEqual(expect.objectContaining({
+      available: false,
+      status: 'UNAVAILABLE',
+    }));
+  });
+
+  test('persists through T0 before native delivery and degrades to the highest proven handler', async () => {
+    const calls = [];
+    const adapter = createHarnessDeliveryAdapter({
+      probeResult: probeResult(['initiating_agent_delivery']),
+      handlers: {
+        T0: async () => { calls.push('T0'); return { cursor: 7 }; },
+        T1: async () => { calls.push('T1'); return { acknowledged: true }; },
+        T2: async () => { calls.push('T2'); return { acknowledged: true }; },
+      },
+    });
+
+    const result = await adapter.deliver({ event_id: 'event-1' }, 'agent-1', { preferredTier: 'T2' });
+
+    expect(calls).toEqual(['T0', 'T1']);
+    expect(result).toEqual({
+      harness_id: 'codex',
+      tier: 'T1',
+      degraded_from: 'T2',
+      persistence: { cursor: 7 },
+      delivery: { acknowledged: true },
+    });
+  });
+
+  test('never invokes a native adapter when durable T0 persistence fails', async () => {
+    let nativeCalled = false;
+    const adapter = createHarnessDeliveryAdapter({
+      probeResult: probeResult(['initiating_agent_delivery', 'native_streaming_monitor']),
+      handlers: {
+        T0: async () => { throw new Error('store unavailable'); },
+        T2: async () => { nativeCalled = true; },
+      },
+    });
+
+    await expect(adapter.deliver({ event_id: 'event-1' }, 'agent-1')).rejects.toThrow('store unavailable');
+    expect(nativeCalled).toBe(false);
+  });
+
+  test('rejects an invalid delivery budget before invoking a handler', () => {
+    let called = false;
+
+    for (const timeoutMs of [0, -1, 1.5, 5001, Infinity]) {
+      expect(() => createHarnessDeliveryAdapter({
+        probeResult: probeResult(),
+        timeoutMs,
+        handlers: { T0: () => { called = true; } },
+      })).toThrow('timeoutMs must be an integer between 1 and 5000');
+    }
+    expect(called).toBe(false);
+  });
+
+  test('aborts timed-out durable persistence and never invokes native delivery', async () => {
+    let durableSignal;
+    let nativeCalled = false;
+    const adapter = createHarnessDeliveryAdapter({
+      probeResult: probeResult(['initiating_agent_delivery']),
+      timeoutMs: 10,
+      handlers: {
+        T0: async (_event, _target, { signal }) => {
+          durableSignal = signal;
+          await new Promise(() => {});
+        },
+        T1: async () => { nativeCalled = true; },
+      },
+    });
+
+    let error;
+    try {
+      await adapter.deliver({ event_id: 'event-1' }, 'agent-1', { preferredTier: 'T1' });
+    } catch (caught) {
+      error = caught;
+    }
+
+    expect(error).toEqual(expect.objectContaining({
+      code: 'DELIVERY_TIMEOUT',
+      evidence: expect.objectContaining({
+        status: 'INCOMPLETE',
+        tier: 'T0',
+        timeout_ms: expect.any(Number),
+        abort_requested: true,
+      }),
+    }));
+    expect(error.evidence.timeout_ms).toBeGreaterThan(0);
+    expect(error.evidence.timeout_ms).toBeLessThanOrEqual(10);
+    expect(durableSignal).toBeInstanceOf(AbortSignal);
+    expect(durableSignal.aborted).toBe(true);
+    expect(nativeCalled).toBe(false);
+  });
+
+  test('bounds native delivery within the total budget and preserves its durable receipt', async () => {
+    let nativeSignal;
+    const persistence = { cursor: 9 };
+    const adapter = createHarnessDeliveryAdapter({
+      probeResult: probeResult(['initiating_agent_delivery']),
+      timeoutMs: 10,
+      handlers: {
+        T0: async () => persistence,
+        T1: async (_event, _target, { signal }) => {
+          nativeSignal = signal;
+          await new Promise(() => {});
+        },
+      },
+    });
+
+    let error;
+    try {
+      await adapter.deliver({ event_id: 'event-1' }, 'agent-1', { preferredTier: 'T1' });
+    } catch (caught) {
+      error = caught;
+    }
+
+    expect(error).toEqual(expect.objectContaining({
+      code: 'DELIVERY_TIMEOUT',
+      evidence: expect.objectContaining({
+        status: 'INCOMPLETE',
+        tier: 'T1',
+        persistence,
+      }),
+    }));
+    expect(nativeSignal).toBeInstanceOf(AbortSignal);
+    expect(nativeSignal.aborted).toBe(true);
+  });
+
+  test('persists T0 then skips unapproved T4 for the highest eligible tier', async () => {
+    const calls = [];
+    const adapter = createHarnessDeliveryAdapter({
+      probeResult: probeResult(['human_notification', 'initiating_agent_delivery']),
+      handlers: {
+        T0: async () => { calls.push('T0'); return { cursor: 4 }; },
+        T1: async () => { calls.push('T1'); return { acknowledged: 'agent' }; },
+        T4: async () => { calls.push('T4'); return { acknowledged: true }; },
+      },
+    });
+
+    const degraded = await adapter.deliver({ event_id: 'event-1' }, 'human-1');
+    expect(calls).toEqual(['T0', 'T1']);
+    expect(degraded).toEqual({
+      harness_id: 'codex',
+      tier: 'T1',
+      degraded_from: 'T4',
+      persistence: { cursor: 4 },
+      delivery: { acknowledged: 'agent' },
+    });
+
+    const result = await adapter.deliver({ event_id: 'event-1' }, 'human-1', {
+      approvals: ['configured_human_notification_consent'],
+    });
+    expect(calls).toEqual(['T0', 'T1', 'T0', 'T4']);
+    expect(result.tier).toBe('T4');
+  });
+});
