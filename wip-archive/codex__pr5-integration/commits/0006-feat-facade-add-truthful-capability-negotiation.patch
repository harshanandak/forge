diff --git a/lib/capabilities/delivery.js b/lib/capabilities/delivery.js
new file mode 100644
index 00000000..8f338c89
--- /dev/null
+++ b/lib/capabilities/delivery.js
@@ -0,0 +1,190 @@
+'use strict';
+
+const MAX_DELIVERY_TIMEOUT_MS = 5000;
+
+const TIER_DEFINITIONS = Object.freeze([
+  Object.freeze({ id: 'T0', mode: 'deterministic', action: 'durable_pull', capabilities: [] }),
+  Object.freeze({ id: 'T1', mode: 'deterministic', action: 'next_turn_injection', capabilities: ['initiating_agent_delivery'] }),
+  Object.freeze({ id: 'T2', mode: 'bounded-adaptive', action: 'active_session_delivery', capabilities: ['native_streaming_monitor', 'initiating_agent_delivery'] }),
+  Object.freeze({ id: 'T3', mode: 'bounded-adaptive', action: 'resume_or_wake', capabilities: ['wake_resume'] }),
+  Object.freeze({ id: 'T4', mode: 'deterministic', action: 'human_notification', capabilities: ['human_notification'] }),
+]);
+
+const TIER_IDS = Object.freeze(TIER_DEFINITIONS.map(({ id }) => id));
+
+function freedomEnvelope(definition) {
+  return Object.freeze({
+    mode: definition.mode,
+    allowed_actions: Object.freeze([definition.action]),
+    forbidden_actions: Object.freeze([
+      'authoritative_state_mutation',
+      'unprobed_native_delivery',
+      'delivery_outside_declared_target',
+    ]),
+    decision_points: Object.freeze([
+      'capability_probe_result',
+      'preferred_delivery_tier',
+      'durable_persistence_result',
+    ]),
+    budgets: Object.freeze({ time_ms: MAX_DELIVERY_TIMEOUT_MS, token_count: 0, action_count: definition.id === 'T0' ? 1 : 2 }),
+    approval_requirements: Object.freeze(definition.id === 'T4' ? ['configured_human_notification_consent'] : []),
+    rollback_strategy: 'degrade_to_T0',
+    evidence_requirements: Object.freeze(['capability_probe_result_hash', 'delivery_receipt']),
+    escalation_conditions: Object.freeze([
+      'capability_unavailable',
+      'capability_incomplete',
+      'delivery_unacknowledged',
+    ]),
+  });
+}
+
+function projectCapabilityFreedom(capability) {
+  if (!capability || typeof capability.id !== 'string' || capability.id.length === 0) {
+    throw new TypeError('capability.id must be a non-empty string');
+  }
+  return freedomEnvelope({
+    id: 'CAPABILITY',
+    mode: 'deterministic',
+    action: capability.id,
+  });
+}
+
+function capabilityMap(probeResult) {
+  if (!probeResult || typeof probeResult !== 'object' || !Array.isArray(probeResult.capabilities)) {
+    throw new TypeError('probeResult must contain capabilities');
+  }
+  return new Map(probeResult.capabilities.map((capability) => [capability.id, capability]));
+}
+
+function projectDeliveryTiers(probeResult, handlers = {}) {
+  const capabilities = capabilityMap(probeResult);
+  const durableAvailable = typeof handlers.T0 === 'function';
+  return TIER_DEFINITIONS.map((definition) => {
+    const required = definition.capabilities.map((id) => capabilities.get(id));
+    const probeSupported = definition.id === 'T0'
+      || (required.length > 0 && required.every((capability) => capability?.available === true));
+    const adapterAvailable = typeof handlers[definition.id] === 'function';
+    const available = probeSupported && adapterAvailable && (definition.id === 'T0' || durableAvailable);
+    let reason = 'PROBED_SUPPORTED';
+    if (definition.id === 'T0' && adapterAvailable) reason = 'PORTABLE_DURABLE_PULL';
+    else if (definition.id === 'T0') reason = 'ADAPTER_UNAVAILABLE';
+    else if (probeSupported && !durableAvailable) reason = 'DURABLE_HANDLER_UNAVAILABLE';
+    else if (!probeSupported && required.some((capability) => capability?.status === 'INCOMPLETE')) reason = 'PROBE_INCOMPLETE';
+    else if (!probeSupported && required.some((capability) => capability?.reason === 'BEHAVIOR_UNVERIFIED')) reason = 'BEHAVIOR_UNVERIFIED';
+    else if (!probeSupported) reason = 'PROBED_UNSUPPORTED';
+    else if (!adapterAvailable) reason = 'ADAPTER_UNAVAILABLE';
+    return Object.freeze({
+      id: definition.id,
+      available,
+      status: available ? 'AVAILABLE' : 'UNAVAILABLE',
+      reason,
+      required_capabilities: Object.freeze([...definition.capabilities]),
+      freedom_envelope: freedomEnvelope(definition),
+    });
+  });
+}
+
+function assertHandler(handler, tier) {
+  if (typeof handler !== 'function') throw new TypeError(`${tier} delivery handler must be a function`);
+}
+
+function hasApprovals(tier, deliveryOptions) {
+  const approvals = Array.isArray(deliveryOptions.approvals) ? deliveryOptions.approvals : [];
+  return tier.freedom_envelope.approval_requirements.every((approval) => approvals.includes(approval));
+}
+
+function selectTier(tiers, handlers, preferredTier, deliveryOptions) {
+  const preferredIndex = TIER_IDS.indexOf(preferredTier);
+  if (preferredIndex === -1) throw new TypeError(`Unsupported delivery tier: ${preferredTier}`);
+  for (let index = preferredIndex; index >= 0; index -= 1) {
+    const id = TIER_IDS[index];
+    if (tiers[index].available && typeof handlers[id] === 'function' && hasApprovals(tiers[index], deliveryOptions)) {
+      return id;
+    }
+  }
+  return 'T0';
+}
+
+function assertTimeoutMs(timeoutMs) {
+  if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > MAX_DELIVERY_TIMEOUT_MS) {
+    throw new TypeError(`timeoutMs must be an integer between 1 and ${MAX_DELIVERY_TIMEOUT_MS}`);
+  }
+}
+
+function timeoutError(tier, timeoutMs, persistence, abortRequested) {
+  const error = new Error(`${tier} delivery timed out after ${timeoutMs}ms`);
+  error.code = 'DELIVERY_TIMEOUT';
+  error.evidence = Object.freeze({
+    status: 'INCOMPLETE',
+    reason: 'DELIVERY_TIMEOUT',
+    tier,
+    timeout_ms: timeoutMs,
+    abort_requested: abortRequested,
+    ...(persistence === undefined ? {} : { persistence }),
+  });
+  return error;
+}
+
+async function runBeforeDeadline(handler, event, target, tier, deadline, persistence) {
+  const remainingMs = deadline - Date.now();
+  if (remainingMs <= 0) throw timeoutError(tier, 0, persistence, false);
+
+  const controller = new AbortController();
+  let timer;
+  const timeout = new Promise((_resolve, reject) => {
+    timer = setTimeout(() => {
+      const error = timeoutError(tier, remainingMs, persistence, true);
+      controller.abort(error);
+      reject(error);
+    }, remainingMs);
+  });
+  try {
+    return await Promise.race([
+      Promise.resolve().then(() => handler(event, target, { signal: controller.signal })),
+      timeout,
+    ]);
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+function createHarnessDeliveryAdapter(options) {
+  if (!options || typeof options !== 'object') throw new TypeError('delivery adapter options are required');
+  const { probeResult, handlers = {} } = options;
+  assertHandler(handlers.T0, 'T0');
+  for (const [tier, handler] of Object.entries(handlers)) {
+    if (!TIER_IDS.includes(tier)) throw new TypeError(`Unsupported delivery tier: ${tier}`);
+    assertHandler(handler, tier);
+  }
+  const timeoutMs = options.timeoutMs ?? MAX_DELIVERY_TIMEOUT_MS;
+  assertTimeoutMs(timeoutMs);
+  const tiers = projectDeliveryTiers(probeResult, handlers);
+  return Object.freeze({
+    harness_id: probeResult.harness_id,
+    tiers,
+    async deliver(event, target, deliveryOptions = {}) {
+      const preferredTier = deliveryOptions.preferredTier ?? 'T4';
+      const tier = selectTier(tiers, handlers, preferredTier, deliveryOptions);
+      const deadline = Date.now() + timeoutMs;
+      const persistence = await runBeforeDeadline(handlers.T0, event, target, 'T0', deadline);
+      const delivery = tier === 'T0'
+        ? persistence
+        : await runBeforeDeadline(handlers[tier], event, target, tier, deadline, persistence);
+      return Object.freeze({
+        harness_id: probeResult.harness_id,
+        tier,
+        degraded_from: tier === preferredTier ? null : preferredTier,
+        persistence,
+        delivery,
+      });
+    },
+  });
+}
+
+module.exports = {
+  TIER_DEFINITIONS,
+  TIER_IDS,
+  createHarnessDeliveryAdapter,
+  projectCapabilityFreedom,
+  projectDeliveryTiers,
+};
diff --git a/lib/capabilities/executor.js b/lib/capabilities/executor.js
new file mode 100644
index 00000000..e84e4185
--- /dev/null
+++ b/lib/capabilities/executor.js
@@ -0,0 +1,100 @@
+'use strict';
+
+const { execFile } = require('node:child_process');
+const { createHash } = require('node:crypto');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const WINDOWS_SHIM_EXTENSIONS = new Set(['.bat', '.cmd']);
+const UNSAFE_WINDOWS_PATH = /["&|<>^%!\r\n]/;
+const SAFE_PROBE_ARGUMENT = /^[a-z0-9._=+-]+$/i;
+
+function execFileResult(file, args, options) {
+  return new Promise((resolve) => {
+    execFile(file, args, options, (error, stdout = '', stderr = '') => {
+      resolve({ error, stdout: String(stdout), stderr: String(stderr) });
+    });
+  });
+}
+
+function isExecutable(candidate) {
+  try {
+    if (!fs.statSync(candidate).isFile()) return false;
+    if (process.platform !== 'win32') fs.accessSync(candidate, fs.constants.X_OK);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+function resolveExecutable(command, env) {
+  const pathValue = env.PATH ?? env.Path ?? env.path ?? '';
+  const extensions = process.platform === 'win32' ? ['.exe', '.com', '.cmd', '.bat', ''] : [''];
+  for (const directory of pathValue.split(path.delimiter).filter(Boolean)) {
+    for (const extension of extensions) {
+      const candidate = path.join(directory, `${command}${extension}`);
+      if (isExecutable(candidate)) return candidate;
+    }
+  }
+  return null;
+}
+
+function executionTarget(executable, args) {
+  const extension = path.extname(executable).toLowerCase();
+  if (process.platform !== 'win32' || !WINDOWS_SHIM_EXTENSIONS.has(extension)) {
+    return { file: executable, args };
+  }
+  if (UNSAFE_WINDOWS_PATH.test(executable)) {
+    return null;
+  }
+  if (!args.every((argument) => SAFE_PROBE_ARGUMENT.test(argument))) return null;
+  return {
+    file: process.env.ComSpec || 'cmd.exe',
+    args: ['/d', '/c', executable, ...args],
+  };
+}
+
+function executableIdentity(executable) {
+  return createHash('sha256')
+    .update(path.resolve(executable), 'utf8')
+    .update('\0', 'utf8')
+    .update(fs.readFileSync(executable))
+    .digest('hex');
+}
+
+async function executeHarnessProbe(request, options = {}) {
+  const commonOptions = {
+    cwd: options.projectRoot ?? process.cwd(),
+    env: options.env ?? process.env,
+    maxBuffer: request.maxOutputBytes,
+    signal: request.signal,
+    timeout: request.timeoutMs,
+    windowsHide: true,
+  };
+  const executable = resolveExecutable(request.command, commonOptions.env);
+  if (!executable) {
+    return { exitCode: null, stdout: '', stderr: '', errorCode: 'ENOENT' };
+  }
+  const target = executionTarget(executable, request.args);
+  if (!target) {
+    return { exitCode: null, stdout: '', stderr: '', errorCode: 'UNSAFE_EXECUTABLE_PATH' };
+  }
+  const result = await execFileResult(target.file, target.args, commonOptions);
+  return {
+    exitCode: result.error ? (result.error.code ?? null) : 0,
+    stdout: result.stdout,
+    stderr: result.stderr,
+    errorCode: result.error?.code,
+    timedOut: Boolean(result.error?.killed || result.error?.code === 'ETIMEDOUT'),
+    executableIdentity: executableIdentity(executable),
+  };
+}
+
+function createHarnessProbeExecutor(options = {}) {
+  return (request) => executeHarnessProbe(request, options);
+}
+
+module.exports = {
+  createHarnessProbeExecutor,
+  executeHarnessProbe,
+};
