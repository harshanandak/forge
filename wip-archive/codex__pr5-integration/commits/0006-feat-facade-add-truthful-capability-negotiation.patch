+'use strict';
+
+const { describe, expect, test } = require('bun:test');
+
+const capabilities = require('../../lib/commands/capabilities');
+const { successfulExecutor } = require('../capability/fixtures');
+
+describe('capabilities command', () => {
+  test('reports installed products and probed harness behavior without activating products', async () => {
+    const resolved = [];
+    let activations = 0;
+    const result = await capabilities.handler(['--json'], {}, '/fixture', {
+      execute: successfulExecutor(),
+      observedAt: '2026-08-11T00:00:00.000Z',
+      kernelBuilder: async () => {
+        activations += 1;
+        throw new Error('capabilities inspection must not open durable storage');
+      },
+      createMonitorStore() {
+        activations += 1;
+        throw new Error('capabilities inspection must not activate Memory');
+      },
+      resolveProduct(product) {
+        resolved.push(product);
+        return product === 'memory';
+      },
+    });
+
+    expect(result.success).toBe(true);
+    const report = JSON.parse(result.output);
+    expect(report.schema).toBe('forge.capabilities.v1');
+    expect(report.products).toEqual([
+      { id: 'flow', available: false, status: 'UNAVAILABLE', reason: 'FORGE_FLOW_UNAVAILABLE' },
+      { id: 'memory', available: true, status: 'AVAILABLE', reason: 'PACKAGE_RESOLVED' },
+    ]);
+    expect(report.harnesses.map((item) => item.harness_id)).toEqual([
+      'claude', 'codex', 'cursor', 'hermes',
+    ]);
+    expect(report.harnesses.every((item) => item.status === 'PASS')).toBe(true);
+    expect(report.harnesses.every((item) => item.delivery_tiers.length === 5)).toBe(true);
+    expect(report.harnesses.every((item) => (
+      item.delivery_tiers.every((tier) => tier.available === false)
+    ))).toBe(true);
+    expect(report.harnesses.every((item) => (
+      item.delivery_tiers.find((tier) => tier.id === 'T0').reason === 'ADAPTER_UNAVAILABLE'
+    ))).toBe(true);
+    expect(report.harnesses.every((item) => (
+      item.capabilities.every((capability) => capability.available === false)
+    ))).toBe(true);
+    expect(report.harnesses.every((item) => (
+      item.capabilities.every((capability) => capability.surface_available === true)
+    ))).toBe(true);
+    expect(report.harnesses.every((item) => (
+      item.capabilities.every((capability) => capability.freedom_envelope)
+    ))).toBe(true);
+    expect(resolved).toEqual(['flow', 'memory']);
+    expect(activations).toBe(0);
+  });
+
+  test('advertises only tiers backed by injected durable and native handlers', async () => {
+    const result = await capabilities.handler(['--json'], {}, '/fixture', {
+      execute: successfulExecutor({ behaviorVerified: true }),
+      resolveProduct: () => true,
+      deliveryHandlers: {
+        codex: { T0: async () => ({}), T1: async () => ({}) },
+      },
+    });
+
+    const report = JSON.parse(result.output);
+    const codex = report.harnesses.find((item) => item.harness_id === 'codex');
+    expect(codex.delivery_tiers.filter((tier) => tier.available).map((tier) => tier.id)).toEqual(['T0', 'T1']);
+    expect(report.harnesses.filter((item) => item.harness_id !== 'codex').every((item) => (
+      item.delivery_tiers.every((tier) => tier.available === false)
+    ))).toBe(true);
+  });
+
+  test('rejects unsupported arguments instead of guessing a route', async () => {
+    const result = await capabilities.handler(['--yaml'], {}, '/fixture', {
+      execute: successfulExecutor(),
+      resolveProduct: () => false,
+    });
+
+    expect(result).toEqual({
+      success: false,
+      error: 'Usage: forge capabilities --json',
+    });
+  });
+});
