new file mode 100644
index 00000000..ebe2a159
--- /dev/null
+++ b/lib/commands/capabilities.js
@@ -0,0 +1,76 @@
+'use strict';
+
+const {
+  probeAllHarnesses,
+  projectCapabilityFreedom,
+  projectDeliveryTiers,
+} = require('../capabilities');
+const { createHarnessProbeExecutor } = require('../capabilities/executor');
+
+const PRODUCTS = Object.freeze([
+  Object.freeze({ id: 'flow', packageName: '@forge/flow', unavailable: 'FORGE_FLOW_UNAVAILABLE' }),
+  Object.freeze({ id: 'memory', packageName: '@forge/memory', unavailable: 'FORGE_MEMORY_UNAVAILABLE' }),
+]);
+
+function defaultResolveProduct(product, projectRoot) {
+  const definition = PRODUCTS.find((item) => item.id === product);
+  try {
