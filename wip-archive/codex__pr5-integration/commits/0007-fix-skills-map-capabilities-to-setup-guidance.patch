--- a/.agents/skills/setup/evals/scorecard.json
+++ b/.agents/skills/setup/evals/scorecard.json
@@ -3,9 +3,9 @@
   "fixtures": "present",
   "static": {
     "token_cost": {
-      "desc_chars": 1021,
-      "body_lines": 92,
-      "score": 41
+      "desc_chars": 779,
+      "body_lines": 103,
+      "score": 52
     },
     "caps": {
       "desc_within": true,
@@ -37,5 +37,5 @@
     "variance": null,
     "note": "behavioral — W5 (LLM judge): semantic recall/precision/chain/outcome/variance, not deterministic"
   },
-  "composite": 82
+  "composite": 86
 }
diff --git a/skills/coverage.json b/skills/coverage.json
index bc3b4694..903f8262 100644
--- a/skills/coverage.json
+++ b/skills/coverage.json
@@ -27,6 +27,7 @@
     "update": "issue-basics",
     "list": "issue-basics",
     "skill": "using-forge",
+    "capabilities": "setup",
 
     "worktree": "worktree",
     "clean": "worktree",
