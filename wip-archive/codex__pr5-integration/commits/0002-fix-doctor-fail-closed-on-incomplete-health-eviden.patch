   return output;
 }
@@ -78,7 +79,7 @@ function normalizeResult(definition, raw, durationMs) {
 
 async function runOne(definition, context, options, startedAt) {
   const now = options.now || Date.now;
-  const globalTimeoutMs = options.globalTimeoutMs || DEFAULT_GLOBAL_TIMEOUT_MS;
+  const globalTimeoutMs = options.globalTimeoutMs ?? DEFAULT_GLOBAL_TIMEOUT_MS;
   const elapsed = Math.max(0, now() - startedAt);
   const remaining = Math.max(1, globalTimeoutMs - elapsed);
   const timeoutMs = Math.max(1, Math.min(
@@ -119,6 +120,11 @@ async function runHealthChecks(definitions, context = {}, options = {}) {
     while (nextIndex < definitions.length) {
       const index = nextIndex;
       nextIndex += 1;
+      const globalTimeoutMs = options.globalTimeoutMs ?? DEFAULT_GLOBAL_TIMEOUT_MS;
+      if (Math.max(0, now() - startedAt) >= globalTimeoutMs) {
+        results[index] = normalizeResult(definitions[index], timeoutResult('global-deadline'), 0);
+        continue;
+      }
       results[index] = await runOne(definitions[index], context, options, startedAt);
     }
   }
diff --git a/test/commands/doctor-health.test.js b/test/commands/doctor-health.test.js
index c4f69e89..98e0c0c5 100644
--- a/test/commands/doctor-health.test.js
+++ b/test/commands/doctor-health.test.js
@@ -70,6 +70,47 @@ describe('forge doctor health report contract', () => {
     expect(explicit.checks).toHaveLength(1);
     expect(explicit.checks[0].id).toBe('integrations-provider');
     expect(explicit.checks[0].evidence.providerState).toBe('unsupported');
+
+    const unavailable = await doctor.runDoctorReport(root, localDeps(root, {
+      scopes: ['integrations'],
+      providerProbe: async () => ({ available: false, reason: 'offline' }),
+    }));
+    expect(unavailable.status).toBe('INCOMPLETE');
+    expect(unavailable.checks[0].evidence.providerState).toBe('unavailable');
+
+    const timeout = await doctor.runDoctorReport(root, localDeps(root, {
+      scopes: ['integrations'],
+      providerProbe: () => new Promise(() => {}),
+      perCheckTimeoutMs: 5,
+      globalTimeoutMs: 20,
+    }));
+    expect(timeout.status).toBe('INCOMPLETE');
+    expect(timeout.checks[0].evidence.reason).toBe('timeout');
+  });
+
+  test('Flow passes only after probing its inert public runtime adapter', async () => {
+    const root = makeProjectRoot('flow-probe');
+    const inventoryOnly = await doctor.runDoctorReport(root, localDeps(root, {
+      scopes: ['flow'],
+      loadFlow: () => ({}),
+    }));
+    expect(inventoryOnly.status).toBe('INCOMPLETE');
+    expect(inventoryOnly.checks[0].evidence.runtimeState).toBe('unsupported-public-api');
+
+    let adapterConstructed = false;
+    const probed = await doctor.runDoctorReport(root, localDeps(root, {
+      scopes: ['flow'],
+      loadFlow: () => ({
+        createWorkPacketExecutor: ({ run }) => {
+          expect(typeof run).toBe('function');
+          adapterConstructed = true;
+          return Object.freeze({ execute() {} });
+        },
+      }),
+    }));
+    expect(adapterConstructed).toBe(true);
+    expect(probed.status).toBe('PASS');
+    expect(probed.checks[0].evidence.runtimeState).toBe('public-adapter-ready');
   });
 
   test('local filesystem fixtures pass on Windows, macOS, and Linux', async () => {
