diff --git a/lib/commands/doctor.js b/lib/commands/doctor.js
index fced8cf2..06e1e1ae 100644
--- a/lib/commands/doctor.js
+++ b/lib/commands/doctor.js
@@ -9,8 +9,6 @@
 // the gate guards (via buildLocalBrokerConfig, which does no I/O) and reports
 // whether that path is safe, WITHOUT creating any file.
 
-const fs = require('node:fs');
-const path = require('node:path');
 const { buildLocalBrokerConfig } = require('../kernel/broker');
 const { classifyFilesystem, isUnsafeFsOverrideActive, REMEDIATION } = require('../kernel/fs-class');
 const memoryRouter = require('../memory/router');
@@ -151,10 +149,6 @@ function buildDoctorReport(projectRoot, deps = {}) {
 	};
 }
 
-function packageFile(...parts) {
-	return path.resolve(__dirname, '..', '..', ...parts);
-}
-
 function buildHealthCheckDefinitions(projectRoot, deps = {}) {
 	return [
 		{
@@ -169,8 +163,9 @@ function buildHealthCheckDefinitions(projectRoot, deps = {}) {
 						missing: parity.missing,
 						stale: parity.stale,
 						malformed: parity.malformed,
+						unknownCheckIds: parity.unknownCheckIds,
 					},
-					remediation: parity.valid ? '' : 'Add one Health disposition for every missing canonical command family.',
+					remediation: parity.valid ? '' : 'Add a valid Health disposition for every uncovered canonical command family.',
 				};
 			},
 		},
@@ -210,14 +205,7 @@ function buildHealthCheckDefinitions(projectRoot, deps = {}) {
 		{
 			id: 'flow-runtime', version: 1, owner: 'forge.flow', scope: 'flow', default: true,
 			affectedCommandFamilies: affectedFamilies('flow-runtime'),
-			run: async () => {
-				const present = fs.existsSync(packageFile('packages', 'flow', 'package.json'));
-				return {
-					status: present ? 'PASS' : 'INCOMPLETE',
-					evidence: { packagePresent: present },
-					remediation: present ? '' : 'Install a Forge distribution containing the Flow package.',
-				};
-			},
+			run: async () => runFlowCheck(deps),
 		},
 		{
 			id: 'integrations-provider', version: 1, owner: 'forge.integrations', scope: 'integrations', default: false,
@@ -242,6 +230,39 @@ function buildHealthCheckDefinitions(projectRoot, deps = {}) {
 	];
 }
 
+function runFlowCheck(deps) {
+	const loadFlow = deps.loadFlow || (() => require('@forge/flow'));
+	try {
+		const flow = loadFlow();
+		if (typeof flow?.createWorkPacketExecutor !== 'function') {
+			return {
+				status: 'INCOMPLETE',
+				evidence: { runtimeState: 'unsupported-public-api' },
+				remediation: 'Install a Flow version exposing the safe createWorkPacketExecutor adapter.',
+			};
+		}
+		const adapter = flow.createWorkPacketExecutor({ run: () => ({ status: 'INCOMPLETE' }) });
+		if (!adapter || typeof adapter.execute !== 'function') {
+			return {
+				status: 'INCOMPLETE',
+				evidence: { runtimeState: 'invalid-public-adapter' },
+				remediation: 'Repair the Flow public adapter before running Flow stages.',
+			};
+		}
+		return {
+			status: 'PASS',
+			evidence: { runtimeState: 'public-adapter-ready', adapter: 'createWorkPacketExecutor' },
+			remediation: '',
+		};
+	} catch (error) {
+		return {
+			status: 'INCOMPLETE',
+			evidence: { runtimeState: 'unavailable', reason: error?.message || String(error) },
+			remediation: 'Install or repair the Flow runtime and its public dependencies.',
+		};
+	}
+}
+
 async function runProviderCheck(deps) {
 	if (typeof deps.providerProbe !== 'function') {
 		return {
@@ -263,7 +284,7 @@ async function runProviderCheck(deps) {
 	}
 	if (probe?.available === false) {
 		return {
-			status: 'WARN',
+			status: 'INCOMPLETE',
 			evidence: { providerState: 'unavailable', reason: probe.reason || 'unavailable' },
 			remediation: 'Check provider availability and credentials outside Doctor, then retry explicitly.',
 		};
diff --git a/lib/health/doctor-manifest.js b/lib/health/doctor-manifest.js
index b38a736a..460139f7 100644
--- a/lib/health/doctor-manifest.js
+++ b/lib/health/doctor-manifest.js
@@ -46,6 +46,14 @@ const HEALTH_COVERAGE = Object.freeze({
   validate: { sharedDependencyCheck: 'flow-runtime' },
   worktree: { sharedDependencyCheck: 'filesystem-class' },
 });
+const HEALTH_CHECK_IDS = Object.freeze([
+  'filesystem-class',
+  'flow-runtime',
+  'integrations-provider',
+  'manifest-coverage',
+  'memory-backend',
+  'release-tooling',
+]);
 
 function canonicalCommandFamilies() {
   // Lazy requires avoid a cycle while the generated manifest is loading doctor.js.
@@ -72,12 +80,20 @@ function validateCoverageParity(options = {}) {
   const missing = canonicalFamilies.filter(family => !Object.hasOwn(coverage, family));
   const stale = declared.filter(family => !canonical.has(family));
   const malformed = declared.filter(family => !hasOneDisposition(coverage[family]));
+  const checkIds = new Set(options.checkIds || HEALTH_CHECK_IDS);
+  const unknownCheckIds = declared.flatMap(family => {
+    const disposition = coverage[family];
+    const referenced = disposition?.checkId || disposition?.sharedDependencyCheck;
+    return referenced && !checkIds.has(referenced) ? [`${family}:${referenced}`] : [];
+  });
   return {
-    valid: missing.length === 0 && stale.length === 0 && malformed.length === 0,
+    valid: missing.length === 0 && stale.length === 0 && malformed.length === 0
+      && unknownCheckIds.length === 0,
     canonicalFamilies,
     missing,
     stale,
     malformed,
+    unknownCheckIds,
   };
 }
 
@@ -91,6 +107,7 @@ function affectedFamilies(checkId, coverage = HEALTH_COVERAGE) {
 
 module.exports = {
   HEALTH_COVERAGE,
+  HEALTH_CHECK_IDS,
   canonicalCommandFamilies,
   validateCoverageParity,
   affectedFamilies,
diff --git a/lib/health/doctor-runner.js b/lib/health/doctor-runner.js
