   /\/(?:Users|home)\/[^/\s]+(?:\/[^\s"']*)?/g,
 ];
+const SENSITIVE_KEY_PATTERN = /(?:api[_-]?key|authorization|credential|password|prompt|secret|token)/i;
 
 function redactString(value) {
   let redacted = String(value).slice(0, 500);
@@ -34,7 +35,7 @@ function sanitize(value, depth = 0) {
 
 	const output = {};
 	for (const key of Object.keys(value).sort().slice(0, 30)) {
-		output[key] = /prompt/i.test(key) ? '<redacted>' : sanitize(value[key], depth + 1);
+		output[key] = SENSITIVE_KEY_PATTERN.test(key) ? '<redacted>' : sanitize(value[key], depth + 1);
