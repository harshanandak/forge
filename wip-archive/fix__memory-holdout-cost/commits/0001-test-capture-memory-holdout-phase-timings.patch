+function createRecallContext(prefix = 'forge-memory-holdout-', caseLabel = activeCaseLabel) {
+  const root = trackRoot(fs.mkdtempSync(path.join(os.tmpdir(), prefix)), caseLabel);
   const commonDir = path.join(root, '.git');
