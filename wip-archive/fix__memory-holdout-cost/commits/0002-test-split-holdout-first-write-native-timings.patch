 const projectMemory = require('../../lib/project-memory');
-const { createBuiltinSQLiteDriver } = require('../../lib/kernel/sqlite-driver');
+const {
+  createBuiltinSQLiteDriver,
+  selectBuiltinSQLiteRuntime,
+} = require('../../lib/kernel/sqlite-driver');
 const fixture = require('../fixtures/memory-recall-holdouts.json');
 
 const roots = [];
@@ -73,8 +76,65 @@ function measureSync(caseLabel, phase, operation) {
   }
 }
 
+function createProfiledRuntime(caseLabel, runtime, currentContext) {
+  const Database = runtime.module[runtime.databaseClassName];
+
+  function measureNative(phase, operation) {
+    const context = currentContext();
+    return context
+      ? measureSync(caseLabel, `${context}.native.${phase}`, operation)
+      : operation();
+  }
+
+  function wrapStatement(statement) {
+    return new Proxy(statement, {
+      get(target, property) {
+        const value = Reflect.get(target, property, target);
+        if (typeof value !== 'function') return value;
+        if (property === 'all' || property === 'run') {
+          return (...args) => measureNative('statement', () => value.apply(target, args));
+        }
+        return value.bind(target);
+      },
+    });
+  }
+
+  class ProfiledDatabase {
+    constructor(...args) {
+      this.inner = measureNative('open', () => new Database(...args));
+    }
+
+    exec(...args) {
+      return measureNative('exec', () => this.inner.exec(...args));
+    }
+
+    query(...args) {
+      return wrapStatement(measureNative('prepare', () => this.inner.query(...args)));
+    }
+
+    prepare(...args) {
+      return wrapStatement(measureNative('prepare', () => this.inner.prepare(...args)));
+    }
+
+    close(...args) {
+      return this.inner.close(...args);
+    }
+  }
+
+  return {
+    ...runtime,
+    module: {
+      ...runtime.module,
+      [runtime.databaseClassName]: ProfiledDatabase,
+    },
+  };
+}
+
 function createProfiledDriver(caseLabel, options) {
-  const store = createBuiltinSQLiteDriver(options);
+  let nativeContext = null;
+  const selectedRuntime = options.runtime || selectBuiltinSQLiteRuntime();
+  const runtime = createProfiledRuntime(caseLabel, selectedRuntime, () => nativeContext);
+  const store = createBuiltinSQLiteDriver({ ...options, runtime });
   let recordCount = 0;
   const phases = new Map([
     ['recordMemory', () => (recordCount++ === 0 ? 'record.first' : 'record.later')],
@@ -85,7 +145,14 @@ function createProfiledDriver(caseLabel, options) {
     const original = store[method];
     if (typeof original !== 'function') continue;
     store[method] = function profiledDriverMethod(...args) {
-      return measureSync(caseLabel, phaseForCall(), () => original.apply(this, args));
+      const phase = phaseForCall();
+      const previousContext = nativeContext;
+      nativeContext = phase === 'close' ? null : phase;
+      try {
+        return measureSync(caseLabel, phase, () => original.apply(this, args));
+      } finally {
+        nativeContext = previousContext;
+      }
     };
   }
   return store;
@@ -109,6 +176,7 @@ function timingSummary() {
     schema: 'forge.memory-recall-holdout-timing.v1',
     timingRecordFailed,
     hardKillLimit: 'A hard process termination can prevent the active case from reaching afterEach.',
