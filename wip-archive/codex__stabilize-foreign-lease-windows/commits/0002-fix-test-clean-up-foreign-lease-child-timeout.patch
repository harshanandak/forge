From 8bbb364a57734df9b43a5bc39be388bb940fc64d Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 13:43:22 +0530
Subject: [PATCH] fix(test): clean up foreign-lease child timeout

---
 test/pr-monitor/reconcile-executor.test.js | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/test/pr-monitor/reconcile-executor.test.js b/test/pr-monitor/reconcile-executor.test.js
index 960b95d6..ec58b6a2 100644
--- a/test/pr-monitor/reconcile-executor.test.js
+++ b/test/pr-monitor/reconcile-executor.test.js
@@ -8,6 +8,7 @@ const { spawn } = require('node:child_process');
 
 const executor = require('../../lib/pr-monitor/reconcile-executor');
 const shepherdLease = require('../../lib/pr-monitor/shepherd-lease');
+const FOREIGN_LEASE_CHILD_EXIT_TIMEOUT_MS = 5000;
 
 function tmpRepo() {
 	const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'ws4b-exec-'));
@@ -250,9 +251,10 @@ describe('runDaemon — singleton lease lifecycle', () => {
 		});
 		const result = await new Promise((resolve, reject) => {
 			const timeout = setTimeout(() => {
-				child.kill();
-				reject(new Error('foreign-lease loser child did not exit within 5s'));
-			}, 5000);
+				try { child.kill(); } catch { /* best effort */ }
+				child.unref?.();
+				reject(new Error(`foreign-lease loser child did not exit within ${FOREIGN_LEASE_CHILD_EXIT_TIMEOUT_MS}ms`));
+			}, FOREIGN_LEASE_CHILD_EXIT_TIMEOUT_MS);
 			child.once('error', (error) => {
 				clearTimeout(timeout);
 				reject(error);
-- 
