diff --git a/lib/commands/feedback.js b/lib/commands/feedback.js
new file mode 100644
index 00000000..8f1efac7
--- /dev/null
+++ b/lib/commands/feedback.js
@@ -0,0 +1,77 @@
+'use strict';
+
+const readline = require('node:readline/promises');
+const {
+  declineDraft,
+  disableFeedback,
+  loadFeedbackState,
+  sendDraft,
+} = require('../feedback');
+
+const USAGE = 'Usage: forge feedback [status|preview|disable]';
+
+function statusOutput(state) {
+  return `Consent: ${state.consent}\nPending drafts: ${Object.keys(state.drafts).length}\n`;
+}
+
+async function askDefault(prompt) {
+  const input = readline.createInterface({ input: process.stdin, output: process.stdout });
+  try {
+    return await input.question(prompt);
+  } finally {
+    input.close();
+  }
+}
+
+async function handler(args, _flags, _projectRoot, options = {}) {
+  const subcommand = args[0] || null;
+  if (subcommand === 'status') {
+    return { success: true, output: statusOutput(loadFeedbackState(options)) };
+  }
+  if (subcommand === 'preview') {
+    const drafts = Object.values(loadFeedbackState(options).drafts);
+    return { success: true, output: `${JSON.stringify(drafts, null, 2)}\n` };
+  }
+  if (subcommand === 'disable') {
+    disableFeedback(options);
+    return { success: true, output: 'Feedback disabled. Anonymous source ID and queued drafts deleted.\n' };
+  }
+  if (subcommand) return { success: false, error: USAGE };
+
+  const state = loadFeedbackState(options);
+  const fingerprint = Object.keys(state.drafts).sort()[0];
+  const interactive = options.isInteractive === true && (typeof options.question === 'function' || process.stdin.isTTY);
+  if (!interactive || !fingerprint) {
+    return { success: true, output: statusOutput(state) };
+  }
+
+  const write = options.write || (value => process.stdout.write(value));
+  const question = options.question || askDefault;
+  write(`Privacy-safe draft:\n${JSON.stringify(state.drafts[fingerprint], null, 2)}\n`);
+  write('1. Send this report once\n2. Send this report and enable future eligible reports\n3. Do not send\n');
+  const choice = String(await question('Choice [1-3]: ')).trim();
+  if (choice === '3') {
+    declineDraft(fingerprint, options);
+    return { success: true, output: 'Draft deleted and this incident fingerprint suppressed.\n' };
+  }
+  if (choice !== '1' && choice !== '2') {
+    return { success: false, error: 'No report sent. Choose 1, 2, or 3.' };
+  }
+
+  const result = await sendDraft(fingerprint, {
+    ...options,
+    enable: choice === '2',
+    preview: payload => write(`Exact payload:\n${JSON.stringify(payload, null, 2)}\n`),
+  });
+  return {
+    success: true,
+    output: `Report sent. Receipt: ${result.receiptId}\n${choice === '2' ? 'Future eligible reports enabled.\n' : ''}`,
+  };
+}
+
+module.exports = {
+  name: 'feedback',
+  description: 'Preview or send privacy-safe Forge failure reports',
+  usage: USAGE,
+  handler,
+};
diff --git a/lib/feedback.js b/lib/feedback.js
new file mode 100644
index 00000000..937dfa4c
--- /dev/null
+++ b/lib/feedback.js
@@ -0,0 +1,182 @@
+'use strict';
+
+const crypto = require('node:crypto');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+
+const FAILURE_CLASSES = Object.freeze({
+  FORGE_INTERNAL_ERROR: 'crash',
+  FORGE_INVARIANT_VIOLATION: 'invariant_violation',
+  FORGE_STATE_CORRUPTION: 'state_corruption',
+  FORGE_INTERNAL_TIMEOUT: 'timeout',
+});
+const SUBSYSTEMS = new Set(['cli', 'kernel', 'setup', 'shepherd', 'validation', 'workflow']);
+const CONSENTS = new Set(['disabled', 'pending', 'enabled']);
+const SCHEMA_VERSION = 1;
+
+function feedbackHome(options = {}) {
+  return options.homeDir || process.env.FORGE_FEEDBACK_HOME || path.join(os.homedir(), '.forge', 'feedback');
+}
+
+function feedbackStatePath(options = {}) {
+  return path.join(feedbackHome(options), 'state.json');
+}
+
+function emptyState() {
+  return {
+    consent: 'pending',
+    anonymous_source_id: null,
+    drafts: {},
+    suppressed_fingerprints: [],
+  };
+}
+
+function normalizeState(value) {
+  if (!value || typeof value !== 'object') return emptyState();
+  return {
+    consent: CONSENTS.has(value.consent) ? value.consent : 'pending',
+    anonymous_source_id: typeof value.anonymous_source_id === 'string' ? value.anonymous_source_id : null,
+    drafts: value.drafts && typeof value.drafts === 'object' && !Array.isArray(value.drafts) ? value.drafts : {},
+    suppressed_fingerprints: Array.isArray(value.suppressed_fingerprints)
+      ? value.suppressed_fingerprints.filter(item => typeof item === 'string')
+      : [],
+  };
+}
+
+function loadFeedbackState(options = {}) {
+  try {
+    return normalizeState(JSON.parse(fs.readFileSync(feedbackStatePath(options), 'utf8')));
+  } catch (_error) {
+    return emptyState();
+  }
+}
+
+function saveFeedbackState(state, options = {}) {
+  const file = feedbackStatePath(options);
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  const temporary = `${file}.${crypto.randomUUID()}.tmp`;
+  fs.writeFileSync(temporary, `${JSON.stringify(state, null, 2)}\n`, { encoding: 'utf8', mode: 0o600 });
+  fs.renameSync(temporary, file);
+}
+
+function versionBucket(version) {
+  const match = /^(\d+)\.(\d+)/.exec(String(version || ''));
+  return match ? `${match[1]}.${match[2]}` : 'unknown';
+}
+
+function buildDraft(failure, version) {
+  const failureClass = FAILURE_CLASSES[failure?.code];
+  if (!failureClass || !SUBSYSTEMS.has(failure?.subsystem)) return null;
+  const bucket = versionBucket(version);
+  const incidentFingerprint = crypto
+    .createHash('sha256')
+    .update(`${failure.code}\n${failure.subsystem}\n${bucket}`)
+    .digest('hex');
+  return {
+    schema_version: SCHEMA_VERSION,
+    error_code: failure.code,
+    subsystem: failure.subsystem,
+    failure_class: failureClass,
+    forge_version_bucket: bucket,
+    incident_fingerprint: incidentFingerprint,
+  };
+}
+
+function resolveEndpoint(options = {}) {
+  const raw = options.endpoint || process.env.FORGE_FEEDBACK_ENDPOINT;
+  if (!raw) throw new Error('Feedback endpoint is not configured.');
+  const endpoint = new URL(raw);
+  if (endpoint.protocol !== 'https:' || endpoint.username || endpoint.password) {
+    throw new Error('Feedback endpoint must be HTTPS and contain no credentials.');
+  }
+  return endpoint.toString();
+}
+
+async function sendDraft(incidentFingerprint, options = {}) {
+  const state = loadFeedbackState(options);
+  const draft = state.drafts[incidentFingerprint];
+  if (!draft) throw new Error('Feedback draft not found.');
+  const endpoint = resolveEndpoint(options);
+  const generateId = options.idGenerator || crypto.randomUUID;
+  const anonymousSourceId = state.anonymous_source_id || generateId();
+  const receiptId = generateId();
+  const payload = {
+    ...draft,
+    anonymous_source_id: anonymousSourceId,
+    receipt_id: receiptId,
+  };
+
+  state.anonymous_source_id = anonymousSourceId;
+  saveFeedbackState(state, options);
+  if (options.preview) options.preview(payload);
+
+  const post = options.fetch || globalThis.fetch;
+  if (typeof post !== 'function') throw new Error('HTTPS transport is unavailable.');
+  const response = await post(endpoint, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify(payload),
+    redirect: 'error',
+  });
+  if (!response?.ok) throw new Error(`Feedback transport failed with status ${response?.status || 'unknown'}.`);
+
+  delete state.drafts[incidentFingerprint];
+  if (options.enable === true) state.consent = 'enabled';
+  saveFeedbackState(state, options);
+  return { receiptId, payload };
+}
+
+async function captureFailure(failure, options = {}) {
+  const draft = buildDraft(failure, options.version || require('../package.json').version);
+  if (!draft) return { captured: false, reason: 'ineligible' };
+  const state = loadFeedbackState(options);
+  if (state.consent === 'disabled') return { captured: false, reason: 'disabled' };
+  const fingerprint = draft.incident_fingerprint;
+  if (state.suppressed_fingerprints.includes(fingerprint)) {
+    return { captured: false, suppressed: true, incidentFingerprint: fingerprint };
+  }
+  if (state.drafts[fingerprint]) {
+    return { captured: true, deduplicated: true, incidentFingerprint: fingerprint };
+  }
+
+  state.drafts[fingerprint] = draft;
+  saveFeedbackState(state, options);
+  const result = { captured: true, deduplicated: false, incidentFingerprint: fingerprint };
+  if (state.consent === 'enabled' && options.interactive === true) {
+    try {
+      const sent = await sendDraft(fingerprint, options);
+      return { ...result, sent: true, receiptId: sent.receiptId };
+    } catch (_error) {
+      return { ...result, sent: false };
+    }
+  }
+  return result;
+}
+
+function declineDraft(incidentFingerprint, options = {}) {
+  const state = loadFeedbackState(options);
+  delete state.drafts[incidentFingerprint];
+  if (!state.suppressed_fingerprints.includes(incidentFingerprint)) {
+    state.suppressed_fingerprints.push(incidentFingerprint);
+  }
+  saveFeedbackState(state, options);
+  return state;
+}
+
+function disableFeedback(options = {}) {
+  const state = loadFeedbackState(options);
+  state.consent = 'disabled';
+  state.anonymous_source_id = null;
+  state.drafts = {};
+  saveFeedbackState(state, options);
+  return state;
+}
+
+module.exports = {
+  captureFailure,
+  declineDraft,
+  disableFeedback,
+  loadFeedbackState,
+  sendDraft,
+};
