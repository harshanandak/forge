+'use strict';
+
+const { describe, expect, test } = require('bun:test');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+
+const feedbackCommand = require('../../lib/commands/feedback');
+const { captureFailure, loadFeedbackState } = require('../../lib/feedback');
+
+function tempHome() {
+  return fs.mkdtempSync(path.join(os.tmpdir(), 'forge-feedback-command-'));
+}
+
+async function seed(homeDir) {
+  return captureFailure(
+    { code: 'FORGE_INTERNAL_ERROR', subsystem: 'cli' },
+    { homeDir, version: '1.7.0' },
+  );
+}
+
+describe('forge feedback command', () => {
+  test('non-interactive invocation never asks or sends', async () => {
+    const homeDir = tempHome();
+    await seed(homeDir);
+    let asked = 0;
+    let sent = 0;
+    const result = await feedbackCommand.handler([], {}, '.', {
+      homeDir,
+      isInteractive: false,
+      question: async () => { asked += 1; return '1'; },
+      fetch: async () => { sent += 1; return { ok: true }; },
+    });
+
+    expect(result.success).toBe(true);
+    expect(result.output).toContain('Consent: pending');
+    expect(result.output).toContain('Pending drafts: 1');
+    expect(asked).toBe(0);
+    expect(sent).toBe(0);
+  });
+
+  test('interactive send once previews the exact transmitted payload without enabling', async () => {
+    const homeDir = tempHome();
+    await seed(homeDir);
+    let sent;
+    let displayed = '';
+    const result = await feedbackCommand.handler([], {}, '.', {
+      homeDir,
+      isInteractive: true,
+      endpoint: 'https://feedback.forge.test/v1/reports',
+      question: async () => '1',
+      write: value => { displayed += value; },
+      fetch: async (_url, options) => {
+        sent = JSON.parse(options.body);
+        return { ok: true, status: 202 };
+      },
+    });
+
+    const exact = displayed.slice(displayed.indexOf('Exact payload:\n') + 'Exact payload:\n'.length);
+    const preview = JSON.parse(exact.slice(0, exact.lastIndexOf('}') + 1));
+    expect(preview).toEqual(sent);
+    expect(result.output).toContain(`Receipt: ${sent.receipt_id}`);
+    expect(loadFeedbackState({ homeDir }).consent).toBe('pending');
+  });
+
+  test('interactive send-and-enable and decline map to choices 2 and 3', async () => {
+    const enableHome = tempHome();
+    await seed(enableHome);
+    await feedbackCommand.handler([], {}, '.', {
+      homeDir: enableHome,
+      isInteractive: true,
+      endpoint: 'https://feedback.forge.test/v1/reports',
+      question: async () => '2',
+      write: () => {},
+      fetch: async () => ({ ok: true, status: 202 }),
+    });
+    expect(loadFeedbackState({ homeDir: enableHome }).consent).toBe('enabled');
+
+    const declineHome = tempHome();
+    const draft = await seed(declineHome);
+    await feedbackCommand.handler([], {}, '.', {
+      homeDir: declineHome,
+      isInteractive: true,
+      question: async () => '3',
+      write: () => {},
+    });
+    const declined = loadFeedbackState({ homeDir: declineHome });
+    expect(declined.drafts).toEqual({});
+    expect(declined.suppressed_fingerprints).toContain(draft.incidentFingerprint);
+    expect(declined.consent).toBe('pending');
+  });
+});
