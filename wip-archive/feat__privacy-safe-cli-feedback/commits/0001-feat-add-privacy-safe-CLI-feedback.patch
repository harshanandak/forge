+'use strict';
+
+const { describe, expect, test } = require('bun:test');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+
+const {
+  captureFailure,
+  declineDraft,
+  disableFeedback,
+  loadFeedbackState,
+  sendDraft,
+} = require('../lib/feedback');
+const { executeCommand } = require('../lib/commands/_registry');
+
+function tempHome() {
+  return fs.mkdtempSync(path.join(os.tmpdir(), 'forge-feedback-'));
+}
+
+const eligible = {
+  code: 'FORGE_STATE_CORRUPTION',
+  subsystem: 'kernel',
+};
+
+describe('privacy-safe feedback core', () => {
+  test('starts pending, captures only allowlisted fields, and deduplicates by fingerprint', async () => {
+    const homeDir = tempHome();
+    const first = await captureFailure(
+      { ...eligible, path: 'C:/secret/repo', prompt: 'private', log: 'raw' },
+      { homeDir, version: '1.7.4', interactive: false },
+    );
+    const second = await captureFailure(eligible, { homeDir, version: '1.7.9', interactive: false });
+    const state = loadFeedbackState({ homeDir });
+    const draft = Object.values(state.drafts)[0];
+
+    expect(state.consent).toBe('pending');
+    expect(first.captured).toBe(true);
+    expect(second.deduplicated).toBe(true);
+    expect(Object.keys(state.drafts)).toHaveLength(1);
+    expect(draft).toEqual({
+      schema_version: 1,
+      error_code: 'FORGE_STATE_CORRUPTION',
+      subsystem: 'kernel',
+      failure_class: 'state_corruption',
+      forge_version_bucket: '1.7',
+      incident_fingerprint: first.incidentFingerprint,
+    });
+    expect(JSON.stringify(draft)).not.toMatch(/secret|repo|private|raw|path|prompt|log/i);
+  });
+
+  test('rejects unknown and non-Forge failures without creating state', async () => {
+    const homeDir = tempHome();
+    expect((await captureFailure({ code: 'ENOENT', subsystem: 'kernel' }, { homeDir })).captured).toBe(false);
+    expect((await captureFailure({ code: eligible.code, subsystem: 'provider' }, { homeDir })).captured).toBe(false);
+    expect(fs.readdirSync(homeDir)).toEqual([]);
+  });
+
+  test('decline deletes one draft and suppresses only its fingerprint', async () => {
+    const homeDir = tempHome();
+    const first = await captureFailure(eligible, { homeDir, version: '1.7.0' });
+    const other = await captureFailure(
+      { code: 'FORGE_INTERNAL_TIMEOUT', subsystem: 'workflow' },
+      { homeDir, version: '1.7.0' },
+    );
+
+    declineDraft(first.incidentFingerprint, { homeDir });
+    const again = await captureFailure(eligible, { homeDir, version: '1.7.0' });
+    const state = loadFeedbackState({ homeDir });
+
+    expect(again.suppressed).toBe(true);
+    expect(state.drafts[first.incidentFingerprint]).toBeUndefined();
+    expect(state.drafts[other.incidentFingerprint]).toBeDefined();
+  });
+
+  test('approved send previews the exact payload, uses no credentials, and returns an unguessable receipt', async () => {
+    const homeDir = tempHome();
+    const captured = await captureFailure(eligible, { homeDir, version: '1.7.0' });
+    let request;
+    let preview;
+    const result = await sendDraft(captured.incidentFingerprint, {
+      homeDir,
+      endpoint: 'https://feedback.forge.test/v1/reports',
+      idGenerator: (() => {
+        const ids = ['source-4ce92c91-2435-44fa-854f-6fb36ab8d5cb', 'receipt-3870317c-3368-4949-8f91-945a959244cb'];
+        return () => ids.shift();
+      })(),
+      preview: payload => { preview = payload; },
+      fetch: async (url, options) => {
