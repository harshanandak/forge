diff --git a/lib/feedback.js b/lib/feedback.js
index 937dfa4c..53bf8dc6 100644
--- a/lib/feedback.js
+++ b/lib/feedback.js
@@ -5,15 +5,21 @@ const fs = require('node:fs');
 const os = require('node:os');
 const path = require('node:path');
 
-const FAILURE_CLASSES = Object.freeze({
-  FORGE_INTERNAL_ERROR: 'crash',
-  FORGE_INVARIANT_VIOLATION: 'invariant_violation',
-  FORGE_STATE_CORRUPTION: 'state_corruption',
-  FORGE_INTERNAL_TIMEOUT: 'timeout',
-});
+const FAILURE_CLASSES = new Map([
+  ['FORGE_INTERNAL_ERROR', 'crash'],
+  ['FORGE_INVARIANT_VIOLATION', 'invariant_violation'],
+  ['FORGE_STATE_CORRUPTION', 'state_corruption'],
+  ['FORGE_INTERNAL_TIMEOUT', 'timeout'],
+]);
 const SUBSYSTEMS = new Set(['cli', 'kernel', 'setup', 'shepherd', 'validation', 'workflow']);
 const CONSENTS = new Set(['disabled', 'pending', 'enabled']);
 const SCHEMA_VERSION = 1;
+const FINGERPRINT_PATTERN = /^[a-f0-9]{64}$/;
+const OPAQUE_ID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+function isOpaqueId(value) {
+  return typeof value === 'string' && OPAQUE_ID_PATTERN.test(value);
+}
 
 function feedbackHome(options = {}) {
   return options.homeDir || process.env.FORGE_FEEDBACK_HOME || path.join(os.homedir(), '.forge', 'feedback');
@@ -32,15 +38,59 @@ function emptyState() {
   };
 }
 
+function fingerprintFor(errorCode, subsystem, bucket) {
+  return crypto
+    .createHash('sha256')
+    .update(`${errorCode}\n${subsystem}\n${bucket}`)
+    .digest('hex');
+}
+
+function reconstructDraft(value) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
+  const failureClass = FAILURE_CLASSES.get(value.error_code);
+  const validBucket = typeof value.forge_version_bucket === 'string'
+    && /^(?:\d+\.\d+|unknown)$/.test(value.forge_version_bucket);
+  if (
+    value.schema_version !== SCHEMA_VERSION
+    || !failureClass
+    || !SUBSYSTEMS.has(value.subsystem)
+    || value.failure_class !== failureClass
+    || !validBucket
+    || typeof value.incident_fingerprint !== 'string'
+    || !FINGERPRINT_PATTERN.test(value.incident_fingerprint)
+  ) return null;
+  const expectedFingerprint = fingerprintFor(value.error_code, value.subsystem, value.forge_version_bucket);
+  if (value.incident_fingerprint !== expectedFingerprint) return null;
+  return {
+    schema_version: SCHEMA_VERSION,
+    error_code: value.error_code,
+    subsystem: value.subsystem,
+    failure_class: failureClass,
+    forge_version_bucket: value.forge_version_bucket,
+    incident_fingerprint: expectedFingerprint,
+  };
+}
+
+function normalizeDrafts(value) {
+  const drafts = {};
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return drafts;
+  for (const [key, stored] of Object.entries(value)) {
+    const draft = reconstructDraft(stored);
+    if (draft && key === draft.incident_fingerprint) drafts[key] = draft;
+  }
+  return drafts;
+}
+
 function normalizeState(value) {
-  if (!value || typeof value !== 'object') return emptyState();
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return emptyState();
+  const suppressed = Array.isArray(value.suppressed_fingerprints)
+    ? [...new Set(value.suppressed_fingerprints.filter(item => typeof item === 'string' && FINGERPRINT_PATTERN.test(item)))]
+    : [];
   return {
     consent: CONSENTS.has(value.consent) ? value.consent : 'pending',
-    anonymous_source_id: typeof value.anonymous_source_id === 'string' ? value.anonymous_source_id : null,
-    drafts: value.drafts && typeof value.drafts === 'object' && !Array.isArray(value.drafts) ? value.drafts : {},
-    suppressed_fingerprints: Array.isArray(value.suppressed_fingerprints)
-      ? value.suppressed_fingerprints.filter(item => typeof item === 'string')
-      : [],
+    anonymous_source_id: isOpaqueId(value.anonymous_source_id) ? value.anonymous_source_id : null,
+    drafts: normalizeDrafts(value.drafts),
+    suppressed_fingerprints: suppressed,
   };
 }
 
@@ -66,13 +116,10 @@ function versionBucket(version) {
 }
 
 function buildDraft(failure, version) {
-  const failureClass = FAILURE_CLASSES[failure?.code];
+  const failureClass = FAILURE_CLASSES.get(failure?.code);
   if (!failureClass || !SUBSYSTEMS.has(failure?.subsystem)) return null;
   const bucket = versionBucket(version);
-  const incidentFingerprint = crypto
-    .createHash('sha256')
-    .update(`${failure.code}\n${failure.subsystem}\n${bucket}`)
-    .digest('hex');
+  const incidentFingerprint = fingerprintFor(failure.code, failure.subsystem, bucket);
   return {
     schema_version: SCHEMA_VERSION,
     error_code: failure.code,
@@ -93,16 +140,26 @@ function resolveEndpoint(options = {}) {
   return endpoint.toString();
 }
 
+function nextOpaqueId(options = {}) {
+  const id = (options.idGenerator || crypto.randomUUID)();
+  if (!isOpaqueId(id)) throw new Error('Feedback identifier generation failed.');
+  return id;
+}
+
 async function sendDraft(incidentFingerprint, options = {}) {
   const state = loadFeedbackState(options);
-  const draft = state.drafts[incidentFingerprint];
+  const draft = Object.hasOwn(state.drafts, incidentFingerprint) ? state.drafts[incidentFingerprint] : null;
   if (!draft) throw new Error('Feedback draft not found.');
   const endpoint = resolveEndpoint(options);
-  const generateId = options.idGenerator || crypto.randomUUID;
-  const anonymousSourceId = state.anonymous_source_id || generateId();
-  const receiptId = generateId();
+  const anonymousSourceId = state.anonymous_source_id || nextOpaqueId(options);
+  const receiptId = nextOpaqueId(options);
   const payload = {
-    ...draft,
+    schema_version: draft.schema_version,
+    error_code: draft.error_code,
+    subsystem: draft.subsystem,
+    failure_class: draft.failure_class,
+    forge_version_bucket: draft.forge_version_bucket,
+    incident_fingerprint: draft.incident_fingerprint,
     anonymous_source_id: anonymousSourceId,
     receipt_id: receiptId,
   };
@@ -143,7 +200,8 @@ async function captureFailure(failure, options = {}) {
   state.drafts[fingerprint] = draft;
   saveFeedbackState(state, options);
   const result = { captured: true, deduplicated: false, incidentFingerprint: fingerprint };
-  if (state.consent === 'enabled' && options.interactive === true) {
+  const interactive = options.inputInteractive === true && options.outputInteractive === true;
+  if (state.consent === 'enabled' && interactive) {
     try {
       const sent = await sendDraft(fingerprint, options);
       return { ...result, sent: true, receiptId: sent.receiptId };
@@ -173,10 +231,21 @@ function disableFeedback(options = {}) {
   return state;
 }
 
+function enableFeedback(options = {}) {
+  const state = loadFeedbackState(options);
+  if (state.consent === 'enabled' && state.anonymous_source_id) return state;
+  if (state.consent === 'disabled') state.drafts = {};
+  state.consent = 'enabled';
+  state.anonymous_source_id = nextOpaqueId(options);
+  saveFeedbackState(state, options);
+  return state;
+}
+
 module.exports = {
   captureFailure,
   declineDraft,
   disableFeedback,
   loadFeedbackState,
+  enableFeedback,
   sendDraft,
 };
