From: forge-shepherd <noreply@anthropic.com>
Date: Fri, 7 Aug 2026 18:47:58 +0530
Subject: [PATCH] fix: make stale feedback reclaim ownership-safe

---
 lib/feedback.js                       | 53 +++++++++++++++++++---
 test/feedback.test.js                 | 65 ++++++++++++++++++++++++++-
 test/fixtures/feedback-race-worker.js |  5 ++-
 3 files changed, 112 insertions(+), 11 deletions(-)

diff --git a/lib/feedback.js b/lib/feedback.js
index 323856a2..87267d49 100644
--- a/lib/feedback.js
+++ b/lib/feedback.js
@@ -166,21 +166,58 @@ function feedbackLockPath(options = {}) {
   return `${feedbackStatePath(options)}.lock`;
 }
 
-function lockIsStale(io, file, staleMs) {
+function inspectFeedbackLock(io, file, staleMs) {
+  let raw;
   let owner;
   try {
-    owner = JSON.parse(io.readFileSync(file, 'utf8'));
+    raw = io.readFileSync(file, 'utf8');
+    owner = JSON.parse(raw);
   } catch {
     owner = null;
   }
   if (Number.isInteger(owner?.pid)) {
-    return !processIsAlive(owner.pid);
+    return { raw, stale: !processIsAlive(owner.pid) };
   }
   try {
-    return Date.now() - io.statSync(file).mtimeMs > staleMs;
+    return { raw, stale: Date.now() - io.statSync(file).mtimeMs > staleMs };
   } catch {
-    return true;
+    return { raw, stale: true };
+  }
+}
+
+function restoreMovedLock(io, tombstone, file) {
+  try {
+    io.linkSync(tombstone, file);
+  } catch {
+    return;
+  }
+  try { io.unlinkSync(tombstone); } catch { /* canonical hard link preserves the lock */ }
+}
+
+function reclaimStaleFeedbackLock(io, file, snapshot) {
+  if (typeof snapshot.raw !== 'string') return 'changed';
+  const tombstone = `${file}.stale.${crypto.randomUUID()}`;
+  try {
+    io.renameSync(file, tombstone);
+  } catch (error) {
+    if (error?.code === 'ENOENT') return 'missing';
+    if (LOCK_CONTENTION_CODES.has(error?.code)) return 'missing';
+    throw error;
+  }
+
+  let movedRaw;
+  try {
+    movedRaw = io.readFileSync(tombstone, 'utf8');
+  } catch {
+    restoreMovedLock(io, tombstone, file);
+    return 'changed';
+  }
+  if (movedRaw !== snapshot.raw) {
+    restoreMovedLock(io, tombstone, file);
+    return 'changed';
   }
+  try { io.unlinkSync(tombstone); } catch { /* stale tombstone is harmless */ }
+  return 'reclaimed';
 }
 
 function releaseFeedbackLock(io, lock) {
@@ -217,8 +254,10 @@ function acquireFeedbackLock(options = {}) {
         releaseFeedbackLock(io, lock);
       }
       if (!LOCK_CONTENTION_CODES.has(error?.code)) throw error;
-      if (lockIsStale(io, file, staleMs)) {
-        try { io.unlinkSync(file); } catch { /* another process reclaimed first */ }
+      const snapshot = inspectFeedbackLock(io, file, staleMs);
+      if (snapshot.stale) {
+        const reclaimResult = reclaimStaleFeedbackLock(io, file, snapshot);
+        if (reclaimResult === 'changed' && attempt + 1 < attempts) sleepSync(waitMs);
         continue;
       }
       if (attempt + 1 < attempts) sleepSync(waitMs);
