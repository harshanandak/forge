     cwd: path.join(__dirname, '..'),
     stdio: ['ignore', 'pipe', 'pipe'],
   });
@@ -597,6 +597,67 @@ describe('privacy-safe feedback core', () => {
     fs.unlinkSync(lock);
   });
 
+  test('stale reclaim preserves a successor injected between inspection and removal', async () => {
+    const homeDir = tempHome();
+    writeState(homeDir, validEmptyState());
+    const lock = `${stateFile(homeDir)}.lock`;
+    const successorToken = '33333333-3333-4333-8333-333333333333';
+    fs.writeFileSync(lock, JSON.stringify({ pid: 999999999, owner_token: 'stale-owner' }));
+    const injectingFs = {
+      ...fs,
+      renameSync(from, to) {
+        if (from === lock) {
+          fs.writeFileSync(lock, JSON.stringify({ pid: process.pid, owner_token: successorToken }));
+        }
+        return fs.renameSync(from, to);
+      },
+      unlinkSync(file) {
+        if (file === lock) {
+          fs.writeFileSync(lock, JSON.stringify({ pid: process.pid, owner_token: successorToken }));
+        }
+        return fs.unlinkSync(file);
+      },
+    };
+
+    await expect(captureFailure(eligible, {
+      homeDir,
+      version: '1.7.0',
+      fs: injectingFs,
+      lockAttempts: 1,
+    })).rejects.toThrow('Feedback state is busy');
+    expect(JSON.parse(fs.readFileSync(lock, 'utf8')).owner_token).toBe(successorToken);
+    fs.unlinkSync(lock);
+  });
+
+  test('two concurrent stale reclaimers serialize without losing either draft', async () => {
+    const homeDir = tempHome();
+    writeState(homeDir, validEmptyState());
+    const lock = `${stateFile(homeDir)}.lock`;
+    fs.writeFileSync(lock, JSON.stringify({ pid: 999999999, owner_token: 'stale-owner' }));
+    const goFile = path.join(homeDir, 'stale-go');
+    fs.writeFileSync(goFile, 'go');
+    const first = runCaptureWorker(
+      homeDir,
+      path.join(homeDir, 'stale-ready-a'),
+      goFile,
+      'FORGE_INTERNAL_ERROR',
+      'cli',
+      'lock',
+    );
+    const second = runCaptureWorker(
+      homeDir,
+      path.join(homeDir, 'stale-ready-b'),
+      goFile,
+      'FORGE_INTERNAL_TIMEOUT',
+      'workflow',
+      'lock',
+    );
+    await Promise.all([workerExit(first), workerExit(second)]);
+
+    expect(Object.keys(loadFeedbackState({ homeDir }).drafts)).toHaveLength(2);
+    expect(fs.existsSync(lock)).toBe(false);
+  });
+
   test('corrupt or unreadable state fails closed and preserves original bytes', async () => {
     for (const raw of ['{"consent":"disabled"', '[]']) {
       const homeDir = tempHome();
