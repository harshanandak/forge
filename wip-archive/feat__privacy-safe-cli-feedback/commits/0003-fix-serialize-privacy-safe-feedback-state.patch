+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const [homeDir, readyFile, goFile, code, subsystem] = process.argv.slice(2);
+const stateFile = path.join(homeDir, 'state.json');
+const originalRead = fs.readFileSync;
+let paused = false;
+
+fs.readFileSync = function readWithBarrier(file, ...args) {
+  const result = originalRead.call(this, file, ...args);
+  if (!paused && path.resolve(String(file)) === path.resolve(stateFile)) {
+    paused = true;
+    fs.writeFileSync(readyFile, 'ready');
+    const sleeper = new Int32Array(new SharedArrayBuffer(4));
+    while (!fs.existsSync(goFile)) Atomics.wait(sleeper, 0, 0, 10);
+  }
+  return result;
+};
+
+const { captureFailure } = require('../../lib/feedback');
+
+captureFailure({ code, subsystem }, { homeDir, version: '1.7.0' })
+  .then(() => { process.exitCode = 0; })
+  .catch(error => {
+    process.stderr.write(`${error.stack || error}\n`);
+    process.exitCode = 1;
+  });
