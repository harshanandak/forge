diff --git a/lib/pr-monitor/flow-monitor.js b/lib/pr-monitor/flow-monitor.js
index ccead4cb..54276bc0 100644
--- a/lib/pr-monitor/flow-monitor.js
+++ b/lib/pr-monitor/flow-monitor.js
@@ -302,8 +302,7 @@ async function readDeliveryAuthority(ctx) {
   } catch {
     throw new FlowMonitorError('PROVIDER_UNAVAILABLE', 'Durable delivery state is unavailable');
   }
-  if (!deliveryState || deliveryState.overflow?.cursors || deliveryState.overflow?.outbox
-    || !Array.isArray(deliveryState.cursors)) {
+  if (!deliveryState || deliveryState.overflow?.cursors || !Array.isArray(deliveryState.cursors)) {
     throw new FlowMonitorError('PROVIDER_UNAVAILABLE', 'Durable delivery state is incomplete');
   }
   return deliveryState;
