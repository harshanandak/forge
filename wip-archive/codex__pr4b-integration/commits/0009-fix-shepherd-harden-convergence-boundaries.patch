+
+    await expect(runFlowMonitorPass(ctx))
+      .rejects.toMatchObject({ code: 'MONITOR_HISTORY_INCOMPLETE' });
+  });
+
+  test('rejects a bounded replay when the durable delivery outbox was truncated', async () => {
