diff --git a/lib/pr-monitor/reconcile-executor.js b/lib/pr-monitor/reconcile-executor.js
index b31f4f7b..5883d257 100644
--- a/lib/pr-monitor/reconcile-executor.js
+++ b/lib/pr-monitor/reconcile-executor.js
@@ -403,7 +403,7 @@ async function gatherObserved(gitCommonDir, lock, opts = {}) {
  * Kill a watcher pid ONLY after re-verifying start-time (design risk #4). Returns
  * true iff the kill actually happened. Never kills on a PID match alone.
  */
-function verifiedKill(entry, ctx) {
+function verifiedKill(entry, ctx, signal) {
 	if (!entry || entry.pid == null || entry.startedAt == null) return false;
 	const isAlive = ctx.isAlive || shepherdLease.pidAlive;
 	if (!isAlive(entry.pid)) return false;
@@ -412,13 +412,20 @@ function verifiedKill(entry, ctx) {
 	const claim = readClaim(entry);
 	if (claim == null || String(claim) !== String(entry.startedAt)) return false;
 	try {
-		(ctx.kill || process.kill)(entry.pid);
+		const kill = ctx.kill || process.kill;
+		if (signal) kill(entry.pid, signal);
+		else kill(entry.pid);
 	} catch {
 		return false;
 	}
 	return true;
 }
 
+function daemonCanRetire(convergence) {
+	return convergence?.desiredCount === 0
+		&& (!Array.isArray(convergence.watchers) || convergence.watchers.length === 0);
+}
+
 /**
  * Per-action-type handlers, keyed by `action.type`. Extracted from `execute` so
  * each is small and independently testable and the dispatcher stays a flat loop
@@ -464,9 +471,20 @@ const ACTION_HANDLERS = {
 				continue;
 			}
 			const isAlive = s.ctx.isAlive || shepherdLease.pidAlive;
-			if (isAlive(entry.pid)) continue;
-			if (entry.lifecycle.state.phase !== 'CANCEL_REQUESTED') continue;
-			checkpointLifecycle(entry, lifecycleEvent(entry, 'cancel-acknowledged', at), s);
+			if (isAlive(entry.pid)) {
+				const cancelledAt = entry.lifecycle.state.cancelRequestedAt;
+				if (entry.lifecycle.state.phase === 'CANCEL_REQUESTED'
+					&& Number.isSafeInteger(cancelledAt) && at - cancelledAt >= lifecycleOptions(entry).graceMs) {
+					checkpointLifecycle(entry, lifecycleEvent(entry, 'grace-expired', at), s);
+					verifiedKill(entry, s.ctx, 'SIGKILL');
+				}
+				continue;
+			}
+			if (entry.lifecycle.state.phase === 'CANCEL_REQUESTED') {
+				checkpointLifecycle(entry, lifecycleEvent(entry, 'cancel-acknowledged', at), s);
+			} else if (entry.lifecycle.state.phase === 'FORCE_KILL_REQUESTED') {
+				checkpointLifecycle(entry, lifecycleEvent(entry, 'forced-kill-acknowledged', at, { signal: 'SIGKILL' }), s);
+			} else continue;
 			checkpointLifecycle(entry, lifecycleEvent(entry, 'reap', at, { childReaped: true }), s);
 			s.removeClaim(entry); // clear the start-time marker so a reused PID can't match it later
 		}
@@ -699,7 +717,7 @@ async function runDaemon(projectRoot, opts = {}) {
 
 	if (opts.once) {
 		const conv = await converge(projectRoot, convergeArgs);
-		if (conv.desiredCount === 0) {
+		if (daemonCanRetire(conv)) {
 			recordDaemonDiagnostic(opts, gitCommonDir, 'retired-no-open-prs');
 			await retire();
 		}
@@ -753,7 +771,7 @@ async function runDaemon(projectRoot, opts = {}) {
 			// left intact; we just stop spawning/reaping behind it.
 			if (conv && conv.leaseLost) {
 				await retireForLeaseLoss();
-			} else if (conv && conv.desiredCount === 0) {
+			} else if (daemonCanRetire(conv)) {
 				stopped = true;
 				if (timer) clearInterval(timer);
 				recordDaemonDiagnostic(opts, gitCommonDir, 'retired-no-open-prs');
