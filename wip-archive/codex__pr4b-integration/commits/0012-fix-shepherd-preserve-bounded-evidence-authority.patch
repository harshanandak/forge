     const lifecycle = String(current?.prState || current?.state || '').toUpperCase();
     if (lifecycle !== 'OPEN') return replay;
     return runFlowMonitorPass({
@@ -353,9 +418,10 @@ async function runFlowMonitorPass(ctx) {
   state = replayed.state;
   const receiptIds = replayed.receiptIds;
 
-  const next = boundSnapshotValue(await ctx.gather());
-  const previous = durableEvents.at(-1)?.payload.bounded_payload.snapshot ?? null;
-  const candidates = diffSnapshots(previous, next);
+  const gathered = await ctx.gather();
+  const next = compactSnapshot(gathered);
+  const previous = comparableSnapshot(durableEvents.at(-1)?.payload.bounded_payload.snapshot ?? null);
+  const candidates = diffSnapshots(previous, comparableSnapshot(next, gathered));
   if (candidates.length === 0) {
     return finalizePass(ctx, bridge, spec, {
       state,
