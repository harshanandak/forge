From 002dd203a0845349def3b8e9bfa8c18816356eeb Mon Sep 17 00:00:00 2001
From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Wed, 19 Aug 2026 00:05:45 +0530
Subject: [PATCH] fix: close final shepherd authority gaps

---
 lib/commands/merge.js                      |  4 +++
 lib/commands/shepherd.js                   | 21 +++++++---------
 lib/pr-monitor/reconcile-executor.js       |  2 ++
 test/commands/merge-authority.test.js      | 29 +++++++++++++++++++---
 test/commands/shepherd.test.js             | 20 ++++++++++++---
 test/pr-monitor/reconcile-executor.test.js | 24 ++++++++++++++----
 6 files changed, 77 insertions(+), 23 deletions(-)

diff --git a/lib/commands/merge.js b/lib/commands/merge.js
index 33e8c296..5272b446 100644
--- a/lib/commands/merge.js
+++ b/lib/commands/merge.js
@@ -1040,6 +1040,10 @@ function defaultMergePr({ pr, expectedHead, repository, gh = defaultGh }) {
   if (!head) throw new Error('A full 40-character expected PR head SHA is required.');
   if (!normalizePrNumber(String(pr)) || !repo) throw new Error('A canonical PR number and repository are required.');
   gh(['pr', 'merge', String(pr), '--repo', repo, '--squash', '--match-head-commit', head]);
+  const confirmed = ghJson(gh, ['pr', 'view', String(pr), '--repo', repo, '--json', 'state,headRefOid']);
+  if (confirmed?.state !== 'MERGED' || normalizeFullHeadSha(confirmed.headRefOid) !== head) {
+    return { merged: false, reason: 'provider merge is not confirmed for the exact reviewed head' };
+  }
   return { merged: true, method: 'squash' };
 }
 
diff --git a/lib/commands/shepherd.js b/lib/commands/shepherd.js
index 7a4c9bb8..0033ccb4 100644
--- a/lib/commands/shepherd.js
+++ b/lib/commands/shepherd.js
@@ -67,9 +67,9 @@ const defaultGhRunner = (cmd, a) => execFileSync(cmd, a, { encoding: 'utf8', tim
 /**
  * Resolve owner/repo and base branch for the shepherd pass.
  *
- * The base branch is read from the PR itself (`gh pr view <pr> --json
- * baseRefName`) rather than the current checkout's default branch, so PRs
- * targeting `release/*`/`develop` are evaluated against the correct branch.
+ * The exact base commit is read from the PR itself (`gh pr view <pr> --json
+ * baseRefOid`) rather than a local remote, so fork checkouts and PRs targeting
+ * `release/*`/`develop` are evaluated against the provider's reviewed base.
  * `owner`/`name` come from the repository the PR is queried in — that IS the
  * base repository. `cwd` (the worktree root) is threaded through so divergence
  * is computed against the right checkout.
@@ -78,9 +78,13 @@ const defaultGhRunner = (cmd, a) => execFileSync(cmd, a, { encoding: 'utf8', tim
  * @returns {Promise<{ pr: string, owner: string, repo: string, base: string, baseRef: string, cwd?: string }>}
  */
 async function defaultBuildContext({ pr, gh, git, projectRoot }) {
-  const prJson = gh('gh', ['pr', 'view', String(pr), '--json', 'baseRefName,headRefOid']);
+  const prJson = gh('gh', ['pr', 'view', String(pr), '--json', 'baseRefName,baseRefOid,headRefOid']);
   const prInfo = JSON.parse(prJson || '{}');
   const base = prInfo.baseRefName || 'master';
+  if (typeof prInfo.baseRefOid !== 'string' || !/^[0-9a-f]{40}$/i.test(prInfo.baseRefOid)) {
+    throw new Error('PR base commit is unavailable from the provider');
+  }
+  const baseRef = prInfo.baseRefOid.toLowerCase();
   const headSha = typeof prInfo.headRefOid === 'string' && /^[0-9a-f]{40}$/i.test(prInfo.headRefOid)
     ? prInfo.headRefOid.toLowerCase()
     : null;
@@ -90,13 +94,6 @@ async function defaultBuildContext({ pr, gh, git, projectRoot }) {
   const owner = repo.owner?.login || '';
   const name = repo.name || '';
 
-  let baseRemote;
-  try {
-    baseRemote = git('git', ['remote']).split(/\s+/).filter(Boolean)[0] || 'origin';
-  } catch (_err) {
-    baseRemote = 'origin';
-  }
-
   let localHead = null;
   try {
     const candidate = git('git', ['rev-parse', 'HEAD']).trim();
@@ -110,7 +107,7 @@ async function defaultBuildContext({ pr, gh, git, projectRoot }) {
     owner,
     repo: name,
     base,
-    baseRef: `${baseRemote}/${base}`,
+    baseRef,
     headSha,
     localHead,
     ...(projectRoot ? { cwd: projectRoot } : {}),
diff --git a/lib/pr-monitor/reconcile-executor.js b/lib/pr-monitor/reconcile-executor.js
index c4ccfff2..50b76b0b 100644
--- a/lib/pr-monitor/reconcile-executor.js
+++ b/lib/pr-monitor/reconcile-executor.js
@@ -498,6 +498,8 @@ const ACTION_HANDLERS = {
 					&& Number.isSafeInteger(cancelledAt) && at - cancelledAt >= lifecycleOptions(entry).graceMs) {
 					checkpointLifecycle(entry, lifecycleEvent(entry, 'grace-expired', at), s);
 					verifiedKill(entry, s.ctx, 'SIGKILL');
+				} else if (entry.lifecycle.state.phase === 'FORCE_KILL_REQUESTED') {
+					verifiedKill(entry, s.ctx, 'SIGKILL');
 				}
 				continue;
 			}
