index a7e51783..ae3f42ae 100644
--- a/lib/commands/merge.js
+++ b/lib/commands/merge.js
@@ -117,6 +117,29 @@ function normalizeRepository(value) {
   return typeof value === 'string' && REPOSITORY_NAME.test(value) ? value.toLowerCase() : null;
 }
 
+function defaultResolveLocalRepository({ projectRoot, git = execFileSync }) {
+  try {
+    const remote = git('git', ['remote', 'get-url', 'origin'], {
+      cwd: projectRoot,
+      encoding: 'utf8',
+      timeout: 3000,
+      stdio: ['pipe', 'pipe', 'pipe'],
+      windowsHide: true,
+    }).trim();
+    const scp = /^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+:([A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+?)(?:\.git)?$/.exec(remote);
+    if (scp) return normalizeRepository(scp[1]);
+    const parsed = new URL(remote);
+    if (!['git:', 'http:', 'https:', 'ssh:'].includes(parsed.protocol)
+      || !parsed.hostname || parsed.password || parsed.search || parsed.hash
+      || (['http:', 'https:'].includes(parsed.protocol) && parsed.username)) return null;
+    const parts = parsed.pathname.split('/').filter(Boolean);
+    if (parts.length !== 2) return null;
+    return normalizeRepository(`${parts[0]}/${parts[1].replace(/\.git$/, '')}`);
+  } catch {
+    return null;
+  }
+}
+
 function terminalEvidenceFromTrace(row, { issueId, repository, number, expectedHead }) {
