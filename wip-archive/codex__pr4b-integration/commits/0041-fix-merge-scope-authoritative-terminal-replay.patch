 ...merge-authority-review-regressions.test.js | 15 +++-
 test/commands/merge-authority.test.js         | 36 +++++++-
 3 files changed, 107 insertions(+), 31 deletions(-)

diff --git a/lib/commands/merge.js b/lib/commands/merge.js
index 6732e318..a7e51783 100644
--- a/lib/commands/merge.js
+++ b/lib/commands/merge.js
@@ -251,11 +251,14 @@ async function defaultVerifyIssueOwnership({
   };
 }
 
-function selectPrBindingRow(rows, repository, number) {
+function selectPrBindingRow(rows, repository, number, gitCommonDir = null) {
   if (!Array.isArray(rows)) return { error: 'Kernel PR linkage is unreadable.' };
-  const candidateRows = repository
+  const repositoryRows = repository
     ? rows.filter(row => normalizeRepository(row?.repo) === repository)
     : rows;
+  const candidateRows = gitCommonDir
+    ? repositoryRows.filter(row => row?.git_common_dir === gitCommonDir)
+    : repositoryRows;
   if (candidateRows.some(row => !normalizeKernelPrNumber(row.number))) {
     return { error: 'Kernel PR linkage contains a malformed PR number.' };
   }
@@ -282,12 +285,27 @@ async function openPrBindingBroker(projectRoot, buildBroker) {
 
 async function readPrBindingRows(built, allowRetired, { issueId, number, repository }) {
   if (allowRetired) {
-    const target = { issue_id: issueId, pr_number: Number(number) };
+    const target = {
+      issue_id: issueId,
+      pr_number: Number(number),
+      git_common_dir: built.gitCommonDir,
+    };
     if (repository) target.repo = repository;
     const read = await built.broker.readTrace(target);
-    return read?.pull_requests;
+    return { rows: read?.pull_requests, gaps: read?.gaps };
   }
-  return built.broker.listOpenPrs(built.gitCommonDir);
+  return { rows: await built.broker.listOpenPrs(built.gitCommonDir), gaps: [] };
+}
+
+function terminalTraceIsIncomplete(gaps, row) {
+  if (!Array.isArray(gaps)) return true;
+  const rowId = typeof row?.id === 'string' && row.id ? row.id : null;
+  return gaps.some((gap) => {
+    if (rowId && gap === `pull_requests:${rowId}:unlinked_issue`) return true;
+    if (!/^iterations:.*:(?:missing|incomplete|overflow)$/.test(gap)) return false;
+    return !rowId || ['missing', 'incomplete', 'overflow']
+      .some(suffix => gap === `iterations:${rowId}:${suffix}`);
+  });
 }
 
 async function defaultVerifyPrIssueBinding({
@@ -313,12 +331,21 @@ async function defaultVerifyPrIssueBinding({
       || typeof built.gitCommonDir !== 'string' || !built.gitCommonDir) {
       return { bound: false, error: 'Kernel PR linkage reader is unavailable.' };
     }
-    const rows = await readPrBindingRows(built, allowRetired, { issueId, number, repository });
-    const selection = selectPrBindingRow(rows, repository, number);
+    const linkage = await readPrBindingRows(built, allowRetired, { issueId, number, repository });
+    const { rows } = linkage;
+    const selection = selectPrBindingRow(
+      rows,
+      repository,
+      number,
+      allowRetired ? built.gitCommonDir : null,
+    );
     if (!selection.row) return { bound: false, error: selection.error };
     const { row } = selection;
     repository = repository || normalizeRepository(row.repo);
     const bound = (allowRetired || row.state === 'open') && row.issue_id === issueId;
+    if (allowRetired && bound && terminalTraceIsIncomplete(linkage.gaps, row)) {
+      return { bound: false, error: 'Kernel merged PR evidence is incomplete or ambiguous.' };
+    }
     const terminalEvidence = allowRetired && bound
       ? terminalEvidenceFromTrace(row, {
         issueId,
@@ -1035,6 +1062,7 @@ async function handler(args, _flags, projectRoot, deps = {}) {
   const gh = deps.gh || defaultGh;
   const exactMergeIdentity = !parsed.error && parsed.expectedHead && parsed.issueId;
   let prContext; let prState = '';
+  let preProviderReplayFailure = null;
   if (exactMergeIdentity) {
     try {
       const replay = await recoverMergedTerminal({
@@ -1049,26 +1077,15 @@ async function handler(args, _flags, projectRoot, deps = {}) {
         replayOnly: true,
       });
       if (replay.replayMissing !== true) {
-        return replay.success ? replay : { ...replay, merged: false };
+        if (replay.success) return replay;
+        preProviderReplayFailure = { ...replay, merged: false };
       }
     } catch (error) {
-      return { success: false, merged: false, error: `Merged PR terminal evidence replay failed: ${error.message}` };
-    }
-    try {
-      prContext = await fetchPrContext({ pr, projectRoot: root, gh, now: deps.now || Date.now() });
-    } catch (err) {
-      return { success: false, merged: false, error: `Failed to fetch PR context: ${err.message}` };
-    }
-    prState = prContext?.state ? String(prContext.state).toUpperCase() : '';
-    if (prState === 'MERGED') {
-      try {
-        const replay = await recoverMergedTerminal({
-          pr, parsed, root, config: {}, prContext, ownershipActor, ownershipSessionId, deps, replayOnly: true,
-        });
-        if (replay.replayMissing !== true) return replay;
-      } catch (error) {
-        return { success: false, merged: true, error: `Merged PR terminal evidence replay failed: ${error.message}` };
-      }
+      preProviderReplayFailure = {
+        success: false,
+        merged: false,
+        error: `Merged PR terminal evidence replay failed: ${error.message}`,
+      };
     }
   }
 
@@ -1094,6 +1111,26 @@ async function handler(args, _flags, projectRoot, deps = {}) {
     process.stdout.write(`${reason}\n`);
     return { success: true, merged: false, enabled: false, reason };
   }
+  if (preProviderReplayFailure) return preProviderReplayFailure;
+
+  if (exactMergeIdentity) {
+    try {
+      prContext = await fetchPrContext({ pr, projectRoot: root, gh, now: deps.now || Date.now() });
+    } catch (err) {
+      return { success: false, merged: false, error: `Failed to fetch PR context: ${err.message}` };
+    }
+    prState = prContext?.state ? String(prContext.state).toUpperCase() : '';
+    if (prState === 'MERGED') {
+      try {
+        const replay = await recoverMergedTerminal({
+          pr, parsed, root, config: {}, prContext, ownershipActor, ownershipSessionId, deps, replayOnly: true,
+        });
+        if (replay.replayMissing !== true) return replay;
+      } catch (error) {
+        return { success: false, merged: true, error: `Merged PR terminal evidence replay failed: ${error.message}` };
+      }
+    }
+  }
 
   // Opted in but no rules → refuse (fail-closed): an empty ruleset is vacuously
   // "allowed", which would merge unconditionally. Treat that as misconfiguration.
