From 0e102d62bf2ed8f0c1be1f0cad692db9c371092d Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Thu, 13 Aug 2026 09:24:00 +0530
Subject: [PATCH] fix: recover partial monitor batches

---
 lib/pr-monitor/flow-monitor.js       | 37 ++++++++++++++++++++++++----
 test/pr-monitor/flow-monitor.test.js | 25 +++++++++++++++++++
 2 files changed, 57 insertions(+), 5 deletions(-)

diff --git a/lib/pr-monitor/flow-monitor.js b/lib/pr-monitor/flow-monitor.js
index 2d623098..f3895d69 100644
--- a/lib/pr-monitor/flow-monitor.js
+++ b/lib/pr-monitor/flow-monitor.js
@@ -272,7 +272,7 @@ function monitorSpec(ctx, subjectRevision) {
   };
 }
 
-function monitorEvent(ctx, record, snapshot, subjectRevision) {
+function monitorEvent(ctx, record, snapshot, subjectRevision, checkpointComplete = true) {
   const seed = `${ctx.monitorId}:${record.seq}:${record.type}:${record.key}`;
   const boundedRecord = {
     ...boundMonitorRecord(record),
@@ -291,7 +291,7 @@ function monitorEvent(ctx, record, snapshot, subjectRevision) {
       type: record.type,
       actionability: record.type === T.SNAPSHOT_CHECKPOINT ? 'advisory' : 'action_required',
       observed_at: record.ts,
-      bounded_payload: { record: boundedRecord, snapshot },
+      bounded_payload: { record: boundedRecord, snapshot, checkpoint_complete: checkpointComplete },
     },
   );
 }
@@ -430,13 +430,21 @@ async function persistRecords(ctx, bridge, spec, {
   initialState,
   records,
   snapshot,
+  previousSnapshot,
   subjectRevision,
   timestamp,
 }) {
   let state = initialState;
   const receiptIds = [];
-  for (const record of records) {
-    const event = monitorEvent(ctx, record, snapshot, subjectRevision);
+  for (const [index, record] of records.entries()) {
+    const checkpointComplete = index === records.length - 1;
+    const event = monitorEvent(
+      ctx,
+      record,
+      checkpointComplete ? snapshot : previousSnapshot,
+      subjectRevision,
+      checkpointComplete,
+    );
     const transition = reduceMonitor(spec, state, { kind: 'observation', event });
     await bridge.persistEvent(event);
     const receipt = deliveryReceipt(ctx, event, timestamp);
@@ -512,11 +520,29 @@ async function runFlowMonitorPass(ctx, reopenDepth = 0) {
 
   const gathered = await ctx.gather();
   const next = compactSnapshot(gathered);
-  const previousSnapshot = durableEvents.at(-1)?.payload.bounded_payload.snapshot ?? null;
+  let checkpointIndex = -1;
+  for (let index = durableEvents.length - 1; index >= 0; index -= 1) {
+    if (durableEvents[index].payload.bounded_payload.checkpoint_complete !== false) {
+      checkpointIndex = index;
+      break;
+    }
+  }
+  const previousSnapshot = checkpointIndex >= 0
+    ? durableEvents[checkpointIndex].payload.bounded_payload.snapshot ?? null
+    : null;
+  const pendingEvents = durableEvents.slice(checkpointIndex + 1);
   const previous = previousSnapshot == null
     ? null
     : comparableSnapshot(compactSnapshot(previousSnapshot));
   const candidates = diffSnapshots(previous, comparableSnapshot(next, gathered));
+  for (const [index, pending] of pendingEvents.entries()) {
+    const candidate = candidates[index];
+    const record = pending.payload.bounded_payload.record;
+    if (!candidate || candidate.type !== record.type || boundIdentity(candidate.key) !== record.key) {
+      throw new FlowMonitorError('MONITOR_HISTORY_INCOMPLETE', 'Durable monitor transition batch is incomplete');
+    }
+  }
+  candidates.splice(0, pendingEvents.length);
   if (candidates.length === 0) {
     const snapshotChanged = snapshotIdentity(previousSnapshot) !== snapshotIdentity(next);
     if (snapshotChanged) {
@@ -543,6 +569,7 @@ async function runFlowMonitorPass(ctx, reopenDepth = 0) {
     initialState: state,
     records,
     snapshot: next,
+    previousSnapshot,
     subjectRevision,
     timestamp,
   });
diff --git a/test/pr-monitor/flow-monitor.test.js b/test/pr-monitor/flow-monitor.test.js
index 36a80210..a1bb341c 100644
--- a/test/pr-monitor/flow-monitor.test.js
+++ b/test/pr-monitor/flow-monitor.test.js
@@ -219,6 +219,31 @@ describe('Flow-backed PR monitor authority', () => {
     expect(deliveries).toBe(0);
   });
 
+  test('recovers the remaining transition records after a mid-batch append failure', async () => {
+    const store = durableStore();
+    const appendEvent = store.appendEvent.bind(store);
+    let appends = 0;
+    store.appendEvent = async (...args) => {
+      appends += 1;
+      if (appends === 2) throw new Error('mid-batch storage failure');
+      return appendEvent(...args);
+    };
+    const delivered = [];
+    const merged = snapshot({ prState: 'MERGED' });
+    const ctx = context(store, async () => merged, async record => delivered.push(record));
+
+    await expect(runFlowMonitorPass(ctx)).rejects.toMatchObject({ code: 'PROVIDER_UNAVAILABLE' });
+    expect(store.events.map(event => event.payload.type)).toEqual(['verdict.changed']);
+    expect(store.events[0].payload.bounded_payload.snapshot).toBeNull();
+
+    store.appendEvent = appendEvent;
+    const resumed = await runFlowMonitorPass(ctx);
+
+    expect(resumed.events.map(event => event.type)).toEqual(['pr.merged']);
+    expect(delivered.map(event => event.type)).toEqual(['verdict.changed', 'pr.merged']);
+    expect(resumed.terminalReceiptId).toBeString();
+  });
+
   test('preserves the provider root cause when durable history is unavailable', async () => {
     const store = durableStore();
     const cause = new Error('socket closed');
-- 
