Subject: [PATCH] fix: resolve fork repository merge authority

---
 lib/commands/merge.js                 |  46 ++++++++++-
 test/commands/merge-authority.test.js | 110 ++++++++++++++++++++++++++
 2 files changed, 152 insertions(+), 4 deletions(-)

diff --git a/lib/commands/merge.js b/lib/commands/merge.js
index 5272b446..b7fec881 100644
--- a/lib/commands/merge.js
+++ b/lib/commands/merge.js
@@ -286,7 +286,8 @@ function selectPrBindingRow(rows, repository, number, gitCommonDir = null) {
     return { error: 'Kernel PR linkage contains a malformed PR number.' };
   }
   const matches = candidateRows.filter(row => normalizeKernelPrNumber(row.number) === number);
-  if (matches.length !== 1) return { error: 'Kernel PR linkage is missing or ambiguous.' };
+  if (matches.length === 0) return { missing: true, error: 'Kernel PR linkage is missing.' };
+  if (matches.length > 1) return { error: 'Kernel PR linkage is ambiguous.' };
   if (!normalizeRepository(matches[0]?.repo)) return { error: 'Kernel PR repository identity is unreadable.' };
   return { row: matches[0] };
 }
@@ -320,17 +321,34 @@ async function readPrBindingRows(built, allowRetired, { issueId, number, reposit
   return { rows: await built.broker.listOpenPrs(built.gitCommonDir), gaps: [] };
 }
 
+function terminalTraceGapKind(gap) {
+  if (typeof gap !== 'string') return null;
+  if (/^(?:issue|worktree|work_folder|pull_requests|(?:plan|tasks|decisions)(?::(?:outside_project|oversized))?)$/.test(gap)) {
+    return 'benign';
+  }
+  if (gap === 'pull_requests:overflow'
+    || /^pull_requests:[^:]+:unlinked_issue$/.test(gap)
+    || /^iterations:[^:]+:(?:missing|incomplete|overflow)$/.test(gap)) {
+    return 'authority';
+  }
+  return null;
+}
+
 function terminalTraceIsIncomplete(gaps, row) {
-  if (!Array.isArray(gaps)) return true;
+  if (!Array.isArray(gaps) || gaps.some(gap => terminalTraceGapKind(gap) === null)) return true;
   const rowId = typeof row?.id === 'string' && row.id ? row.id : null;
   return gaps.some((gap) => {
     if (rowId && gap === `pull_requests:${rowId}:unlinked_issue`) return true;
-    if (!/^iterations:.*:(?:missing|incomplete|overflow)$/.test(gap)) return false;
+    if (!/^iterations:[^:]+:(?:missing|incomplete|overflow)$/.test(gap)) return false;
     return !rowId || ['missing', 'incomplete', 'overflow']
       .some(suffix => gap === `iterations:${rowId}:${suffix}`);
   });
 }
 
+function terminalTraceAbsenceIsClean(gaps) {
+  return Array.isArray(gaps) && gaps.every(gap => terminalTraceGapKind(gap) === 'benign');
+}
+
 async function defaultVerifyPrIssueBinding({
   issueId,
   pr,
@@ -362,7 +380,19 @@ async function defaultVerifyPrIssueBinding({
       number,
       allowRetired ? built.gitCommonDir : null,
     );
-    if (!selection.row) return { bound: false, error: selection.error };
+    if (!selection.row) {
+      const cleanRetiredAbsence = allowRetired && selection.missing === true
+        && terminalTraceAbsenceIsClean(linkage.gaps);
+      return {
+        bound: false,
+        error: cleanRetiredAbsence
+          ? selection.error
+          : (selection.missing === true && allowRetired
+            ? 'Kernel merged PR evidence is incomplete or ambiguous.'
+            : selection.error),
+        ...(cleanRetiredAbsence ? { missing: true } : {}),
+      };
+    }
     const { row } = selection;
     repository = repository || normalizeRepository(row.repo);
     const bound = (allowRetired || row.state === 'open') && row.issue_id === issueId;
@@ -751,6 +781,14 @@ async function recoverMergedTerminal({
   });
   const repository = normalizeRepository(prContext?.repository) || normalizeRepository(binding?.repository);
   if (binding?.bound !== true) {
+    if (replayOnly && binding?.missing === true) {
+      return {
+        success: false,
+        merged: true,
+        replayMissing: true,
+        error: 'Merged PR terminal evidence is not yet available for replay.',
+      };
+    }
     return { success: false, merged: true, error: 'Merged PR is not authoritatively linked to the supplied Forge issue.' };
   }
   if (binding.terminalEvidence) {
