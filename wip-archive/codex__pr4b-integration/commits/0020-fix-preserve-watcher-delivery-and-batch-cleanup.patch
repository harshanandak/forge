From 58cc81b88c05716d19f1ea416cd33ea4641054af Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Thu, 13 Aug 2026 03:20:06 +0530
Subject: [PATCH] fix: preserve watcher delivery and batch cleanup

---
 lib/pr-monitor/reconcile-executor.js       | 15 +++++++++++----
 lib/pr-monitor/watch.js                    |  4 +++-
 test/pr-monitor/reconcile-executor.test.js | 20 ++++++++++++++++++++
 test/pr-monitor/watch.test.js              | 22 ++++++++++++++++++++++
 4 files changed, 56 insertions(+), 5 deletions(-)

diff --git a/lib/pr-monitor/reconcile-executor.js b/lib/pr-monitor/reconcile-executor.js
index 8ad87a0b..529a9130 100644
--- a/lib/pr-monitor/reconcile-executor.js
+++ b/lib/pr-monitor/reconcile-executor.js
@@ -456,7 +456,6 @@ const ACTION_HANDLERS = {
 		s.watchers.push(entry);
 		s.writeClaim(entry);
 		if (s.persistLifecycleCheckpoint(s.watchers) === false) {
-			verifiedKill(entry, s.ctx, 'SIGKILL');
 			const error = new Error('Watcher lifecycle checkpoint persistence failed');
 			error.code = 'PROVIDER_UNAVAILABLE';
 			throw error;
@@ -571,9 +570,17 @@ async function execute(actions, ctx = {}) {
 		ctx, // verifiedKill reads isAlive/readClaim/kill/projectRoot off the original ctx
 	};
 
-	for (const action of boundedActions) {
-		const handler = ACTION_HANDLERS[action && action.type];
-		if (handler && (await handler(action, s)) === false) break;
+	const seedIdentities = new Set(watchers.map(processIdentity));
+	try {
+		for (const action of boundedActions) {
+			const handler = ACTION_HANDLERS[action && action.type];
+			if (handler && (await handler(action, s)) === false) break;
+		}
+	} catch (error) {
+		for (const entry of s.watchers.filter(watcher => !seedIdentities.has(processIdentity(watcher)))) {
+			if (verifiedKill(entry, s.ctx, 'SIGKILL')) s.removeClaim(entry);
+		}
+		throw error;
 	}
 	return s.watchers;
 }
diff --git a/lib/pr-monitor/watch.js b/lib/pr-monitor/watch.js
index 454607f9..0b0ae210 100644
--- a/lib/pr-monitor/watch.js
+++ b/lib/pr-monitor/watch.js
@@ -152,9 +152,11 @@ function confirmHeld(pending, contra, emit) {
  */
 async function runWatchPass(state, ctx, emit) {
   const monitorPass = ctx.runMonitorPass || runMonitorPass;
-  const { events, terminalReceiptId } = await monitorPass({
+  const journalCursor = ctx.dir ? journal.lastSeq(ctx.dir) : 0;
+  const { events: rawEvents, terminalReceiptId } = await monitorPass({
     ...ctx, dir: ctx.dir, gather: ctx.gather, now: ctx.now, enrich: ctx.enrich, lockOpts: ctx.lockOpts,
   });
+  const events = ctx.dir ? journal.readEventsSince(ctx.dir, journalCursor) : rawEvents;
   if (terminalReceiptId && events.length === 0) return { terminal: true };
   const { failures, terminal, others } = partition(events);
   const contra = contradictions(events);
