     const unavailable = await doctor.runDoctorReport(root, localDeps(root, {
       scopes: ['integrations'],
-      providerProbe: async () => ({ available: false, reason: 'offline' }),
+      providerProbe: async () => ({
+        available: false,
+        reason: 'tenant alice@example.com prompt unavailable in private region',
+      }),
     }));
     expect(unavailable.status).toBe('INCOMPLETE');
     expect(unavailable.checks[0].evidence.providerState).toBe('unavailable');
+    expect(unavailable.checks[0].evidence.reason).toBe('provider-unavailable');
+    expect(JSON.stringify(unavailable)).not.toContain('alice@example.com');
 
     const timeout = await doctor.runDoctorReport(root, localDeps(root, {
       scopes: ['integrations'],
@@ -156,6 +166,19 @@ describe('forge doctor health report contract', () => {
     expect(adapterConstructed).toBe(true);
     expect(probed.status).toBe('PASS');
     expect(probed.checks[0].evidence.runtimeState).toBe('public-adapter-ready');
+
+    const privateText = 'customer bob@example.com prompt failed during runtime load';
+    const unavailable = await doctor.runDoctorReport(root, localDeps(root, {
+      scopes: ['flow'],
+      loadFlow: () => { throw new Error(privateText); },
+    }));
+    expect(unavailable.status).toBe('INCOMPLETE');
+    expect(unavailable.checks[0].evidence).toEqual({
+      reason: 'flow-runtime-unavailable',
+      runtimeState: 'unavailable',
+    });
+    expect(JSON.stringify(unavailable)).not.toContain(privateText);
+    expect(JSON.stringify(unavailable)).not.toContain('bob@example.com');
   });
 
   test('local filesystem fixtures pass on Windows, macOS, and Linux', async () => {
diff --git a/test/health/doctor-runner.test.js b/test/health/doctor-runner.test.js
index 344dd8d0..a7050c9a 100644
--- a/test/health/doctor-runner.test.js
+++ b/test/health/doctor-runner.test.js
@@ -68,6 +68,27 @@ describe('Doctor health runner', () => {
     expect(serialized).toContain('<redacted-path>');
   });
 
+  test('classifies arbitrary reason and exception text without exposing customer input', async () => {
+    const privateText = 'customer jane@example.com prompt: summarize acquisition target';
+    const checks = [
+      definition('raw-reason', 'core', ['doctor'], async () => ({
+        status: 'INCOMPLETE',
+        evidence: { reason: privateText },
+      })),
+      definition('thrown-error', 'core', ['status'], async () => {
+        throw new Error(privateText);
+      }),
+    ];
+    const result = await runHealthChecks(checks, {}, { now: () => 100 });
+    const rawReason = result.checks.find(check => check.id === 'raw-reason');
+    const thrownError = result.checks.find(check => check.id === 'thrown-error');
+
+    expect(rawReason.evidence.reason).toBe('unclassified-reason');
+    expect(thrownError.evidence).toEqual({ reason: 'check-error' });
+    expect(JSON.stringify(result)).not.toContain(privateText);
+    expect(JSON.stringify(result)).not.toContain('jane@example.com');
+  });
+
   test('maps per-check timeout to INCOMPLETE without hanging', async () => {
     const checks = [definition('slow-provider', 'integrations', ['adapter'], () => new Promise(() => {}), 5)];
     const result = await runHealthChecks(checks, {}, {
