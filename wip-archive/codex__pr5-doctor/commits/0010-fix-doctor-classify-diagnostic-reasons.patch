     }));
     expect(explicit.status).toBe('INCOMPLETE');
     expect(explicit.checks).toHaveLength(1);
     expect(explicit.checks[0].id).toBe('integrations-provider');
     expect(explicit.checks[0].evidence.providerState).toBe('unsupported');
+    expect(explicit.checks[0].evidence.reason).toBe('provider-unsupported');
