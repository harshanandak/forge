+		return `${lines.join('\n')}\n`;
+	}
 	const lines = report.checks.map(formatCheckLine);
 	for (const check of report.checks) {
 		if (check.remediation) {
@@ -166,22 +369,50 @@ function formatReportText(report) {
 }
 
 async function handler(args, _flags, projectRoot, deps = {}) {
-	const report = buildDoctorReport(projectRoot, deps);
-	const output = (args || []).includes('--json')
+	const selectors = parseSelectors(args || []);
+	if (selectors.error) return { success: false, error: selectors.error };
+	const definitions = deps.healthChecks || buildHealthCheckDefinitions(projectRoot, deps);
+	if (selectors.check && !definitions.some(check => check.id === selectors.check)) {
+		return { success: false, error: `Unknown doctor check: ${selectors.check}` };
