index 00000000..b38a736a
--- /dev/null
+++ b/lib/health/doctor-manifest.js
@@ -0,0 +1,97 @@
+'use strict';
+
+// Health coverage is intentionally separate from the generated command manifest:
+// the command manifest remains the routing source of truth, while this exhaustive
+// ledger makes any new canonical family fail Doctor parity until it receives a
+// check, a shared dependency check, or a reviewed not-applicable rationale.
+const HEALTH_COVERAGE = Object.freeze({
+  adapter: { checkId: 'integrations-provider' },
+  add: { sharedDependencyCheck: 'filesystem-class' },
+  audit: { sharedDependencyCheck: 'manifest-coverage' },
+  clean: { sharedDependencyCheck: 'filesystem-class' },
+  comment: { sharedDependencyCheck: 'filesystem-class' },
+  control: { sharedDependencyCheck: 'flow-runtime' },
+  dev: { sharedDependencyCheck: 'flow-runtime' },
+  doctor: { notApplicableReason: 'Doctor is the Health orchestrator; recursively diagnosing itself is unsafe.' },
+  explain: { sharedDependencyCheck: 'manifest-coverage' },
+  export: { sharedDependencyCheck: 'filesystem-class' },
+  gate: { sharedDependencyCheck: 'filesystem-class' },
+  hooks: { sharedDependencyCheck: 'filesystem-class' },
+  inbox: { sharedDependencyCheck: 'filesystem-class' },
+  init: { sharedDependencyCheck: 'filesystem-class' },
+  issue: { sharedDependencyCheck: 'filesystem-class' },
+  memory: { checkId: 'memory-backend' },
+  migrate: { sharedDependencyCheck: 'filesystem-class' },
+  new: { sharedDependencyCheck: 'filesystem-class' },
+  options: { sharedDependencyCheck: 'manifest-coverage' },
+  orient: { sharedDependencyCheck: 'filesystem-class' },
+  patch: { sharedDependencyCheck: 'filesystem-class' },
+  plan: { sharedDependencyCheck: 'flow-runtime' },
+  pr: { sharedDependencyCheck: 'release-tooling' },
+  prime: { sharedDependencyCheck: 'filesystem-class' },
+  push: { sharedDependencyCheck: 'flow-runtime' },
+  recap: { sharedDependencyCheck: 'filesystem-class' },
+  recommend: { sharedDependencyCheck: 'manifest-coverage' },
+  release: { checkId: 'release-tooling' },
+  role: { sharedDependencyCheck: 'filesystem-class' },
+  serve: { notApplicableReason: 'Dashboard GET /health owns server liveness; Doctor does not duplicate it.' },
+  setup: { sharedDependencyCheck: 'filesystem-class' },
+  skill: { sharedDependencyCheck: 'flow-runtime' },
+  stage: { sharedDependencyCheck: 'flow-runtime' },
+  status: { notApplicableReason: 'Status is orientation, not diagnostics; Doctor retains the Health boundary.' },
+  sync: { sharedDependencyCheck: 'filesystem-class' },
+  team: { sharedDependencyCheck: 'filesystem-class' },
+  test: { sharedDependencyCheck: 'flow-runtime' },
+  upgrade: { sharedDependencyCheck: 'release-tooling' },
+  validate: { sharedDependencyCheck: 'flow-runtime' },
+  worktree: { sharedDependencyCheck: 'filesystem-class' },
+});
+
+function canonicalCommandFamilies() {
+  // Lazy requires avoid a cycle while the generated manifest is loading doctor.js.
+  const manifest = require('../commands/_manifest');
+  const { isAlias } = require('../commands/_aliases');
+  return manifest.commands
+    .map(entry => entry.module.name)
+    .filter(name => !isAlias(name))
+    .sort();
+}
+
+function hasOneDisposition(disposition) {
+  if (!disposition || typeof disposition !== 'object') return false;
+  const populated = ['checkId', 'sharedDependencyCheck', 'notApplicableReason']
+    .filter(key => typeof disposition[key] === 'string' && disposition[key].trim().length > 0);
+  return populated.length === 1;
+}
+
+function validateCoverageParity(options = {}) {
+  const canonicalFamilies = [...(options.canonicalFamilies || canonicalCommandFamilies())].sort();
+  const coverage = options.coverage || HEALTH_COVERAGE;
+  const declared = Object.keys(coverage).sort();
+  const canonical = new Set(canonicalFamilies);
+  const missing = canonicalFamilies.filter(family => !Object.hasOwn(coverage, family));
+  const stale = declared.filter(family => !canonical.has(family));
+  const malformed = declared.filter(family => !hasOneDisposition(coverage[family]));
+  return {
+    valid: missing.length === 0 && stale.length === 0 && malformed.length === 0,
+    canonicalFamilies,
+    missing,
+    stale,
+    malformed,
+  };
+}
+
+function affectedFamilies(checkId, coverage = HEALTH_COVERAGE) {
+  return Object.entries(coverage)
+    .filter(([, disposition]) => disposition.checkId === checkId
+      || disposition.sharedDependencyCheck === checkId)
+    .map(([family]) => family)
+    .sort();
+}
+
+module.exports = {
+  HEALTH_COVERAGE,
+  canonicalCommandFamilies,
+  validateCoverageParity,
+  affectedFamilies,
+};
diff --git a/lib/health/doctor-runner.js b/lib/health/doctor-runner.js
new file mode 100644
index 00000000..635d05e2
--- /dev/null
+++ b/lib/health/doctor-runner.js
@@ -0,0 +1,143 @@
+'use strict';
+
+const SCOPES = Object.freeze(['core', 'memory', 'flow', 'integrations', 'release']);
+const STATUS_WEIGHT = Object.freeze({ PASS: 0, WARN: 1, INCOMPLETE: 2, FAIL: 3 });
+const DEFAULT_PER_CHECK_TIMEOUT_MS = 1000;
+const DEFAULT_GLOBAL_TIMEOUT_MS = 4000;
+const DEFAULT_CONCURRENCY = 4;
+
+const SECRET_PATTERNS = [
+  /gh[pousr]_[A-Za-z0-9]{20,}/g,
+  /sk_(?:live|test)_[A-Za-z0-9]{16,}/g,
+  /sk-[A-Za-z0-9]{16,}/g,
+  /AKIA[0-9A-Z]{16}/g,
+  /\b(api[_-]?key|token|secret|password)\s*[:=]\s*[^\s,;]+/gi,
+];
+const USER_PATH_PATTERNS = [
+  /\b[A-Za-z]:\\Users\\[^\\\s]+(?:\\[^\s"'<>|]*)?/g,
+  /\/(?:Users|home)\/[^/\s]+(?:\/[^\s"']*)?/g,
+];
+
+function redactString(value) {
+  let redacted = String(value).slice(0, 500);
+  for (const pattern of SECRET_PATTERNS) redacted = redacted.replace(pattern, '<redacted>');
+  for (const pattern of USER_PATH_PATTERNS) redacted = redacted.replace(pattern, '<redacted-path>');
+  return redacted;
+}
+
+function sanitize(value, depth = 0) {
+  if (value == null || typeof value === 'boolean' || typeof value === 'number') return value;
+  if (typeof value === 'string') return redactString(value);
+  if (depth >= 4) return '<bounded>';
+  if (Array.isArray(value)) return value.slice(0, 20).map(item => sanitize(item, depth + 1));
+  if (typeof value !== 'object') return redactString(value);
+
+	const output = {};
+	for (const key of Object.keys(value).sort().slice(0, 30)) {
+		output[key] = /prompt/i.test(key) ? '<redacted>' : sanitize(value[key], depth + 1);
+	}
+  return output;
+}
+
+function timeoutResult(reason) {
+  return {
+    status: 'INCOMPLETE',
+    evidence: { reason },
+    remediation: 'Re-run this check explicitly after the unavailable dependency or deadline is resolved.',
+  };
+}
+
+async function runWithTimeout(run, timeoutMs) {
+  let timer;
+  try {
+    return await Promise.race([
+      Promise.resolve().then(run),
+      new Promise(resolve => {
+        timer = setTimeout(() => resolve(timeoutResult('timeout')), timeoutMs);
+      }),
+    ]);
+  } finally {
+    if (timer) clearTimeout(timer);
+  }
+}
+
+function normalizeResult(definition, raw, durationMs) {
+  const status = Object.hasOwn(STATUS_WEIGHT, raw?.status) ? raw.status : 'INCOMPLETE';
+  return {
+    id: definition.id,
+    version: definition.version,
+    owner: definition.owner,
+    scope: definition.scope,
+    affectedCommandFamilies: [...(definition.affectedCommandFamilies || [])].sort(),
+    status,
+    durationMs: Math.max(0, Number(durationMs) || 0),
+    evidence: sanitize(raw?.evidence || { reason: 'check-returned-no-evidence' }),
+    remediation: redactString(raw?.remediation || ''),
+  };
+}
+
+async function runOne(definition, context, options, startedAt) {
+  const now = options.now || Date.now;
+  const globalTimeoutMs = options.globalTimeoutMs || DEFAULT_GLOBAL_TIMEOUT_MS;
+  const elapsed = Math.max(0, now() - startedAt);
+  const remaining = Math.max(1, globalTimeoutMs - elapsed);
+  const timeoutMs = Math.max(1, Math.min(
+    definition.timeoutMs || options.perCheckTimeoutMs || DEFAULT_PER_CHECK_TIMEOUT_MS,
+    remaining,
+  ));
+  const checkStarted = now();
+  let raw;
+  try {
+    raw = await runWithTimeout(() => definition.run(context), timeoutMs);
+  } catch (error) {
+    raw = {
+      status: 'INCOMPLETE',
+      evidence: { reason: 'check-error', message: error?.message || String(error) },
+      remediation: 'Resolve the local diagnostic error and re-run this check.',
+    };
+  }
+  return normalizeResult(definition, raw, now() - checkStarted);
+}
+
+function overallStatus(checks) {
+  return checks.reduce((current, check) => (
+    STATUS_WEIGHT[check.status] > STATUS_WEIGHT[current] ? check.status : current
+  ), 'PASS');
+}
+
+async function runHealthChecks(definitions, context = {}, options = {}) {
+  const now = options.now || Date.now;
+  const startedAt = now();
+  const results = new Array(definitions.length);
+  let nextIndex = 0;
+  const concurrency = Math.max(1, Math.min(
+    Number(options.concurrency) || DEFAULT_CONCURRENCY,
+    definitions.length || 1,
+  ));
+
+  async function worker() {
+    while (nextIndex < definitions.length) {
+      const index = nextIndex;
+      nextIndex += 1;
+      results[index] = await runOne(definitions[index], context, options, startedAt);
+    }
+  }
+
+  await Promise.all(Array.from({ length: concurrency }, () => worker()));
+  const scopeOrder = new Map(SCOPES.map((scope, index) => [scope, index]));
+  results.sort((left, right) => (
+    scopeOrder.get(left.scope) - scopeOrder.get(right.scope) || left.id.localeCompare(right.id)
+  ));
+  return {
+    checks: results,
+    status: overallStatus(results),
+    durationMs: Math.max(0, now() - startedAt),
+  };
+}
+
+module.exports = {
+  SCOPES,
+  runHealthChecks,
+  redactString,
+  sanitize,
+};
