+					status: parity.valid ? 'PASS' : 'FAIL',
+					evidence: {
+						canonicalFamilyCount: parity.canonicalFamilies.length,
+						missing: parity.missing,
+						stale: parity.stale,
+						malformed: parity.malformed,
+					},
+					remediation: parity.valid ? '' : 'Add one Health disposition for every missing canonical command family.',
