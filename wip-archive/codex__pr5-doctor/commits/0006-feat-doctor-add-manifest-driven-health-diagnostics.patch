+const { describe, expect, test } = require('bun:test');
+const { validateCoverageParity } = require('../../lib/health/doctor-manifest');
+
+describe('Doctor health manifest', () => {
+  test('exhaustively covers every canonical non-alias command family', () => {
+    const parity = validateCoverageParity();
+    expect(parity.valid).toBe(true);
+    expect(parity.missing).toEqual([]);
+    expect(parity.stale).toEqual([]);
+    expect(parity.canonicalFamilies.length).toBeGreaterThan(0);
+    expect(parity.canonicalFamilies).toEqual([...parity.canonicalFamilies].sort());
+  });
+
+  test('fails parity when a canonical command family has no disposition', () => {
+    const parity = validateCoverageParity({
+      canonicalFamilies: ['doctor', 'future-command'],
+    });
+    expect(parity.valid).toBe(false);
+    expect(parity.missing).toEqual(['future-command']);
+  });
+});
