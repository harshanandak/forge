+	if (selectedDefinition?.network && !selectors.scopes.includes('integrations')) {
+		return { success: false, error: `Doctor check ${selectors.check} requires --scope integrations.` };
+	}
+	if (selectors.check && selectors.scopes.length > 0) {
+		if (!selectors.scopes.includes(selectedDefinition.scope)) {
+			return { success: false, error: `Doctor check ${selectors.check} is not in the selected scope.` };
+		}
+	}
+	const report = await runDoctorReport(projectRoot, {
+		...deps,
+		scopes: selectors.scopes,
