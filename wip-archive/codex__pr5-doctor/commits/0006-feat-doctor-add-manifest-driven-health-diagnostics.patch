+			run: async () => {
+				const check = buildMemoryCheck(projectRoot, deps.env || process.env);
+				return {
+					status: check.ok ? 'PASS' : 'WARN',
+					evidence: { backend: check.backend, detail: check.detail },
+					remediation: check.ok ? '' : 'Repair the selected local memory backend configuration, then re-run Doctor.',
+				};
+			},
+		},
+		{
+			id: 'flow-runtime', version: 1, owner: 'forge.flow', scope: 'flow', default: true,
+			affectedCommandFamilies: affectedFamilies('flow-runtime'),
+			run: async () => {
+				const present = fs.existsSync(packageFile('packages', 'flow', 'package.json'));
+				return {
+					status: present ? 'PASS' : 'INCOMPLETE',
+					evidence: { packagePresent: present },
+					remediation: present ? '' : 'Install a Forge distribution containing the Flow package.',
+				};
+			},
+		},
+		{
+			id: 'integrations-provider', version: 1, owner: 'forge.integrations', scope: 'integrations', default: false,
+			network: true,
+			affectedCommandFamilies: affectedFamilies('integrations-provider'),
+			run: async () => runProviderCheck(deps),
+		},
+		{
+			id: 'release-tooling', version: 1, owner: 'forge.release', scope: 'release', default: true,
+			affectedCommandFamilies: affectedFamilies('release-tooling'),
+			run: async () => {
+				const packageJson = require('../../package.json');
+				const requiredBins = ['forge', 'forge-preflight', 'forge-workflow'];
+				const missingBins = requiredBins.filter(bin => typeof packageJson.bin?.[bin] !== 'string');
+				return {
+					status: missingBins.length === 0 ? 'PASS' : 'FAIL',
+					evidence: { requiredBins, missingBins },
+					remediation: missingBins.length === 0 ? '' : 'Restore the supported Forge compatibility binaries.',
+				};
+			},
+		},
+	];
+}
+
+async function runProviderCheck(deps) {
+	if (typeof deps.providerProbe !== 'function') {
+		return {
+			status: 'INCOMPLETE',
+			evidence: { providerState: 'unsupported', reason: 'no safe provider probe adapter' },
+			remediation: 'Install or configure a supported provider adapter, then re-run with --scope integrations.',
+		};
+	}
+	const probe = await deps.providerProbe();
+	if (probe?.notApplicable) {
+		return { status: 'PASS', evidence: { providerState: 'not-applicable' }, remediation: '' };
+	}
+	if (probe?.supported === false) {
+		return {
+			status: 'INCOMPLETE',
+			evidence: { providerState: 'unsupported', reason: probe.reason || 'unsupported' },
+			remediation: 'Use a provider version with a side-effect-free probe adapter.',
+		};
+	}
+	if (probe?.available === false) {
+		return {
+			status: 'WARN',
+			evidence: { providerState: 'unavailable', reason: probe.reason || 'unavailable' },
+			remediation: 'Check provider availability and credentials outside Doctor, then retry explicitly.',
+		};
+	}
+	if (probe?.failed) {
+		return {
+			status: 'FAIL',
+			evidence: { providerState: 'failed', reason: probe.reason || 'probe failed' },
+			remediation: 'Repair the provider integration and retry the explicit check.',
+		};
+	}
+	return { status: 'PASS', evidence: { providerState: 'available' }, remediation: '' };
+}
+
+function selectHealthChecks(definitions, deps = {}) {
+	const requestedScopes = Array.isArray(deps.scopes) ? deps.scopes : [];
+	if (deps.check) return definitions.filter(check => check.id === deps.check);
+	if (requestedScopes.length > 0) {
+		const selected = new Set(requestedScopes);
+		return definitions.filter(check => selected.has(check.scope));
+	}
+	if (deps.healthChecks) return definitions;
+	return definitions.filter(check => check.default);
+}
+
+async function runDoctorReport(projectRoot, deps = {}) {
+	const definitions = deps.healthChecks || buildHealthCheckDefinitions(projectRoot, deps);
+	const selected = selectHealthChecks(definitions, deps);
+	const execution = await runHealthChecks(selected, { projectRoot }, deps);
+	const status = execution.status;
+	return {
+		schema: 'forge.doctor.v1',
+		schemaVersion: SCHEMA_VERSION,
+		command: 'doctor',
+		status,
+		ok: status === 'PASS' || status === 'WARN',
+		scopes: SCOPES.filter(scope => selected.some(check => check.scope === scope)),
+		durationMs: execution.durationMs,
+		checks: execution.checks,
+	};
+}
+
+function parseSelectors(args = []) {
+	const selectors = { scopes: [], check: null, json: false };
+	for (let index = 0; index < args.length; index += 1) {
+		const arg = args[index];
+		if (arg === '--json') {
+			selectors.json = true;
+			continue;
+		}
+		if (arg === '--scope' || arg.startsWith('--scope=')) {
+			const value = arg.startsWith('--scope=') ? arg.slice('--scope='.length) : args[++index];
+			if (!SCOPES.includes(value)) return { error: `Invalid doctor scope: ${value || '<missing>'}` };
+			selectors.scopes.push(value);
+			continue;
+		}
+		if (arg === '--check' || arg.startsWith('--check=')) {
+			const value = arg.startsWith('--check=') ? arg.slice('--check='.length) : args[++index];
+			if (!value) return { error: 'Unknown doctor check: <missing>' };
+			selectors.check = value;
+		}
+	}
+	selectors.scopes = [...new Set(selectors.scopes)];
+	return selectors;
+}
+
 function formatCheckLine(check) {
 	if (check.id === 'memory-backend') {
 		return `${check.ok ? '✓' : '!'} ${check.detail}`;
@@ -155,6 +346,18 @@ function formatCheckLine(check) {
 }
 
