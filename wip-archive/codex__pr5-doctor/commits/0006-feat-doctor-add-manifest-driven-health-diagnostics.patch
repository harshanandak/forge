+'use strict';
+
+const { describe, expect, test } = require('bun:test');
+const { runHealthChecks } = require('../../lib/health/doctor-runner');
+
+function definition(id, scope, affectedCommandFamilies, run, timeoutMs) {
+  return { id, version: 1, owner: 'forge.test', scope, affectedCommandFamilies, run, timeoutMs };
+}
+
+describe('Doctor health runner', () => {
+  test('uses deterministic scope/id and affected-family ordering', async () => {
+    const checks = [
+      definition('z-release', 'release', ['zeta', 'alpha'], async () => ({ status: 'PASS', evidence: { ready: true } })),
+      definition('b-core', 'core', ['doctor'], async () => ({ status: 'PASS', evidence: { ready: true } })),
+      definition('a-core', 'core', ['status'], async () => ({ status: 'PASS', evidence: { ready: true } })),
+    ];
+    const result = await runHealthChecks(checks, {}, { now: () => 100 });
+    expect(result.checks.map(check => check.id)).toEqual(['a-core', 'b-core', 'z-release']);
+    expect(result.checks[2].affectedCommandFamilies).toEqual(['alpha', 'zeta']);
+  });
+
+  test('redacts secrets, prompts, and user-home paths before serialization', async () => {
+    const checks = [definition('redaction', 'core', ['doctor'], async () => ({
+      status: 'WARN',
+      evidence: {
+        token: 'ghp_abcdefghijklmnopqrstuvwxyz123456',
+        path: String.raw`C:\Users\alice\private\config.json`,
+        rawPrompt: 'do the private thing with customer data',
+      },
+      remediation: 'Remove token=super-secret-value from C:\\Users\\alice\\private\\config.json',
+    }))];
+    const result = await runHealthChecks(checks, {}, { now: () => 100 });
+    const serialized = JSON.stringify(result);
+    expect(serialized).not.toContain('ghp_abcdefghijklmnopqrstuvwxyz123456');
+    expect(serialized).not.toContain('super-secret-value');
+    expect(serialized).not.toContain('C:\\\\Users\\\\alice');
+    expect(serialized).not.toContain('do the private thing with customer data');
+    expect(serialized).toContain('<redacted>');
+    expect(serialized).toContain('<redacted-path>');
+  });
+
+  test('maps per-check timeout to INCOMPLETE without hanging', async () => {
+    const checks = [definition('slow-provider', 'integrations', ['adapter'], () => new Promise(() => {}), 5)];
+    const result = await runHealthChecks(checks, {}, {
+      perCheckTimeoutMs: 5,
+      globalTimeoutMs: 20,
+    });
+    expect(result.status).toBe('INCOMPLETE');
+    expect(result.checks[0].status).toBe('INCOMPLETE');
+    expect(result.checks[0].evidence.reason).toBe('timeout');
+  });
+});
