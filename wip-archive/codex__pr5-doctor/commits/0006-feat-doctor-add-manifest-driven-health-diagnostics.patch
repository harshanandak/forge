+'use strict';
+
+const { afterEach, describe, expect, test } = require('bun:test');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+
+const doctor = require('../../lib/commands/doctor');
+
+const tempDirs = [];
+
+function makeProjectRoot(label) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), `forge-doctor-health-${label}-`));
+  tempDirs.push(root);
+  return root;
+}
+
+function localDeps(projectRoot, extra = {}) {
+  return {
+    env: {},
+    gitCommonDir: path.join(projectRoot, '.git'),
+    classifyFilesystem: () => ({
+      class: 'local-ok', riskTier: 'safe', signal: 'none', remediationKey: 'local-ok',
+    }),
+    now: () => 100,
+    ...extra,
+  };
+}
+
+afterEach(() => {
+  while (tempDirs.length > 0) {
+    fs.rmSync(tempDirs.pop(), { recursive: true, force: true });
+  }
+});
+
+describe('forge doctor health report contract', () => {
+  test('returns a versioned PASS report with stable per-check fields', async () => {
+    const root = makeProjectRoot('schema');
+    const report = await doctor.runDoctorReport(root, localDeps(root));
+
+    expect(report.schema).toBe('forge.doctor.v1');
+    expect(report.schemaVersion).toBe(1);
+    expect(report.command).toBe('doctor');
+    expect(report.status).toBe('PASS');
+    expect(report.ok).toBe(true);
+    expect(report.checks.length).toBeGreaterThan(0);
+    for (const check of report.checks) {
+      expect(typeof check.id).toBe('string');
+      expect(check.version).toBe(1);
+      expect(typeof check.owner).toBe('string');
+      expect(['core', 'memory', 'flow', 'integrations', 'release']).toContain(check.scope);
+      expect(Array.isArray(check.affectedCommandFamilies)).toBe(true);
+      expect(['PASS', 'WARN', 'FAIL', 'INCOMPLETE']).toContain(check.status);
+      expect(typeof check.durationMs).toBe('number');
+      expect(check.evidence).toBeDefined();
+      expect(typeof check.remediation).toBe('string');
+    }
+  });
+
+  test('provider/network checks run only under explicit integrations scope', async () => {
+    const root = makeProjectRoot('provider');
+    const defaultReport = await doctor.runDoctorReport(root, localDeps(root));
+    expect(defaultReport.checks.some(check => check.scope === 'integrations')).toBe(false);
+
+    const explicit = await doctor.runDoctorReport(root, localDeps(root, {
+      scopes: ['integrations'],
+      providerProbe: async () => ({ supported: false, reason: 'no safe adapter' }),
+    }));
+    expect(explicit.status).toBe('INCOMPLETE');
+    expect(explicit.checks).toHaveLength(1);
+    expect(explicit.checks[0].id).toBe('integrations-provider');
+    expect(explicit.checks[0].evidence.providerState).toBe('unsupported');
+  });
+
+  test('local filesystem fixtures pass on Windows, macOS, and Linux', async () => {
+    for (const platform of ['win32', 'darwin', 'linux']) {
+      const root = makeProjectRoot(platform);
+      const report = await doctor.runDoctorReport(root, localDeps(root, {
+        platform,
+        scopes: ['core'],
+      }));
+      const filesystem = report.checks.find(check => check.id === 'filesystem-class');
+      expect(filesystem.status).toBe('PASS');
+      expect(filesystem.evidence.platform).toBe(platform);
+    }
+  });
+});
+
+describe('forge doctor selectors and side effects', () => {
+  test('rejects invalid scope and check selectors before running checks', async () => {
+    const root = makeProjectRoot('selectors');
+    const badScope = await doctor.handler(['--scope', 'remote'], {}, root, localDeps(root));
+    expect(badScope.success).toBe(false);
+    expect(badScope.error).toContain('Invalid doctor scope');
+
+    const badCheck = await doctor.handler(['--check=missing-check'], {}, root, localDeps(root));
+    expect(badCheck.success).toBe(false);
+    expect(badCheck.error).toContain('Unknown doctor check');
+
+    const implicitProvider = await doctor.handler(
+      ['--check', 'integrations-provider'], {}, root, localDeps(root),
+    );
+    expect(implicitProvider.success).toBe(false);
+    expect(implicitProvider.error).toContain('requires --scope integrations');
+  });
+
+  test('default execution creates no project or authority files', async () => {
+    const root = makeProjectRoot('no-side-effects');
+    const before = fs.readdirSync(root);
+    const result = await doctor.handler(['--json'], {}, root, localDeps(root));
+    const after = fs.readdirSync(root);
+
+    expect(result.success).toBe(true);
+    expect(before).toEqual([]);
+    expect(after).toEqual([]);
+    expect(fs.existsSync(path.join(root, '.forge'))).toBe(false);
+  });
+});
