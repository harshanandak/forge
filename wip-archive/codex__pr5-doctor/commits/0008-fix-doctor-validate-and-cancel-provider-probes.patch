+  test('provider responses fail closed unless they match a strict result shape', async () => {
+    const root = makeProjectRoot('provider-shape');
+    for (const response of [undefined, null, {}, 'available', [], { available: true }]) {
+      const report = await doctor.runDoctorReport(root, localDeps(root, {
+        scopes: ['integrations'],
+        providerProbe: async () => response,
+      }));
+      expect(report.status).toBe('INCOMPLETE');
+      expect(report.checks[0].evidence.providerState).toBe('invalid-response');
+    }
+
+    const valid = await doctor.runDoctorReport(root, localDeps(root, {
+      scopes: ['integrations'],
+      providerProbe: async () => ({ supported: true, available: true, failed: false }),
+    }));
+    expect(valid.status).toBe('PASS');
+  });
+
+  test('provider timeout supplies and aborts an AbortSignal for cooperative cleanup', async () => {
+    const root = makeProjectRoot('provider-abort');
+    let receivedSignal;
+    let providerActive = false;
+    const report = await doctor.runDoctorReport(root, localDeps(root, {
+      scopes: ['integrations'],
+      perCheckTimeoutMs: 5,
+      globalTimeoutMs: 20,
+      providerProbe: ({ signal }) => new Promise(resolve => {
+        receivedSignal = signal;
+        providerActive = true;
+        const providerTimer = setInterval(() => {}, 1000);
+        signal.addEventListener('abort', () => {
+          clearInterval(providerTimer);
+          providerActive = false;
+          resolve({ supported: true, available: true, failed: false });
+        }, { once: true });
+      }),
+    }));
+    expect(receivedSignal).toBeInstanceOf(AbortSignal);
+    expect(receivedSignal.aborted).toBe(true);
+    expect(providerActive).toBe(false);
+    expect(report.status).toBe('INCOMPLETE');
+    expect(report.checks[0].evidence.abortRequested).toBe(true);
+    expect(report.checks[0].evidence.isolation).toBe('cooperative-abort');
+  });
+
