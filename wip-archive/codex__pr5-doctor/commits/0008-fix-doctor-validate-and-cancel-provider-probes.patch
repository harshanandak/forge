-function timeoutResult(reason) {
+function timeoutResult(reason, options = {}) {
   return {
     status: 'INCOMPLETE',
-    evidence: { reason },
-    remediation: 'Re-run this check explicitly after the unavailable dependency or deadline is resolved.',
+    evidence: {
+      reason,
+      abortRequested: Boolean(options.abortRequested),
+      isolation: options.isolation || 'not-started',
+    },
+    remediation: options.abortRequested
+      ? 'The deadline requested cooperative cancellation; non-cooperative in-process work cannot be forcibly isolated.'
+      : 'Re-run this check explicitly after the unavailable dependency or deadline is resolved.',
   };
 }
 
-async function runWithTimeout(run, timeoutMs) {
+async function runWithTimeout(run, timeoutMs, reason, options) {
+  const controller = new AbortController();
+  const schedule = options.setTimeout || setTimeout;
+  const cancel = options.clearTimeout || clearTimeout;
   let timer;
   try {
     return await Promise.race([
-      Promise.resolve().then(run),
+      Promise.resolve().then(() => run(controller.signal)),
       new Promise(resolve => {
-        timer = setTimeout(() => resolve(timeoutResult('timeout')), timeoutMs);
+        timer = schedule(() => {
+          resolve(timeoutResult(reason, {
+            abortRequested: true,
+            isolation: 'cooperative-abort',
+          }));
+          controller.abort(reason);
+        }, timeoutMs);
       }),
     ]);
   } finally {
-    if (timer) clearTimeout(timer);
+    if (timer !== undefined) cancel(timer);
   }
 }
 
@@ -86,10 +104,19 @@ async function runOne(definition, context, options, startedAt) {
     definition.timeoutMs || options.perCheckTimeoutMs || DEFAULT_PER_CHECK_TIMEOUT_MS,
     remaining,
   ));
+  const timeoutReason = remaining <= (definition.timeoutMs
+    || options.perCheckTimeoutMs || DEFAULT_PER_CHECK_TIMEOUT_MS)
+    ? 'global-deadline'
+    : 'timeout';
   const checkStarted = now();
   let raw;
   try {
-    raw = await runWithTimeout(() => definition.run(context), timeoutMs);
+    raw = await runWithTimeout(
+      signal => definition.run({ ...context, signal }),
+      timeoutMs,
+      timeoutReason,
+      options,
+    );
   } catch (error) {
     raw = {
       status: 'INCOMPLETE',
diff --git a/test/commands/doctor-health.test.js b/test/commands/doctor-health.test.js
