 	}
 }
 
-async function runProviderCheck(deps) {
+const PROVIDER_RESULT_KEYS = new Set(['available', 'failed', 'notApplicable', 'reason', 'supported']);
+
+function validateProviderResult(value) {
+	try {
+		if (!value || typeof value !== 'object' || Array.isArray(value)
+			|| Object.getPrototypeOf(value) !== Object.prototype) {
+			return { valid: false };
+		}
+		const keys = Object.keys(value);
+		if (keys.some(key => !PROVIDER_RESULT_KEYS.has(key))) return { valid: false };
+		const data = Object.create(null);
+		for (const key of keys) {
+			const descriptor = Object.getOwnPropertyDescriptor(value, key);
+			if (!descriptor || !Object.hasOwn(descriptor, 'value')) return { valid: false };
+			if (key === 'reason' && typeof descriptor.value !== 'string') return { valid: false };
+			if (key !== 'reason' && typeof descriptor.value !== 'boolean') return { valid: false };
+			data[key] = descriptor.value;
+		}
+		if (data.notApplicable === true && keys.every(key => ['notApplicable', 'reason'].includes(key))) {
+			return { valid: true, state: 'not-applicable', reason: data.reason };
+		}
+		if (data.supported === false && keys.every(key => ['supported', 'reason'].includes(key))) {
+			return { valid: true, state: 'unsupported', reason: data.reason };
+		}
+		if (data.available === false && data.failed === undefined && data.notApplicable === undefined
+			&& (data.supported === undefined || data.supported === true)) {
+			return { valid: true, state: 'unavailable', reason: data.reason };
+		}
+		if (data.failed === true && data.notApplicable === undefined && data.supported !== false
+			&& data.available !== false) {
+			return { valid: true, state: 'failed', reason: data.reason };
+		}
+		if (data.supported === true && data.available === true && data.failed === false
+			&& data.notApplicable === undefined) {
+			return { valid: true, state: 'available' };
+		}
+		return { valid: false };
+	} catch {
+		return { valid: false };
+	}
+}
+
+async function runProviderCheck(deps, signal) {
 	if (typeof deps.providerProbe !== 'function') {
 		return {
 			status: 'INCOMPLETE',
@@ -271,28 +313,36 @@ async function runProviderCheck(deps) {
 			remediation: 'Install or configure a supported provider adapter, then re-run with --scope integrations.',
 		};
 	}
-	const probe = await deps.providerProbe();
-	if (probe?.notApplicable) {
+	const probe = await deps.providerProbe({ signal });
+	const validation = validateProviderResult(probe);
+	if (!validation.valid) {
+		return {
+			status: 'INCOMPLETE',
+			evidence: { providerState: 'invalid-response' },
+			remediation: 'Update the provider probe to return one documented, explicit provider state.',
+		};
+	}
+	if (validation.state === 'not-applicable') {
 		return { status: 'PASS', evidence: { providerState: 'not-applicable' }, remediation: '' };
 	}
-	if (probe?.supported === false) {
+	if (validation.state === 'unsupported') {
 		return {
 			status: 'INCOMPLETE',
-			evidence: { providerState: 'unsupported', reason: probe.reason || 'unsupported' },
+			evidence: { providerState: 'unsupported', reason: validation.reason || 'unsupported' },
 			remediation: 'Use a provider version with a side-effect-free probe adapter.',
 		};
 	}
-	if (probe?.available === false) {
+	if (validation.state === 'unavailable') {
 		return {
 			status: 'INCOMPLETE',
-			evidence: { providerState: 'unavailable', reason: probe.reason || 'unavailable' },
+			evidence: { providerState: 'unavailable', reason: validation.reason || 'unavailable' },
 			remediation: 'Check provider availability and credentials outside Doctor, then retry explicitly.',
 		};
 	}
-	if (probe?.failed) {
+	if (validation.state === 'failed') {
 		return {
 			status: 'FAIL',
-			evidence: { providerState: 'failed', reason: probe.reason || 'probe failed' },
+			evidence: { providerState: 'failed', reason: validation.reason || 'probe failed' },
 			remediation: 'Repair the provider integration and retry the explicit check.',
 		};
 	}
