Subject: [PATCH] fix(test): retain shard exit diagnostics

---
 scripts/test-full-suite.js           |  46 +++++++++--
 test/scripts/test-full-suite.test.js | 111 ++++++++++++++++++++++++++-
 2 files changed, 148 insertions(+), 9 deletions(-)

diff --git a/scripts/test-full-suite.js b/scripts/test-full-suite.js
index 0d4f3a63..a8213b0f 100644
--- a/scripts/test-full-suite.js
+++ b/scripts/test-full-suite.js
@@ -22,6 +22,7 @@ const {
 } = require('./test-profile');
