+const path = require('node:path');
+
+const ROOT = path.resolve(__dirname, '../..');
+
+function skill(name) {
+  return fs.readFileSync(path.join(ROOT, 'skills', name, 'SKILL.md'), 'utf8');
+}
+
+describe('release critical-path skill contract', () => {
+  test('protected approvals bind to immutable commits; snapshots remain advisory', () => {
+    const dev = skill('dev');
+    const review = skill('review');
+
+    expect(dev).toContain('COMMIT:<full 40-character SHA>');
+    expect(dev).toContain('SNAPSHOT:<sha256');
+    expect(dev).toContain('authority: PROTECTED | ADVISORY');
+    expect(dev).toContain('Only `COMMIT` + `PROTECTED` may produce shipping approval');
+    expect(dev).not.toContain('exact candidate commit or WORKTREE');
+    expect(review).toContain('full 40-character head SHA');
+    expect(review).toContain('never count as protected approval');
+  });
+
