index 06826d1d..0d0bfd46 100644
--- a/packages/flow/test/monitor-runtime.test.js
+++ b/packages/flow/test/monitor-runtime.test.js
@@ -74,6 +74,32 @@ describe("MonitorSpec deterministic reducer", () => {
     expect(result.modelTurns).toBe(1);
   });
 
