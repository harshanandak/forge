From 3bbdff2a62ea3e3e4ac53478f9e9408543032261 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Tue, 14 Jul 2026 16:59:16 +0530
Subject: [PATCH] fix(security): resolve git via secureExecFileSync in
 lefthook-wiring (SonarCloud S4036)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SonarCloud flagged javascript:S4036 (VULNERABILITY, Security rating B on new code) at
lib/lefthook-wiring.js: spawning `git` by bare name lets the OS search PATH, which may
contain a writable directory. Use the codebase's shared secureExecFileSync (lib/shell-utils),
which resolves the command to its absolute path via which/where.exe before executing — the
same convention husky-migration.js already uses — so no PATH search happens.

projectRoot is still passed only as an execFile ARGUMENT (never a shell string), so there is
no command-injection surface. Behavior is unchanged: resolveGitHooksDir still asks git for the
core.hooksPath-aware hooks dir and falls back to the filesystem logic on any failure. All
lefthook-wiring + live-handler e2e tests still pass (26/26).

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 lib/lefthook-wiring.js | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/lib/lefthook-wiring.js b/lib/lefthook-wiring.js
index dce9e10e..e9131cdf 100644
--- a/lib/lefthook-wiring.js
+++ b/lib/lefthook-wiring.js
@@ -25,7 +25,9 @@
 
 const fs = require('node:fs');
 const path = require('node:path');
-const { execFileSync } = require('node:child_process');
+// Shared secure spawner: resolves the command to its absolute path (which/where.exe)
+// before executing, so we never search a potentially-writable PATH for `git` (S4036).
+const { secureExecFileSync } = require('./shell-utils');
 
 // Sentinel embedded in every native hook Forge writes. Lets verifyHooksActive
 // distinguish a Forge-managed hook from a lefthook-managed one or a user's own.
@@ -115,12 +117,15 @@ function resolveGitHooksDir(projectRoot) {
 // null on any failure (git missing, not a repo) so the filesystem fallback can run.
 function resolveHooksDirViaGit(projectRoot) {
   try {
-    const out = execFileSync(
+    // secureExecFileSync resolves `git` to its absolute path first (no PATH search, S4036).
+    // projectRoot is passed as an ARGUMENT to execFile (never a shell string), so it cannot
+    // be interpreted as a command — no command-injection surface.
+    const out = secureExecFileSync(
       'git',
       ['-C', projectRoot, 'rev-parse', '--path-format=absolute', '--git-path', 'hooks'],
       { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }
-    ).trim();
-    return out || null;
+    );
+    return (typeof out === 'string' && out.trim()) ? out.trim() : null;
   } catch {
     return null;
   }
