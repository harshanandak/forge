+
   if (intent === 'protected-path') {
+    if (protectedPathsOff) return { decision: 'allow' };
     const target = extractPath(input);
     if (isProtectedPath(target)) {
       return {
@@ -162,6 +250,8 @@ function decide({ intent, input, runTddCheck = runInstalledTddCheck }) {
   }
 
   if (intent === 'tdd-gate') {
