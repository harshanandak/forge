 .forge/hooks/forge-native-hook.js      | 71 ++++++++++++++++++++++----
 lib/commands/setup.js                  | 31 ++++++++++-
 test/forge-native-hook.test.js         | 33 ++++++++++++
 test/setup-enforcement-honesty.test.js | 45 ++++++++++++++++
 4 files changed, 169 insertions(+), 11 deletions(-)
