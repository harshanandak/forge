+      baseChanged: true,
+      from: 'MERGE_READY',
+      to: 'MERGE_READY',
+      headSha: head1,
+      baseSha: 'b'.repeat(40),
+      addedReasons: [],
+      removedReasons: [],
+    });
+  });
 });
 
