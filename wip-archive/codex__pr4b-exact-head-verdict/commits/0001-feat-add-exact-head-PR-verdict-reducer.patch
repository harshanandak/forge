+    expect(change).toEqual({
+      changed: true,
+      headChanged: true,
+      stateChanged: true,
+      from: 'BLOCKED',
+      to: 'MERGE_READY',
+      headSha: head2,
+      addedReasons: [],
+      removedReasons: ['required_check_not_successful'],
