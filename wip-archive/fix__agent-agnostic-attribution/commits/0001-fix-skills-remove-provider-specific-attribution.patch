 ```
 
 **Step 5c: Create the PR**
diff --git a/skills/ship/SKILL.md b/skills/ship/SKILL.md
index 2352a19b..28464ca5 100644
--- a/skills/ship/SKILL.md
+++ b/skills/ship/SKILL.md
@@ -148,8 +148,6 @@ If no PR template exists, use this minimal fallback:
 
 ## Issue
 Closes forge-xxx
-
-🤖 Generated with [Claude Code](https://claude.com/claude-code)
 ```
 
 **Step 5c: Create the PR**
diff --git a/test/agents-skills-repo-discovery.test.js b/test/agents-skills-repo-discovery.test.js
index 484d6bec..81f0932f 100644
--- a/test/agents-skills-repo-discovery.test.js
+++ b/test/agents-skills-repo-discovery.test.js
@@ -18,6 +18,17 @@ const { UTILITY_SKILL_IDS } = require('../lib/harness-capability-matrix');
 
 const repoRoot = path.resolve(__dirname, '..');
 
+function findProviderAttributionFooter(content) {
+  const footerPattern = /^[\t ]*(?:🤖[\t ]*)?generated with[\t ]+\[([^\]\r\n]+)\]\(([^)\r\n]+)\)[\t ]*$/i;
+  for (const line of content.split(/\r?\n/)) {
+    const match = line.match(footerPattern);
+    if (match && match[1].trim().toLowerCase() !== 'forge workflow') {
+      return line;
+    }
+  }
+  return null;
+}
+
 // ─── Codex repo-local (.agents/skills) discovery parity ───────────────────────
 //
 // Codex scans `.agents/skills/<name>/SKILL.md` from cwd up to the repo root for
@@ -87,4 +98,45 @@ describe('codex repo-local .agents/skills discovery', () => {
       expect(drift).toEqual([]);
     }
   });
+
+  test('canonical and committed skills contain no provider-specific attribution footer', () => {
+    const committed = resolveCodexRepoSkillsDir(repoRoot);
+    for (const skill of listCanonicalSkills(repoRoot)) {
+      const skillFiles = [
+        path.join(skill.sourcePath, 'SKILL.md'),
+        path.join(committed, skill.name, 'SKILL.md'),
+      ];
+      for (const skillFile of skillFiles) {
+        expect(findProviderAttributionFooter(fs.readFileSync(skillFile, 'utf8'))).toBeNull();
+      }
+    }
+  });
+
+  test('attribution detection rejects agent footers without rejecting prose or Forge', () => {
+    const providerFooters = [
+      '🤖 Generated with [Claude Code](https://claude.com/claude-code)',
+      'Generated with [Hermes](https://example.com/hermes)',
+      'Generated with [OpenAI Codex](https://example.com/codex)',
+      'Generated with [Cline](https://example.com/cline)',
+    ];
+    for (const footer of providerFooters) {
+      expect(findProviderAttributionFooter(footer)).toBe(footer);
+    }
+
+    expect(findProviderAttributionFooter('Artifacts generated with Codex CLI are stored here.')).toBeNull();
+    expect(
+      findProviderAttributionFooter('Generated with\n[Claude Code](https://claude.com/claude-code)'),
+    ).toBeNull();
+    expect(
+      findProviderAttributionFooter('Generated with [Claude\nCode](https://claude.com/claude-code)'),
+    ).toBeNull();
+    expect(
+      findProviderAttributionFooter('Generated with [Claude Code](https://claude.com/\nclaude-code)'),
+    ).toBeNull();
+    expect(
+      findProviderAttributionFooter(
+        '🤖 Generated with [Forge Workflow](https://github.com/anthropics/forge)',
+      ),
+    ).toBeNull();
+  });
 });
