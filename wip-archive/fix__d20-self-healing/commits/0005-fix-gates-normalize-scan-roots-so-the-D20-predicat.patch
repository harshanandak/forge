From ffa5715447ed844b3c901cd1fcb73fe911abbfb7 Mon Sep 17 00:00:00 2001
From: forge-shepherd <noreply@anthropic.com>
Date: Sun, 26 Jul 2026 08:06:04 +0530
Subject: [PATCH] fix(gates): normalize scan roots so the D20 predicate matches
 the census
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A scan root reaches getScanRoots in whatever spelling its source used — a
plugin manifest directory entry, a sync-manifest file, an explicit scanRoots
option — and a trailing separator survived. walkFiles joins it away and scans
the tree regardless, while isBdCensusPath built `root//` and matched nothing
beneath it, so the pre-commit auto-heal skipped exactly the files the census
counts and the artifact went stale while the hook reported success.

Normalize once where the roots are resolved, and drop the predicate's own
re-normalization so there is a single rule rather than two free to drift.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 lib/release-readiness.js       | 25 ++++++++++++++++++++-----
 test/release-readiness.test.js | 22 ++++++++++++++++++++++
 2 files changed, 42 insertions(+), 5 deletions(-)

diff --git a/lib/release-readiness.js b/lib/release-readiness.js
index bfee3b94..f2c3dcd7 100644
--- a/lib/release-readiness.js
+++ b/lib/release-readiness.js
@@ -413,13 +413,27 @@ function readSyncManifestScanRoots(projectRoot) {
   }
 }
 
+// Scan roots reach here in whatever spelling their source used — a plugin manifest
+// directory entry, a sync-manifest file, an explicit scanRoots option — so they are
+// normalized once, at the single place they are resolved. walkFiles would join a trailing
+// separator away and scan the tree regardless, while isBdCensusPath would build `root//`
+// and match nothing under it; normalizing here is what keeps the census and the
+// pre-commit predicate from disagreeing about which files count.
+function normalizeScanRoot(root) {
+  if (typeof root !== 'string' || root.length === 0) {
+    return '';
+  }
+  return normalizeRepoPath(root).replace(/[/\\]+$/, '');
+}
+
 function getScanRoots(projectRoot, options = {}) {
   const roots = options.scanRoots || getDefaultScanRoots(projectRoot);
   return [
-    ...new Set([
-      ...roots,
-      ...readSyncManifestScanRoots(projectRoot),
-    ]),
+    ...new Set(
+      [...roots, ...readSyncManifestScanRoots(projectRoot)]
+        .map(normalizeScanRoot)
+        .filter(Boolean),
+    ),
   ];
 }
 
@@ -569,8 +583,9 @@ function isBdCensusPath(projectRoot, filePath, options = {}) {
     return false;
   }
 
+  // getScanRoots already returns normalized roots — re-normalizing here would be a second
+  // copy of that rule, free to drift from the one auditBdCallSites walks.
   return getScanRoots(projectRoot, options)
-    .map(normalizeRepoPath)
     .some(root => {
       // walkFiles applies no directory skips to a root that is itself a file.
       if (relativePath === root) {
diff --git a/test/release-readiness.test.js b/test/release-readiness.test.js
index bf7e247e..7b638bad 100644
--- a/test/release-readiness.test.js
+++ b/test/release-readiness.test.js
@@ -2372,6 +2372,28 @@ describe('isBdCensusPath — the pre-commit auto-heal predicate', () => {
     expect(isBdCensusPath(root, 'AGENTS.md')).toBe(true);
   });
 
+  // A scan root can arrive with a trailing separator — a plugin manifest directory entry,
+  // or an explicit scanRoots option. walkFiles joins it away and scans the whole tree, so
+  // a predicate that keeps it builds `root//` and rejects every descendant the census just
+  // counted. The auto-heal would then skip exactly the commits it exists to heal.
+  test('a trailing-separator scan root still counts its descendants', () => {
+    const root = makeRepo();
+    writeFile(root, 'lib/commands/_issue.js', "exec('bd', ['show']);\n");
+
+    const audit = auditBdCallSites(root, { scanRoots: ['lib/'] });
+    expect(audit.groups.command.files.map(file => file.path)).toContain('lib/commands/_issue.js');
+    expect(isBdCensusPath(root, 'lib/commands/_issue.js', { scanRoots: ['lib/'] })).toBe(true);
+  });
+
+  test('resolves redundant scan-root spellings to the same root the census walks', () => {
+    const root = makeRepo();
+    writeFile(root, 'lib/commands/_issue.js', "exec('bd', ['show']);\n");
+
+    for (const scanRoot of ['lib//', './lib/', 'lib\\']) {
+      expect(isBdCensusPath(root, 'lib/commands/_issue.js', { scanRoots: [scanRoot] })).toBe(true);
+    }
+  });
+
   // Derivation, not duplication: skill roots come from lib/agents/*.plugin.json, so a
   // manifest-declared root must count without the predicate naming it.
   test('follows manifest-declared skill roots', () => {
