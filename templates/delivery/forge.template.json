{
  "schemaVersion": "forge.template/1",
  "id": "harsha/delivery",
  "version": "0.1.1",
  "summary": "The owner's delivery loop over the work, memory and check blocks: slice, build with receipts, review in bounded rounds, merge on a pinned head. Operations read block configuration; skills carry delivery guidance.",
  "config": {
    "schemaVersion": "forge.config/1",
    "blocks": {
      "work": {
        "source": {
          "builtin": "forge/work"
        },
        "config": {
          "labelOrder": ["p0", "p1", "p2", "p3", "p4"],
          "claimTtlSeconds": 7200
        }
      },
      "memory": {
        "source": {
          "builtin": "forge/memory"
        }
      },
      "check": {
        "source": {
          "builtin": "forge/check"
        }
      }
    }
  }
}
