{
  "name": "forge-cloud-dev",
  "main": "src/adapters/workers-oauth/compose.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Reachable on workers.dev now that device tokens exist; every route needs a token. No preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "vars": {
    "CLERK_ISSUER": "https://example.clerk.accounts.dev",
    "FORGE_OWNER_SUBJECT": "user_REPLACEWITHOWNERID",
    "CLERK_CLIENT_ID": "public-client-id",
    "CLERK_REDIRECT_URI": "https://worker.workers.dev/callback",
    "FORGE_API_RESOURCE": "https://worker.workers.dev",
    "OAUTH_TIMEOUT_MS": "5000",
    // Device login (routes loginstart and loginpoll) needs FORGE_CLOUD_PROJECT, the one already provisioned
    // project name it serves, and the secret DEVICE_LOGIN_HMAC_KEY (random, base64url, at least 32 bytes).
    // Set the secret with `wrangler secret put DEVICE_LOGIN_HMAC_KEY`; never commit its value.
    // Issue reads (command issue.show) need FORGE_CLOUD_ID_PREFIX, the issue id prefix as in <prefix>-<n>:
    // lowercase letters, digits and hyphens, at most 32 characters. Without it issue.show answers 503.
    // Optional FORGE_OAUTH_REDIRECTS: comma-separated https redirect URLs that may register besides loopback.
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROJECTS", "class_name": "Project" },
      { "name": "CODE_REDEMPTION", "class_name": "CodeRedemption" },
      { "name": "REGISTRATION_LIMITER", "class_name": "RegistrationLimiter" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Project"] },
    { "tag": "v2-code-redemption", "new_sqlite_classes": ["CodeRedemption"] },
    {
      "tag": "v3-registration-limits",
      "new_sqlite_classes": ["RegistrationLimiter"],
    },
  ],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "send_metrics": false,
}
