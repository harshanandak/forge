{
  "name": "forge-cloud-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Reachable on workers.dev now that device tokens exist; every route needs a token. No preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "PROJECTS", "class_name": "Project" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Project"] }],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "send_metrics": false,
}
