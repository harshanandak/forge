{
  "name": "forge-cloud-dev",
  "main": "src/adapters/workers-oauth/compose.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Reachable on workers.dev now that device tokens exist; every route needs a token. No preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "vars": {
    "CLERK_ISSUER": "https://example.clerk.accounts.dev",
    "CLERK_CLIENT_ID": "public-client-id",
    "CLERK_REDIRECT_URI": "https://worker.workers.dev/callback",
    "FORGE_API_RESOURCE": "https://worker.workers.dev",
    "OAUTH_TIMEOUT_MS": "5000",
  },
  "durable_objects": {
    "bindings": [{ "name": "PROJECTS", "class_name": "Project" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Project"] }],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "send_metrics": false,
}
