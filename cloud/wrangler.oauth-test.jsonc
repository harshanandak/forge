{
  // Isolated CI-local OAuth fixture. Never deploy this entry.
  "name": "forge-oauth-conformance",
  "main": "conformance/oauth-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "oauth-conformance" }],
  "durable_objects": {
    "bindings": [
      { "name": "CODE_REDEMPTION", "class_name": "CodeRedemption" },
      { "name": "GRANT_STATE", "class_name": "GrantState" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CodeRedemption"] },
    { "tag": "v2", "new_sqlite_classes": ["GrantState"] },
  ],
  "dev": { "ip": "127.0.0.1", "port": 8788 },
  "send_metrics": false,
}
