{
  // Conformance only (.github/workflows/cloud.yml). The same Worker as wrangler.example.jsonc, entered through
  // a wrapper that can fail a receipt insert on request. Never deploy with this file.
  "name": "forge-cloud-conformance",
  "main": "conformance/fault-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "PROJECTS", "class_name": "Project" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Project"] }],
  // Test-only limits so a small project needs several dump pages and a larger one trips the size guard.
  // wrangler.example.jsonc sets none, so a deploy uses the defaults (4 MiB pages, a 32 MiB project, 20,000 rows per table).
  "vars": {
    "DUMP_PAGE_BYTES": "4096",
    "DUMP_MAX_BYTES": "131072",
    "DUMP_MAX_ROWS": "100",
    // Device login for the admitted project, with public test values only. The Clerk upstream is a test
    // double in conformance/fault-worker.ts; nothing here reaches a real identity provider.
    "DEVICE_LOGIN_HMAC_KEY": "BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc",
    "CLERK_ISSUER": "https://clerk.test",
    "FORGE_OWNER_SUBJECT": "user_ConformanceOwner",
    "CLERK_CLIENT_ID": "conformance-client",
    "CLERK_REDIRECT_URI": "http://127.0.0.1:8787/callback",
    "FORGE_API_RESOURCE": "http://127.0.0.1:8787",
    "OAUTH_TIMEOUT_MS": "5000",
  },
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "send_metrics": false,
}
