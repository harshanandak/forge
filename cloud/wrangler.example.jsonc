{
  // Committed example only. A bare `wrangler deploy` finds no wrangler.jsonc here and stops. Copy this
  // file to cloud/wrangler.local.jsonc (git-ignored), fill every <placeholder> with your real value,
  // run scripts/preflight.mjs, and pass --config wrangler.local.jsonc to every wrangler command.
  "name": "<worker-name>",
  "account_id": "<account-id>",
  "main": "src/adapters/workers-oauth/compose.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // The id of an existing namespace, so a deploy never provisions or inherits another one.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<kv-namespace-id>" }],
  "vars": {
    "CLERK_ISSUER": "<clerk-frontend-api-url>",
    "CLERK_CLIENT_ID": "<clerk-client-id>",
    "CLERK_REDIRECT_URI": "<worker-origin>/callback",
    "FORGE_API_RESOURCE": "<worker-origin>",
    "OAUTH_TIMEOUT_MS": "5000",
    "FORGE_OWNER_SUBJECT": "<owner-subject>",
    "FORGE_CLOUD_PROJECT": "<project-name>",
    // Issue reads (command issue.show) need FORGE_CLOUD_ID_PREFIX, the issue id prefix as in <prefix>-<n>:
    // lowercase letters, digits and hyphens, at most 32 characters. Without it issue.show answers 503.
    "FORGE_CLOUD_ID_PREFIX": "<id-prefix>",
    // Server-owned GitHub scope for the one admitted project. Never omit repository_ids when minting.
    "GITHUB_APP_ID": "<github-app-id>",
    "GITHUB_APP_INSTALLATION_ID": "<github-installation-id>",
    "GITHUB_REPOSITORY_ID": "<admitted-repository-id>",
    // producer.appId is app.id from the approved workflow check suite, independent of credential GITHUB_APP_ID.
    "GITHUB_MERGE_POLICY": "{\"project\":\"<project-name>\",\"repositoryId\":<admitted-repository-id>,\"baseBranch\":\"<base-branch>\",\"version\":\"<policy-version>\",\"producer\":{\"repositoryId\":<admitted-repository-id>,\"appId\":<producer-app-id>,\"workflowId\":<workflow-id>,\"workflowPath\":\".github/workflows/<workflow-file>.yml\",\"workflowDigest\":\"<workflow-sha256>\"},\"requiredChecks\":[\"<required-check-name>\"]}",
    // Optional FORGE_OAUTH_REDIRECTS: comma-separated https redirect URLs that may register besides loopback.
  },
  // Secrets, set with `wrangler secret put` and never written here: DEVICE_LOGIN_HMAC_KEY, ADMIN_TOKEN, GITHUB_APP_PRIVATE_KEY (PKCS#8 PEM).
  "durable_objects": {
    "bindings": [
      { "name": "PROJECTS", "class_name": "Project" },
      { "name": "CODE_REDEMPTION", "class_name": "CodeRedemption" },
      { "name": "REGISTRATION_LIMITER", "class_name": "RegistrationLimiter" },
      { "name": "GRANT_STATE", "class_name": "GrantState" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Project"] },
    { "tag": "v2-code-redemption", "new_sqlite_classes": ["CodeRedemption"] },
    {
      "tag": "v3-registration-limits",
      "new_sqlite_classes": ["RegistrationLimiter"],
    },
    { "tag": "v4-oauth-grant-state", "new_sqlite_classes": ["GrantState"] },
  ],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "send_metrics": false,
}
